/-
AtFullSide/K2/CarriedLit.lean: the entries that the written book carries to the code switch's parts,
written out. Definitions alone: CarriedWritten.lean ties them to the book, piece by piece.
-/
import AtFullSide.K14.RawAheadWritten
import Johnson.Unfolds.SplitOn
import Johnson.Unfolds.SliceFoldl

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace AtFullSide.K2
open VerifiableInference.Desc (KindName Place)
open ProofFile.Honest
open AtFullSide.K14 (rawAheadW rawSegW)

/-- An entry without its mark: name, owner, start, count, spender. -/
abbrev Tup : Type := String × Addr × Due × Due × Addr

/-- What an entry says, but for its mark. -/
def tupOf (e : Ahead) : Tup := (e.name, e.owner, e.start, e.count, e.spender)

/-- The carried entry that a tuple writes out. -/
def aheadOf (t : Tup) : Ahead := ⟨t.1, t.2.1, t.2.2.1, t.2.2.2.1, t.2.2.2.2, false⟩

/-- A carried entry at part 0 of a place of the kind. -/
def keepK2 (e : Ahead) : Bool :=
  !e.once && e.spender.place.kind == KindName.K2 && e.spender.part == 0

