variable {W₀ : Type}

/-- CONDITIONAL: see the head. **The clause of the rule at the list of the test on G_u, at the
maker's return at the filling, at the library's book, WITH ONE CLAUSE ON VALUES LEFT**: hAns:
each answer of the instance's key is its row's own, at the rows as the senders are handed them. hAns
names no coin k that the book lends, no challenge, no stand and no carried block; it reads the
index, the committer's pads and the key. -/
theorem onAtRun_U_at_return_paid {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD} {r₀ : LPFD.Full.RunPF}
    {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain S ProofFile.Cl}
    {x₀ : VerifiableInference.Desc.First.Look.Place}
    (h : P5J.AtMgA OnBytes.secondHashFunction Z D₀ r₀ Zp Np cF x₀)
    (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8])
    (I : WiderIn W₀) (S' : OnBytes.HonestTrace.Sz) (O : OnlineProverArguments)
    {Ar : OnlineProverWithDescription W₀ IndexCommitterCoins Cells Unit Unit}
    (hAr : onlineProverFromPublicFiles OnBytes.secondHashFunction Z.pol Z.lay Z.KL (onlineProverPartsInUse I OnBytes.secondHashFunction S' O) =
      .ok Ar)
    {Bk : ProverCoinCounts}
    (hB : bookWhole (P5J.F0T OnBytes.secondHashFunction Zp Np cF) proofSendsFull.1 proofSendsFull.2.1
      proofSendsFull.2.2 (mergesByName (P5J.F0T OnBytes.secondHashFunction Zp Np cF).first.blocksInOrder) = .ok Bk)
    {H : Prover W₀ IndexCommitterCoins ProofFile.Inst TableKey Cells Unit Unit}
    {G : Sides (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk W₀ IndexCommitterCoins TableKey Cells Unit Unit}
    (hP : G.prover H = Ar.H) {w₀ : W₀} {rc : IndexCommitterCoins}
    {x : ProofFile.Inst} {k : Coins Bk} {ρ : Draws}
    {R : Ready W₀ IndexCommitterCoins ProofFile.Inst TableKey Cells Unit Unit}
    {r : RunC (P5J.F0T OnBytes.secondHashFunction Zp Np cF)}
    (T : ThreadsP (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k R)
    (hρ : ρ.due (P5J.F0T OnBytes.secondHashFunction Zp Np cF) = true)
    (hR : ready (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k = .ok R)
    (hrun : runC (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k ρ = .ok r)
    (A : ManyJob (Common W₀ IndexCommitterCoins TableKey) Unit)
    (hA : jobRealU (I.weights Zp) (fun w => Bind.ForProver.encW Zp (I.weights Zp w)) Zp = some A)
    (Js : SimJob TableKey) (hJs : Js = simHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8])
    (L : Lettered Bk St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
    (hL : IsListAtU Np L A Js)
    (hAns : ∀ csU csO : Array E, OwnAnswers (K1.qAt Zp Np) x.pub.key
      (heldAt (K1.qAt Zp Np)
        (askOf ⟨K1.qAt Zp Np, 0⟩ (fun c => I.weights Zp c.w₀)
          (fun c => randNow (K1.qAt Zp Np) c.rc)
          (⟨w₀, rc, x.pub.key⟩ : Common W₀ IndexCommitterCoins TableKey)) csU csO)) :
    OnAtRun₂ T ρ r L := by
  have eZ : Ar.Z = Zp := (atPure_at_laid h.laid hAr).1
  have hst : Ar.H.storedWords = fun w rc i y =>
      (Bind.ForProver.encW Zp (I.weights Zp w) rc i y).map (·.map OnBytes.Slice.ofF) := by
    funext w rc' i y
    rw [atPure_storedWords hAr, eZ]
    rfl
  obtain ⟨hgU, hgO⟩ := sendings_found h I OnBytes.secondHashFunction S' O hAr
  have hA' : A = jobHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] (G.prover H).storedWords
      (fun w => I.weights Zp w.w₀) (fun w => randAt (K1.qAt Zp Np) w.rc) none := by
    have e := jobRealU_at_head h.toAtMg b1 b2 b3 b4 b5 b6 b7 b8 hb (I.weights Zp)
      (fun w => Bind.ForProver.encW Zp (I.weights Zp w))
    rw [hA] at e
    rw [hP, hst]
    exact Option.some.inj e
  have h1 : nowSharedBy (I.weights Zp) Zp =
      .ok (K14.proverSidesOfSharedRounds ⟨(K1.qAt Zp Np).S, 0, 6⟩ (I.weights Zp) ++
        K14.proverSidesOfSharedSendings { P := K1.qAt Zp Np, atPoint := 0 } (I.weights Zp)
          (K14.randNow (K1.qAt Zp Np))) := K14.sixBody_at_head h _
  have hg : ((G.prover H).shared.find? fun g => g.place == (fourOf Np).U.place) =
      some (proverSideOfProximityTest A.toRun.toTest) := by
    have hU : halfU (I.weights Ar.Z) (fun w => Bind.ForProver.encW Ar.Z (I.weights Ar.Z w)) Ar.Z ≠
        [] := by
      rw [eZ, halfU_at_head h.toAtMg b1 b2 b3 b4 b5 b6 b7 b8 hb]
      exact List.cons_ne_nil _ _
    obtain ⟨M, hM, hf⟩ := shared_test_found_of_laid I OnBytes.secondHashFunction S' O hAr
      (by rw [eZ]; exact h1) hU
    rw [eZ, hA] at hM
    obtain rfl := Option.some.inj hM
    have ePl : (fourOf Np).U.place = placeU := p12At_place _ _
    rw [hP, ePl]
    exact hf
  -- the eighth sub-protocol's half
  have hgS : ((G.prover H).shared.find? fun g => g.place == b8.place) = some ⟨b8.place,
      [(K14.liftK14 ⟨(K1.qAt Zp Np).S, 0, 6⟩ (I.weights Zp)
        (K14.splitPart ⟨(K1.qAt Zp Np).S, 0, 6⟩) :
        Part Empty (Common W₀ IndexCommitterCoins TableKey) Unit)]⟩ := by
    obtain ⟨-, -, -, -, -, -, -, -, hs, -⟩ := atPure_ok hAr
    have hs' : Ar.H.shared = sharedWithUO I Ar.Z := hs
    rw [eZ] at hs'
    have e0 : sharedWithUO I Zp =
        K14.proverSidesOfSharedRounds ⟨(K1.qAt Zp Np).S, 0, 6⟩ (I.weights Zp) ++
          K14.proverSidesOfSharedSendings { P := K1.qAt Zp Np, atPoint := 0 } (I.weights Zp)
            (K14.randNow (K1.qAt Zp Np)) ++
          halfU (I.weights Zp) (fun w => Bind.ForProver.encW Zp (I.weights Zp w)) Zp ++
          halfO (I.weights Zp) Zp := by
      show (match nowSharedBy (I.weights Zp) Zp with
        | .ok six =>
          six ++ halfU (I.weights Zp) (fun w => Bind.ForProver.encW Zp (I.weights Zp w)) Zp ++
            halfO (I.weights Zp) Zp
        | .error _ => []) = _
      rw [h1]
    have hH : (K14.proverSidesOfSharedRounds ⟨(K1.qAt Zp Np).S, 0, 6⟩ (I.weights Zp) :
        List (Placed Empty (Common W₀ IndexCommitterCoins TableKey) Unit)).find?
          (fun g => g.place == K14.place 8) = some ⟨K14.place 8,
        [K14.liftK14 ⟨(K1.qAt Zp Np).S, 0, 6⟩ (I.weights Zp)
          (K14.splitPart ⟨(K1.qAt Zp Np).S, 0, 6⟩)]⟩ := by
      rw [K14.halves_eq, if_pos (facts_at_head h.toAtMg).1]
      rfl
    rw [hP, hs', e0, (K14.places4 _ b1 b2 b3 b4 b5 b6 b7 b8 hb).2.2.2, List.find?_append,
      List.find?_append, List.find?_append, hH]
    rfl
  -- the input that ready lays for the shared chain
  have hα : ∀ y, (G.prover H).key y = y.pub.key := by
    rw [hP]
    exact key_at_pure hAr
  have hcom : R.common = ⟨w₀, rc, x.pub.key⟩ := by
    obtain ⟨-, tr, -, -, hc₀, -⟩ := ready_ok hR
    rw [hc₀, hα x]
  -- the rule's clause
  intro σ hσ u hu pre' t' hcut m ca _ _ hca hc hmid hfrt
  have hpl : σ.block.place = L.place := side_place hσ
  have hJ : A.toRun.toTest = (jobHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8]
      (G.prover H).storedWords (fun c => I.weights Zp c.w₀)
      (fun c => randNow (K1.qAt Zp Np) c.rc) none).toRun.toTest := by rw [hA']; rfl
  have hJp : A.toRun.toTest.p = (fourOf Np).U := by rw [hA']; rfl
  have hfr : A.toRun.toTest.fresh.isNone = false := by rw [hA']; rfl
  have hs : Js.p = (fourOf Np).U := by rw [hJs]; rfl
  have ho : Js.own = false := by rw [hJs]; rfl
  have hσ' : testSide (P5J.F0T OnBytes.secondHashFunction Zp Np cF).shared.blocksInOrder A.toRun.toTest Js [] =
      some σ := by
    unfold testSide
    rw [hJp, ← hL.place, ← hL.row]
    exact hσ
  obtain ⟨e9, Sd, hlaid, hmem, s, next, rest, Ti, hk, hfit⟩ := seat_at_U h.toAtMg b1 b2 b3 b4 b5 b6
    b7 b8 hb hρ hR _ Js hJp hfr hs ho σ hσ' hg pre' t' hcut
  rw [hL.on, hfrt]
  replace hu : u ∈ [firstMember A.toRun.toTest Js, restMember A.toRun.toTest Js] := by
    rw [← hmem]
    exact hu
  rcases List.mem_cons.1 hu with rfl | hu'
  · intro hn
    cases hn
  obtain rfl := List.mem_singleton.1 hu'
  intro _
  obtain ⟨ca₁, m₁, g₁, g₂, g₃⟩ := onFreeT_head_U_paid h.toAtMg b1 b2 b3 b4 b5 b6 b7 b8 hb hB
    (P := G.prover H) hα (I.weights Zp) _ hJ Js hJs hR σ pre' t' Sd
    e9 (by rw [hpl, hL.place]; exact hg) hlaid s next rest _ Ti hk hfit hrun
    (by rw [hpl]; exact hc) (by rw [hP]; exact hgU) (by rw [hP]; exact hgO)
    ⟨(K1.qAt Zp Np).S, 0, 6⟩ rfl rfl rfl hgS (fun y => by rw [hP, hst]; rfl)
    (by rw [hcom]; exact hAns)
  rw [hpl] at g₁ g₂ g₃
  have e₁ : ca₁ = ca := Except.ok.inj (g₁.symm.trans hca)
  have hmid' : orRefused (midSharedAtW (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k ρ
      ⟨L.place, 1⟩) = .ok m := hmid
  have g₂' : midSharedAtW (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k ρ
      ⟨L.place, 1⟩ = .ok (some m₁) := g₂
  rw [g₂'] at hmid'
  have e₂ : m₁ = m := Except.ok.inj (show (Except.ok m₁ : Except Refusal _) = .ok m from hmid')
  subst e₁
  subst e₂
  exact g₃

/-- CONDITIONAL: see the head. **The same at the return's own book**: hB is paid: the book that the
maker returns is the library's, at the written sendings (`atPure_book_at_head`,
`made_sends_at_files`). So among the binders no premise on a book is left: the book's return has
moved into hAr. -/
theorem onAtRun_U_at_the_returns_book {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD}
    {r₀ : LPFD.Full.RunPF}
    {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain S ProofFile.Cl}
    {x₀ : VerifiableInference.Desc.First.Look.Place}
    (h : P5J.AtMgA OnBytes.secondHashFunction Z D₀ r₀ Zp Np cF x₀)
    (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8])
    (I : WiderIn W₀) (S' : OnBytes.HonestTrace.Sz) (O : OnlineProverArguments)
    {Ar : OnlineProverWithDescription W₀ IndexCommitterCoins Cells Unit Unit}
    (hAr : onlineProverFromPublicFiles OnBytes.secondHashFunction Z.pol Z.lay Z.KL (onlineProverPartsInUse I OnBytes.secondHashFunction S' O) =
      .ok Ar)
    {H : Prover W₀ IndexCommitterCoins ProofFile.Inst TableKey Cells Unit Unit}
    {G : Sides (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Ar.B W₀ IndexCommitterCoins TableKey Cells Unit Unit}
    (hP : G.prover H = Ar.H) {w₀ : W₀} {rc : IndexCommitterCoins}
    {x : ProofFile.Inst} {k : Coins Ar.B} {ρ : Draws}
    {R : Ready W₀ IndexCommitterCoins ProofFile.Inst TableKey Cells Unit Unit}
    {r : RunC (P5J.F0T OnBytes.secondHashFunction Zp Np cF)}
    (T : ThreadsP (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Ar.B (G.prover H) w₀ rc x k R)
    (hρ : ρ.due (P5J.F0T OnBytes.secondHashFunction Zp Np cF) = true)
    (hR : ready (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Ar.B (G.prover H) w₀ rc x k = .ok R)
    (hrun : runC (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Ar.B (G.prover H) w₀ rc x k ρ = .ok r)
    (A : ManyJob (Common W₀ IndexCommitterCoins TableKey) Unit)
    (hA : jobRealU (I.weights Zp) (fun w => Bind.ForProver.encW Zp (I.weights Zp w)) Zp = some A)
    (Js : SimJob TableKey) (hJs : Js = simHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8])
    (L : Lettered Ar.B St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
    (hL : IsListAtU Np L A Js)
    (hAns : ∀ csU csO : Array E, OwnAnswers (K1.qAt Zp Np) x.pub.key
      (heldAt (K1.qAt Zp Np)
        (askOf ⟨K1.qAt Zp Np, 0⟩ (fun c => I.weights Zp c.w₀)
          (fun c => randNow (K1.qAt Zp Np) c.rc)
          (⟨w₀, rc, x.pub.key⟩ : Common W₀ IndexCommitterCoins TableKey)) csU csO)) :
    OnAtRun₂ T ρ r L := by
  have hB : bookWhole (P5J.F0T OnBytes.secondHashFunction Zp Np cF) proofSendsFull.1 proofSendsFull.2.1
      proofSendsFull.2.2 (mergesByName (P5J.F0T OnBytes.secondHashFunction Zp Np cF).first.blocksInOrder) =
        .ok Ar.B := by
    have hb' := K14.atPure_book_at_head h hAr
    rw [K14.made_sends_at_files h.scope h.laid] at hb'
    exact hb'
  exact onAtRun_U_at_return_paid h b1 b2 b3 b4 b5 b6 b7 b8 hb I S' O hAr hB hP T hρ hR hrun A hA Js
    hJs L hL hAns

