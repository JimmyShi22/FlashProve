/-- The carried entries among the written pieces behind. -/
def openCD : List Ahead := [
  ⟨"message 4 of 1.0.1.0 to 3.-.2.0: carried", ⟨⟨1, some 0, 1, .K1⟩, 0⟩, ⟨25848, 8647⟩, ⟨0, 311⟩,
    ⟨⟨3, none, 2, .K12⟩, 0⟩, false⟩,
  ⟨"message 4 of 1.0.1.0 to 3.-.2.1: carried", ⟨⟨1, some 0, 1, .K1⟩, 0⟩, ⟨25848, 8647⟩, ⟨0, 311⟩,
    ⟨⟨3, none, 2, .K12⟩, 1⟩, false⟩]

/-- **The 335 spending entries.** -/
def openS : List Ahead := openSA ++ openSB

/-- **The 209 carried entries.** -/
def openC : List Ahead := openCC ++ openCD

/-- A filter of rawAheadW, piece by piece. -/
theorem filter_whole (f : Ahead → Bool) {a b c d : List Ahead}
    (hA : (rawWantsW.map (·.entry)).filter f = a) (hB : shortB.filter f = b)
    (hC : rawSegW.filter f = c) (hD : shortD.filter f = d) :
    rawAheadW.filter f = a ++ b ++ c ++ d := by
  subst hA hB hC hD
  unfold rawAheadW shortB shortD
  simp only [List.filter_append, List.append_assoc]

/-- A list of which the test accepts no entry is emptied by the filter. -/
theorem filter_none (l : List Ahead) (f : Ahead → Bool) (h : (l.all fun e => !f e) = true) :
    l.filter f = [] := by
  rw [List.filter_eq_nil_iff]
  intro e he h2
  have h1 := List.all_eq_true.1 h e he
  simp [h2] at h1

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem wants_spend :
    decide (((rawWantsW.map (·.entry)).filter fun e => e.owner == opener && e.once).map aheadView =
      openSA.map aheadView) = true := by
  decide +kernel

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem wants_carry :
    ((rawWantsW.map (·.entry)).all fun e => !(e.owner == opener && !e.once)) = true := by
  decide +kernel

set_option maxRecDepth 1000000 in
theorem shortB_spend :
    decide ((shortB.filter fun e => e.owner == opener && e.once).map aheadView =
      openSB.map aheadView) = true := by
  decide +kernel

set_option maxRecDepth 1000000 in
theorem shortB_carry : (shortB.all fun e => !(e.owner == opener && !e.once)) = true := by
  decide +kernel

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem seg_spend : (rawSegW.all fun e => !(e.owner == opener && e.once)) = true := by
  unfold rawSegW ProofFile.Honest.segmentCarries ProofFile.Honest.linkOf
  simp only [Johnson.Unfolds.splitOn_eq, Johnson.Unfolds.slice_toNat?_eq]
  decide +kernel

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem seg_carry :
    decide ((rawSegW.filter fun e => e.owner == opener && !e.once).map aheadView =
      openCC.map aheadView) = true := by
  unfold rawSegW ProofFile.Honest.segmentCarries ProofFile.Honest.linkOf
  simp only [Johnson.Unfolds.splitOn_eq, Johnson.Unfolds.slice_toNat?_eq]
  decide +kernel

set_option maxRecDepth 1000000 in
theorem shortD_spend : (shortD.all fun e => !(e.owner == opener && e.once)) = true := by
  decide +kernel

set_option maxRecDepth 1000000 in
theorem shortD_carry :
    decide ((shortD.filter fun e => e.owner == opener && !e.once).map aheadView =
      openCD.map aheadView) = true := by
  decide +kernel

set_option maxRecDepth 1000000 in
/-- The comparison can fail: the count 312 for 311 in the last entry. -/
theorem open_bent :
    decide ((shortD.filter fun e => e.owner == opener && !e.once).map aheadView =
      (openCD.map fun e => { e with count := ⟨0, 312⟩ }).map aheadView) = false := by
  decide +kernel

/-- **rawAheadW's spending entries with the opening's sender as owner are openS.** -/
theorem spends_open : (rawAheadW.filter fun e => e.owner == opener && e.once) = openS := by
  rw [filter_whole _ (List.map_injective_iff.2 aheadView_inj (of_decide_eq_true wants_spend))
    (List.map_injective_iff.2 aheadView_inj (of_decide_eq_true shortB_spend))
    (filter_none _ _ seg_spend) (filter_none _ _ shortD_spend)]
  simp only [List.append_nil, openS]

/-- **rawAheadW's carried entries with that owner are openC.** -/
theorem carries_open : (rawAheadW.filter fun e => e.owner == opener && !e.once) = openC := by
  rw [filter_whole _ (filter_none _ _ wants_carry) (filter_none _ _ shortB_carry)
    (List.map_injective_iff.2 aheadView_inj (of_decide_eq_true seg_carry))
    (List.map_injective_iff.2 aheadView_inj (of_decide_eq_true shortD_carry))]
  simp only [List.nil_append, openC]

