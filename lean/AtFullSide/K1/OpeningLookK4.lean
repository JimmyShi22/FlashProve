/-- A tool: members 0 and 4 of rides_first_written (Honest/K1/Law/RideAtPlans.lean): at the
opening's written plan no table rides at message 0 or at message 4. That 0 and 4 lie below the
number of messages is read off the equation's own two lengths; range_at (Honest/K2/Law/Reads.lean)
gives the range's member. -/
theorem ride_zero_four :
    rideOf (firstFold K1.qFull) 0 = none ∧ rideOf (firstFold K1.qFull) 4 = none := by
  have hlen : K1.parGF.sent.size = 5 := by
    have e := congrArg List.length rides_first_written
    rw [List.length_map, List.length_range] at e
    exact e
  have e0 : ((List.range K1.parGF.sent.size).map (rideOf (firstFold K1.qFull)))[0]? = some none :=
    congrArg (fun l => l[0]?) rides_first_written
  have e4 : ((List.range K1.parGF.sent.size).map (rideOf (firstFold K1.qFull)))[4]? = some none :=
    congrArg (fun l => l[4]?) rides_first_written
  rw [List.getElem?_map, ProofFile.Honest.K2.Reads.range_at (by rw [hlen]; decide)] at e0 e4
  exact ⟨Option.some.inj e0, Option.some.inj e4⟩

variable {Z : VerifierAndGoals.PublicFiles} {D : WholeD} {r : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4}
  {cF : Chain S ProofFile.Cl} {x : First.Look.Place} {Bs : ProofFile.PureBase}
  {base₀ : List (Block S ProofFile.Cl)} {Bk : ProverCoinCounts} {Wl Xi X : Type}

/-- h, O AND hJ ARE PREMISES. **THE MASK ROW: MESSAGE 0.** An identity of two readings of one
element, at each run's coins. That row 1's "row" is rowZeroW is not said here. -/
theorem opening_look_row (h : P5J.AtMgA OnBytes.secondHashFunction Z D r Zp Np cF x)
    (O : IM.Open OnBytes.secondHashFunction Z.pol Z.lay Z.KL (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Zp Bs base₀ cF
      (seatZ Zp Np) (secondAt Zp Np))
    (wit : Wl → PlaceIn Xi) (own₀ : X) (first : Nat) (Dd : RowDataOf Xi)
    {J : SendJob (PlaceIn Xi) X}
    (hJ : J = placeJob (K1.firstPar Bs.G₀.first (K1.gpOf Zp)) first (firstFold Bs.G₀.first) Dd) :
    ∀ (k : Coins Bk) w hd ν y',
      ν < (shapeAt J.P 0).maskRows * (J.P.codes.mask.getD (shapeAt J.P 0).maskCode default).ell →
      msgTxt 0 wit J own₀ 0 k w hd true 0 ν = some y' →
      (k.look 0 rowZeroW.owner).2.eAt (rowZeroW.base.e + ν) = .ok y' := by
  intro k w hd ν y' hν hy
  have hP : J.P = K1.firstPar Bs.G₀.first (K1.gpOf Zp) := by
    subst hJ
    rfl
  have hR : J.ride = rideOf (firstFold Bs.G₀.first) := by
    subst hJ
    exact placeJob_ride _ _ _ _ 0
  obtain ⟨e1, e2, -, -⟩ := opening_head_written h O
  obtain ⟨-, -, -, m0, -, -⟩ := opening_head h O
  have h1 : (shapeAt J.P 0).maskRows = 1 := by
    rw [hP]
    exact m0
  rw [h1, Nat.one_mul] at hν
  rw [e1, e2, ← hP, ← hR]
  refine msgTxt_mask_look_one 0 wit J own₀ 0 ν k w hd ?_ ?_ h1 hν y' hy
  · rw [hP]
    exact (openingNos_head h O).1
  · rw [hR, ride_two_head h O]
    exact ride_zero_four.1

/-- h, O, hJ AND hg ARE PREMISES. **THE INDEX MASKS' MESSAGE: MESSAGE 4.** An identity of two
readings of one element, at each run's coins. -/
theorem opening_look_idx (h : P5J.AtMgA OnBytes.secondHashFunction Z D r Zp Np cF x)
    (O : IM.Open OnBytes.secondHashFunction Z.pol Z.lay Z.KL (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Zp Bs base₀ cF
      (seatZ Zp Np) (secondAt Zp Np))
    (wit : Wl → PlaceIn Xi) (own₀ : X) (first : Nat) (Dd : RowDataOf Xi)
    {J : SendJob (PlaceIn Xi) X}
    (hJ : J = placeJob (K1.firstPar Bs.G₀.first (K1.gpOf Zp)) first (firstFold Bs.G₀.first) Dd)
    {g : ℕ} (hg : g < 12) :
    ∀ (c : Coins Bk) w hd y',
      msgTxt 0 wit J own₀ 4 c w hd true (k4IndexRow Zp g) (k4IndexPlace Zp g) = some y' →
      (c.look 0 rawIdxW.owner).2.eAt (rawIdxW.base.e + k4IndexTakes Zp g) = .ok y' := by
  intro c w hd y' hy
  have hP : J.P = K1.firstPar Bs.G₀.first (K1.gpOf Zp) := by
    subst hJ
    rfl
  have hR : J.ride = rideOf (firstFold Bs.G₀.first) := by
    subst hJ
    exact placeJob_ride _ _ _ _ 0
  obtain ⟨-, -, e3, e4⟩ := opening_head_written h O
  obtain ⟨-, -, -, -, m4, -⟩ := opening_head h O
  obtain ⟨r1, r2⟩ := idxEntry_head h O g
  rw [r1, r2, m4, Nat.mod_one, Nat.div_one] at hy
  have hb := idxTakes_below h O hg
  rw [m4, Nat.one_mul] at hb
  rw [e3, e4, ← hP, ← hR]
  refine msgTxt_mask_look_one 0 wit J own₀ 4 (k4IndexTakes Zp g) c w hd ?_ ?_ ?_ ?_ y' hy
  · rw [hP]
    exact (openingNos_head h O).2
  · rw [hR, ride_two_head h O]
    exact ride_zero_four.2
  · rw [hP]
    exact m4
  · rw [hP]
    exact hb

/-- h, hA AND hJ ARE PREMISES; NO OPENING. **THE MASK ROW, AT A RETURNED onlineProverFromPublicFiles.** The opening is
taken out of w_at_mg; hJ is said at the ground that it returns, which is A.G. -/
theorem opening_look_row_at (h : P5J.AtMgA OnBytes.secondHashFunction Z D r Zp Np cF x)
    {W₀ Rc Tr X₀ Xa : Type} {P : OnlineProverParts W₀ Rc Tr X₀ Xa} {A : OnlineProverWithDescription W₀ Rc Tr X₀ Xa}
    (hA : onlineProverFromPublicFiles OnBytes.secondHashFunction Z.pol Z.lay Z.KL P = .ok A)
    (wit : Wl → PlaceIn Xi) (own₀ : X) (first : Nat) (Dd : RowDataOf Xi)
    {J : SendJob (PlaceIn Xi) X}
    (hJ : J = placeJob (K1.firstPar A.G.first (K1.gpOf A.Z)) first (firstFold A.G.first) Dd) :
    ∀ (k : Coins Bk) w hd ν y',
      ν < (shapeAt J.P 0).maskRows * (J.P.codes.mask.getD (shapeAt J.P 0).maskCode default).ell →
      msgTxt 0 wit J own₀ 0 k w hd true 0 ν = some y' →
      (k.look 0 rowZeroW.owner).2.eAt (rowZeroW.base.e + ν) = .ok y' := by
  obtain ⟨Bs, base, O, -⟩ := P4.w_at_mg h.toAtMg
  obtain ⟨eZ, eG, -⟩ := atPure_at_laid_ground h.laid O.blank hA
  exact opening_look_row h O wit own₀ first Dd (by rw [hJ, eZ, eG])

/-- h, hA, hJ AND hg ARE PREMISES; NO OPENING. **THE INDEX MASKS' MESSAGE, AT A RETURNED
onlineProverFromPublicFiles.** -/
theorem opening_look_idx_at (h : P5J.AtMgA OnBytes.secondHashFunction Z D r Zp Np cF x)
    {W₀ Rc Tr X₀ Xa : Type} {P : OnlineProverParts W₀ Rc Tr X₀ Xa} {A : OnlineProverWithDescription W₀ Rc Tr X₀ Xa}
    (hA : onlineProverFromPublicFiles OnBytes.secondHashFunction Z.pol Z.lay Z.KL P = .ok A)
    (wit : Wl → PlaceIn Xi) (own₀ : X) (first : Nat) (Dd : RowDataOf Xi)
    {J : SendJob (PlaceIn Xi) X}
    (hJ : J = placeJob (K1.firstPar A.G.first (K1.gpOf A.Z)) first (firstFold A.G.first) Dd)
    {g : ℕ} (hg : g < 12) :
    ∀ (c : Coins Bk) w hd y',
      msgTxt 0 wit J own₀ 4 c w hd true (k4IndexRow Zp g) (k4IndexPlace Zp g) = some y' →
      (c.look 0 rawIdxW.owner).2.eAt (rawIdxW.base.e + k4IndexTakes Zp g) = .ok y' := by
  obtain ⟨Bs, base, O, -⟩ := P4.w_at_mg h.toAtMg
  obtain ⟨eZ, eG, -⟩ := atPure_at_laid_ground h.laid O.blank hA
  exact opening_look_idx h O wit own₀ first Dd (by rw [hJ, eZ, eG]) hg

