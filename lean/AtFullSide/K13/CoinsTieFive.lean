/-- The library's written list of shapes has, at number 4, the shape of message number 4 of the
opening's written plan. By evaluation in Lean's kernel. -/
theorem shapeFourW : MFull[4]? = some (shapeAt parGF 4) := by
  decide +kernel

/-- The evaluation can fail: at number 3 the list has not this shape. -/
theorem shapeFourW_bites : decide (MFull[3]? = some (shapeAt parGF 4)) = false := by
  decide +kernel

/-- At the opening's written plan message number 4 has 255 free mask entries. By evaluation in
Lean's kernel. -/
theorem freeFourW : Send.freeMaskEntries (shapeAt parGF 4).maskRows
    (parGF.codes.mask.getD (shapeAt parGF 4).maskCode default).ell (shapeAt parGF 4).answers =
      255 := by
  decide +kernel

variable {Z : VerifierAndGoals.PublicFiles} {D : WholeD} {r : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4}
  {cF : Chain TS ProofFile.Cl} {xh : VerifiableInference.Desc.First.Look.Place}
  {Bs : ProofFile.PureBase} {base₀ : List (Block TS ProofFile.Cl)}

/-- **hshape, UNDER THE HEAD, AT THE PLAN OF THE DESCRIPTION's OWN GROUND.** CONDITIONAL on h and O.
-/
theorem k13_hshape_at_head (h : AtMgA OnBytes.secondHashFunction Z D r Zp Np cF xh)
    (O : IM.Open OnBytes.secondHashFunction Z.pol Z.lay Z.KL (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Zp Bs base₀ cF
      (seatZ Zp Np) (secondAt Zp Np)) :
    (msgsOfChain Zp.made.proof.1)[4]? = some (shapeAt (firstPar Bs.G₀.first (gpOf Zp)) 4) := by
  rw [h.toAtMg.msgs_at_head,
    VerifiableInference.Desc.K1.eG_atAll h O (VerifiableInference.Desc.K1.pin1_atAll h)]
  exact shapeFourW

/-- **THE LEDGER's COUNT AS IT IS MADE, UNDER THE HEAD.** CONDITIONAL on h. -/
theorem k13_free0_at_head (h : AtMgA OnBytes.secondHashFunction Z D r Zp Np cF xh) :
    indexFree0 Zp cF = 255 := by
  have hc : P5J.At.cs Zp = _ :=
    LT28.K11Tests.codes_in_scope h.scope h.laid.pub (VerifiableInference.Desc.K1.pin1_atAll h)
  show VerifiableInference.Desc.First.FillP1.free0Of (P5J.At.cs Zp)
    (msgsOfChain Zp.made.proof.1) (P5J.At.N Zp cF).indexNo = 255
  rw [hc, h.toAtMg.msgs_at_head, h.toAtMg.indexNo_at]
  exact LT28.K11Tests.free_full

variable (h : AtMgA OnBytes.secondHashFunction Z D r Zp Np cF xh)
  {Bk : ProverCoinCounts} {W₀ Rc Ky Tr X₀ X' : Type}
  (H : Prover W₀ Rc ProofFile.Inst Ky Tr X₀ X')
  (Q : Script Bk (Local W₀ Rc ProofFile.Inst Tr) (CellsM OnBytes.Flat.numsFull) P5J.At.Tok MsgT)
  (test : Nat → TS → Option String) (carryX : Nat → ProofFile.InstPub × TS → Strs → WtF → Prop)
  (item n₁ n₂ b₀ : Nat) (Vd : Local W₀ Rc ProofFile.Inst Tr → Prop)
  (Rd : Nat → Local W₀ Rc ProofFile.Inst Tr → TS → Prop) (Kp : Place → TS → TS → Prop)
  (w₁ : Local W₀ Rc ProofFile.Inst Tr)

/-- THE RECORD IS A PREMISE: no Script is laid. hW (`bookWhole` RETURNS THE THREAD's BOOK, at the
head's own sendings of the first chain; p1 and p2 are free letters) IS A PREMISE: THAT THE BOOK
WHICH IT RETURNS IS THE THREAD's IS SHOWN NOWHERE. **`CoinsTie` AT THE HEAD, AT THE BORDER 355, FROM
FIVE PREMISES**: kind K1's record at the opening (K), the library's "opened" (O), that the job's
plan and ride are the opening's (hP, hR), and "the book is the maker's" (hW):
`k13_coinsTie_of_seated_written` with its three premises on public numbers shown. IT PAYS NO DEBT BY
ITSELF. CONDITIONAL on h. -/
theorem k13_coinsTie_of_five {weights : W₀ → Weights} {pile : PileOf ProofFile.Inst}
    {Bs : ProofFile.PureBase} {base₀ : List (Block TS ProofFile.Cl)}
    (O : IM.Open OnBytes.secondHashFunction Z.pol Z.lay Z.KL (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Zp Bs base₀ cF
      (seatZ Zp Np) (secondAt Zp Np))
    {blk₂ : Block TS ProofFile.Cl} {wit : Local W₀ Rc ProofFile.Inst Tr → PlaceIn ProofFile.Inst}
    {J : K1.SendJob (PlaceIn ProofFile.Inst) X'} {own₀ : X'} {seats₀ : List (ℕ × ℕ)} {ms : List Mem}
    {rad : ℕ → ℕ}
    (K : K1Seated (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁) 2 blk₂ wit J
      own₀ .opening (P5J.At.arr Zp) seats₀ ms rad)
    (hP : J.P = firstPar Bs.G₀.first (gpOf Zp))
    (hR : J.ride = K1.rideOf (K1.firstFold Bs.G₀.first))
    {p1 p2 : Johnson.G.ChainSends}
    (hW : bookWhole (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Zp.made.proof.1 p1 p2
      (mergesByName cF.blocksInOrder) = .ok Bk) :
    CoinsTie (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁) 355 weights pile h.𝔇.P13
      (k13ReaderAt h) := by
  have hs : Zp.made.proof = proofSendsFull :=
    VerifiableInference.PlanWritten.Joined.sends_in_scope h.scope h.laid.pub
      (VerifiableInference.Desc.K1.pin1_atAll h)
  rw [hs] at hW
  refine k13_coinsTie_of_seated_written h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ O K hP hR
    (by rw [hP]; exact k13_hshape_at_head h O) ?_ hW ?_
  · rw [k13_free0_at_head h, hP,
      VerifiableInference.Desc.K1.eG_atAll h O (VerifiableInference.Desc.K1.pin1_atAll h),
      freeFourW]
  · rw [k13_free0_at_head h, m3_kCol h]
    decide

end AtFullSide.K13

