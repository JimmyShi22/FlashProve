/-- The grid's text of n bytes with the step s: byte i is (n + s i) mod 256. -/
def ramp (n s : Nat) : ByteArray :=
  (List.range n).foldl (fun o i => o.push ((n + s * i) % 256).toUInt8)
    (ByteArray.emptyWithCapacity n)

