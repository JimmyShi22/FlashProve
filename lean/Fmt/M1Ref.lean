def bump (e : E) : E := (Fld.two.add e.1 1, e.2.1, e.2.2)
/-- element j of what round i sends, made one larger -/
def bumpSent (i j : Nat) : View :=
  ⟨refRounds.mapIdx fun a r =>
      if a == i then { r with sent := r.sent.mapIdx fun b e => if b == j then bump e else e }
      else r,
    refOpened⟩
/-- word j of opened column number i, made one larger -/
def bumpCol (i j : Nat) : View :=
  ⟨refRounds,
    refOpened.mapIdx fun a o =>
      if a == i then (o.1, o.2.1, o.2.2.mapIdx fun b w => if b == j then Fld.two.add w 1 else w)
