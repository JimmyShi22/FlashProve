def refView : View := ⟨refRounds, refOpened⟩

def rd (i : Nat) : RV := refRounds.getD i {}
def s0 : Stage := refPar.stages.getD 0 default
def s1 : Stage := refPar.stages.getD 1 default
def s2 : Stage := refPar.stages.getD 2 default
def e0 (l : List E) (i : Nat) : E := l.getD i Fld.zeroE
def pr (i : Nat) : E × E := (e0 (rd i).sent 0, e0 (rd i).sent 1)

/-- the four rows under BAT, by this library's blocks (K = 3: rounds 0 .. 8) -/
def rows1 : List GRow :=
  pscBlock .two 3 s0.Z.l (rd 2).els (e0 (rd 3).sent 0) [pr 4, pr 5, pr 6] (pr 7) (pr 8)
      (e0 (rd 3).els 0) [e0 (rd 4).els 0, e0 (rd 5).els 0, e0 (rd 6).els 0] (e0 (rd 7).els 0) ++
    [sampleRow .two s0.Am s0.Az ((rd 0).els.take s0.na) (e0 (rd 0).els s0.na) (e0 (rd 1).sent 0)]
def G1 : GRow := sumRows .two (e0 (rd 9).els 0) rows1
def S1 : SRow :=
  foldStep .two 2 0 G1 (e0 (rd 10).sent 0) (e0 (rd 10).els 0)
    [pr 11, pr 12] [e0 (rd 11).els 0, e0 (rd 12).els 0]
def G2 : Option GRow :=
  csStep .two s0 s1 S1
    (sampleRow .two s1.Am s1.Az ((rd 13).els.take s1.na) (e0 (rd 13).els s1.na) (e0 (rd 14).sent 0))
    (rd 14).poss (e0 (rd 14).els 0) fun x => (colAt refView 0 x).bind (stageCol s0 3 0)
def S2 : Option SRow :=
  G2.map fun G =>
    foldStep .two 1 1 G (e0 (rd 15).sent 0) (e0 (rd 15).els 0) [pr 16] [e0 (rd 16).els 0]
def G3 : Option GRow :=
  S2.bind fun S =>
    csStep .two s1 s2 S
      (sampleRow .two s2.Am s2.Az ((rd 17).els.take s2.na)
        (e0 (rd 17).els s2.na) (e0 (rd 18).sent 0))
      (rd 18).poss (e0 (rd 18).els 0) fun x => (colAt refView 1 x).bind (stageCol s1 0 2)

