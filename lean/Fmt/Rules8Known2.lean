/-
Fmt/Rules8Known2.lean: a chain in a file, three more toys whose files another program has made.
  L: listed positions.
  T: one tree opened at two lists in two rounds.
  M: a second, shallower tree under the same draw.

Definitions and guards only; made by a program from that other program's files. No Mathlib.

Tests of the strict reader `wholeChain` (Fmt/Rules8.lean), the verifier's parser of a proof file:
round by round it recomputes the hash chain from which the challenges are drawn, tests the proof of
work and checks every Merkle opening against its root. A toy is a small chain made up for tests; the
one before these three is `Toy8K.spec` (Fmt/Rules8Known.lean). A test (#guard) is an evaluation made
while the file compiles; the compile fails if the result moves; it leaves no theorem. A guard is
such a test.

The page: an edition of the format page that is not the one that ships; not held against that page.
(The head of Fmt/Rules8Known.lean says what "the page" and "the programs" are.)
This library's own toys, not the programs': the files were made, byte for byte, by a program that
calls the page's own twin in Python, independently of these Lean files.
The configuration is the page's toys' (one public file; `Toy4.cfg`, Fmt/Rules4.lean).
The toys exercise these rules:
  R8.2 and R8.7: the list comes after the nonce and before the openings; a chain's own trees are
    opened in the order of their numbers.
  R7.14: two openings under one root give no vertex two values (T). R7.15 (M): a tree of depth b
    under a draw below 2 ^ k is opened at the set of the short positions, increasing. The short
    position of x is the remainder of x by 2 ^ b (`shortPos`, Fmt/Rules7.lean).

Main names:
  `Toy8K2.specL` (L): two rounds: a root (a tree of depth 4, three elements a column), 8 bits of
    work, three positions below 16, listed in one byte each, the tree's opening; an element.
  `Toy8K2.specT` (T): three rounds: a root, work, three positions, the tree's opening; an element,
    three positions, the same tree's opening at their list; an element.
  `Toy8K2.specM` (M): round 1 sends two roots: tree 0 of depth 4, tree 1 of depth 2; behind the draw
    (three positions, one comes twice) both are opened, in the order of their numbers.

What the guards check: each honest file is read, with these values as the other program printed
them:
  the digest of the parameters, the run's value and the first value of the chain (`heads`);
  the positions as drawn, the lists, and the number of given digests of every opening (`lists`).
The later values of the chain are checked through the draws that depend on them: that is T's value
after round 1 alone, through T's second draw. The other later values are compared nowhere in this
file.
Of the altered copies the reader refuses all but those that differ in a last message alone, which
only a protocol's decision can refuse.

Limits: this file says nothing on the programs' own files.
-/
import Fmt.Rules8

namespace Fmt
namespace Toy8K2

def e1 (msg roots : Nat) : Entry :=
  { name := "toy: positions", work := 8, msg := msg, roots := roots, poss := 3, logN := 4 }
def e2 : Entry := { name := "toy: positions again", msg := 24, poss := 3, logN := 4 }
def e3 : Entry := { name := "toy: nothing", msg := 24 }
def shA : Shape := { a := 4, W := 3, tree := 0 }
def shB : Shape := { a := 2, W := 3, tree := 1 }

def mk (posB : Nat) (rs : List Round) : Spec where
  label := 7
  plan := { field := .two, salt := 40, nonce := 8, posB := posB, samples := 0,
            saved := 1, entries := rs.map (·.entry) }
  params := paramsBytes
    { field := .two, salt := 40, nonce := 8, posB := posB, samples := 0,
      saved := 1, entries := rs.map (·.entry) }
    Toy4.cfg []
  statement := items [("toy: claim", ext (1, 2, 3))]
  rand := .inFile
  cfg := Toy4.cfg
  rounds := rs

def specL : Spec :=
  mk 1 [{ entry := e1 32 1, kind := .positions, items := [.root], opens := [(shA, .own 0)] },
      { entry := e3, kind := .nothing, items := [.e] }]
def specT : Spec :=
  mk 0 [{ entry := e1 32 1, kind := .positions, items := [.root], opens := [(shA, .own 0)] },
      { entry := e2, kind := .positions, items := [.e], opens := [(shA, .own 0)] },
      { entry := e3, kind := .nothing, items := [.e] }]
def specM : Spec :=
  mk 0 [{ entry := e1 64 2, kind := .positions, items := [.root, .root],
          opens := [(shA, .own 0), (shB, .own 1)] },
      { entry := e3, kind := .nothing, items := [.e] }]

def read (S : Spec) (s : String) : Option ChainOut := wholeChain (m := Id) formatHash S (unhex s)
def heads (o : ChainOut) : String × Option String × String := (hex o.pd, o.run.map hex, hex o.rho0)
def lists (o : ChainOut) : List (List Nat × List Nat × List (Nat × List Nat × Nat)) :=
  o.rounds.toList.map fun r =>
    (r.drawn.poss, r.list, r.opens.map fun x => (x.1.tree, x.2.1, x.2.2.given.length))

end Toy8K2

open Toy8K2 in
#guard specL.ok && specT.ok && specM.ok

/-! ## L -/

open Toy8K2 in
#guard ((read specL "").map heads) =
  some ("88fba0568f249f55bc0eb2ffa2b166b54b6788e67ea607b3d2fb6ec8700ffedc", some "6423ba474bb5d5ae3944ca71c54989dedfda2e56ea53bd62da5df84140ebb6a3", "f52f0193422d4b53316233c23341d91481491377883e21dfcbe9b2521bef3037")
open Toy8K2 in
#guard ((read specL "").map lists) == some [([0, 12, 13], [0, 12, 13], [(0, [0, 12, 13], 5)]), ([], [], [])]
-- alt-01: the first listed position is one larger
open Toy8K2 in
#guard (read specL "").isNone
-- alt-02: the first two listed positions swapped (not increasing)
open Toy8K2 in
#guard (read specL "").isNone
-- alt-03: the list backwards ([13, 12, 0]), not increasing (at the edition named in the head the draws come out increasing: the list as drawn is the honest one)
open Toy8K2 in
#guard (read specL "").isNone
-- alt-04: the list left out (the form of a file of `Toy8K.spec`, Fmt/Rules8Known.lean)
open Toy8K2 in
#guard (read specL "").isNone
-- alt-05: a fourth listed position put in behind the list
open Toy8K2 in
#guard (read specL "").isNone

/-! ## T -/

open Toy8K2 in
#guard ((read specT "").map heads) =
  some ("da53fb395566e59ee07c3a9a8722d29c018010378801d5a7abdb6c31736723b8", some "f0ce5f92c6d76efb1120e35fa6f0eb7d06f3e212d7544b40206495556b456549", "6e1877427f2a2997e7387c7063edc7282027c8a20594405b35fce521eb52be15")
open Toy8K2 in
#guard ((read specT "").map lists) == some [([6, 3, 5], [3, 5, 6], [(0, [3, 5, 6], 5)]), ([1, 8, 4], [1, 4, 8], [(0, [1, 4, 8], 7)]), ([], [], [])]
-- alt-01: in the second opening the given digest (4, 5) has bit 0 flipped. The pair is (depth,
-- place). The first opening has fixed the value of this vertex
open Toy8K2 in
#guard (read specT "").isNone
-- alt-02: in the second opening a column's byte flipped
open Toy8K2 in
#guard (read specT "").isNone
-- alt-03: s1 (round 2's element): byte 0 flipped (the second draw moves)
open Toy8K2 in
#guard (read specT "").isNone
-- alt-04: s2 (round 3's element): byte 0 flipped: read (only a decision of the protocol can refuse
-- it)
open Toy8K2 in
#guard (read specT "").isSome

/-! ## M -/

open Toy8K2 in
#guard ((read specM "").map heads) =
  some ("6edff96c67862edf340ec3884d7709f873c462e1c57350da26ea86fa63da7d97", some "f8679bfe163550a65f6822fcbe97c1213ae8144e5a185563fc0eba40617e1e0b", "1d360e4f677b6593a96d9db9896c6f8af795e333953175cbe80e04c0e02d9afc")
open Toy8K2 in
#guard ((read specM "").map lists) == some [([11, 6, 11], [6, 11], [(0, [6, 11], 6), (1, [2, 3], 1)]), ([], [], [])]
-- alt-01: the two roots swapped
open Toy8K2 in
#guard (read specM "").isNone
-- alt-02: a byte of a column of tree 1 flipped
open Toy8K2 in
#guard (read specM "").isNone
-- alt-03: a byte of a salt of tree 1 flipped
open Toy8K2 in
#guard (read specM "").isNone
-- alt-04: s (round 2's element): byte 0 flipped: read (only a decision of the protocol can refuse
-- it)
open Toy8K2 in
#guard (read specM "").isSome

end Fmt
