/-
Fmt/M1Targets.lean: the nineteen values that the programs print on the verifier's way through a
proof of the first toy (a product test), as a function of the view. They are computed here so that
each block by itself can be compared with the programs.

The values are intermediate results of the verifier's computation: targets and single coefficients
of the linear claims that it carries from one step to the next, folded symbols of an opened column,
and the two sides of the last check.
"The programs" are the C++ implementation that comes with this Lean code. Definitions that compute,
with tests (#guard). No theorem. Core Lean; total; generic in the sizes.

The words. A block is one step of the toy's protocol. The string of blocks is the function that goes
through them one after the other (`decWith`, Fmt/M1Dec.lean, whose head lists them). BAT, FOLD, CS
and BASE are steps of the string. The view is `View`, Fmt/M1Types.lean. A target is the right-hand
side t of a row (`GRow`) or of a fold's claim (`SRow`).

Why: no equation before the last block is tested. So an accepted or refused file tells only whether
all blocks agree. At a request made for this library the programs write, beside a proof, nineteen
elements of E, in this
order (source: the answers to questions on the programs' description of the toy, section 0):
    the target after BAT;
    for each stage but the last: the target after FOLD; the three folded symbols (main, old mask,
      fresh mask) at the first draw of the switch; the target after CS; the first entry of its c;
      the first and the last entry of its d;
    the two sides of the last block's linear check.

Main names:
  `targets P V : Option (List E)`: these values (1 + 8 for each stage but the last + 2), by this
    library's blocks, along the same string of rounds as `decWith`; none
      where the string would refuse a round's numbers,
      or a position drawn at a code switch (CS) has no column of the stage's width,
      or a switch draws no position,
      or a round is left over,
      or there is no stage.
  `names n`: their names at n stages (nineteen at three stages), for use in a report.

Tests. At the programs' own tiny parameters (`parTheirTiny`, Fmt/M1All.lean), on a run of this
library's own reference program in Python (a second, independent reading of the same description;
its own witness
and coins): all nineteen are the reference's; the decision (`decM`) accepts the run's view.

Limits: nothing is compared in this file with the nineteen values that the programs print. On the
    programs' own proofs the nineteen values are compared in Fmt/M1FullProgPTv.lean,
    Fmt/M1FullProgPRv.lean and Fmt/M1FullProgPFv.lean.
  `targets` walks the rounds by a copy of the string's steps, not by `decWith` itself. `targets`
    leaves out that function's test on the sizes (`stagesOK`) and reads no column of the last tree.

Terms: lean/GLOSSARY.md.
-/
import Fmt.M1All

namespace Fmt.M1

/-- The values from a group's row on, along the steps of `iopp` (Fmt/M1Dec.lean). -/
def ioppT (f : Fld) (V : View) : List Stage → (tree mF mE : Nat) → GRow → Rs → Option (List E)
  | [], _, _, _, _, _ => none
  | [s], _, _, _, G, rs =>
    match nextN 1 1 0 rs with
    | some (⟨[tauS], [lam], _⟩, rs1) =>
      match nextN (s.C.l + s.Z.l + s.C.r + s.Z.r) 0 s.t rs1 with
      | some (v, []) =>
        some [f.addE (dot f G.c (v.sent.take s.C.l).toArray)
              (dot f G.d ((v.sent.drop s.C.l).take s.Z.l).toArray),
          f.addE tauS (f.mulE lam G.t)]
      | _ => none
    | _ => none
  | s :: s' :: more, tree, mF, mE, G, rs =>
    match nextN 1 1 0 rs with
    | some (⟨[sigma], [eps], _⟩, rs1) =>
      match takeRounds s.k rs1 with
      | some (qs, g, rs2) =>
        match seedOf s'.na rs2 with
        | some (z, beta, rs3) =>
          match nextN 1 1 s.t rs3 with
          | some (⟨[alpha], [theta], xs⟩, rs4) =>
            let S := foldStep f s.k s.h G sigma eps qs g
            let col := fun x => (colAt V tree x).bind (stageCol s mF mE)
            match xs.head?.bind col,
              csStep f s s' S (sampleRow f s'.Am s'.Az z beta alpha) xs theta col with
            | some c1, some G' =>
              let y := yOf f s.h S c1
              (ioppT f V (s' :: more) (tree + 1) 0 (2 ^ s'.k) G' rs4).map fun r =>
                [S.t, y.1, y.2.1, y.2.2, G'.t, ent G'.c 0, ent G'.d 0, ent G'.d (G'.d.size - 1)] ++
                  r
            | _, _ => none
          | _ => none
        | none => none
      | none => none
    | _ => none

/-- The nineteen values (so many at three stages), in the head's order. -/
def targets (P : Par) (V : View) : Option (List E) :=
  match P.stages with
  | [] => none
  | s :: _ =>
    match seedOf s.na V.rounds with
    | none => none
    | some (z, beta, rs1) =>
      match nextN 1 0 0 rs1 with
      | some (⟨[y], _, _⟩, rs2) =>
        match nextN 0 P.K 0 rs2 with
        | some (vz, rs3) =>
          match nextN 1 1 0 rs3 with
          | some (⟨[mu], [eps], _⟩, rs4) =>
            match takeRounds P.K rs4 with
            | some (qs, gamma, rs5) =>
              match nextN 2 1 0 rs5 with
              | some (⟨[p1, p2], [bY], _⟩, rs6) =>
                match nextN 2 0 0 rs6 with
                | some (⟨[v1, v2], _, _⟩, rs7) =>
                  match nextN 0 1 0 rs7 with
                  | some (⟨_, [x], _⟩, rs8) =>
                    let G := sumRows P.fld x
                      (pscBlock P.fld P.K s.Z.l vz.els mu qs (p1, p2) (v1, v2) eps gamma bY ++
                        [sampleRow P.fld s.Am s.Az z beta y])
                    (ioppT P.fld V P.stages 0 3 0 G rs8).map fun r => G.t :: r
                  | _ => none
                | _ => none
              | _ => none
            | none => none
          | _ => none
        | none => none
      | _ => none

/-- their names, at n stages -/
def names (n : Nat) : List String :=
  ["BAT: target"] ++
    (List.replicate (n - 1)
      ["FOLD: target", "CS: y_main at the first draw",
        "CS: y_0 at the first draw", "CS: y_1 at the first draw", "CS: target",
        "CS: c'[0]", "CS: d'[0]", "CS: d's last entry"]).flatten ++
    ["BASE: left side of the linear check", "BASE: right side of the linear check"]

#guard (names 3).length == 19

end Fmt.M1

