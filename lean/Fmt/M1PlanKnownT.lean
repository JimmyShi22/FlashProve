  work := 6
  salt := 40

def pubFile : ByteArray := unhex ""
def cfg : ByteArray := configDigest [pubFile]

/-- the further items: as the programs spell them -/
def items (P : Par) : List (String × ByteArray) := itemsOf P

def spec : Spec := specOf par cfg (items par)
def read (b : ByteArray) : Option ChainOut := wholeChain (m := Id) formatHash spec b

