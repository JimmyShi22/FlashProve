/-! ## 1 The letters that stay -/

/-- **The letters that stay.** -/
structure KeyFill (Bk : ProverCoinCounts) (W₀ Rc Cells M Smp Rec : Type) where
  /-- how a witness is read -/
  R : KRead Cells M
  /-- what a code, a sample and the stored table's OOD sample give, ONCE for the three chains: the
  library's own form in which each chain's own state is read (Johnson/RunOne/KeyOneReading.lean),
  with its three readings -/
  base : BaseSt Cells M Smp Rec
  /-- the stored table's OOD sample is the cells' own -/
  meetsT : Rec → Cells → Prop
  /-- the code's encoding of the folded message, and the radius: the library's letters -/
  enc : (Nat → OnBytes.E) → Nat → OnBytes.E
  rad : Nat
  /-- THE SCRIPT: what the stored table commits to -/
  cells : W₀ → Rc → Cells
  /-- message number n: 0 I · 1 B · 2 V: OF THE FIRST CHAIN's CHALLENGES · 3 U · 4 Omega · 5 the
  split's masks: OF THE SHARED CHAIN's -/
  msg : Nat → Coins Bk → W₀ → Rc → List Fmt.Drawn → M
  /-- after how many challenges OF ITS OWN CHAIN it turns no more -/
  fixedMsg : Nat → Nat
  pad : Nat → Nat → Coins Bk → W₀ → Rc → M
  /-- the two earlier chains' last states -/
  ends : Coins Bk → W₀ → Rc → Xi → List Fmt.Drawn → FirstState × St₂
  /-- what the step of a KIND's sub-protocol keeps: a letter; the sixteen sub-protocols of no kind
  have their clause by text (E2E/KeyKeepsEq.lean) -/
  kind₁ : Nat → FirstState → FirstState → Prop
  kind₂ : Nat → St₂ → St₂ → Prop
  kind₃ : Nat → St₃ → St₃ → Prop
  /-- of which inputs something is said -/
  Rel : W₀ → Rc → Xi → Prop
  /-- the stored table's columns; its item in the statement -/
  stored : W₀ → Rc → Nat → Nat → Option (List UInt64)
  item : Nat
  /-- the trees' tables, chain by chain -/
  table₁ : Fmt.TreeSource → Coins Bk → Local W₀ Rc Xi Unit → List Fmt.Drawn → Place × Table
  table₂ : Fmt.TreeSource → Coins Bk → Common W₀ Rc OnBytes.TableKey → List Fmt.Drawn → Place × Table
  table₃ : Fmt.TreeSource → Coins Bk → Local W₀ Rc Xi Unit → List Fmt.Drawn → Place × Table

section
variable {Bk : ProverCoinCounts} {W₀ Rc Cells M Smp Rec : Type} (L : KeyFill Bk W₀ Rc Cells M Smp Rec)

/-- **The witness**, of the first chain's challenges hA and the shared chain's hB: each message is
cut from its own chain's list. -/
def KeyFill.wit (k : Coins Bk) (w₀ : W₀) (rc : Rc) (hA hB : List Fmt.Drawn) : Wit Cells Unit M :=
  ⟨L.cells w₀ rc, (),
    fun n => L.msg n k w₀ rc ((if n < 3 then hA else hB).take (L.fixedMsg n)),
    fun j t => L.pad j t k w₀ rc⟩

/-- As the last chain's thread reads it: off one list: the first chain's challenges, then the shared
chain's, then its own. len₁: how many rounds the first chain has. -/
def KeyFill.witLast (len₁ : Nat) (k : Coins Bk) (w₀ : W₀) (rc : Rc) (h : List Fmt.Drawn) :
    Wit Cells Unit M :=
  L.wit k w₀ rc (h.take len₁) (h.drop len₁)

/-- **ONE MESSAGE ACROSS THE SEAMS**: a message of the first chain is the same in the first and in
the last thread. -/
theorem KeyFill.wit_first (len₁ : Nat) (k : Coins Bk) (w₀ : W₀) (rc : Rc)
    (h₁ h₂ : List Fmt.Drawn) (hl : h₁.length = len₁) {n : Nat} (hn : n < 3)
    (hB : List Fmt.Drawn) :
    (L.witLast len₁ k w₀ rc (h₁ ++ h₂)).msg n = (L.wit k w₀ rc h₁ hB).msg n := by
  show L.msg n k w₀ rc ((if n < 3 then (h₁ ++ h₂).take len₁ else _).take _) =
    L.msg n k w₀ rc ((if n < 3 then h₁ else hB).take _)
  rw [if_pos hn, if_pos hn, ← hl, List.take_left]

/-- And a message of the shared chain is the same in the shared and in the last thread, once it
turns no more. -/
theorem KeyFill.wit_shared (len₁ : Nat) (k : Coins Bk) (w₀ : W₀) (rc : Rc)
    (h₁ h₂ h₃ : List Fmt.Drawn) (hl : h₁.length = len₁) {n : Nat} (hn : ¬ n < 3)
    (hf : L.fixedMsg n ≤ h₂.length) (hA : List Fmt.Drawn) :
    (L.witLast len₁ k w₀ rc (h₁ ++ (h₂ ++ h₃))).msg n = (L.wit k w₀ rc hA h₂).msg n := by
  show L.msg n k w₀ rc ((if n < 3 then _ else (h₁ ++ (h₂ ++ h₃)).drop len₁).take _) =
    L.msg n k w₀ rc ((if n < 3 then hA else h₂).take _)
  rw [if_neg hn, if_neg hn, ← hl, List.drop_left, List.take_append_of_le_length hf]

end

/-! ## 2 What an item says on the honest side -/

section
variable {XI P S Cells M Smp Rec : Type} (F : FileDescription XI) (G : Reading (P × S) Cells M Smp Rec)
  (at_ : Where) (meetsT : Rec → Cells → Prop) (Mg : KMeaning P S (Wit Cells Unit M))

/-- **An item's sentence on the honest side.** -/
def holdsH : KItem → P × S → Strs → Wit Cells Unit M → Prop
  | .pin k => fun a _ w => ∃ o z, F.oracleAt (at_ k).1 = some o ∧
      G.smp a (at_ k).1 (at_ k).2 = some z ∧
      G.meets o (at_ k).1 (at_ k).2 (msgOf G w (at_ k).1 (at_ k).2) z
  | .pinT => fun a _ w => ∃ r, G.recOf a = some r ∧ meetsT r w.cells
  | i => i.holds F G at_ Mg

/-- **A DEBT WITH A NAME**: the committed word at message k's seat is an encoding of the witness's
message. It is a definition: a premise's form. -/
def Encodes (k : Nat) (y : Strs) (w : Wit Cells Unit M) : Prop :=
  ∀ o, F.oracleAt (at_ k).1 = some o →
    G.enc o (at_ k).1 (at_ k).2 (msgOf G w (at_ k).1 (at_ k).2) (wordOf F y (at_ k).1 (at_ k).2) ∧
      ∀ x, x < 2 ^ o.logLength → (wordOf F y (at_ k).1 (at_ k).2 x).isSome = true

theorem far_self (n : Nat) (c : Nat → Option VerifiableInference.Desc.Sym)
    (h : ∀ x, x < 2 ^ n → (c x).isSome = true) : far n c c = 0 := by
  unfold far
  rw [List.length_eq_zero_iff, List.filter_eq_nil_iff]
  intro x hx
  have h1 := h x (List.mem_range.1 hx)
  cases hc : c x with
  | none =>
    rw [hc] at h1
    cases h1
  | some s => simp

/-- **With that debt the honest pin gives the library's.** -/
theorem pin_of_honest (k : Nat) (a : P × S) (y : Strs) (w : Wit Cells Unit M)
    (h : holdsH F G at_ meetsT Mg (.pin k) a y w) (he : Encodes F G at_ k y w) :
    PIN F G (at_ k).1 (at_ k).2 a y w := by
  obtain ⟨o, z, h1, h2, h3⟩ := h
  obtain ⟨e1, e2⟩ := he o h1
  exact ⟨o, z, h1, h2, ⟨_, e1, by rw [far_self _ _ e2]; exact Nat.zero_le _⟩, h3⟩

end

/-! ## 2b The shared chain's ties, cut in two -/

section
variable {Cells M Smp Rec : Type} (G₂ : Reading (P₂ × St₂) Cells M Smp Rec) (at_ : Where)
  (S : OnBytes.Params.LinShape) (K₁ : VerifiableInference.Desc.Key.KPlan) (a : Nat)
  (last₁ : FirstState → Bool) (off₂ : Nat → Nat)

/-- **The library's facts on the state alone at a border of the shared chain** (`Tests₂`,
Johnson/RunOne/KeyOn2Parts.lean), AS FAR AS THEY READ THE KEY AND THE CHAIN's OWN STATE. -/
structure Own₂ (k : Nat) (ky : OnBytes.TableKey) (s : St₂) : Prop where
  key : s.loc.key = ky
  lay : 3 ≤ k → s.loc.oU.lay = OnBytes.vectorLay s.st.codes S.fold.u S.fold.rowsHigh
  placed : VerifiableInference.Desc.Key.Placed (plan₂ S).orc (fun o => s.book.place[o]?) off₂ at_
    ((pinned (open₂ k)).filter (3 ≤ ·))
  order : OnBytes.Means.InOrder s.st
  linOk : 2 ≤ k → OnBytes.linOk s.st.codes S = true
  seatU : 3 ≤ k → (s.st.oracles[0]?).any (·.shape == S.fold.u) = true
  seatOmega : 6 ≤ k → (s.st.oracles[2]?).any (·.shape == S.omega) = true
  fits : ky.fits S.fold.index = true
  maskU : 3 ≤ k → VerifiableInference.Desc.Key.MaskWith (fun i => s.book.place[i]?) 0 1

/-- The rest of them: ON THE FIRST CHAIN's LAST STATE. The shared chain's thread is not handed that
state. They hold of the states at which the two earlier threads end (`door_of_threads`,
E2E/KeySideCash.lean); no thread's clause holds them. -/
structure Handed₂ (e₁ : FirstState) (s : St₂) : Prop where
  last : last₁ e₁ = true
  eval : EvalIs S e₁
  placed₁ : VerifiableInference.Desc.Key.Placed K₁.orc (fun o => e₁.d.book.place[o]?) id at_ [0, 2]
  order₁ : OnBytes.Means.InOrder e₁.d.st
  codes : s.st.codes = e₁.d.st.codes
  mask₁ : ∀ o, K₁.orc 2 = some o →
    VerifiableInference.Desc.Key.MaskWith (fun i => e₁.d.book.place[i]?) o (o + 1)

/-- **THE JOINT**: the library's heap is the Bool, the own half and the handed half. -/
theorem tests₂_iff (k : Nat) (x : Xi) (e₁ : FirstState) (s : St₂) :
    Tests₂ at_ S K₁ a last₁ off₂ k ((x, e₁), s) ↔
      LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a k s) = true ∧ Own₂ at_ S off₂ k x.key s ∧
        Handed₂ at_ S K₁ last₁ e₁ s :=
  ⟨fun T => ⟨T.shape, ⟨T.key, T.lay, T.placed, T.order, T.linOk, T.seatU, T.seatOmega, T.fits,
      T.maskU⟩, ⟨T.last, T.eval, T.placed₁, T.order₁, T.codes, T.mask₁⟩⟩,
    fun ⟨h, O, H⟩ => ⟨h, H.last, H.eval, H.placed₁, H.order₁, O.key, H.codes, O.lay, O.placed,
      O.order, O.linOk, O.seatU, O.seatOmega, O.fits, H.mask₁, O.maskU⟩⟩

end

/-! ## 3 The filling -/

section
variable {Bk : ProverCoinCounts} {W₀ Rc Cells M Smp Rec : Type} (Xs : VerifiableInference.Desc.Key.Source)
  (N : H2U.PlaceNums) (Pl : VerifiableInference.Desc.Key.LaterPlaces)
  (L : KeyFill Bk W₀ Rc Cells M Smp Rec) (w₀ : W₀) (rc : Rc) (x : Xi)

/-- The key file's description: the term that E2E/KeyProtocolOverDescription.lean calls `keyFileDescription`. -/
abbrev D : FileDescription Xi := VerifiableInference.Desc.Key.descriptionFromSource Xs N Pl

/-- THE PUBLIC VALUES THAT THE DESCRIPTION's OWN FIRST CHAIN IS MADE OF: no letter. -/
abbrev one₀ : OnBytes.Params.OneTime := Xs.Y.k.oneTime

/-- **The first chain's.** -/
def rest₁ : Rest Bk FirstState (Local W₀ Rc Xi Unit) where
  table := L.table₁
  stored := fun w => L.stored w.w₀ w.rc
  valid := fun w => w = ⟨w₀, rc, x, ()⟩ ∧ L.Rel w₀ rc x
  P := Xi
  handed := fun _ w _ => w.x
  Wt := Wit Cells Unit M
  form := fun b a =>
    shape₁ (plan₁ (one₀ Xs)) (readers₁ (one₀ Xs)) (book₁ (one₀ Xs)) 2 (slots₁ (one₀ Xs)) b a.2
  formP := fun b a => Side18 Xs b a.2 ∧ ∃ r, L.base.recOf a.1 = some r
  means := fun _ => holdsH (D Xs N Pl) L.base.h₁ atSix L.meetsT (meaning₁At (one₀ Xs) L.R)
  wit := fun k w h => L.wit k w.w₀ w.rc h []
  strs := Env.strs L.item (srcAt 0 6 11)
  begun := fun _ w _ s₀ => s₀ = (D Xs N Pl).start₁ ((D Xs N Pl).pub w.x)
  rides := fun _ _ _ => True
  keeps := eq₁ (one₀ Xs) L.kind₁

/-- The library's meaning at the shared chain, at the structure's letters. -/
abbrev mg₂ : KMeaning P₂ St₂ (Wit Cells Unit M) :=
  meaning₂ (shapeAt Xs) (plan₁ (one₀ Xs)) L.R L.enc L.rad

/-- **The shared chain's.** It is handed the table's key, which its input holds; the instance is the
key. Each item is said at the instance of that key with EVERY state of the first chain: that state
is what the library's meaning is handed beside, and this thread is not. -/
def rest₂ : Rest Bk St₂ (Common W₀ Rc OnBytes.TableKey) where
  table := L.table₂
  stored := fun w => L.stored w.w₀ w.rc
  valid := fun w => w = ⟨w₀, rc, x.key⟩ ∧ L.Rel w₀ rc x
  P := OnBytes.TableKey
  handed := fun _ w _ => w.key
  Wt := Wit Cells Unit M
  form := fun _ _ => true
  formP := fun b a => Side₂ Xs b a.1 a.2 ∧ ∃ r, L.base.recOf ⟨a.1⟩ = some r
  means := fun _ i a y v => ∀ e₁ : FirstState,
    holdsH (D Xs N Pl) L.base.h₂ atSix L.meetsT (mg₂ Xs L) i ((⟨a.1⟩, e₁), a.2) y v
  wit := fun k w h => L.wit k w.w₀ w.rc [] h
  strs := Env.strs L.item (srcAt 1 6 11)
  begun := fun _ _ _ s₀ => s₀ = (D Xs N Pl).start₂ ((D Xs N Pl).pub x)
  rides := fun _ _ _ => True
  keeps := eq₂ L.kind₂

/-- **The last chain's.** It is handed the instance with the two earlier chains' last states. -/
def rest₃ : Rest Bk St₃ (Local W₀ Rc Xi Unit) where
  table := L.table₃
  stored := fun w => L.stored w.w₀ w.rc
  valid := fun w => w = ⟨w₀, rc, x, ()⟩ ∧ L.Rel w₀ rc x
  P := P₃
  handed := fun k w h => (w.x, L.ends k w.w₀ w.rc w.x h)
  Wt := Wit Cells Unit M
  form := fun b a => shapeB₃ (shapeAt Xs) (plan₁ (one₀ Xs)) (one₀ Xs).given.plan.samples [0]
    (srcOk (VerifiableInference.Desc.Key.ownTest Pl)) ((one₀ Xs).ranges.stages.length + 2) b a.2
  formP := fun b a => Side₃ Xs Pl b a
  means := fun _ =>
    holdsH (D Xs N Pl) L.base.h₃ atSix L.meetsT (meaning₃ (shapeAt Xs) (plan₁ (one₀ Xs)) L.R)
  wit := fun k w h => L.witLast (decl₁ (D Xs N Pl)).length k w.w₀ w.rc h
  strs := Env.strs L.item (srcAt 2 6 11)
  begun := fun k w h s₀ => (D Xs N Pl).start₃ ((D Xs N Pl).pub w.x) (L.ends k w.w₀ w.rc w.x h).1
    (L.ends k w.w₀ w.rc w.x h).2 = .ok s₀
  rides := fun _ _ _ => True
  keeps := eq₃ L.kind₃

/-- **WHAT TIES THE LETTERS TO EACH OTHER AND TO THE PLAN**: the library's own list of what is left
as a premise (`AtFk`, Johnson/RunOne/KeyRowsAtFk.lean: three public facts on the shape and the
codes; the reading's numbers of the first chain's messages are the plan's; at the shared chain the
seats are the messages' own and the rows read what a pin pins; two seats keep their tree's number in
the last chain's book), AND WHAT IT LACKS: the like at the first and the last chain, and at two more
seats of the shared one; the letter that reads a sample off a message's entry does not read its
ledger. It is a definition: a premise's form. -/
structure LettersOk : Prop where
  atFk : AtFk Xs L.base atSix L.R off₃N
  arr₁ : VerifiableInference.Desc.Key.ArrOk L.base.h₁ atSix [0, 1, 2]
  arr₃ : VerifiableInference.Desc.Key.ArrOk L.base.h₃ atSix [0, 2, 4]
  reads₁ : VerifiableInference.Desc.Key.ReadsPinned L.base.h₁ atSix L.R [0, 1, 2]
  reads₂ : VerifiableInference.Desc.Key.ReadsPinned L.base.h₂ atSix L.R [0, 2]
  reads₃ : VerifiableInference.Desc.Key.ReadsPinned L.base.h₃ atSix L.R [0, 2, 4]
  smReads : L.base.SmReads

/-- **The three threads so filled**, over the base threads of E2E/KeyThreadBase.lean. -/
def filled₁ {X' : Type} : Thread Bk (D Xs N Pl).S₁ (D Xs N Pl).Cl (Local W₀ Rc Xi Unit)
    (Local W₀ Rc Xi Unit) X' Xi :=
  keyBase₁ (D Xs N Pl) (rest₁ Xs N Pl L w₀ rc x)

def filled₂ {X₀ : Type} : Thread Bk (D Xs N Pl).S₂ (D Xs N Pl).Cl Empty
    (Common W₀ Rc OnBytes.TableKey) X₀ OnBytes.TableKey :=
  keyBase₂ (D Xs N Pl) (rest₂ Xs N Pl L w₀ rc x)

def filled₃ {X' : Type} : Thread Bk (D Xs N Pl).S₃ (D Xs N Pl).Cl (Local W₀ Rc Xi Unit)
    (Local W₀ Rc Xi Unit) X' Xi :=
  keyBase₃ (D Xs N Pl) (rest₃ Xs N Pl L w₀ rc x)

/-- **THE SAME THREE WITH ANY HALVES AND ANY TABLES LAID**: what is shown of the verifier's side is
shown at these, for all halves and tables: a thread that is seated (E2E/KeyLaid.lean), or whose
tables are laid anew, is such a term by unfolding. -/
def laid₁ {X' : Type} (hs : List (Placed (Local W₀ Rc Xi Unit) (Local W₀ Rc Xi Unit) X'))
    (tb : Fmt.TreeSource → Coins Bk → Local W₀ Rc Xi Unit → List Fmt.Drawn → Place × Table) :
    Thread Bk (D Xs N Pl).S₁ (D Xs N Pl).Cl (Local W₀ Rc Xi Unit) (Local W₀ Rc Xi Unit) X' Xi :=
  { filled₁ (X' := X') Xs N Pl L w₀ rc x with hs := hs, table := tb }

def laid₂ {X₀ : Type} (hs : List (Placed Empty (Common W₀ Rc OnBytes.TableKey) X₀))
    (tb : Fmt.TreeSource → Coins Bk → Common W₀ Rc OnBytes.TableKey → List Fmt.Drawn →
      Place × Table) :
    Thread Bk (D Xs N Pl).S₂ (D Xs N Pl).Cl Empty (Common W₀ Rc OnBytes.TableKey) X₀
      OnBytes.TableKey :=
  { filled₂ (X₀ := X₀) Xs N Pl L w₀ rc x with hs := hs, table := tb }

def laid₃ {X' : Type} (hs : List (Placed (Local W₀ Rc Xi Unit) (Local W₀ Rc Xi Unit) X'))
    (tb : Fmt.TreeSource → Coins Bk → Local W₀ Rc Xi Unit → List Fmt.Drawn → Place × Table) :
    Thread Bk (D Xs N Pl).S₃ (D Xs N Pl).Cl (Local W₀ Rc Xi Unit) (Local W₀ Rc Xi Unit) X' Xi :=
  { filled₃ (X' := X') Xs N Pl L w₀ rc x with hs := hs, table := tb }

end

/-! ## 4 The shared thread's sentences do not read what the library's meaning is handed -/

/-- The items that the shared chain's thread bears. -/
def sharedItems : List KItem :=
  [.pinT, .pin 3, .srow 3, .pin 4, .srow 4, .pin 5, .srow 5, .claim 2 "NearU", .claim 2 "RecRow",
    .claim 2 "record", .claim 2 "columns", .claim 2 "Fold", .claim 2 "FoldO", .claim 2 "FoldU"]

/-- It bears no other: at its start and in its twelve rows. -/
theorem shared_listed :
    (startShared ++ (List.range 12).flatMap fun b =>
      (rowsAt (rows₂.map sharedRow) b).asks ++ (rowsAt (rows₂.map sharedRow) b).owes ++
        (rowsAt (rows₂.map sharedRow) b).shuts).all (sharedItems.contains ·) = true := by decide

section
variable {XI Cells M Smp Rec : Type} (F : FileDescription XI) (G₂ : Reading (P₂ × St₂) Cells M Smp Rec)
  (at_ : Where) (meetsT : Rec → Cells → Prop) (S : OnBytes.Params.LinShape)
  (K₁ : VerifiableInference.Desc.Key.KPlan) (R : KRead Cells M)
  (enc : (Nat → OnBytes.E) → Nat → OnBytes.E) (rad : Nat)

/-- At the seats of the shared chain's own messages the reading's sample does not read the first
chain's state; nor does the stored table's OOD sample. It is a definition: a premise's form. -/
def BlindG : Prop :=
  ∀ (x : Xi) (e e' : FirstState) (s : St₂),
    (∀ k ∈ [3, 4, 5],
      G₂.smp ((x, e), s) (at_ k).1 (at_ k).2 = G₂.smp ((x, e'), s) (at_ k).1 (at_ k).2) ∧
      G₂.recOf ((x, e), s) = G₂.recOf ((x, e'), s)

/-- **A shared item's sentence at ((x, e), s) is its sentence at ((x, e'), s).** -/
theorem shared_blind (hG : BlindG G₂ at_) : ∀ i ∈ sharedItems, ∀ (x : Xi) (e e' : FirstState)
    (s : St₂) (y : Strs) (v : Wit Cells Unit M),
    holdsH F G₂ at_ meetsT (meaning₂ S K₁ R enc rad) i ((x, e), s) y v ↔
      holdsH F G₂ at_ meetsT (meaning₂ S K₁ R enc rad) i ((x, e'), s) y v := by
  intro i hi x e e' s y v
  simp only [sharedItems, List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · simp only [holdsH, (hG x e e' s).2]
  · simp only [holdsH, (hG x e e' s).1 3 (by decide)]
  · exact Iff.rfl
  · simp only [holdsH, (hG x e e' s).1 4 (by decide)]
  · exact Iff.rfl
  · simp only [holdsH, (hG x e e' s).1 5 (by decide)]
  · exact Iff.rfl
  all_goals exact Iff.rfl

/-- So "at every state of the first chain" asks no more than "at one". -/
theorem means₂_iff (hG : BlindG G₂ at_) {i : KItem} (hi : i ∈ sharedItems) (x : Xi)
    (e₀ : FirstState) (s : St₂) (y : Strs) (v : Wit Cells Unit M) :
    (∀ e : FirstState, holdsH F G₂ at_ meetsT (meaning₂ S K₁ R enc rad) i ((x, e), s) y v) ↔
      holdsH F G₂ at_ meetsT (meaning₂ S K₁ R enc rad) i ((x, e₀), s) y v :=
  ⟨fun h => h e₀,
    fun h e => (shared_blind F G₂ at_ meetsT S K₁ R enc rad hG i hi x e₀ e s y v).1 h⟩

/-- **THE PREMISE IS MET BY THE LIBRARY's OWN FORM OF THE READING**, where the seats of the shared
chain's three messages are theirs. -/
theorem blind_base (B : BaseSt Cells M Smp Rec)
    (h : VerifiableInference.Desc.Key.ArrOk B.h₂ at_ [3, 4, 5]) : BlindG B.h₂ at_ := by
  intro x e e' s
  refine ⟨fun k hk => ?_, rfl⟩
  have ha : B.arr (at_ k).1 (at_ k).2 = k := h k hk
  have h3 : ¬ B.arr (at_ k).1 (at_ k).2 < 3 := by
    rw [ha]
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hk
    rcases hk with rfl | rfl | rfl <;> decide
  show (if B.arr (at_ k).1 (at_ k).2 < 3 then _ else _) =
    (if B.arr (at_ k).1 (at_ k).2 < 3 then _ else _)
  rw [if_neg h3, if_neg h3]

/-- The pins that are open at a border of the shared thread are the shared chain's own. -/
theorem shared_pins : ∀ b ∈ List.range 13,
    ∀ k ∈ pinned (fwdOpen startShared (rowsAt (rows₂.map sharedRow)) b), k ∈ [3, 4, 5] := by decide

end

section
variable {Bk : ProverCoinCounts} {W₀ Rc Cells M Smp Rec : Type} (Xs : VerifiableInference.Desc.Key.Source)
  (L : KeyFill Bk W₀ Rc Cells M Smp Rec)

/-- Under it the premise of `shared_blind` holds. -/
theorem LettersOk.blind (h : LettersOk Xs L) : BlindG L.base.h₂ atSix :=
  blind_base atSix L.base fun k hk => h.atFk.arr k (by
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hk ⊢
    rcases hk with rfl | rfl | rfl <;> simp)

/-- Under it the one premise on the reading of E2E/KeyRides.lean holds: by the library's law. -/
theorem LettersOk.readsL (h : LettersOk Xs L) : Johnson.RunOne.KeyRows1.ReadsL L.base.h₁ :=
  Johnson.RunOne.KeyRows1.readsL_h₁ L.base h.smReads

end

