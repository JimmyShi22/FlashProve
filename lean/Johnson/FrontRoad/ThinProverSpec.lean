/-- **At most twenty-five halves**: at each written place of the smallness test at which parOwn
names parameters P, the one pinned part at P. Under scope, the reading and LaidAt parOwn names
parameters at all twenty-five. -/
def thinFirst {W₀ Rc Xi Tr' X : Type} (Zp : ProofFile.Pub) (cells : Tr' → Cells) :
    List (Placed (Local W₀ Rc Xi Tr') (Local W₀ Rc Xi Tr') X) :=
  (List.range 25).filterMap fun l =>
    (parOwn Zp (matsOf Zp.p.X) (k8PlaceAt l)).map fun P =>
      ⟨k8PlaceAt l, [quietStop (smallStop cells P) (windowShare P.1)]⟩

/-- **A book for a prover that has one part with one round, and no coin, at each place of ks**: for
each member of each chain one row, at the part 0, with as many coins of the base field as the member
declares mask words; no entry; for each place of ks the cut [1]. It is such a book only where the
member at each place of ks has one round and declares no mask word. -/
def thinBook {Xi : Type} (F : VerifiableInference.Desc.FileDescription Xi) (ks : List Place) : ProverCoinCounts :=
  { first := F.first.blocksInOrder.map fun b => (⟨b.place, 0⟩, ⟨ProofFile.Honest.maskWords b, 0⟩)
    shared := F.shared.blocksInOrder.map fun b => (⟨b.place, 0⟩, ⟨ProofFile.Honest.maskWords b, 0⟩)
    second := F.second.blocksInOrder.map fun b => (⟨b.place, 0⟩, ⟨ProofFile.Honest.maskWords b, 0⟩)
    ahead := []
    cuts := ks.map fun a => (a, [1]) }

/-- H₀ with the twenty-five halves in the first chain and none in the two others. -/
def thinHalves {W₀ Rc Xi Ky Tr' X₀ X : Type} (Zp : ProofFile.Pub) (cells' : Tr' → Cells)
    (H₀ : Prover W₀ Rc Xi Ky Tr' X₀ X) : Prover W₀ Rc Xi Ky Tr' X₀ X :=
  { H₀ with first := thinFirst Zp cells', shared := [], second := [] }

/-- H₀ with its range test laid as «true» and its trace field as modelAt Zp.p.X e. -/
def thinAt {Rc Ky Tr' X₀ X : Type} (Zp : ProofFile.Pub) (e : Tr → Tr')
    (H₀ : Prover FullSizeMatrix Rc ProofFile.Inst Ky Tr' X₀ X) : Prover FullSizeMatrix Rc ProofFile.Inst Ky Tr' X₀ X :=
  { { H₀ with inRange := fun _ => true } with trace := modelAt Zp.p.X e }

/-- The book at the description and the twenty-five places. -/
def thinB (Zp : ProofFile.Pub) (Np : H2U.Places4) (cF : VerifiableInference.Desc.Chain TS ProofFile.Cl) :
    ProverCoinCounts :=
  thinBook (descZ Zp Np cF) ((List.range 25).map k8PlaceAt)

/-- The rows: bareSides of thinHalves, at that book. -/
def thinG {W₀ Rc Ky Tr' X₀ X : Type} (Zp : ProofFile.Pub) (Np : H2U.Places4)
    (cF : VerifiableInference.Desc.Chain TS ProofFile.Cl) (cells' : Tr' → Cells)
    (H₀ : Prover W₀ Rc ProofFile.Inst Ky Tr' X₀ X) :
    Sides (descZ Zp Np cF) (thinB Zp Np cF) W₀ Rc Ky Tr' X₀ X :=
  bareSides (descZ Zp Np cF) (thinB Zp Np cF) (thinHalves Zp cells' H₀)

/-- Short for provG at the book thinB, the rows thinG and the prover thinAt. -/
abbrev thinP (Z : PublicFiles) (Zp : ProofFile.Pub) (Np : H2U.Places4)
    (cF : VerifiableInference.Desc.Chain TS ProofFile.Cl) {Tr' X₀ Xh : Type} (cells' : Tr' → Cells)
    (e : Tr → Tr') (H₀ : Prover FullSizeMatrix (protocolAtFiles Z).EncodingRandomness ProofFile.Inst TableKey Tr' X₀ Xh) :
    Prover FullSizeMatrix (protocolAtFiles Z).EncodingRandomness ProofFile.Inst TableKey Tr' X₀ Xh :=
  provG Z Zp Np cF (thinB Zp Np cF) (thinG Zp Np cF cells' H₀) (thinAt Zp e H₀)

/-- **The twenty-five halves meet the pin's clauses on the halves**, at the description's own
parameters and the list matsOf, at the first chain without its last member. -/
def Spec.thin_halves : Prop :=
  ∀ (Z : PublicFiles) (Zp : ProofFile.Pub) (Np : H2U.Places4)
    (cF : VerifiableInference.Desc.Chain TS ProofFile.Cl), InScope Z = true →
    ∀ {pp : Inst.Model.ScalesAndPolicy}, readFiles Z = .ok pp → ∀ {D : WholeD} {r : LPFD.Full.RunPF},
    LaidAt OnBytes.secondHashFunction Z.pol Z.lay Z.KL D r Zp Np cF →
    ∀ {W₀ Rc Xi Tr' X : Type} (cells : Tr' → Cells),
      PinHalvesAt (parOwn Zp (matsOf Zp.p.X)) cells
        (thinFirst Zp cells : List (Placed (Local W₀ Rc Xi Tr') (Local W₀ Rc Xi Tr') X))
        (descZ Zp Np cF).first.blocksInOrder.dropLast

/-- **Each of them stands at a place of the kind K8.** -/
def Spec.thin_no_frame : Prop :=
  ∀ {W₀ Rc Xi Tr' X : Type} (Zp : ProofFile.Pub) (cells : Tr' → Cells),
    ∀ g ∈ (thinFirst Zp cells : List (Placed (Local W₀ Rc Xi Tr') (Local W₀ Rc Xi Tr') X)),
      g.place.kind = KindName.K8

/-- A control; it counts as no goal. **The four conditions of Spec.sessionStops_of_elder can be met
together**: at all public files in scope that can be read, under LaidAt and ReadsAs: by a prover at
the index type Cm.Idx with the twenty-five halves, no half in the second chain, and the trace
function that answers e of the model's trace. -/
def Spec.thin_meets_four : Prop :=
  ∀ (Z : PublicFiles) (Zp : ProofFile.Pub) (Np : H2U.Places4)
    (cF : VerifiableInference.Desc.Chain TS ProofFile.Cl), InScope Z = true →
    ∀ {pp : Inst.Model.ScalesAndPolicy}, readFiles Z = .ok pp → ∀ {D : WholeD} {r : LPFD.Full.RunPF},
    LaidAt OnBytes.secondHashFunction Z.pol Z.lay Z.KL D r Zp Np cF →
    ∀ {Rc' Tr' X₀ Xh : Type} (H₀ : Prover Cm.Idx Rc' ProofFile.Inst TableKey Tr' X₀ Xh)
      (cells' : Tr' → Cells) (e : Tr → Tr'), ReadsAs Zp.p.X cells' e →
      let H' : Prover Cm.Idx Rc' ProofFile.Inst TableKey Tr' X₀ Xh :=
        { thinHalves Zp cells' H₀ with trace := fun i ξ => (modelTrace Zp.p.X i ξ).map e }
      (∀ g ∈ H'.first, g.place.kind ≠ KindName.frame) ∧
        PinHalvesAt (parOwn Zp (matsOf Zp.p.X)) cells' H'.first
          (descZ Zp Np cF).first.blocksInOrder.dropLast ∧
        PinHalvesAt (fun _ => none) cells' H'.second (descZ Zp Np cF).second.blocksInOrder ∧
        TraceCellsAt Zp.p.X cells' H'.trace

/-- **The book's own tests pass at thinB.** -/
def Spec.thinBook_word : Prop :=
  ∀ (Z : PublicFiles) (Zp : ProofFile.Pub) (Np : H2U.Places4)
    (cF : VerifiableInference.Desc.Chain TS ProofFile.Cl), InScope Z = true →
    ∀ {pp : Inst.Model.ScalesAndPolicy}, readFiles Z = .ok pp → ∀ {D : WholeD} {r : LPFD.Full.RunPF},
    LaidAt OnBytes.secondHashFunction Z.pol Z.lay Z.KL D r Zp Np cF →
    (thinB Zp Np cF).word (descZ Zp Np cF) = none

/-- **ready returns at the thin prover**, at some matrix, randomness, instance and coins. -/
def Spec.thin_ready : Prop :=
  ∀ (Z : PublicFiles) (Zp : ProofFile.Pub) (Np : H2U.Places4) (cF : VerifiableInference.Desc.Chain TS ProofFile.Cl)
    {Tr' X₀ Xh : Type} (H₀ : Prover FullSizeMatrix (protocolAtFiles Z).EncodingRandomness ProofFile.Inst TableKey Tr' X₀ Xh)
    (_scope : InScope Z = true) {pp : Inst.Model.ScalesAndPolicy}
    (_hr : readFiles Z = .ok pp) (_live : protocolDataWellFormed (asDescriptionFiles Z) = true) {D : WholeD}
    {r : LPFD.Full.RunPF} (_L : LaidAt OnBytes.secondHashFunction Z.pol Z.lay Z.KL D r Zp Np cF)
    (cells' : Tr' → ProofFile.Honest.Cells) (e : Tr → Tr'),
    ∃ w₀ rc x₀ k₀ R,
      ready (descZ Zp Np cF) (thinB Zp Np cF) (thinP Z Zp Np cF cells' e H₀) w₀ rc x₀ k₀ = .ok R

/-- **All five premises on rows and prover of Spec.sessionStops_of_cellsOwn, at mats := matsOf
Zp.p.X, hold together** at the book thinB, the rows thinG and the prover thinAt: under the four
public premises and ReadsAs. NOT THE HONEST PROVER: it has no part that sends anything. -/
def Spec.premises_met_together : Prop :=
  ∀ (Z : PublicFiles) (Zp : ProofFile.Pub) (Np : H2U.Places4) (cF : VerifiableInference.Desc.Chain TS ProofFile.Cl)
    {R₂ R₃ : Type} [Fintype R₂] [Nonempty R₂] [Fintype R₃] [Inhabited R₃]
    (run₂ : R₂ → ByteArray) (run₃ : R₃ → ByteArray) {Tr' X₀ Xh : Type}
    (H₀ : Prover FullSizeMatrix (protocolAtFiles Z).EncodingRandomness ProofFile.Inst TableKey Tr' X₀ Xh)
    (_scope : InScope Z = true) {pp : Inst.Model.ScalesAndPolicy}
    (_hr : readFiles Z = .ok pp) (_live : protocolDataWellFormed (asDescriptionFiles Z) = true) {D : WholeD}
    {r : LPFD.Full.RunPF} (_L : LaidAt OnBytes.secondHashFunction Z.pol Z.lay Z.KL D r Zp Np cF)
    (cells' : Tr' → ProofFile.Honest.Cells) (e : Tr → Tr') (_hE : ReadsAs Zp.p.X cells' e),
    (∃ w₀ rc x₀ k₀ R,
        ready (descZ Zp Np cF) (thinB Zp Np cF) (thinP Z Zp Np cF cells' e H₀) w₀ rc x₀ k₀ =
          .ok R) ∧
      (∀ L ∈ (thinG Zp Np cF cells' H₀).first, L.place.kind ≠ KindName.frame) ∧
      RowsPinned (parOwn Zp (matsOf Zp.p.X)) cells' (thinP Z Zp Np cF cells' e H₀).first
        (descZ Zp Np cF).first.blocksInOrder.dropLast ∧
      RowsPinned (fun _ => none) cells' (thinP Z Zp Np cF cells' e H₀).second
        (descZ Zp Np cF).second.blocksInOrder ∧
      ∀ Yes : FullSizeMatrix → XF → Prop, CellsOwnAt Z Zp Np cF run₂ run₃ (thinB Zp Np cF)
        (thinG Zp Np cF cells' H₀) (thinAt Zp e H₀) Yes cells'

/-- **So the end of that implication holds at the thin prover**, under the four public premises and
ReadsAs alone. NOT THE HONEST PROVER: it has no part that sends anything. -/
def Spec.sessionStops_at_thin : Prop :=
  ∀ (Z : PublicFiles) (Zp : ProofFile.Pub) (Np : H2U.Places4) (cF : VerifiableInference.Desc.Chain TS ProofFile.Cl)
    {R₂ R₃ : Type} [Fintype R₂] [Nonempty R₂] [Fintype R₃] [Inhabited R₃]
    (run₂ : R₂ → ByteArray) (run₃ : R₃ → ByteArray) {Tr' X₀ Xh : Type}
    (H₀ : Prover FullSizeMatrix (protocolAtFiles Z).EncodingRandomness ProofFile.Inst TableKey Tr' X₀ Xh)
    (_scope : InScope Z = true) {pp : Inst.Model.ScalesAndPolicy}
    (_hr : readFiles Z = .ok pp) (_live : protocolDataWellFormed (asDescriptionFiles Z) = true) {D : WholeD}
    {r : LPFD.Full.RunPF} (_L : LaidAt OnBytes.secondHashFunction Z.pol Z.lay Z.KL D r Zp Np cF)
    (cells' : Tr' → ProofFile.Honest.Cells) (e : Tr → Tr') (_hE : ReadsAs Zp.p.X cells' e)
    (Yes : FullSizeMatrix → XF → Prop) (ok : FullSizeMatrix → Prop) (Gs : (protocolAtFiles Z).OutOfDomainSeed → Prop),
    HidSmall (famG Z Zp Np cF run₂ run₃ (thinB Zp Np cF) (thinG Zp Np cF cells' H₀)
        (thinAt Zp e H₀))
      (fun n w a => TiedIn Z Zp Np cF run₂ run₃ (thinB Zp Np cF) (thinG Zp Np cF cells' H₀)
        (thinAt Zp e H₀) Yes ok Gs n w (LPFD.Full.instanceAsPlainRecord a))
      (ENNReal.ofReal ((2 : ℝ) ^ (-(((linesAt Zp).sec : ℝ) + (clog2 (linesAt Zp).slots : ℝ) +
        (clog2 (max 1 (batchesAt Zp)) : ℝ) +
        (clog2 (plannedCopies (linesAt Zp) (oneTimeAt Zp) (columnsFirstAt Zp)) : ℝ)))) + 0)

