/-- The trees that the file's data tell in front of the place (l, d): the piece's base. -/
abbrev baseL (aN : ℕ) (R₁ R₂ R₃ : Rounds) (c : Chain S Cl) (l : ℕ) (d : Bool) : ℕ :=
  nTrees ((dataOf aN R₁ R₂ R₃).ds₁.take (inFront c (noL l d)))

theorem paid_radRec {k : ℕ} {P : Par} (h : PaidRec k P) : PaidAt P (radRec k P) := by
  obtain ⟨y, hy, hp⟩ := h
  unfold radRec
  rw [hy]
  exact hp

theorem isLeft_cases (q : Pub) (h : isLeft q = true) : (∃ m, q = .left m) ∨ ∃ m, q = .leftOn m := by
  cases q with
  | left m => exact Or.inl ⟨m, rfl⟩
  | leftOn m => exact Or.inr ⟨m, rfl⟩
  | _ => cases h

theorem paidL (Z : ProofFile.Pub) (G : ProofFile.Ground) (hc : G.first.codes = codesFull2)
    (hs : G.first.shape = shapeFull) (l : ℕ) (hl : l < 25) (d : Bool) :
    PaidAt (parL Z G l d) (radRec (recL l d) (parL Z G l d)) := by
  cases d with
  | true => exact paid_radRec ((k01_paid_first_chain G.first (gpOf Z) hc hs).2 l _ 2 hl (Or.inr rfl))
  | false => exact paid_radRec ((k01_paid_first_chain G.first (gpOf Z) hc hs).2 l _ 1 hl (Or.inl rfl))

theorem sampledL (Z : ProofFile.Pub) (G : ProofFile.Ground) (hs : G.first.shape = shapeFull) (l : ℕ)
    (hl : l < 25) (d : Bool) (j : Fin (shapesOf (parL Z G l d)).length) :
    sampledAt (parL Z G l d) j := by
  cases d with
  | true => exact later_sampled _ _ hs l _ 2 hl (Or.inr rfl) j
  | false => exact later_sampled _ _ hs l _ 1 hl (Or.inl rfl) j

theorem noL_lt (l : ℕ) (hl : l < 25) (d : Bool) : noL l d < 357 := by
  have : k1Ix l d ≤ 6 := by unfold k1Ix; split <;> split <;> omega
  show 14 * l + k1Ix l d + 2 < 357
  omega

/-- The book behind a yes of the place's sub-protocol is the book in front with the place's trees and messages laid at its end. -/
theorem booked_blkL (Z : ProofFile.Pub) (G : ProofFile.Ground) (l : ℕ) (d : Bool) (X : LinkH)
    (arrs : Option (List ℕ)) (s s' : S) (r₁ r₂ : Fmt.RoundView) (gs : List (List (Nat × List UInt64)))
    (h : (blkL Z G l d X arrs).decide s [r₁, r₂] gs = .ok s') :
    Booked (parL Z G l d) s.book s.st.oracles.size s'.book s'.st.oracles.size := by
  cases d with
  | true => exact commitAtS_booked _ _ _ _ s s' r₁ r₂ gs h
  | false =>
    have h' : ((laterAt G.first (gpOf Z) l (k1Ix l false + 1) 1 arrs : Block S Unit).decide s
        ([r₁, r₂].take (laterAt G.first (gpOf Z) l (k1Ix l false + 1) 1 arrs :
          Block S Unit).rounds.length)
        (gs.take (laterAt G.first (gpOf Z) l (k1Ix l false + 1) 1 arrs :
          Block S Unit).openings)).bind (fun s₁ =>
        (IM.k1Quiet G l X).decide s₁
          ([r₁, r₂].drop (laterAt G.first (gpOf Z) l (k1Ix l false + 1) 1 arrs :
            Block S Unit).rounds.length)
          (gs.drop (laterAt G.first (gpOf Z) l (k1Ix l false + 1) 1 arrs :
            Block S Unit).openings)) = .ok s' := h
    obtain ⟨s₁, h1, h2⟩ := (bind_ok _ _ _).1 h'
    have q := quietL_k1Quiet G l X _ _ _ _ h2
    rw [q.1, q.2.1]
    exact commitAtS_booked _ _ _ _ s s₁ r₁ r₂ _ h1

theorem laterFacts_blkL (Z : ProofFile.Pub) (G : ProofFile.Ground) (l : ℕ) (d : Bool) (X : LinkH)
    (arrs : Option (List ℕ)) : LaterFacts (blkL Z G l d X arrs) := by
  cases d with
  | true => exact laterFacts_commit _ _ _ _
  | false => exact laterFacts_k1Reads _ _ _ _ _ _

