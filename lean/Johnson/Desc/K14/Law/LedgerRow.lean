/-- The bases rise along the tiling. -/
theorem bases_rise : x3.base ≤ base4 ∧ base4 ≤ base5 ∧ base5 ≤ x6.base ∧ x6.base ≤ base7 ∧
    base7 ≤ x8.base ∧ x8.base ≤ x9.base ∧ x9.base ≤ x10.base ∧ x10.base ≤ x11.base := by
  obtain ⟨-, -, -, -, -, -, -, e4, -, -, -, e5, -, -, -, e6, -, -, -, e7, -, -, -, e8, -, -, -, e9,
    -, -, -, e10, -, -, -, e11, -⟩ := ht
  have e4' : base4 = x3.base + x3.trees := e4
  have e5' : base5 = base4 + (pc1 c4 base4 d4 ex4 er4).trees := e5
  have e6' : x6.base = base5 + (pc2 c5 base5 d51 d52 ex5 er5).trees := e6
  have e7' : base7 = x6.base + x6.trees := e7
  have e8' : x8.base = base7 + (pc1 c7 base7 d7 ex7 er7).trees := e8
  omega

theorem sent3 : SentBefore N f (pt :: [(pc2 c2 base2 d21 d22 ex2 er2), x3, (pc1 c4 base4 d4 ex4
    er4), (pc2 c5 base5 d51 d52 ex5 er5), x6, (pc1 c7 base7 d7 ex7 er7), x8, x9, x10, x11]) 3 x3 .oU
    := by
  obtain ⟨h4, -⟩ := bases_rise N c2 c4 c5 c7 x3 x6 x8 x9 x10 x11 base2 d21 d22 ex2 er2 base4 d4 ex4
      er4 base5 d51 d52 ex5 er5 base7 d7 ex7 er7 ht hlo tU
  exact ⟨hlo _, tU, (by show _ < base4; omega), tU⟩

theorem sent4 : SentBefore N f (pt :: [(pc2 c2 base2 d21 d22 ex2 er2), x3, (pc1 c4 base4 d4 ex4
    er4), (pc2 c5 base5 d51 d52 ex5 er5), x6, (pc1 c7 base7 d7 ex7 er7), x8, x9, x10, x11]) 4 (pc1
    c4 base4 d4 ex4 er4) .oU := by
  obtain ⟨h4, h5, -⟩ := bases_rise N c2 c4 c5 c7 x3 x6 x8 x9 x10 x11 base2 d21 d22 ex2 er2 base4 d4
      ex4 er4 base5 d51 d52 ex5 er5 base7 d7 ex7 er7 ht hlo tU
  exact ⟨hlo _, (by show _ < base4; omega), (by show _ < base5; omega),
    (by show _ < base4; omega)⟩

