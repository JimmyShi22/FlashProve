variable {P₁ Cl Xi Cells Tok : Type} {Fr : Frame} (cs : OnBytes.Codes) (G : FileDescription Xi)
  (arr : ℕ → ℕ → ℕ)
  (smp₂ : St → (s : Sending) → (i : Fin s.l.length) → Option ((sigOf cs s.l).om i).Smp)
  (ms : List Mem) (decT₂ : (ℕ → Option (ℕ × List UInt64)) → St → Option Cells) (c₀ : Cells)
  (bkR : TreeBook → TreeBook)
  (N : NumbersS) (Mg₀ : MeaningS St P₁ (Wit Cells Tok MsgT)) (Pm₀ : PromMeaning St)
  (Oc : P₁ → Strs → Prop)
  (mem : ℕ → Option Mem) (rd : (x : Mem) → ((sigOf cs x.1.l).om x.2).Msg → Part → ℕ → GE)
  (e' n nU nO : ℕ) (num : Msg2 → ℕ) (Q : P14) (X : ℕ → St → Bool)

/-- The items' meaning at the one filling. -/
abbrev mgK : MeaningS St P₁ (Wit Cells Tok MsgT) :=
  meaningSigS cs G arr smp₂ ms decT₂
    (mgI cs arr Mg₀ mem rd Q.par (uRK Q.par) (omWK cs arr mem rd nO Q) e' n)

/-- The promise's meaning at the one filling, with nothing beside shapeK. -/
abbrev pm0 : PromMeaning St :=
  promSigS cs G smp₂ ms (fun s : St => s.st) (fun s : St => bkR s.book)
    (pmI decT₂ Pm₀ Q.par n nU nO)

/-- **The promise's meaning at the one filling**: the layout's test and the letter X beside
shapeK. -/
abbrev pmK : PromMeaning St := besideP (pm0 cs G smp₂ ms decT₂ bkR Pm₀ n nU nO Q) (besX Q X)

/-- The table's files' extractor, handed the acting part's value. -/
abbrev exK (Fr : Frame) : ℕ → ActV St Fr → Wit Cells Tok MsgT → Wit Cells Tok MsgT :=
  fun k v w => extS cs G arr smp₂ ms decT₂ c₀ N true k v.1 (strsOfAct Fr v) w

/-- The piece that holds a block, in the wrap, at one written round. -/
abbrev pc1 (b : Block St Cl) (base : ℕ) (d : RDT)
    (ex : (P₁ × St) × Fr.E.Str → Iop.Tr (uLT (ckP .two) [d]) → Wit Cells Tok MsgT → Wit Cells Tok
        MsgT)
    (er : Err (uLT (ckP .two) [d])) : Piece (ckP .two) Fr (P₁ × St) Cl (Wit Cells Tok MsgT) :=
  ⟨heldW b, base, [d], [], ex, er⟩

/-- The like at the two written rounds of a sending. -/
abbrev pc2 (b : Block St Cl) (base : ℕ) (d₁ d₂ : RDT)
    (ex : (P₁ × St) × Fr.E.Str → Iop.Tr (uLT (ckP .two) [d₁, d₂]) → Wit Cells Tok MsgT → Wit Cells
        Tok MsgT)
    (er : Err (uLT (ckP .two) [d₁, d₂])) : Piece (ckP .two) Fr (P₁ × St) Cl (Wit Cells Tok MsgT) :=
  ⟨heldW b, base, [d₁, d₂], [], ex, er⟩

/-- K1's parameters at "send o_u". -/
abbrev parU (Q : P14) (sentU : Array OracleNotice) : VerifiableInference.Desc.K1.Par :=
  parK1 Q 2 "o_u and the first mask" sentU

/-- K1's parameters at "send o_omega". -/
abbrev parO (Q : P14) : VerifiableInference.Desc.K1.Par :=
  parK1 Q 5 "o_omega and o_sp" (withOmega Q.S)

