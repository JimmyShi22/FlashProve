/-- **The ledger's debt along a row passes to a promise with a test laid beside the book-keeping**,
where each block hands the test on for certain. -/
theorem each_beside {P₁ S₂ Cl Wt : Type} {C : CK} {Fr : Frame} (N : NumbersS)
    (Mg : MeaningS S₂ P₁ Wt) (Pm : PromMeaning S₂) (Oc : P₁ → Strs → Prop) (split : Bool)
    (p : Piece C Fr (P₁ × S₂) Cl Wt) (l : List (Piece C Fr (P₁ × S₂) Cl Wt))
    (e₀ : ℕ → ActV S₂ Fr → Wt → Wt) (X : ℕ → S₂ → Bool) (own : OwnErrs C Fr (P₁ × S₂) Cl Wt) :
    ∀ (m : List (Piece C Fr (P₁ × S₂) Cl Wt)) (k : ℕ),
      (∀ j x, m[j]? = some x → ∀ a τ b, onQ₂ N (besideP Pm X) Oc split p l (k + j) a →
        x.ior.red.out a τ = some b → X (k + j + 1) b.1.2 = true) →
      EachPlainShOwn N Mg Pm Oc split p l e₀ own k m →
      EachPlainShOwn N Mg (besideP Pm X) Oc split p l e₀ own k m
  | [], _, _, _ => trivial
  | x :: m, k, hX, h =>
    ⟨clause_beside N Mg Pm Oc split p l e₀ X k x (own k x) (hX 0 x rfl) h.1,
      each_beside N Mg Pm Oc split p l e₀ X own m (k + 1)
        (fun j y hy => by
          have := hX (j + 1) y hy
          rwa [show k + (j + 1) = k + 1 + j by omega] at this) h.2⟩

end VerifiableInference.Desc.Sound

