/-- **THE KIND'S SHARE OF THE CHAIN OF PROMISES, AT THE COMPOSED MEANING, AT THE FULL CHAIN, IN THE
GOALS' SCOPE.** -/
theorem kindTied_K6_mgAll {Z : VerifierAndGoals.PublicFiles} {pp : Inst.Model.ScalesAndPolicy} {lay : Option ByteArray}
    (hZ : VerifierAndGoals.InScope Z = true) (hR : VerifierAndGoals.readFiles Z = .ok pp)
    (hX : OnBytes.Model.Verify.publicOf Z.pol Z.KL lay = .ok Wp)
    (l : List (Piece (_root_.Run.ckP .two) Fr (P × S) Claim
      (Wit (Fin rows → Fin cols → GE) Tok MsgT)))
    (hMore : Mg.more = {}) (hPP : ∀ i ∈ pubQ (MGA).more linksFull PS (341 + 1), (∀ m, i ≠ .left m) →
      (∀ m, i ≠ .leftOn m) → ∀ x, Mg.pubP i x)
    (hMg : ∀ (z : P) (t : S) h, Mg.inOrder (z, { t with here := h }) = Mg.inOrder (z, t))
    (hPubH : ∀ (j : First.Pub) (z : P) (t : S) h,
      Mg.pub j (z, { t with here := h }) = Mg.pub j (z, t))
    (hreq : ∀ (z : P) (t : S) h, D.H.req (z, { t with here := h }) = D.H.req (z, t))
    (reqW : P → Array UInt32)
    (hfold : ∀ a, Rch 341 a → a.1.2.failed = none → AtFold.FoldAt Lp Mm D.cs D.shape lay6 a.1.2)
    (hreqIs : ∀ a, Rch 341 a → a.1.2.failed = none → a.1.2.req = reqW a.1.1)
    (hreqW : ∀ a, onQ (Fr := Fr) D.N MGA linksFull PS (fun a => a) 341 a → Rch 341 a →
      a.1.2.failed = none → reqW a.1.1 = OnBytes.Flat.requestWordsOf (D.H.req a.1).val)
    (hput : PutKeeps D.put) 
    (hrqX : ∀ a, onQ (Fr := Fr) D.N MGA linksFull PS (fun a => a) 341 a → Rch 341 a → a.1.2.failed =
        none →
      D.rq a.1.1 = reqX (D.H.req a.1).val)
    (hall : ∀ q, l[341]? = some q → ∃ (bef : List (ℕ × ℕ)) (bS B : Block S Claim)
      (numD : Fmt.TreeSource → Nat) (bs : List (Block (P × S) Claim)),
        Seated Wp .two Fr q 24 bef B bS ∧
        K6DueMg D Mg lay6 num tokV req dec hN hG tab tokH Fr piece6 Lk small x Rch Lp Mm bS
            numD bs
            q) :
    KindTiedR D.N MGA linksFull PS Rch
      (fun i => extQAt D.cs D.G D.arr D.smp D.ms D.decT c₀ tokOf D.N linksFull PS (fun a => a) i) l
      .K6 :=
  kindTied_K6_full D.cs D.G D.arr D.smp D.decT c₀ D.ms D.N (Meaning.sizesOf Wp) (seatLay Wp
      lay6 num) Wp (plAt (num 24 0) 0) Fr tokOf MGA Rch l
    (by rw [Sound.mgAll_more_closed D Mg hMore]; exact fit_closed) (sigFields_mgAll D Mg)
    fun q hq => by
      obtain ⟨bef, bS, B, numD, bs, Hs, M⟩ := hall q hq
      have hpS := InScope.seated_in_scope hZ hR hX Hs.lot
      exact ⟨bef, bS, B, numD, Hs, dueAt_of_mg D Mg lay6 num tokV req dec hN hG tab
          tokH Fr piece6 Lk small x Rch Lp Mm bef bS B numD bs q hZ hR hX
        Hs Sound.place341_full
        (by rw [Sound.mgAll_more_closed D Mg hMore]; exact fit_closed) hMore hPP
        (planB_seated Hs.lot hpS) hpS (Came.inRanges_in_scope hZ hR hX _)
        (fun a r c => Came.inSizes_in_scope hZ hR hX a r c) ⟨_, _, _, hX⟩
        (Meaning.nmFit_of_core hX (OnBytes.Road.Hd.core_of_scope hZ hR hX)) hMg hPubH hreq reqW
            hfold
            hreqIs hreqW hput
        hrqX (by rw [(InScope.numbers_in_scope hZ hR hX).V]; decide)
        (InScope.numbers_in_scope hZ hR hX).d (InScope.numbers_in_scope hZ hR hX).V
        (InScope.k6Pub_in_scope hZ hR hX) M⟩

/-- **The same under FoldFacts, whole: a corollary**, for the join at the top, where
every kind's law is called under one structure. -/
theorem kindTied_K6_fold {Z : VerifierAndGoals.PublicFiles} {pp : Inst.Model.ScalesAndPolicy} {lay : Option ByteArray}
    (hZ : VerifierAndGoals.InScope Z = true) (hR : VerifierAndGoals.readFiles Z = .ok pp)
    (hX : OnBytes.Model.Verify.publicOf Z.pol Z.KL lay = .ok Wp)
    (l : List (Piece (_root_.Run.ckP .two) Fr (P × S) Claim
      (Wit (Fin rows → Fin cols → GE) Tok MsgT)))
    (hMore : Mg.more = {}) (hPP : ∀ i ∈ pubQ (MGA).more linksFull PS (341 + 1), (∀ m, i ≠ .left m) →
      (∀ m, i ≠ .leftOn m) → ∀ x, Mg.pubP i x)
    (hMg : ∀ (z : P) (t : S) h, Mg.inOrder (z, { t with here := h }) = Mg.inOrder (z, t))
    (hPubH : ∀ (j : First.Pub) (z : P) (t : S) h,
      Mg.pub j (z, { t with here := h }) = Mg.pub j (z, t))
    (hreq : ∀ (z : P) (t : S) h, D.H.req (z, { t with here := h }) = D.H.req (z, t))
    (d : First.FoldData) (reqW : P → Array UInt32)
    (FF : First.FoldFacts Rch (fun a => a.1) d reqW linksFull PS) (hdS : d.sent = D.sent)
    (hlay : D.layout = lay6)
    (hreqW : ∀ a, onQ (Fr := Fr) D.N MGA linksFull PS (fun a => a) 341 a → Rch 341 a →
      a.1.2.failed = none → reqW a.1.1 = OnBytes.Flat.requestWordsOf (D.H.req a.1).val)
    (hput : PutKeeps D.put)
    (hrqX : ∀ a, onQ (Fr := Fr) D.N MGA linksFull PS (fun a => a) 341 a → Rch 341 a →
      a.1.2.failed = none → D.rq a.1.1 = reqX (D.H.req a.1).val)
    (hall : ∀ q, l[341]? = some q → ∃ (bef : List (ℕ × ℕ)) (bS B : Block S Claim)
      (numD : Fmt.TreeSource → Nat) (bs : List (Block (P × S) Claim)),
        Seated Wp .two Fr q 24 bef B bS ∧
        K6DueMg D Mg lay6 num tokV req dec hN hG tab tokH Fr piece6 Lk small x Rch d.L d.M bS numD
          bs q) :
    KindTiedR D.N MGA linksFull PS Rch
      (fun i => extQAt D.cs D.G D.arr D.smp D.ms D.decT c₀ tokOf D.N linksFull PS (fun a => a) i) l
      .K6 :=
