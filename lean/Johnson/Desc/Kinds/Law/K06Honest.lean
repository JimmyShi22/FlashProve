/-! ## What is asked of the record in front, beside K06_law's own five -/

/-- The record stands in the head's link, the link is opened, and what the lookup left is laid. -/
def HeadOpen (s : S) : Prop :=
  ∃ o, s.here = .head o ∧ o.opened = true ∧ o.lookHeard.isSome = true

/-- The same, as a test with code. -/
def headOpenB (s : S) : Bool :=
  match s.here with
  | .head o => o.opened && o.lookHeard.isSome
  | _ => false

theorem headOpenB_iff (s : S) : headOpenB s = true ↔ HeadOpen s := by
  unfold headOpenB HeadOpen
  cases hh : s.here with
  | head o => simp
  | _ => simp

/-- The seat's two layings return at an unmarked record that stands in the opened head's link, whatever is laid. -/
theorem lays_of (h : OnBytes.Model.Head.Shape) (iU3 : Nat) (s : S) (hf : s.failed = none)
    (ho : HeadOpen s) (F1 : Fork) (H : HeardAll) :
    ∃ s1 s2, (seatAt h iU3).setLedger s F1 = .ok s1 ∧ (seatAt h iU3).setHeard s1 H = .ok s2 := by
  obtain ⟨o, hh, hop, hx⟩ := ho
  obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp hx
  have e1 : (seatAt h iU3).setLedger s F1 = .ok { s with here := .head { o with F := F1 } } := by
    show s.putFork? F1 = _
    unfold S.putFork? S.fork? S.putFork S.unmarked
    simp [hh, hop, hf]
  have e2 : ((seatAt h iU3).setHeard { s with here := .head { o with F := F1 } } H).toOption.isSome
      = true := by
    unfold seatAt
    simp only [hx]
    rfl
  cases e3 : (seatAt h iU3).setHeard { s with here := .head { o with F := F1 } } H with
  | error m => rw [e3] at e2; cases e2
  | ok s2 => exact ⟨_, s2, e1, e3⟩

/-- The draws of one run of the head's rounds: canonical, none (0,0,0), in the counts that the plan's numbers fix. -/
structure DrawsOk [Sizes] (pts : List E) (gam epsS down om epsP epsN epsL : E)
    (rsS rsP rsN rsL : List E) : Prop where
  lpts : pts.length = lt
  lS : rsS.length = lPd + lt + 1
  lP : rsP.length = lt + 1
  lN : rsN.length = lt + 1
  lL : rsL.length = lt + lPd + 1
  ok : ∀ x ∈ drawsOf pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL,
    okE x = true ∧ OnBytes.isZeroE x = false

/-! ## An honest run, at the letters -/

section Letters

variable [Sizes] [Policy] [Request] [Token] [FinalNorm.In] [In]

/-- **AN HONEST RUN OF THE OUTPUT HEAD's ROUNDS**, at cells c, a mask row, the ledger F in front: rounds rs, canonical, shaped as Head.lean's table says with all that is drawn in D, none of D (0,0,0); the hearing takes them all and returns
H and the ledger G; AND ALL THAT WAS SENT IS THE TRUTH OF THE CELLS: at every stretch (RowTruth: the sumchecks' messages are the true tables' sums) and at the end (NormTruthW, HeadTruth: the hidden scalars are the cells' own values, AND THE FOUR SUMCHECKS' OWN FORMS ARE WORTH 0: these four are among the 35 forms of the row's ninth premise).
No word on who made the rounds. -/
structure HonestRun (c : NCells) (mask : Nat → E) (F : Fork) (D : List E) (rs : List Fmt.RoundView)
    (H : HeardAll) (G : Fork) : Prop where
  can : Canonical rs
  hears : hear F rs = some (H, G, [])
  shaped : ShapedAs D rs rounds
  nonzero : ∀ x ∈ D, OnBytes.isZeroE x = false
  truth : RowTruth c mask F rs
  sPV : H.1.pV.size = lt
  sS : H.1.squares.r.size = lPd + lt
  sP : H.1.products.r.size = lt
  sN : H.2.1.normed.r.size = lt
  normT : letI : Norm.Heard := H.1
    letI : FinalNorm.Heard := H.2.1
    letI : FinalNorm.Reads := normReadsAtCells c
    NormTruthW (worldE G mask noEnt) c
  headT : letI : Heard := H.2.2
    letI : Reads := readsAt c.toCells
    HeadTruth c.toCells G mask noEnt

/-- **Behind an honest run**: no draw is bad under the block's one rule; the claim on the weights is true and all 35 forms are worth 0 at the ledger behind. -/
theorem honestRun_opens (c : NCells) (mask : Nat → E) {F G : Fork} {D : List E}
    {rs : List Fmt.RoundView} {H : HeardAll} (hW : WellLaid F) (R : HonestRun c mask F D rs H G)
    (hH : (dataOf c).Holds) (hC : HonestHead c.toCells) (hreq : Request.ok = true) (hy : y < V)
    (hw : WeightsOk) (hzt : (FinalNorm.zt).size = lt) (hls : ls ≤ lPd) (hdS : S2 ∣ d)
    (hblock : ∀ x, x < d →
      FinalNorm.ew .remLow x = FinalNorm.ewh .remLow (x / S2) * eq FinalNorm.zl (x % S2)) :
    Sound.NoBad (Came.rowRuleC c mask F) rs ∧
      (let _ : Norm.Heard := H.1
       let _ : FinalNorm.Heard := H.2.1
       let _ : Heard := H.2.2
       let _ : FinalNorm.Reads := normReadsAtCells c
       let _ : Reads := readsAt c.toCells
       WeightTrue c.toCells G mask noEnt ∧
        ∀ name fs, claims.lookup name = some fs → ∀ f, f ∈ fs → atWorld G mask noEnt f = 0) := by
  refine ⟨Came.row_true c mask F hW R.hears R.truth, ?_⟩
  obtain ⟨Fa, Fb, lr, hNorm, _, _, _, hsL, _⟩ := Came.hear_parts hW R.hears
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, h4, _, _⟩ := norm_parts hW hNorm
  have h6 : okE (H.1.P.getD 6 {}).var.const = true := batch_okConst h4 6
  exact opened_all H G c mask hreq hy hw hzt hls hdS hblock R.sPV R.sS R.sP R.sN hH hC R.normT h6
    R.headT

/-- **THERE IS AN HONEST RUN WHOSE DRAWN ELEMENTS ARE AMONG ANY GIVEN DRAWS**: the sender (head_sendsC), at cells at which the norm's identities hold, from a ledger with room. -/
theorem honestRun_exists (c : NCells) (mask : Nat → E) {F : Fork} (hW : WellLaid F)
    (hH : (dataOf c).Holds) (hzt : (FinalNorm.zt).size = lt)
    (pts : List E) (gam epsS down om epsP epsN epsL : E) (rsS rsP rsN rsL : List E)
    (hD : DrawsOk pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL)
    (hroom : Fresh F (41 + 8 * lt + 4 * lPd)) :
    ∃ (rs : List Fmt.RoundView) (H : HeardAll) (G : Fork),
      HonestRun c mask F (drawsOf pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL) rs H G := by
  have szP : zP.size = lt + lPd := by
    unfold zP
    rw [Array.size_append, hzt]
    simp [halves]
  have sPt : pts.toArray.size = lt := by simpa using hD.lpts
  have mem : ∀ x, x ∈ drawsOf pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL →
      okE x = true := fun x hx => (hD.ok x hx).1
  have inD : ∀ x, (x ∈ pts ∨ (x = gam ∨ x = down ∨ x = epsS ∨ x ∈ rsS) ∨
      (x = om ∨ x = epsP ∨ x ∈ rsP) ∨ (x = epsN ∨ x ∈ rsN) ∨ (x = epsL ∨ x ∈ rsL)) →
      x ∈ drawsOf pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL := by
    intro x hx
    unfold drawsOf
    simp only [List.mem_append, List.mem_cons]
    rcases hx with a | a | a | a | a
    · exact Or.inl (Or.inl (Or.inl (Or.inl a)))
    · exact Or.inl (Or.inl (Or.inl (Or.inr a)))
    · exact Or.inl (Or.inl (Or.inr a))
    · exact Or.inl (Or.inr a)
    · exact Or.inr a
  have lS : rsS.length = (zS pts.toArray).size + 1 := by rw [zS_size _ sPt]; exact hD.lS
  have lP : rsP.length = pts.toArray.size + 1 := by rw [sPt]; exact hD.lP
  have lN : rsN.length = (FinalNorm.zt).size + 1 := by rw [hzt]; exact hD.lN
  have lL : rsL.length = zP.size + 1 := by rw [szP]; exact hD.lL
  have hF := hroom.less (m := 9 + (Part.MaskedSum.ownSlots
      (callOf 0 (zS pts.toArray) 2).all + 2 +
      (7 + (1 + (Part.MaskedSum.ownSlots (callOf 1 pts.toArray 4).all + 4 +
        (1 + (Part.MaskedSum.ownSlots (callOf 1 FinalNorm.zt 2).all + 2 +
          (1 + (Part.MaskedSum.ownSlots (callOf 1 zP 2).all + 2 + 0))))))))) (by
    rw [own_callOf, own_callOf, own_callOf, own_callOf, zS_size _ sPt, sPt, hzt, szP]
    omega)
  obtain ⟨rs, H, G, hShape, hcan, hhear, hNT, hST, _, hWG, ePV, eg, eo, eS, eP, eN, eL, hval⟩ :=
    head_sendsC c mask hW hH pts hD.lpts gam epsS down om epsP epsN epsL rsS rsP rsN rsL lS lP lN
      lL (fun x hx => mem x (inD x (Or.inl hx)))
      (mem _ (inD _ (Or.inr (Or.inl (Or.inl rfl)))))
      (mem _ (inD _ (Or.inr (Or.inl (Or.inr (Or.inr (Or.inl rfl)))))))
      (mem _ (inD _ (Or.inr (Or.inl (Or.inr (Or.inl rfl))))))
      (mem _ (inD _ (Or.inr (Or.inr (Or.inl (Or.inl rfl))))))
      (mem _ (inD _ (Or.inr (Or.inr (Or.inl (Or.inr (Or.inl rfl)))))))
      (mem _ (inD _ (Or.inr (Or.inr (Or.inr (Or.inl (Or.inl rfl)))))))
      (mem _ (inD _ (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))))
      (fun x hx => mem x (inD x (Or.inr (Or.inl (Or.inr (Or.inr (Or.inr hx)))))))
      (fun x hx => mem x (inD x (Or.inr (Or.inr (Or.inl (Or.inr (Or.inr hx)))))))
      (fun x hx => mem x (inD x (Or.inr (Or.inr (Or.inr (Or.inl (Or.inr hx)))))))
      (fun x hx => mem x (inD x (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr hx))))))) hF
  have hRT : RowTruth c mask F rs :=
    ⟨hNT, fun pre tN tL Hn Fa Fb F1 SN SL a b c' d' =>
      ⟨(hST pre tN tL Hn Fa Fb F1 SN SL a b c' d').1,
        logits_form _ _ _ _ (hST pre tN tL Hn Fa Fb F1 SN SL a b c' d').2⟩⟩
  obtain ⟨⟨w1, w2, w3, w4, w5, w6, w7⟩, ⟨n0, n1, n2, n3⟩, ⟨l0, l1, l2, l3⟩⟩ :=
    hval G (worldE G mask noEnt) (OnBytes.PscRun.Later.refl _) (fun _ _ _ => rfl)
  have sL : H.2.2.logits.r.size = lt + lPd := by
    rw [eL, List.size_toArray, List.length_take, lL, szP]
    omega
  obtain ⟨Fa, Fb, lr, hNorm, _, _, _, hsL, _⟩ := Came.hear_parts hW hhear
  have ok1 : okE (H.2.2.logits.end_ 1).var.const = true := sumcheck_okEnds hsL 1
  refine ⟨rs, H, G, hcan, hhear, hShape hzt, fun x hx => (hD.ok x hx).2, hRT, by rw [ePV]; exact sPt,
    by rw [eS, List.size_toArray, List.length_take, lS, zS_size _ sPt]; omega,
    by rw [eP, List.size_toArray, List.length_take, lP, sPt]; omega,
    by rw [eN, List.size_toArray, List.length_take, lN, hzt]; omega, ?_, ?_⟩
  · letI : Norm.Heard := H.1
    letI : FinalNorm.Heard := H.2.1
    letI : FinalNorm.Reads := normReadsAtCells c
    exact { sums := w1, prods := w2, sqRow := w3, sq0 := w4 0 (by omega), sq1 := w4 1 (by omega)
            prClaimed := w5, prRow := w6, prEnd := w7, nmRow := n1
            nm0 := by rw [Came.vsG_length, hzt] at n2; exact n2
            nm1 := by rw [Came.vsG_length, hzt] at n3; exact n3 }
  · letI : Heard := H.2.2
    letI : Reads := readsAt c.toCells
    exact headTruth_of_values c.toCells G mask noEnt hzt sL l0 l1
      (by rw [Came.vsG_length, szP] at l2; exact l2) (by rw [Came.vsG_length, szP] at l3; exact l3)
      ok1

end Letters

/-! ## At the record -/

section At

variable (h : OnBytes.Model.Head.Shape) (iU3 work l : Nat)

/-- **rs IS AN HONEST RUN OF K6's ROUNDS AT THE RECORD s**, for the cells c and the mask row: the head's letters are read at s (given returns); at these letters the cells are honest (the norm's identities hold; the policy's four forms hold in
the cells) and rs is an honest run from the record's own ledger. -/
def HonestRunK6 (s : S) (c : NCells) (mask : Nat → E) (rs : List Fmt.RoundView) : Prop :=
  ∃ (g : Given) (D : List E) (H : HeardAll) (G : Fork),
    given (parOf h work) (seatAt h iU3) s = .ok g ∧ (dataOf c).Holds ∧ HonestHead c.toCells ∧
      HonestRun c mask ((seatAt h iU3).ledger s) D rs H G

/-- **EVERY HONEST RUN MEETS ALL NINE PREMISES OF K06_law.** -/
theorem nine_of_honest (s : S) (c : NCells) (mask : Nat → E) (rs : List Fmt.RoundView)
    (hWL : WellLaid ((seatAt h iU3).ledger s)) (hplan : (parOf h work).ok = true)
    (hfeat : hasFeatures (parOf h work))
    (hstart : (parOf h work).okStart ((seatAt h iU3).request s) = true)
    (htok : ∀ y, Reply.token (seatAt h iU3).toSeat s = some y → y < (parOf h work).sizes.V)
    (hfail : s.failed = none) (hopen : HeadOpen s) (R : HonestRunK6 h iU3 work s c mask rs) :
    ∃ (s' : S) (gs : List (List (Nat × List UInt64))),
    (blockAt h iU3 work l).decide s rs gs = .ok s' ∧ WellLaid ((seatAt h iU3).ledger s) ∧
    (parOf h work).ok = true ∧ hasFeatures (parOf h work) ∧
    (parOf h work).okStart ((seatAt h iU3).request s) = true ∧
    (∀ y, Reply.token (seatAt h iU3).toSeat s = some y → y < (parOf h work).sizes.V) ∧
    Canonical rs ∧ Sound.NoBad (ruleK6T (parOf h work) (seatAt h iU3) s c mask) rs ∧
    Opened (parOf h work) (seatAt h iU3) s' c mask := by
  obtain ⟨g, D, H, G, hg, hH, hC, R⟩ := R
  obtain ⟨z, y, hz, hty, hP, rfl⟩ := Came.given_ok (parOf h work) (seatAt h iU3) s g hg
  letI : Sizes := (parOf h work).sizes
  letI : Policy := (parOf h work).policy
  letI : Request := (seatAt h iU3).request s
  letI : Token := ⟨y⟩
  obtain ⟨hw, hzt, hblock⟩ :=
    letters_of_lookup (parOf h work).sT (parOf h work).floor z.1 z.2 hplan hP
  letI : FinalNorm.In := (fromLookup (parOf h work).floor z.1 z.2).norm
  letI : In := (fromLookup (parOf h work).floor z.1 z.2).head
  have P := planFacts hplan
  have hdS : S2 ∣ d := Nat.dvd_of_mod_eq_zero P.hdS
  have hls : ls ≤ lPd := Came.ls_le_lPd hfeat hdS
  obtain ⟨hnb, hopen'⟩ := honestRun_opens c mask hWL R hH hC hstart (htok y hty) hw hzt hls hdS
    hblock
  have htape := tape_returns (parOf h work).work D R.nonzero rs rounds R.shaped rounds_plain
  obtain ⟨t, ht⟩ := Option.isSome_iff_exists.mp htape
  have ht' : tapeT { rows := fun e => e.name == "BAT-sigma" } rs
      (((parOf h work).declare rounds).map (·.entry)) = some t := by
    rw [← ht]
    unfold Par.declare headRule
    rw [List.map_map]
    rfl
  obtain ⟨s1, s2, e1, e2⟩ := lays_of h iU3 s hfail hopen G H
  obtain ⟨w, hd⟩ := decide_returns (fun _ => ()) (seatAt h iU3) l 4 (parOf h work) s s1 s2 rs []
    _ t H G hg ht' R.hears e1 e2
  obtain ⟨bL, bH, bG, _⟩ := seatBack_at h iU3 work s _ rs [] G H w s1 s2 hg hWL R.can R.hears e1 e2
  refine ⟨_, [], hd, hWL, hplan, hfeat, hstart, htok, R.can,
    Came.ruleK6T_of_row (parOf h work) (seatAt h iU3) s c _ hg hnb, _, H, bG.trans hg, bH, ?_⟩
  rw [bL]
  exact hopen'

/-- **THERE IS AN HONEST RUN AT THE RECORD, FOR ALL HONEST CELLS, EVERY MASK ROW AND ANY GIVEN DRAWS (its drawn elements are among them)**, where the letters are read and the ledger has room. -/
theorem honestK6_exists (s : S) (c : NCells) (mask : Nat → E)
    (hWL : WellLaid ((seatAt h iU3).ledger s)) (hplan : (parOf h work).ok = true)
    (hgiven : (given (parOf h work) (seatAt h iU3) s).toOption.isSome = true)
    (hroom : letI : Sizes := (parOf h work).sizes
      Fresh ((seatAt h iU3).ledger s) (41 + 8 * lt + 4 * lPd))
    (hc : ∀ g : Given, given (parOf h work) (seatAt h iU3) s = .ok g →
      (dataOf c).Holds ∧ HonestHead c.toCells)
    (pts : List E) (gam epsS down om epsP epsN epsL : E) (rsS rsP rsN rsL : List E)
    (hD : letI : Sizes := (parOf h work).sizes
      DrawsOk pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL) :
    ∃ rs, HonestRunK6 h iU3 work s c mask rs ∧
      ShapedAs (drawsOf pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL) rs
        (@rounds (parOf h work).sizes) := by
  cases hg : given (parOf h work) (seatAt h iU3) s with
  | error e => rw [hg] at hgiven; cases hgiven
  | ok g =>
    obtain ⟨hH, hC⟩ := hc g hg
    obtain ⟨z, y, hz, hty, hP, rfl⟩ := Came.given_ok (parOf h work) (seatAt h iU3) s g hg
    letI : Sizes := (parOf h work).sizes
    letI : Policy := (parOf h work).policy
    letI : Request := (seatAt h iU3).request s
    letI : Token := ⟨y⟩
    obtain ⟨_, hzt, _⟩ :=
      letters_of_lookup (parOf h work).sT (parOf h work).floor z.1 z.2 hplan hP
    letI : FinalNorm.In := (fromLookup (parOf h work).floor z.1 z.2).norm
    letI : In := (fromLookup (parOf h work).floor z.1 z.2).head
    obtain ⟨rs, H, G, R⟩ := honestRun_exists c mask hWL hH hzt pts gam epsS down om epsP epsN epsL
      rsS rsP rsN rsL hD hroom
    exact ⟨rs, ⟨_, _, H, G, hg, hH, hC, R⟩, R.shaped⟩

end At

/-! ## At the public record: the block as it rides -/

/-- n more numbers are there and every number from the next on is free: Fresh, as a test with code. -/
def roomB (F : Fork) (n : Nat) : Bool :=
  Decidable.decide (F.next + n ≤ F.ns) && Decidable.decide (F.gotF.size = F.ns) &&
    (List.range (F.ns - F.next)).all fun i => !(F.gotF.getD (F.next + i) true)

theorem roomB_iff (F : Fork) (n : Nat) : roomB F n = true ↔ Fresh F n := by
  unfold roomB Fresh Part.MaskedSum.FreeIn
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range,
    Bool.not_eq_true']
  constructor
  · rintro ⟨⟨a, b⟩, e⟩
    refine ⟨a, Nat.le_refl _, b, fun j h1 h2 => ?_⟩
    have := e (j - F.next) (by omega)
    rwa [show F.next + (j - F.next) = j by omega] at this
  · rintro ⟨a, _, b, e⟩
    exact ⟨⟨a, b⟩, fun i hi => e _ (by omega) (by omega)⟩

/-- What the honest run's yes asks of the record in front BESIDE K6On: it bears no mark; it stands in the head's link, opened, with what the lookup left laid. -/
def K6MoreB (s : S) : Bool := s.failed.isNone && headOpenB s

/-- What the EXISTENCE of an honest run asks besides: the head's letters are read at the record; the ledger has room for the hearing's 41 + 8 lt + 4 lPd numbers, all free. -/
def K6RoomB (W : OnBytes.Model.Verify.Public) (s : S) : Bool :=
  (given (parOf W.hS (workOf W)) (seatAt W.hS (readsOf W)) s).toOption.isSome &&
    (let _ := (parOf W.hS (workOf W)).sizes
     roomB ((seatAt W.hS (readsOf W)).ledger s) (41 + 8 * lt + 4 * lPd))

/-- **EVERY HONEST RUN OF K6's ROUNDS MEETS ALL NINE PREMISES OF K06_law's OWN LINE (RowRidesStatement)**: at every public record W, link l and block b that blockOf hands out, every record s in front that passes K6On and the two tests
of K6MoreB, all cells, every mask row and every honest run rs. -/
def K06HonestStatement : Prop :=
  ∀ (W : OnBytes.Model.Verify.Public) (l : Nat) (b : Block S Unit), blockOf W l = some b →
    ∀ (s : S) (c : NCells) (mask : Nat → E) (rs : List Fmt.RoundView), K6On W s → K6MoreB s = true →
    HonestRunK6 W.hS (readsOf W) (workOf W) s c mask rs →
    ∃ (s' : S) (gs : List (List (Nat × List UInt64))),
    b.decide s rs gs = .ok s' ∧ WellLaid ((seatAt W.hS (readsOf W)).ledger s) ∧
    (parOf W.hS (workOf W)).ok = true ∧ hasFeatures (parOf W.hS (workOf W)) ∧
    (parOf W.hS (workOf W)).okStart ((seatAt W.hS (readsOf W)).request s) = true ∧
    (∀ y, Reply.token (seatAt W.hS (readsOf W)).toSeat s = some y →
      y < (parOf W.hS (workOf W)).sizes.V) ∧
    Canonical rs ∧
    Sound.NoBad (ruleK6T (parOf W.hS (workOf W)) (seatAt W.hS (readsOf W)) s c mask) rs ∧
    Opened (parOf W.hS (workOf W)) (seatAt W.hS (readsOf W)) s' c mask

theorem k06Honest : K06HonestStatement := by
  intro W l b hb s c mask rs hOn hMore R
  obtain ⟨iU3, hu, rfl⟩ := Option.map_eq_some_iff.mp hb
  have hr : readsOf W = iU3 := by
    unfold readsOf
    rw [hu]
    rfl
  obtain ⟨a1, a2, a3, a4, a5, _⟩ := hOn
  rw [hr] at a1 a4 a5 R ⊢
  unfold K6MoreB at hMore
  rw [Bool.and_eq_true] at hMore
  exact nine_of_honest W.hS iU3 (workOf W) l s c mask rs a1 a2 a3 a4 a5
    (Option.isNone_iff_eq_none.mp hMore.1) ((headOpenB_iff s).mp hMore.2) R

/-- So for every honest run there is a record s' at which K06_law's conclusion holds: Came.rowRides applies with nothing else in hand. (s' stands under a bare "there is": that it is the record which the decision returns: Law/K06HonestWhole.lean.) -/
theorem k06Honest_closes (W : OnBytes.Model.Verify.Public) (l : Nat) (b : Block S Unit)
    (hb : blockOf W l = some b) (s : S) (c : NCells) (mask : Nat → E) (rs : List Fmt.RoundView)
    (hOn : K6On W s) (hMore : K6MoreB s = true)
    (R : HonestRunK6 W.hS (readsOf W) (workOf W) s c mask rs) :
    ∃ s', ClosedWhole (parOf W.hS (workOf W)) (seatAt W.hS (readsOf W)) s' c mask := by
  obtain ⟨s', gs, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := k06Honest W l b hb s c mask rs hOn hMore R
  exact ⟨s', Came.rowRides W l b hb s c mask s' rs gs h1 h2 h3 h4 h5 h6 h7 h8 h9⟩

/-- **AND HONEST RUNS THERE ARE**: for all honest cells, every mask row and any given canonical elements, none (0,0,0): a run each of whose drawn elements is AMONG them. -/
def K06HonestExistsStatement : Prop :=
  ∀ (W : OnBytes.Model.Verify.Public) (s : S) (c : NCells) (mask : Nat → E), K6On W s →
    K6RoomB W s = true →
    (∀ g : Given, given (parOf W.hS (workOf W)) (seatAt W.hS (readsOf W)) s = .ok g →
      (dataOf c).Holds ∧ HonestHead c.toCells) →
    ∀ (pts : List E) (gam epsS down om epsP epsN epsL : E) (rsS rsP rsN rsL : List E),
    (letI : Sizes := (parOf W.hS (workOf W)).sizes
     DrawsOk pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL) →
    ∃ rs, HonestRunK6 W.hS (readsOf W) (workOf W) s c mask rs ∧
      ShapedAs (drawsOf pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL) rs
        (@rounds (parOf W.hS (workOf W)).sizes)

theorem k06HonestExists : K06HonestExistsStatement := by
  intro W s c mask hOn hRoom hc pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL hD
  obtain ⟨a1, a2, _⟩ := hOn
  unfold K6RoomB at hRoom
  rw [Bool.and_eq_true] at hRoom
  exact honestK6_exists W.hS (readsOf W) (workOf W) s c mask a1 a2 hRoom.1
    ((roomB_iff _ _).mp hRoom.2) hc pts gam epsS down om epsP epsN epsL rsS rsP rsN rsL hD

end VerifiableInference.Desc.Kinds.Head.Law

