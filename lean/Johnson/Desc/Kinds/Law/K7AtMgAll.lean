/-- The driver's list has the next token's place at 338. -/
theorem place338 : (flatPlacesOf linksFull true)[338]? = some ⟨1, some 24, 1, .K7⟩ := by
  decide +kernel

/-- And the head's second piece behind it. -/
theorem place339 : (flatPlacesOf linksFull true)[339]? = some ⟨1, some 24, 2, .K2⟩ := by
  decide +kernel

/-- **338 is the one number at which the driver's list has a place of the kind K7.** -/
theorem only338 (i : Nat) (a : Place) (h : (flatPlacesOf linksFull true)[i]? = some a)
    (hk : a.kind = .K7) : i = 338 := by
  have hall : ((flatPlacesOf linksFull true).zipIdx.all fun x =>
      !(x.1.kind == KindName.K7) || x.2 == 338) = true := by decide +kernel
  have hm : (a, i) ∈ (flatPlacesOf linksFull true).zipIdx := by
    rw [List.mem_zipIdx_iff_getElem?]
    exact h
  have h1 := List.all_eq_true.1 hall (a, i) hm
  simp only [hk, beq_self_eq_true, Bool.not_true, Bool.false_or, beq_iff_eq] at h1
  exact h1

/-- **THE TEN ITEMS THAT ARE OPEN AT THE BORDER 338.** -/
theorem open338 : openQ linksFull (flatPlacesOf linksFull true) 338 =
    [.unmarked, .pinW, .pile, .constr 24 .idn, .constr 24 .lookCalls, .constr 24 .rider,
      .constr 24 .small, .pinI, .carry 23, .pinKept 23] := by
  decide +kernel

/-- **No class of rows is open there.** -/
theorem noRows338 : rowSegs (openQ linksFull (flatPlacesOf linksFull true) 338) = [] := by
  rw [open338]
  rfl

/-- **TWO PINS ARE OPEN THERE**: so the bill's fields "held" and "shown" speak of the index masks'
tenant, whatever the numbers, and of the tenants that the head's segment keeps of segment 23's. -/
theorem sampled338 (N : Numbers) :
    sampledIn N (openQ linksFull (flatPlacesOf linksFull true) 338) = N.index :: N.keptOf 23 := by
  rw [open338]
  simp [sampledIn]

/-- What the next token's row closes. -/
theorem ins338 : (rowQ linksFull (flatPlacesOf linksFull true) 338).ins =
    [.constr 24 .lookCalls] := by
  decide +kernel

/-- Two of the table's tests at the full chain, and the list's length. -/
theorem readsOpen_full :
    readsOpen linksFull (flatPlacesOf linksFull true) (start linksFull) = true := by
  decide +kernel

theorem rowsApart_full : rowsApart linksFull (flatPlacesOf linksFull true) = true := by
  decide +kernel

theorem len338 : 338 ≤ (flatPlacesOf linksFull true).length := by decide +kernel

/-- **THE PUBLIC ITEMS AT THE BORDER 338**, at the composed meaning's closed list of extra public
tests: open: "no token is heard yet"; tied to open items: the two on the index masks' message. -/
theorem pubFront338 :
    (pubSets mgMore linksFull (flatPlacesOf linksFull true))[338]?.getD [] ++
      pubOfItems ((openSets linksFull (flatPlacesOf linksFull true) (start linksFull))[338]?.getD
        []) = [.unheard, .indexIs, .indexThere] := by
  decide +kernel

/-- Behind the next token's row: open: "a small token is heard". -/
theorem pubStep338 :
    pubStep ((pubSets mgMore linksFull (flatPlacesOf linksFull true))[338]?.getD [])
      (pubRowM mgMore linksFull ⟨1, some 24, 1, .K7⟩) = [.tokenSmall] := by
  decide +kernel

/-- And the same two are tied. -/
theorem pubTied339 :
    pubOfItems (stepOpen
      ((openSets linksFull (flatPlacesOf linksFull true) (start linksFull))[338]?.getD [])
      (rowOf linksFull ⟨1, some 24, 1, .K7⟩)) = [.indexIs, .indexThere] := by
  decide +kernel

variable {Xi P Tok Cl : Type} {rows cols nR : Nat} {Wp : OnBytes.Model.Verify.Public} {C : CK}
  {Fr : Frame} (D : MgData Xi P Tok rows cols nR Wp)
  (Mg : Meaning P (Wit (Fin rows → Fin cols → GE) Tok MsgT)) (c₀ : Fin rows → Fin cols → GE)
  (tab : Nat → Nat) (tokH : P × S → Fin ppref.V) (tokOf : P × S → Tok)
  (s : Nat → Cb.Pv.Tail.Size) (seat : ∀ k, Fin (s k).NM → Nat → Nat → Nat × Nat × Nat)
  (pl : Nat → Nat × Bool × Nat × Nat) (Rch : Nat → (P × S) × Fr.E.Str → Prop)

set_option quotPrecheck false in
/-- The reading, with the oracles' one decoder. -/
local notation "HID" => oneDec D.decT D.H

set_option quotPrecheck false in
/-- The filling of the letter headPart. -/
local notation "HP" => headPartK6 D.cs D.arr D.ms D.N s seat Wp pl tab D.put HID tokH

/-- The driver's list of places, at the full chain. -/
local notation "PS" => flatPlacesOf linksFull true

set_option quotPrecheck false in
/-- The piece over the verifier's state at 338 (Law/K7Seated.lean), before B, q and z. -/
local notation "PCW" =>
  pieceK7 D.cs D.arr D.N tokOf linksFull PS 338 D.G D.smp D.ms D.decT c₀

/-- The composed meaning's field constr is the bill's, where the head's link's number is 24 and the
structure of letters has this filling of headPart. -/
theorem constr_mgAll (hseg : headLink Wp = 24) (hhead : D.headPart = HP) :
    (mgAll D Mg).constr = P5J.constrQAt 24 D.put HID HP D.digitsPart := by
  rw [mgAll_constr, hseg, hhead]

/-- The composed meaning's field decodes says that the reading's decoder answers. -/
theorem decIs_mgAll (a : P × S) (y : Strs) :
    (mgAll D Mg).decodes a y ↔ ((HID).dec a y).isSome = true := Iff.rfl

/-- **THE FIELD "tok" OF K7Rest, TO THE LETTER**, at P5J/TokTerms.lean's three terms for the token
and its reading off the seats, with the one decoder. -/
theorem tok_terms_one {P' : Type} (cs : OnBytes.Codes) (arr : Nat → Nat → Nat) (msR : List Mem)
    (N : Numbers) (req : P' × S → P5J.TReq)
    (dec : P' × S → Strs → Option (Fin rows → Fin cols → GE)) (hSN : SeatsNamed arr N s seat)
    (hGS : GroupsSeated msR N)
    (decT' : (Nat → Option (Nat × List UInt64)) → P' × S → Option (Fin rows → Fin cols → GE))
    (b : P' × S) (w : Wit (Fin rows → Fin cols → GE) Nat MsgT) :
    ((oneDec decT' (P5J.hidAtSeat Wp cs arr msR N s seat P5J.tokVOf req dec hSN hGS)).hid
      ⟨w.cells, P5J.tokOfHeard b, w.msg, w.pad⟩).tok = P5J.tokHOf b := rfl

/-- **THE ITEM THAT THE NEXT TOKEN's PUBLIC ROW MAKES, AT THE COMPOSED MEANING.** -/
theorem tokenSmall_mgAll (W : OnBytes.Model.Verify.Public) (hW : Wp.hS = W.hS) (l : Nat)
    (name : String) (front : Block S Unit) (z : P) :
    ∀ x rs gs t, (front.andThen name (Reply.blockOf W l)).decide x rs gs = .ok t →
      (mgAll D Mg).pub .tokenSmall (z, t) = true := by
  intro x rs gs t h
  show tokenHeardB Wp.hS (iU3At Wp) t = true
  rw [hW]
  exact token_made W l name front (iU3At Wp) x rs gs t h

/-- "The state holds the sample" reads no group: one fresh group leaves the test's answer. -/
theorem smpHeld_withFresh (st : OnBytes.Statement) (book : OnBytes.TreeBook) (c m j t : Nat) :
    smpHeld (withFresh st c m) book j t = smpHeld st book j t := rfl

/-- **What the next token's place leaves of the verifier's state**: all but where the chain stands,
the reply, and the statement's groups. -/
def K7Leaves (x t : S) : Prop :=
  t.st.codes = x.st.codes ∧ t.st.oracles = x.st.oracles ∧ t.book = x.book ∧ t.roots = x.roots ∧
    t.rowsOwed = x.rowsOwed ∧ t.failed = x.failed ∧ t.check = x.check ∧ t.req = x.req

theorem place_leaves (W : OnBytes.Model.Verify.Public) (l : Nat) (name : String)
    (front : Block S Unit) (tl : HTailF2)
    (hfront : ∀ x rs gs x1, front.decide x rs gs = .ok x1 → headFrontQ tl x = .ok x1) :
    ∀ x rs gs t, (front.andThen name (Reply.blockOf W l)).decide x rs gs = .ok t →
      K7Leaves x t := by
  intro x rs gs t h
  obtain ⟨a1, a2, a3, a4, a5, a6, a7⟩ := place_whole W l name front tl hfront x rs gs t h
  exact ⟨by rw [a1]; rfl, by rw [a1]; rfl, a2, a3, a4, a5, a6, a7⟩

/-- Where the piece at 338 accepts, the state behind agrees with the state in front in what the
place leaves. -/
theorem piece_leaves (B : Block S Cl)
    (q : Piece C Fr (P × S) Cl (Wit (Fin rows → Fin cols → GE) Tok MsgT))
    (W : OnBytes.Model.Verify.Public) (l : Nat) (name : String) (front : Block S Unit)
    (tl : HTailF2)
    (hyes : ∀ x rs gs t, B.decide x rs gs = .ok t →
      ∃ rs' gs', (front.andThen name (Reply.blockOf W l)).decide x rs' gs' = .ok t)
    (hfront : ∀ x rs gs x1, front.decide x rs gs = .ok x1 → headFrontQ tl x = .ok x1) :
    ∀ (z : P) a τ b, (PCW B q z).ior.red.out a τ = some b → K7Leaves a.1 b.1 := by
  intro z a τ b hb
  obtain ⟨rs, gs, hy⟩ := Came.piece_yes hyes z a τ b hb
  exact place_leaves W l name front tl hfront _ _ _ _ hy

/-- **WHAT IS LEFT OF "frames", ONE FIELD AN ITEM**: of the eight items that ride past the next
token's place, the two whose sentences are another file's term or an open parameter: what the item
says of the state behind at w it says of the state in front at w with the token laid: WHERE THE
TABLE's PROMISE HOLDS IN FRONT AND BEHIND, and the state in front is reached. -/
structure K7Riders (B : Block S Cl)
    (q : Piece C Fr (P × S) Cl (Wit (Fin rows → Fin cols → GE) Tok MsgT)) : Prop where
  pile : ∀ (z : P) a τ b (w : Wit (Fin rows → Fin cols → GE) Tok MsgT),
    (PCW B q z).ior.red.out a τ = some b → Rch 338 ((z, a.1), a.2) →
    onQ D.N (mgAll D Mg) linksFull PS (fun x => (z, x)) 338 a →
    onQ D.N (mgAll D Mg) linksFull PS (fun x => (z, x)) (338 + 1) b →
    (mgAll D Mg).pile (z, b.1) (strsOf Fr b.2) w →
    (mgAll D Mg).pile (z, a.1) (strsOf Fr a.2) ⟨w.cells, tokOf (z, b.1), w.msg, w.pad⟩
  carry : ∀ (z : P) a τ b (w : Wit (Fin rows → Fin cols → GE) Tok MsgT),
    (PCW B q z).ior.red.out a τ = some b → Rch 338 ((z, a.1), a.2) →
    onQ D.N (mgAll D Mg) linksFull PS (fun x => (z, x)) 338 a →
    onQ D.N (mgAll D Mg) linksFull PS (fun x => (z, x)) (338 + 1) b →
    (mgAll D Mg).carry 23 (z, b.1) (strsOf Fr b.2) w →
    (mgAll D Mg).carry 23 (z, a.1) (strsOf Fr a.2) ⟨w.cells, tokOf (z, b.1), w.msg, w.pad⟩

/-- The number of the index masks' message stays over the place. -/
theorem place_index (W : OnBytes.Model.Verify.Public) (l : Nat) (name : String)
    (front : Block S Unit) (tl : HTailF2)
    (hfront : ∀ x rs gs x1, front.decide x rs gs = .ok x1 → headFrontQ tl x = .ok x1) :
    ∀ x rs gs t, (front.andThen name (Reply.blockOf W l)).decide x rs gs = .ok t →
      t.out.indexMasks = x.out.indexMasks := by
  intro x rs gs t h
  have h' : ((front.decide x (rs.take front.rounds.length) (gs.take front.openings)).bind fun s1 =>
      (Reply.blockOf W l).decide s1 (rs.drop front.rounds.length) (gs.drop front.openings))
      = .ok t := h
  cases hp : front.decide x (rs.take front.rounds.length) (gs.take front.openings) with
  | error e => rw [hp] at h'; cases h'
  | ok s1 =>
    rw [hp] at h'
    obtain ⟨_, _, _, _, _, _, _, _, a9, _⟩ := reply_rest l W.hS.V h'
    rw [a9, (headFrontQ_rest (hfront _ _ _ _ hp)).2.2.2.2.2.1]

/-- **THE FIELD "pub" AT THE COMPOSED MEANING.** The row makes "a small token is heard"
(tokenSmall_mgAll) and drops "no token is heard yet"; the two tied items read the number of the
index masks' message and the statement's oracle messages, which the place leaves. -/
theorem pub_mgAll (hmore : (mgAll D Mg).more = mgMore) (B : Block S Cl)
    (q : Piece C Fr (P × S) Cl (Wit (Fin rows → Fin cols → GE) Tok MsgT))
    (W : OnBytes.Model.Verify.Public) (hW : Wp.hS = W.hS) (l : Nat) (name : String)
    (front : Block S Unit) (tl : HTailF2)
    (hyes : ∀ x rs gs t, B.decide x rs gs = .ok t →
      ∃ rs' gs', (front.andThen name (Reply.blockOf W l)).decide x rs' gs' = .ok t)
    (hfront : ∀ x rs gs x1, front.decide x rs gs = .ok x1 → headFrontQ tl x = .ok x1) :
    ∀ (z : P) a τ b, (PCW B q z).ior.red.out a τ = some b →
      pubHeld (mgAll D Mg) ((openSets linksFull PS (start linksFull))[338]?.getD [])
        ((pubSets (mgAll D Mg).more linksFull PS)[338]?.getD []) (z, a.1) = true →
      pubHeld (mgAll D Mg) (stepOpen ((openSets linksFull PS (start linksFull))[338]?.getD [])
          (rowOf linksFull ⟨1, some 24, 1, .K7⟩))
        (pubStep ((pubSets (mgAll D Mg).more linksFull PS)[338]?.getD [])
          (pubRowM (mgAll D Mg).more linksFull ⟨1, some 24, 1, .K7⟩)) (z, b.1) = true := by
  intro z a τ b hb h
  obtain ⟨rs, gs, hy⟩ := Came.piece_yes hyes z a τ b hb
  have lv := place_leaves W l name front tl hfront _ _ _ _ hy
  have ix := place_index W l name front tl hfront _ _ _ _ hy
  rw [hmore] at h ⊢
  unfold pubHeld at h ⊢
  rw [pubFront338] at h
  rw [pubStep338, pubTied339]
  simp only [List.cons_append, List.nil_append, List.all_cons, List.all_nil, Bool.and_true,
    Bool.and_eq_true] at h ⊢
  obtain ⟨_, h2, h3⟩ := h
  refine ⟨tokenSmall_mgAll D Mg W hW l name front z _ _ _ _ hy, ?_, ?_⟩
  · have h2' : indexIsC D.N.indexNo a.1 = true := h2
    show indexIsC D.N.indexNo b.1 = true
    unfold indexIsC at h2' ⊢
    rw [ix]
    exact h2'
  · have h3' : indexThereC a.1 = true := h3
    show indexThereC b.1 = true
    unfold indexThereC at h3' ⊢
    rw [ix, lv.2.1]
    exact h3'

/-- **THE FIELD "pubP"**: behind the row one public item is open, and what it says beside its test
is the meaning beneath's. -/
theorem pubP_mgAll (hmore : (mgAll D Mg).more = mgMore)
    (hP : ∀ a : P × S, Mg.pubP .tokenSmall a) (a : P × S) :
    ∀ x ∈ pubStep ((pubSets (mgAll D Mg).more linksFull PS)[338]?.getD [])
        (pubRowM (mgAll D Mg).more linksFull ⟨1, some 24, 1, .K7⟩), (mgAll D Mg).pubP x a := by
  intro x hx
  rw [hmore, pubStep338] at hx
  obtain rfl := List.mem_singleton.1 hx
  exact hP a

/-- The decoded table is the same at the two statements. -/
theorem dec_mgAll
    (hdecT : ∀ c (z : P) (x t : S), K7Leaves x t → D.decT c (z, t) = D.decT c (z, x))
    (B : Block S Cl) (q : Piece C Fr (P × S) Cl (Wit (Fin rows → Fin cols → GE) Tok MsgT))
    (z : P) (a : S × Fr.E.Str) (τ : Iop.Tr (OnBytes.Maker.uLT C (PCW B q z).ds))
    (b : S × Fr.E.Str) (hb : (PCW B q z).ior.red.out a τ = some b) (lv : K7Leaves a.1 b.1) :
    (HID).dec (z, b.1) (strsOf Fr b.2) = (HID).dec (z, a.1) (strsOf Fr a.2) := by
  show D.decT (strsOf Fr b.2).cell (z, b.1) = D.decT (strsOf Fr a.2).cell (z, a.1)
  rw [out_behind _ a b τ hb, cell_behind, hdecT _ z a.1 b.1 lv]

/-- **"frames" AT THE COMPOSED MEANING, FROM THESE TWO.** The six other riders are paid here: the
committed table's pin (hdecT) · the two open pins (the fence; hsmp; a pin does not read the
witness's token) · the head's sentence at idn, rider and small (Law/K7Sides.lean; hseg, hhead, hreq,
hK, hplan, hbase). -/
theorem frames_mgAll (hseg : headLink Wp = 24) (hhead : D.headPart = HP) (hK : PutKeeps D.put)
    (hplan : (parOf Wp.hS (workOf Wp)).ok = true)
    (hbase : ∀ (w : Wit (Fin rows → Fin cols → GE) Tok MsgT) (t : Tok),
      D.H.base 24 w → D.H.base 24 ⟨w.cells, t, w.msg, w.pad⟩)
    (hreq : ∀ (z : P) (x t : S), t.req = x.req → (HID).req (z, t) = (HID).req (z, x))
    (hsmp : ∀ (z : P) (x t : S), K7Leaves x t → D.smp (z, t) = D.smp (z, x))
    (hdecT : ∀ c (z : P) (x t : S), K7Leaves x t → D.decT c (z, t) = D.decT c (z, x))
    (B : Block S Cl) (q : Piece C Fr (P × S) Cl (Wit (Fin rows → Fin cols → GE) Tok MsgT))
    (W : OnBytes.Model.Verify.Public) (l : Nat) (name : String) (front : Block S Unit)
    (tl : HTailF2)
    (hyes : ∀ x rs gs t, B.decide x rs gs = .ok t →
      ∃ rs' gs', (front.andThen name (Reply.blockOf W l)).decide x rs' gs' = .ok t)
    (hfront : ∀ x rs gs x1, front.decide x rs gs = .ok x1 → headFrontQ tl x = .ok x1)
    (fence : ∀ x ∈ sampledIn D.N ((openSets linksFull PS (start linksFull))[338]?.getD []),
      x.1 < q.base)
    (I : K7Riders D Mg c₀ tokOf Rch B q) (z : P) :
    (PCW B q z).Frames
      (onR D.N (mgAll D Mg) linksFull PS (fun x => (z, x)) (fun k a => Rch k ((z, a.1), a.2)) 338)
      (onQ D.N (mgAll D Mg) linksFull PS (fun x => (z, x)) (338 + 1))
      (meansQ D.N (mgAll D Mg) fun x => (z, x))
      (openAfter (insQ linksFull PS) (outsQ linksFull PS) (· ∈ start linksFull) 338)
      (insQ linksFull PS 338) := by
  intro a τ b w i ha hb hq ho hn hw
  have lv := piece_leaves D c₀ tokOf B q W l name front tl hyes hfront z a τ b hb
  have hS : ∀ (j t : Nat), ∀ y ∈ D.ms, SitsAt y j t →
      (fun y : S => D.smp (z, y)) b.1 y.1 y.2 = (fun y : S => D.smp (z, y)) a.1 y.1 y.2 := by
    intro _ _ y _ _
    show D.smp (z, b.1) y.1 y.2 = D.smp (z, a.1) y.1 y.2
    rw [hsmp z a.1 b.1 lv]
  have hsam : sampledIn D.N ((openSets linksFull PS (start linksFull))[338]?.getD []) =
      D.N.index :: D.N.keptOf 23 := sampled338 D.N
  have hc := constr_mgAll D Mg tab tokH s seat pl hseg hhead
  have side : ∀ p : P5J.TPart, p = .idn ∨ p = .rider ∨ p = .small →
      (mgAll D Mg).constr 24 p (z, b.1) (strsOf Fr b.2) w →
      (mgAll D Mg).constr 24 p (z, a.1) (strsOf Fr a.2)
        ⟨w.cells, tokOf (z, b.1), w.msg, w.pad⟩ := by
    intro p hp h
    rw [hc] at h ⊢
    exact Came.k7_side_constr D.cs D.arr D.ms D.N s seat Wp pl 24 tab D.put HID tokH D.digitsPart
      (z, a.1) (z, b.1) _ _ w _ (hreq z a.1 b.1 lv.2.2.2.2.2.2.2)
      (dec_mgAll D c₀ tokOf hdecT B q z a τ b hb lv) hK hplan (hbase w _) p hp h
  rw [Came.piece_ext place338 (by decide) z a τ b w hb]
  have hmem : i ∈ openQ linksFull PS 338 :=
    ((openIsList Item (insL linksFull PS) (outsL linksFull PS) (start linksFull) 338 i).trans
      (openL_iff_openSets linksFull PS (start linksFull) readsOpen_full rowsApart_full
        (List.mem_append_left _ List.mem_cons_self) 338 len338 i)).1 ho
  rw [open338] at hmem
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact absurd (List.mem_append_right _ (List.mem_singleton.2 rfl)) hn
  · have h' : D.decT (strsOf Fr b.2).cell (z, b.1) = some w.cells := hw
    rw [out_behind _ a b τ hb, cell_behind, hdecT _ z a.1 b.1 lv] at h'
    exact h'
  · exact I.pile z a τ b w hb ha.2 ha.1 hq hw
  · exact side .idn (Or.inl rfl) hw
  · refine absurd (List.mem_append_left _ (List.mem_append_left _ ?_)) hn
    rw [ins338]
    exact List.mem_singleton.2 rfl
  · exact side .rider (Or.inr (Or.inl rfl)) hw
  · exact side .small (Or.inr (Or.inr rfl)) hw
  · have h1 : pinJT D.cs D.G D.arr (fun y : S => D.smp (z, y)) D.ms D.N.index.1 D.N.index.2 b.1
        (strsOf Fr b.2) w := hw
    exact (pinJT_rides D.cs D.G D.arr (fun y : S => D.smp (z, y)) (PCW B q z) D.ms _ _
      (fence D.N.index (by rw [hsam]; exact List.mem_cons_self)) a b τ hb (hS _ _) w).1 h1
  · exact I.carry z a τ b w hb ha.2 ha.1 hq hw
  · intro x hx
    have h1 : pinJT D.cs D.G D.arr (fun y : S => D.smp (z, y)) D.ms x.1 x.2 b.1
        (strsOf Fr b.2) w := hw x hx
    exact (pinJT_rides D.cs D.G D.arr (fun y : S => D.smp (z, y)) (PCW B q z) D.ms _ _
      (fence x (by rw [hsam]; exact List.mem_cons_of_mem _ hx)) a b τ hb (hS _ _) w).1 h1

/-- **THE BILL's THIRD PART IS PAID AT THE COMPOSED MEANING**, from the fields "yes" and "front" of
its second part, a fence on the piece's base, and three premises on parameters. dec: the committed
table's cells stay (Desc/Sound/DecodesRides.lean), and the decoder reads what the place leaves
(hdecT). order: "in order" is the meaning beneath's own test (hMg) and a test on the public part
alone. held: the book stays, and the statement gains one fresh group, which the test does not read.
shown: the seats' trees were sent in front of the piece (fence), and the samples' reader reads what
the place leaves (hsmp): Desc/Sound/SigRides.lean. -/
theorem state_mgAll (hseg : headLink Wp = 24) (hhead : D.headPart = HP) (hK : PutKeeps D.put)
    (hplan : (parOf Wp.hS (workOf Wp)).ok = true)
    (hbase : ∀ (w : Wit (Fin rows → Fin cols → GE) Tok MsgT) (t : Tok),
      D.H.base 24 w → D.H.base 24 ⟨w.cells, t, w.msg, w.pad⟩)
    (hreq : ∀ (z : P) (x t : S), t.req = x.req → (HID).req (z, t) = (HID).req (z, x))
    (hmore : (mgAll D Mg).more = mgMore) (hP : ∀ a : P × S, Mg.pubP .tokenSmall a)
    (hMg : ∀ (z : P) (x t : S), Mg.inOrder (z, x) = true → Mg.inOrder (z, t) = true)
    (hsmp : ∀ (z : P) (x t : S), K7Leaves x t → D.smp (z, t) = D.smp (z, x))
    (hdecT : ∀ c (z : P) (x t : S), K7Leaves x t → D.decT c (z, t) = D.decT c (z, x))
    (B : Block S Cl) (q : Piece C Fr (P × S) Cl (Wit (Fin rows → Fin cols → GE) Tok MsgT))
    (W : OnBytes.Model.Verify.Public) (hW : Wp.hS = W.hS) (l : Nat) (name : String)
    (front : Block S Unit) (tl : HTailF2)
    (hyes : ∀ x rs gs t, B.decide x rs gs = .ok t →
      ∃ rs' gs', (front.andThen name (Reply.blockOf W l)).decide x rs' gs' = .ok t)
    (hfront : ∀ x rs gs x1, front.decide x rs gs = .ok x1 → headFrontQ tl x = .ok x1)
    (fence : ∀ x ∈ sampledIn D.N ((openSets linksFull PS (start linksFull))[338]?.getD []),
      x.1 < q.base)
    (I : K7Riders D Mg c₀ tokOf Rch B q) :
    K7State D.cs D.arr D.N Wp 24 HID tokOf (mgAll D Mg) linksFull PS 338 D.G D.smp D.ms D.decT c₀ B
      q Rch := by
  have lv := piece_leaves D c₀ tokOf B q W l name front tl hyes hfront
  refine ⟨fun z a τ b hb => ?_, fun z a τ b _ _ h => ?_, fun z a τ b hb _ x _ h => ?_,
    fun z a τ b hb _ x hx h => ?_,
    fun z a τ b hb _ =>
      pub_mgAll D Mg c₀ tokOf hmore B q W hW l name front tl hyes hfront z a τ b hb,
    fun z _ _ b _ _ _ => pubP_mgAll D Mg hmore hP (z, b.1),
    frames_mgAll D Mg c₀ tab tokH tokOf s seat pl Rch hseg hhead hK hplan hbase hreq hsmp hdecT B q
      W l name front tl hyes hfront fence I⟩
  · exact dec_mgAll D c₀ tokOf hdecT B q z a τ b hb (lv z a τ b hb)
  · rw [mgAll_inOrder_at] at h ⊢
    simp only [Bool.and_eq_true] at h ⊢
    exact ⟨hMg z _ _ h.1, h.2⟩
  · obtain ⟨rs, gs, hy⟩ := Came.piece_yes hyes z a τ b hb
    obtain ⟨e1, e2, _⟩ := place_whole W l name front tl hfront _ _ _ _ hy
    show smpHeld b.1.st b.1.book x.1 x.2 = true
    rw [e1, e2, smpHeld_withFresh]
    exact h
  · exact ⟨shownJT_rides D.cs D.G
        (pieceK7 D.cs D.arr D.N tokOf linksFull PS 338 D.G D.smp D.ms D.decT c₀ B q z) D.ms x.1 x.2
        (fence x hx) a b τ hb h.1,
      noCollJT_rides D.cs D.G (fun y : S => D.smp (z, y))
        (pieceK7 D.cs D.arr D.N tokOf linksFull PS 338 D.G D.smp D.ms D.decT c₀ B q z) D.ms x.1 x.2
        (fence x hx) a b τ hb
        (fun y _ _ => by
          show D.smp (z, b.1) y.1 y.2 = D.smp (z, a.1) y.1 y.2
          rw [hsmp z a.1 b.1 (lv z a τ b hb)]) h.2⟩

/-- **THE NEXT TOKEN's KIND's SHARE OF THE CHAIN OF PROMISES, AT THE COMPOSED MEANING AND THE FULL
CHAIN.** -/
theorem k7_kindTied_mgAll (hseg : headLink Wp = 24) (hhead : D.headPart = HP)
    (hK : PutKeeps D.put) (hplan : (parOf Wp.hS (workOf Wp)).ok = true)
    (hbase : ∀ (w : Wit (Fin rows → Fin cols → GE) Tok MsgT) (t : Tok),
      D.H.base 24 w → D.H.base 24 ⟨w.cells, t, w.msg, w.pad⟩)
    (hmore : (mgAll D Mg).more = mgMore) (hP : ∀ a : P × S, Mg.pubP .tokenSmall a)
    (hMg : ∀ (z : P) (x t : S), Mg.inOrder (z, x) = true → Mg.inOrder (z, t) = true)
    (hsmp : ∀ (z : P) (x t : S), K7Leaves x t → D.smp (z, t) = D.smp (z, x))
    (hdecT : ∀ c (z : P) (x t : S), K7Leaves x t → D.decT c (z, t) = D.decT c (z, x))
    (row : List (Piece C Fr (P × S) Cl (Wit (Fin rows → Fin cols → GE) Tok MsgT)))
    (hall : ∀ q, row[338]? = some q →
      ∃ (B Bst : Block S Cl) (W : OnBytes.Model.Verify.Public) (l : Nat) (name : String)
        (front : Block S Unit) (tl : HTailF2) (told : List (List Oracle)),
        SeatOf Bst B ∧ q.b = (Sound.below B).lift Prod.snd (fun t x => (t.1, x)) ∧
        K7Rest D.N Wp HID tokH tokOf PS 338 B W l name front tl told ∧
        (∀ x ∈ sampledIn D.N ((openSets linksFull PS (start linksFull))[338]?.getD []),
          x.1 < q.base) ∧
        Wp.hS = W.hS ∧ K7Riders D Mg c₀ tokOf Rch B q) :
    KindTiedR D.N (mgAll D Mg) linksFull PS Rch
      (fun i => extQAt D.cs D.G D.arr D.smp D.ms D.decT c₀ tokOf D.N linksFull PS (fun a => a) i)
      row .K7 := by
  refine k7_kindTied D.cs D.arr D.ms D.N s seat Wp pl 24 tab D.put HID tokH tokOf D.digitsPart
    (mgAll D Mg) linksFull PS D.G D.smp D.ms D.decT c₀ Rch row fun i q a hq ha hk => ?_
  obtain rfl := only338 i a ha hk
  obtain ⟨B, Bst, W, l, name, front, tl, told, hS, hb, R, fence, hW, I⟩ := hall q hq
  exact ⟨B, Bst, W, l, name, front, tl, .K2, told, hS, hb,
    ⟨⟨constr_mgAll D Mg tab tokH s seat pl hseg hhead, fun _ _ => Iff.rfl, place338, place339,
      by decide, noRows338⟩, R,
      state_mgAll D Mg c₀ tab tokH tokOf s seat pl Rch hseg hhead hK hplan hbase R.req hmore hP hMg
        hsmp hdecT B q W hW l name front tl R.yes R.front fence I⟩⟩

/-- **THE SAME OVER THE CLOSED MEANING BENEATH** (Desc/Sound/MgBase.lean): the premise on it falls:
its "in order" accepts everywhere. -/
theorem k7_kindTied_mgBase (hseg : headLink Wp = 24) (hhead : D.headPart = HP)
    (hK : PutKeeps D.put) (hplan : (parOf Wp.hS (workOf Wp)).ok = true)
    (hbase : ∀ (w : Wit (Fin rows → Fin cols → GE) Tok MsgT) (t : Tok),
      D.H.base 24 w → D.H.base 24 ⟨w.cells, t, w.msg, w.pad⟩)
    (hsmp : ∀ (z : P) (x t : S), K7Leaves x t → D.smp (z, t) = D.smp (z, x))
    (hdecT : ∀ c (z : P) (x t : S), K7Leaves x t → D.decT c (z, t) = D.decT c (z, x))
    (row : List (Piece C Fr (P × S) Cl (Wit (Fin rows → Fin cols → GE) Tok MsgT)))
    (hall : ∀ q, row[338]? = some q →
      ∃ (B Bst : Block S Cl) (W : OnBytes.Model.Verify.Public) (l : Nat) (name : String)
        (front : Block S Unit) (tl : HTailF2) (told : List (List Oracle)),
        SeatOf Bst B ∧ q.b = (Sound.below B).lift Prod.snd (fun t x => (t.1, x)) ∧
        K7Rest D.N Wp HID tokH tokOf PS 338 B W l name front tl told ∧
        (∀ x ∈ sampledIn D.N ((openSets linksFull PS (start linksFull))[338]?.getD []),
          x.1 < q.base) ∧
        Wp.hS = W.hS ∧ K7Riders D mgBase c₀ tokOf Rch B q) :
    KindTiedR D.N (mgAll D mgBase) linksFull PS Rch
      (fun i => extQAt D.cs D.G D.arr D.smp D.ms D.decT c₀ tokOf D.N linksFull PS (fun a => a) i)
      row .K7 :=
  k7_kindTied_mgAll D mgBase c₀ tab tokH tokOf s seat pl Rch hseg hhead hK hplan hbase
    (mgAll_more_base D) (fun _ => rfl) (fun _ _ _ _ => rfl) hsmp hdecT row hall

end VerifiableInference.Desc.Kinds.Head.Law
