     ⟨[], 157, 16, 16, 3, 256⟩, ⟨[], 159, 1, 1, 3, 256⟩, ⟨[], 161, 1, 1, 3, 262144⟩
    ] }

/-- **The cheap test accepts the written view.** Lean's kernel evaluates it. -/
theorem padsFull_yes : padsV padsFull = true := by
  decide +kernel

/-- The first pair changed by f. -/
def turnPair (v : PadsView) (f : Option ArrV → Option ArrV) : PadsView :=
  { v with pairs := match v.pairs with
      | [] => []
      | x :: r => (x.1, x.2.1, f x.2.2) :: r }

/-- A negative test: the first rectangle is moved far down and right. -/
theorem padsFull_no_pad :
    padsV (turnPair padsFull fun o => o.map fun A =>
      { A with ends := match A.ends with
          | [] => []
          | _ :: r => (1000000000, 1000000000) :: r }) = false := by
  decide +kernel

/-- A negative test: the array is missing. -/
theorem padsFull_no_array : padsV (turnPair padsFull fun _ => none) = false := by
  decide +kernel

/-- A negative test: no oracle message. -/
theorem padsFull_no_mems : padsV { padsFull with mems := [] } = false := by
  decide +kernel

/-- So the light test accepts at arguments whose view is the written one. -/
theorem padsDoor_of_view (cs : OnBytes.Codes) (layout : OnBytes.Params.ReqLayout)
    (labs : Nat → Nat → Nat) (num arr : Nat → Nat → Nat) (group : Nat → List (Nat × Nat))
    (mems : List (OnBytes.OracleShape × (Nat × Nat))) (iXI : Nat) (nas : Nat → Nat) (NHf : Nat)
    (h : padsViewOf cs layout labs num arr group mems iXI nas NHf = padsFull) :
    padsDoor cs layout labs num arr group mems iXI nas NHf = true := by
  rw [padsDoor_eq, h]
  exact padsFull_yes

end VerifiableInference.Desc.Kinds.Head.Law.OffPad

