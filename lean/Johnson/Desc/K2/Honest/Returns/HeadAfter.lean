/-- **The named premise**: where u stands in the head's segment, the call of `firstBehind` that
"H.1.quiet" makes returns. -/
def BehindReturns (u : S) : Prop :=
  ∀ a, u.here = .head a → ∃ r, firstBehind u.st
    ⟨u.st, a.fr, u.check.frame.atMoment 0,
      ReqFrame.notices (u.check.frame.atMoment 0) ++
        #[foldMaskNotice (u.check.frame.foldShape u.check.frame.link {})], default, 0⟩
    { (default : Switched) with kept := a.kept, others := a.ids } u.out.reply.toList = .ok r

variable {P : VerifierAndGoals.PublicFiles} {pp : Inst.Model.ScalesAndPolicy} {F : FileDescription ProofFile.Inst}
  {Z : ProofFile.Pub} {Bs : ProofFile.PureBase} {base : List (Block S Cl)} {c : Chain S Cl}
  {A : ProofFile.SharedSeat} {B : ProofFile.SecondSeat} {z : ProofFile.InstPub}

/-- **At every state reached at 339 the head's own part's frame is the library's `HeadFr`.** -/
theorem headFr_reached (hS : VerifierAndGoals.InScope P = true) (hR : VerifierAndGoals.readFiles P = .ok pp)
    (O : IM.Open OnBytes.secondHashFunction P.pol P.lay P.KL F Z Bs base c A B) {s : S}
    (hr : Reach 0 (c.blocksInOrder.map below) (ProofFile.startS Z) 339 (z, s)) : Meaning.K2.HeadFr s := by
  obtain ⟨Lk, b, e1, e2, hj, -⟩ := IM.k7_sits hS hR O
  have hf := IM.hear_at_flat e1 e2
  rw [IM.flatIx_scope hS hR O (by omega) 0] at hf
  have hf' : c.blocksInOrder[338]? = some b := hf
  refine of_reach Meaning.K2.HeadFr (fun b' hb' s₀ s' rs gs hy => ?_) s (reach_raw hr)
  obtain rfl : b = b' := Option.some.inj (hf'.symm.trans hb')
  exact Meaning.K2.h1_headFr (IM.k7_sits_yes hS hR O hj hy).1

/-- Where the covered positions can be made their four arrays have the length T. -/
theorem covered_sized {s : S} {T V : Nat} {cov : Head.Covered}
    (h : s.covered T V = .ok cov) : sizedOk cov T = true := by
  unfold S.covered at h
  split at h
  · unfold S.coveredAt at h
    dsimp only at h
    split at h
    · cases h
    · split at h
      · cases h
      · rename_i h2
        split at h
        · cases h
        · split at h
          · cases h
          · have hs : s.req.size = T + 2 := by simpa using h2
            cases h
            rw [sizedOk_iff]
            refine ⟨?_, by simp, by simp, by simp⟩
            simp
            omega
  · cases h

/-- `S.openHead?` returns in the head's segment, not opened, without a mark. -/
theorem openHead_returns {s : S} {a : HeadOwn} (hh : s.here = .head a) (ho : a.opened = false)
    (hu : s.failed = none) :
    s.openHead? = .ok { s with
      here := .head { a with opened := true, L := { a.L with check := s.check } } } := by
  have e : s.openHead = { s with
      here := .head { a with opened := true, L := { a.L with check := s.check } } } := by
    unfold S.openHead
    rw [hh]
    simp [ho]
  unfold S.openHead?
  rw [e]
  exact (S.unmarked_ok _ _).2 ⟨rfl, hu⟩

/-- **At a reached state without a mark the test on the request's words says yes, at the lot's own
T and V.** -/
theorem reqOk_at_reached (hS : VerifierAndGoals.InScope P = true) (hR : VerifierAndGoals.readFiles P = .ok pp)
    (O : IM.Open OnBytes.secondHashFunction P.pol P.lay P.KL F Z Bs base c A B) (hpl : F.planOk = true)
    {k : Nat} {s : S}
    (hr : Reach 0 (c.blocksInOrder.map below) (ProofFile.startS Z) k (z, s)) (hu : s.failed = none) :
    s.reqOk Bs.G₀.W.hS.T Bs.G₀.W.hS.V = true := by
  have h0 := Meaning.K2.reqOk_of_noMark hS hR O (reach_raw hr) hu
  have hq := Meaning.K2.req_at_open O (P1K2.flat_planOk O hpl) 0 k (z, s) (reach_raw hr) hu
  have hT : Z.p.X.T = Bs.G₀.W.hS.T := by
    rw [← O.W]
    exact Fo.Pub.public_T O.public
  have hV : Z.p.X.P.h.V = Bs.G₀.W.hS.V := by
    rw [← O.W, Meaning.HeadS.headShape_of_public O.public]
    rfl
  rw [hT, hV] at h0
  rw [← h0]
  exact reqOk_of_req hq _ _

/-- **"H.1.quiet" and the guards return, under the named premise.** -/
theorem head_leave_returns (hS : VerifierAndGoals.InScope P = true) (hR : VerifierAndGoals.readFiles P = .ok pp)
    (O : IM.Open OnBytes.secondHashFunction P.pol P.lay P.KL F Z Bs base c A B)
    (hF : ProofFile.onlineDescription OnBytes.secondHashFunction P.pol P.lay P.KL = .ok F) (hpl : F.planOk = true)
    {HP : HeadPar} (hHP : pureLetters Bs.G₀ 24 = some HP) {Pp : Prep} {n : Nums}
    (hP : prepOf Z Bs.G₀ = some Pp) (hn : numsAt Pp (some 24) = some n) {s : S}
    (hr : Reach 0 (c.blocksInOrder.map below) (ProofFile.startS Z) 339 (z, s)) {p : P2}
    (hp : p.stands = .head) {rs : List Fmt.RoundView} {gs : List (List (Nat × List UInt64))} {u : S}
    (hy : decideWith sendByL8 p s rs gs = .ok u) (hb : BehindReturns u) :
    ∃ t, (headOpenQ HP u).bind (guards s) = .ok t := by
  obtain ⟨r₁, r₂, a, G, w, roots, -, k⟩ := head_inv hp hy
  have hh : u.here = .head { a with kept := w.out.kept, ids := w.out.others } := by rw [k.hOut]
  have ec : u.check = s.check := by rw [k.hOut]
  have eo : u.out = s.out := by rw [k.hOut]
  have eq : u.req = s.req := by rw [k.hOut]
  have ef : u.failed = s.failed := by rw [k.hOut]
  have hu : s.failed = none := P1K2.noMark_switch hS hR O (Or.inr (Or.inl rfl)) hr
  obtain ⟨⟨st, f, mine⟩, hfb⟩ := hb _ hh
  -- not opened yet
  obtain ⟨a₀, ha₀, hop, -, -⟩ := unheard_reached hS hR O s (reach_raw hr)
  have ea : a₀ = a := by
    rw [k.hHere] at ha₀
    injection ha₀ with e'
    exact e'.symm
  rw [ea] at hop
  -- the heard reply
  obtain ⟨y, hy1, hy2⟩ := IM.heardToken_below hS hR O (le_refl 339) hr
  have hy1' : u.out.reply = some y := by
    rw [eo]
    exact hy1
  rw [← O.W] at hy2
  -- the lot's letters
  obtain ⟨X, hX, eHP⟩ := Option.map_eq_some_iff.1 hHP
  have e1 : HP.l = 24 := by rw [← eHP]
  have e2 : HP.V = Bs.G₀.W.hS.V := by rw [← eHP]
  have e3 : HP.T = Bs.G₀.W.hS.T := by rw [← eHP]
  have e4 : HP.X.kind = X.kind := by rw [← eHP]
  obtain ⟨X', hX', hk2, -⟩ := (IM.ground_named hS hR O.pub O.blank).2
  obtain rfl : X = X' := Option.some.inj (hX.symm.trans hX')
  -- the frame behind
  have hpl1 : f.plain = [y] := by
    rw [firstBehind_plain hfb, hy1']
    rfl
  obtain ⟨_, bq⟩ := (firstBehind_iff _ _ _ _ _ _ _).1 hfb
  have hl : f.link = 24 := by
    rw [bq.frame]
    show a.fr.link = 24
    obtain ⟨a₁, ha₁, -, -, hl₁⟩ := headFr_reached hS hR O hr
    have ea₁ : a₁ = a := by
      rw [k.hHere] at ha₁
      injection ha₁ with e'
      exact e'.symm
    rw [← ea₁, hl₁]
    exact (P1K2.sw_head hS hR O hF hpl default "" hP hn hr).1.link
  have hfr : front HP.X HP.l (firstKept u.check f mine) u.out =
      .ok ({ check := firstKept u.check f mine, link := HP.l, arrayOf := HP.X.arrayOf
             list := HP.X.Tp }, u.out) := by
    unfold front firstKept
    simp [hpl1, e4, hk2, hl, e1]
  -- the covered positions
  have hts : VerifiableInference.Desc.Kinds.Head.Law.TokSmall Bs.G₀.W.hS.V u := by
    have h0 := IM.tokSmallAt_below hS hR O (le_refl 339) hr
    rw [← O.W] at h0
    exact tokSmall_rides _ h0 (by rw [eo])
  have hVs : Bs.G₀.W.hS.V ≤ OnBytes.pW.toNat := by
    rw [O.W]
    exact IM.vocab_small hS hR O
  have htk : u.replyTok? = some (OnBytes.Desc.Reply.tokOf y) := by
    rw [replyTok_is _ hVs u hts]
    show u.out.reply.map OnBytes.Desc.Reply.tokOf = _
    rw [hy1']
    rfl
  have hrq : u.reqOk Bs.G₀.W.hS.T Bs.G₀.W.hS.V = true := by
    rw [reqOk_of_req eq]
    exact reqOk_at_reached hS hR O hpl hr hu
  obtain ⟨cov, hcov⟩ := covered_answers _ _ u _ htk (replyTok_lt _ u hts _ htk) hrq
  have htok : y.c1 = 0 ∧ y.c2 = 0 ∧ y.c0.toNat < Bs.G₀.W.hS.V := by
    unfold OnBytes.Desc.Reply.isToken at hy2
    simpa [and_assoc] using hy2
  have hop' := openHead_returns hh hop (ef.trans hu)
  have hcov' : u.covered HP.T HP.V = .ok cov := by
    rw [e3, e2]
    exact hcov
  have hq := (headOpenQ_iff HP u _).2 ⟨_, st, f, mine, _, u.out, y, cov, _, _,
    { here := hh, fresh := hop, later := by rw [e1]; omega, behind := hfb, front := hfr
      seat := hy1', token := by rw [e2]; exact htok, covered := hcov'
      sized := covered_sized hcov', opens := hop', opened := rfl, out' := rfl }⟩
  refine ⟨_, (VerifiableInference.Desc.Except.bind_eq_ok _ _ _).2 ⟨_, hq,
    (guards_iff _ _ _).2 ⟨rfl, ?_, ?_⟩⟩⟩
  · show u.failed = none
    exact ef.trans hu
  · show (s.out.reply == u.out.reply) = true
    rw [eo]
    exact beq_self_eq_true _

/-- **So at a reached state the seated decision says yes wherever the kind's own does and the named
premise holds**: at the letters of `head_seat_decides`, with its clauses beside. -/
theorem head_seat_reached (hS : VerifierAndGoals.InScope P = true) (hR : VerifierAndGoals.readFiles P = .ok pp)
    (O : IM.Open OnBytes.secondHashFunction P.pol P.lay P.KL F Z Bs base c A B)
    (hF : ProofFile.onlineDescription OnBytes.secondHashFunction P.pol P.lay P.KL = .ok F) (hpl : F.planOk = true)
    (hcut : cutOf c.blocksInOrder = cutFirstFull) :
    ∃ (b : Block S Cl) (nm : String) (HP : HeadPar) (Pp : Prep) (n : Nums),
      c.blocksInOrder[339]? = some b ∧ pureLetters Bs.G₀ 24 = some HP ∧
      prepOf Z Bs.G₀ = some Pp ∧ numsAt Pp (some 24) = some n ∧
      (∀ (s t : S) (rs : List Fmt.RoundView) (gs : List (List (Nat × List UInt64))), rs.length = 2 →
        gs.length = n.read.length →
        (b.decide s rs gs = .ok t ↔ ∃ u,
          decideWith sendByL8 (k2P Z headPlaceAt nm .head n) s rs gs = .ok u ∧
            (headOpenQ HP u).bind (guards s) = .ok t)) ∧
      ∀ (z : ProofFile.InstPub) (s : S), Reach 0 (c.blocksInOrder.map below) (ProofFile.startS Z) 339 (z, s) →
        ∀ (rs : List Fmt.RoundView) (gs : List (List (Nat × List UInt64))) (u : S), rs.length = 2 →
          gs.length = n.read.length →
          decideWith sendByL8 (k2P Z headPlaceAt nm .head n) s rs gs = .ok u →
          BehindReturns u → ∃ t, b.decide s rs gs = .ok t := by
  obtain ⟨b, nm, HP, Pp, n, hb, hHP, hP, hn, hd⟩ := head_seat_decides hS hR O hpl hcut
  refine ⟨b, nm, HP, Pp, n, hb, hHP, hP, hn, hd, fun z s hr rs gs u h2 hg hy hB => ?_⟩
  obtain ⟨t, ht⟩ := head_leave_returns hS hR O hF hpl hHP hP hn hr rfl hy hB
  exact ⟨t, (hd s t rs gs h2 hg).2 ⟨u, hy, ht⟩⟩

end VerifiableInference.Desc.K2.Honest.Returns

