/-- AT THE EMPTY RECORD THE FOUR PREMISES HOLD FOR NOTHING: each ranges over an empty list. The
Script is then K1's lots alone, which no run has. -/
theorem four_at_empty {Bk : ProverCoinCounts} {Wl : Type} (Zp : ProofFile.Pub) (tl : Nat → TreeLot Bk Wl) :
    MsgsAgree (⟨[], [], tl, []⟩ : Others Bk Wl).ml ∧
    (∀ L' ∈ (⟨[], [], tl, []⟩ : Others Bk Wl).ml, ∃ (j t : ℕ) (q : PSeat),
      ((P5J.At.pseatsAll Zp).find? fun p => p.j == j && p.t == t) = some q ∧
        L'.n = P5J.At.arr Zp j t ∧ (∀ l' k', q.role ≠ .kept l' k') ∧ q.send ≠ 0 ∧
        (∀ l, l < 25 → ∀ d, q.send ≠ 3 * l + momL d) ∧ q.send ≠ 81) ∧
    PadsAgree (⟨[], [], tl, []⟩ : Others Bk Wl).pl ∧
    ∀ L' ∈ (⟨[], [], tl, []⟩ : Others Bk Wl).pl, ∃ q ∈ P5J.At.pseatsAll Zp, L'.j = q.j ∧
      L'.t = q.t ∧ q.send ≠ 0 ∧ (∀ l, l < 25 → ∀ d, q.send ≠ 3 * l + momL d) ∧ q.send ≠ 81 :=
  ⟨fun _ hL => absurd hL List.not_mem_nil, fun _ hL => absurd hL List.not_mem_nil,
    fun _ hL => absurd hL List.not_mem_nil, fun _ hL => absurd hL List.not_mem_nil⟩

