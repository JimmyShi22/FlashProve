/-- «Under the head, at the prover that onlineProverFromPublicFiles returns, two premises on K1's lots, and four on the
other senders' record (their lots agree among themselves, and stand apart from K1's sendings). At an
empty record the four hold for nothing, and the Script is then K1's lots alone, which no run has.»
**(J1) NUMBER 2: ALL TWENTY FIELDS.** THE FOUR, ON THE LETTER Oth: hm (MsgsAgree Oth.ml), hfm (each
lot of Oth.ml far from K1's sendings, at no kept copy's seat), hp (PadsAgree Oth.pl), hfp (each lot
of Oth.pl far). The two on K1's lots: hexK, hoK. -/
theorem k1Seated_two_at_join
    (hexK : ∃ M ∈ P.lots,
      M.halves A.Z A.G = lotHalves wit (lotNo OnBytes.secondHashFunction A.Z) Dt A.Z A.G)
    (hoK : ∀ M ∈ P.lots, (∀ x ∈ M.halves A.Z A.G, x.place.kind = .K1 → x.place.link = none) ∨
      M.halves A.Z A.G = lotHalves wit (lotNo OnBytes.secondHashFunction A.Z) Dt A.Z A.G) :
    ∃ blk, K1Seated (lettersHead h A.H
      (joinQ cF.blocksInOrder 0 cells tok (P5J.At.arr Zp) wit own₀ (k1MembersW J₂ Jl Jw) Oth)
      test carryX item n₁ n₂ b₀ Vd Rd Kp w)
      2 blk wit J₂ own₀ .opening (P5J.At.arr Zp) (P5J.At.seats Zp) (P5J.At.ms Zp Z.lay)
      (K1.radRec 0 J₂.P) := by
  obtain ⟨eZ, eG, -⟩ := atPure_at_laid_ground h.laid O.blank hA
  have hP₂ : J₂.P = K1.firstPar Bs.G₀.first (K1.gpOf Zp) := by rw [hJ₂]; rfl
  have hPl : ∀ l, l < 25 → ∀ d, (Jl l d).P = K1.parL Zp Bs.G₀ l d := fun l _ d => by
    rw [hJl]; exact later_plan_head Zp Bs.G₀ l d _ _
  have hPw : Jw.P = K1.parW Zp.first (wGp Zp) 4 wMsgFull := by rw [hJw]; rfl
  have aM : MsgsAgree (joinMl cF.blocksInOrder 0 (P5J.At.arr Zp) wit own₀ (k1MembersW J₂ Jl Jw) Oth) :=
    k1_msgsAgree_with (Bk := A.B) h O hP₂ hPl hPw 0 wit own₀ hm hfm
  have aP : PadsAgree (joinPl cF.blocksInOrder (k1MembersW J₂ Jl Jw) Oth) :=
    k1_padsAgree_with (Bk := A.B) h O hP₂ hPl hPw hp hfp
  have hx : ((2, J₂) : Nat × SendJob (PlaceIn ProofFile.Inst) X) ∈ k1MembersW J₂ Jl Jw :=
    mem_k1MembersW.2 (Or.inl (mem_k1Members.2 (Or.inl rfl)))
  exact (join_tie_k1_of aM aP cells tok _ hx).elim fun tM tP =>
    k1Seated_two_at_book h hA wit Dt hexK hoK _ test carryX item n₁ n₂ b₀ Vd Rd Kp w own₀ rfl
      (by rw [hJ₂, eZ, eG]) tM tP

/-- «Under the head, at the prover that onlineProverFromPublicFiles returns, two premises on K1's lots, and four on the
other senders' record (their lots agree among themselves, and stand apart from K1's sendings). At an
empty record the four hold for nothing, and the Script is then K1's lots alone, which no run has.»
**(J2) EACH OF THE FIFTY: ALL TWENTY FIELDS.** THE FOUR, ON THE LETTER Oth: hm (MsgsAgree Oth.ml),
hfm (each lot of Oth.ml far from K1's sendings, at no kept copy's seat), hp (PadsAgree Oth.pl), hfp
(each lot of Oth.pl far). The two on K1's lots: hexK, hoK. -/
theorem k1Seated_fifty_at_join
    (hexK : ∃ M ∈ P.lots,
      M.halves A.Z A.G = lotHalves wit (lotNo OnBytes.secondHashFunction A.Z) Dt A.Z A.G)
    (hoK : ∀ M ∈ P.lots, (∀ x ∈ M.halves A.Z A.G, x.place.kind = .K1 → x.place.link = none) ∨
      M.halves A.Z A.G = lotHalves wit (lotNo OnBytes.secondHashFunction A.Z) Dt A.Z A.G)
    {l : ℕ} (hl : l < 25) (d : Bool) :
    ∃ blk, K1Seated (lettersHead h A.H
      (joinQ cF.blocksInOrder 0 cells tok (P5J.At.arr Zp) wit own₀ (k1MembersW J₂ Jl Jw) Oth)
      test carryX item n₁ n₂ b₀ Vd Rd Kp w)
      (K1.noL l d) blk wit (Jl l d) own₀ (cond d (.digits l) (.reads l)) (P5J.At.arr Zp)
      (P5J.At.seats Zp) (P5J.At.ms Zp Z.lay)
      (K1.radRec (3 * l + (if d then 2 else 1)) (Jl l d).P) := by
  obtain ⟨eZ, eG, -⟩ := atPure_at_laid_ground h.laid O.blank hA
  have hP₂ : J₂.P = K1.firstPar Bs.G₀.first (K1.gpOf Zp) := by rw [hJ₂]; rfl
  have hPl : ∀ l, l < 25 → ∀ d, (Jl l d).P = K1.parL Zp Bs.G₀ l d := fun l _ d => by
    rw [hJl]; exact later_plan_head Zp Bs.G₀ l d _ _
  have hPw : Jw.P = K1.parW Zp.first (wGp Zp) 4 wMsgFull := by rw [hJw]; rfl
  have aM : MsgsAgree (joinMl cF.blocksInOrder 0 (P5J.At.arr Zp) wit own₀ (k1MembersW J₂ Jl Jw) Oth) :=
    k1_msgsAgree_with (Bk := A.B) h O hP₂ hPl hPw 0 wit own₀ hm hfm
  have aP : PadsAgree (joinPl cF.blocksInOrder (k1MembersW J₂ Jl Jw) Oth) :=
    k1_padsAgree_with (Bk := A.B) h O hP₂ hPl hPw hp hfp
  have hx : ((K1.noL l d, Jl l d) : Nat × SendJob (PlaceIn ProofFile.Inst) X) ∈ k1MembersW J₂ Jl Jw :=
    mem_k1MembersW.2 (Or.inl (mem_k1Members.2 (Or.inr ⟨l, hl, d, rfl⟩)))
  exact (join_tie_k1_of aM aP cells tok _ hx).elim fun tM tP =>
    k1Seated_fifty_at_book h hA wit Dt hexK hoK _ test carryX item n₁ n₂ b₀ Vd Rd Kp w own₀
      rfl hl d (by rw [hJl, eZ, eG]) tM tP

/-- «Under the head, at the prover that onlineProverFromPublicFiles returns, two premises on K1's lots, and four on the
other senders' record (their lots agree among themselves, and stand apart from K1's sendings). At an
empty record the four hold for nothing, and the Script is then K1's lots alone, which no run has.»
**(J3) NUMBER 356, W's SENDING: ALL TWENTY FIELDS.** THE FOUR, ON THE LETTER Oth: hm (MsgsAgree
Oth.ml), hfm (each lot of Oth.ml far from K1's sendings, at no kept copy's seat), hp (PadsAgree
Oth.pl), hfp (each lot of Oth.pl far). The two on K1's lots are here on W's list: hexW, hoW. hexW IS
MET AT NO FILLING OF TODAY: SO THERE THIS LAW HOLDS OF NOTHING. -/
theorem k1Seated_w_at_join (no : Place → Nat)
    (hexW : ∃ M ∈ P.lots, M.halves A.Z A.G = wHalves wit no Dd A.Z A.G)
    (hoW : ∀ M ∈ P.lots, (∀ g ∈ M.halves A.Z A.G, g.place ≠ ⟨1, none, 4, .K1⟩) ∨
      M.halves A.Z A.G = wHalves wit no Dd A.Z A.G) :
    ∃ blk, K1Seated (lettersHead h A.H
      (joinQ cF.blocksInOrder 0 cells tok (P5J.At.arr Zp) wit own₀ (k1MembersW J₂ Jl Jw) Oth)
      test carryX item n₁ n₂ b₀ Vd Rd Kp w)
      356 blk wit Jw own₀ .w (P5J.At.arr Zp) (P5J.At.seats Zp) (P5J.At.ms Zp Z.lay)
      (K1.radRec 81 Jw.P) := by
  obtain ⟨eZ, eG, -⟩ := atPure_at_laid_ground h.laid O.blank hA
  have hP₂ : J₂.P = K1.firstPar Bs.G₀.first (K1.gpOf Zp) := by rw [hJ₂]; rfl
  have hPl : ∀ l, l < 25 → ∀ d, (Jl l d).P = K1.parL Zp Bs.G₀ l d := fun l _ d => by
    rw [hJl]; exact later_plan_head Zp Bs.G₀ l d _ _
  have hPw : Jw.P = K1.parW Zp.first (wGp Zp) 4 wMsgFull := by rw [hJw]; rfl
  have aM : MsgsAgree (joinMl cF.blocksInOrder 0 (P5J.At.arr Zp) wit own₀ (k1MembersW J₂ Jl Jw) Oth) :=
    k1_msgsAgree_with (Bk := A.B) h O hP₂ hPl hPw 0 wit own₀ hm hfm
  have aP : PadsAgree (joinPl cF.blocksInOrder (k1MembersW J₂ Jl Jw) Oth) :=
    k1_padsAgree_with (Bk := A.B) h O hP₂ hPl hPw hp hfp
  have hx : ((356, Jw) : Nat × SendJob (PlaceIn ProofFile.Inst) X) ∈ k1MembersW J₂ Jl Jw :=
    mem_k1MembersW.2 (Or.inr rfl)
  exact (join_tie_k1_of aM aP cells tok _ hx).elim fun tM tP =>
    k1Seated_w_at_book h hA wit no Dd hexW hoW _ test carryX item n₁ n₂ b₀ Vd Rd Kp w own₀ rfl
      (by rw [hJw, eG]) tM tP

end

