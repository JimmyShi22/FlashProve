/-! ## 1 The premises' forms -/

/-- **What is left at one stand of the test on G_u**: THE ONE CLAUSE ON VALUES: the rows that the
test takes in say true things of the words that the job's own rows make (`SaysAt`, AsksWhole.lean),
at the stand's input, the front that the stand has seen, and the coins that the part is handed as
carried. A definition: a premise's form. -/
structure LeftAtStandU (A : ManyJob (Common W₀ Rc TableKey) X₀) (mem : ℕ → Stretch)
    (m : Mid (Common W₀ Rc TableKey) X₀) : Prop where
  rowsSay : SaysAt A m.st.input (restFront A.toRun.toTest m) (carriedCoins A.toRun.toTest mem)

/-- **The list of the test on G_u**: four equations that bind a list of the shared chain: its place,
its parts with their simulators, its condition On and its bound bud: the On and the bud at which
`good_testOnU` (Sim2/SlotU.lean) has `Good`. The list's fields A and B stay free. A definition: a
premise's form. -/
structure IsListAtU {Bk : ProverCoinCounts} (Np : H2U.Places4)
    (L : Lettered Bk St ProofFile.Cl Empty (Common W₀ Rc TableKey) X₀ TableKey)
    (A : ManyJob (Common W₀ Rc TableKey) X₀) (Js : SimJob TableKey) : Prop where
  place : L.place = (fourOf Np).U.place
  row : L.row = testPairs A.toRun.toTest Js
  on : L.On = onFreeT Face.shared A.toRun.toTest Js codesFull2 1 (fourOf Np).U.nums.first
  bud : L.bud = budOpened A.toRun.toTest.p.nums.stages

/-- **`LeftAtStandU` at every stand of one run**: asked at every stand m and all carried blocks ca,
under all that the rule `OnAtRun₂` holds there at the second member (the cut, the side, the
invariant at the border with the play from there, what the stand has seen, that the part was called,
that ca is what the book hands at the run's own coins, that m is the walk's own stand, the front's
equation), and that the member stands there. A definition: a premise's form. -/
def LeftAtEveryStandU {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain S ProofFile.Cl} {Bk : ProverCoinCounts}
    {H : Prover W₀ Rc ProofFile.Inst TableKey Tr X₀ Y}
    {G : Sides (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk W₀ Rc TableKey Tr X₀ Y} {w₀ : W₀} {rc : Rc}
    {x : ProofFile.Inst} {k : Coins Bk} {R : Ready W₀ Rc ProofFile.Inst TableKey Tr X₀ Y}
    (T : ThreadsP (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k R) (ρ : Draws)
    (r : RunC (P5J.F0T OnBytes.secondHashFunction Zp Np cF)) (pl : Place)
    (A : ManyJob (Common W₀ Rc TableKey) X₀) (Js : SimJob TableKey) : Prop :=
  ∀ (m : Mid (Common W₀ Rc TableKey) X₀)
    (ca : CsAll (restMember (V := Empty) A.toRun.toTest Js).part.carries)
    (σ : Side St ProofFile.Cl Empty (Common W₀ Rc TableKey) X₀ TableKey)
    (pre' t' : List (Block St ProofFile.Cl)),
    (P5J.F0T OnBytes.secondHashFunction Zp Np cF).shared.blocksInOrder = pre' ++ σ.block :: t' →
    testSide (P5J.F0T OnBytes.secondHashFunction Zp Np cF).shared.blocksInOrder A.toRun.toTest Js [] = some σ →
    StandsAt (P5J.F0T OnBytes.secondHashFunction Zp Np cF).shared.blocksInOrder R.shared σ
      (restMember A.toRun.toTest Js) pre' t' (firstLen A.toRun.toTest.p.nums.stages) →
    InsideOf .shared Bk 1 (G.prover H).shared σ.block (T.I₂ pre'.length) (σ.roundsTo 1) k m
      (envOf (H.storedWords w₀ rc) (fun _ _ => none)
        (r.run.played.2.1.take ((pre'.flatMap (·.rounds)).length + σ.roundsTo 1))) →
    m.seen = roundsOf (r.run.played.2.1.take ((pre'.flatMap (·.rounds)).length + σ.roundsTo 1)) →
    r.called ⟨pl, 1⟩ = true →
    carriedAt Bk k 1 ⟨pl, 1⟩ (restMember (V := Empty) A.toRun.toTest Js).part = .ok ca →
    midSharedAtW (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k ρ ⟨pl, 1⟩ =
      .ok (some m) →
    (laidOf (P5J.F0T OnBytes.secondHashFunction Zp Np cF) ρ []
        (r.run.played.2.1.take ((pre'.flatMap (·.rounds)).length + σ.roundsTo 1)) []).front 1
        (storedShown (H.storedWords w₀ rc) (storedAsks (P5J.F0T OnBytes.secondHashFunction Zp Np cF) ρ)) =
      r.run.beforeAt (storedShown (H.storedWords w₀ rc) r.run.storedAsked) ⟨pl, 1⟩ →
    LeftAtStandU A (stretches _ ca) m

/-! ## 2 The seat -/

/-- **What `five_at_run` and the laws made of it ask on the place and on the challenges, at a
proximity test of a shared chain**: the stages' form, h + g = k, `FirstTies` at the run's own
challenges of the first part, and these challenges' form. From the place's public facts, the block's
declared rounds, the cut and Draws.due. -/
theorem first_ties_at_shared_test {Xi W X : Type} {F : FileDescription Xi} {ρ : Draws}
    (hpl : F.planOk = true) (hρ : ρ.due F = true) (J : TestJob W X) {ds : List Fmt.Drawn}
    (Fc : PlaceFacts J.p ds) (hfrN : J.fresh.isNone = false)
    (pre t : List (Block F.S₂ F.Cl)) (b : Block F.S₂ F.Cl)
    (hcut : F.shared.blocksInOrder = pre ++ b :: t) (hzip : b.rounds.zip b.oracles = J.laid) :
    ∃ (s next : Fmt.M1.Stage) (rest : List Fmt.M1.Stage),
      FirstTies J s next rest (byNo ((ρ.shared.drop (pre.flatMap (·.rounds)).length).take
          (firstLen J.p.nums.stages)))
        ((ρ.shared.drop (pre.flatMap (·.rounds)).length).take (firstLen J.p.nums.stages)) ∧
      s.k = (H2K.Pub.sgOf s).h + (H2K.Pub.sgOf s).g ∧
      drawsFit (((H2K.JointK.laidOf J.p).take (firstLen J.p.nums.stages)).map (·.1))
        ((ρ.shared.drop (pre.flatMap (·.rounds)).length).take (firstLen J.p.nums.stages)) =
          true := by
  obtain ⟨s, next, rest, hst⟩ : ∃ s next rest, J.p.nums.stages = s :: next :: rest := by
    have hform := Fc.form
    unfold formPubB at hform
    cases hs' : J.p.nums.stages with
    | nil => rw [hs'] at hform; cases hform
    | cons a l =>
      cases l with
      | nil => rw [hs'] at hform; cases hform
      | cons b' r' => exact ⟨a, b', r', rfl⟩
  have FP := formPub_of_B J.p s next rest hst Fc.form
  have hk : s.k = (H2K.Pub.sgOf s).h + (H2K.Pub.sgOf s).g := by
    have := FP.hk
    show s.k = s.h + (s.k - s.h)
    omega
  have hblk : b ∈ F.shared.blocksInOrder := by
    rw [hcut]
    exact List.mem_append_right _ List.mem_cons_self
  have hsh : b.shaped = true := planOk_shaped hpl b hblk
  have hol := shaped_len b hsh
  have hlenb : b.rounds.length = (H2K.JointK.laidOf J.p).length := by
    show _ = J.laid.length
    rw [← hzip, List.length_zip, hol, Nat.min_self]
  have g0 := draws_fit_shared_chain (F := F) hρ pre t b hcut (firstLen J.p.nums.stages)
    (by rw [hlenb]; exact Fc.enough)
  have e1 : ((H2K.JointK.laidOf J.p).take (firstLen J.p.nums.stages)).map (·.1) =
      b.rounds.take (firstLen J.p.nums.stages) := by
    have hz : H2K.JointK.laidOf J.p = b.rounds.zip b.oracles := hzip.symm
    rw [List.map_take, hz, List.map_fst_zip (by rw [hol])]
  have hfit : drawsFit (((H2K.JointK.laidOf J.p).take (firstLen J.p.nums.stages)).map (·.1))
      ((ρ.shared.drop (pre.flatMap (·.rounds)).length).take (firstLen J.p.nums.stages)) = true := by
    rw [e1]
    exact g0
  have hlen : ((ρ.shared.drop (pre.flatMap (·.rounds)).length).take
      (firstLen J.p.nums.stages)).length = firstLen J.p.nums.stages := by
    have hh := ProofFile.Honest.drawsFit_length _ _ hfit
    rw [hh, List.length_map, List.length_take]
    exact Nat.min_eq_left Fc.enough
  exact ⟨s, next, rest,
    ⟨hst, Fc.enough, FP.sorts, by rw [tablesFitB_eq, hfrN]; exact Fc.tab, hlen,
      fun n hn => (List.getD_eq_getElem _ _ hn).symm⟩, hk, hfit⟩

/-- CONDITIONAL: on the head, the eight, Draws.due, ready's return, four public equations on the two
jobs, the side and the test's half. **The seat of the test on G_u at a run**: every cut of the
shared chain at the side's block is the cut at nine; the second member stands there; the block's
declared rounds are the job's; the side's two members; and what `onFreeT_head_U` asks on the place
and on the challenges. -/
theorem seat_at_U {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD} {r₀ : LPFD.Full.RunPF}
    {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain S ProofFile.Cl}
    (h : P5J.AtMg OnBytes.secondHashFunction Z D₀ r₀ Zp Np cF)
    (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8]) {Bk : ProverCoinCounts}
    {P : Prover W₀ Rc ProofFile.Inst TableKey Tr X₀ Y} {w₀ : W₀} {rc : Rc} {x : ProofFile.Inst}
    {k : Coins Bk} {ρ : Draws} {R : Ready W₀ Rc ProofFile.Inst TableKey Tr X₀ Y}
    (hρ : ρ.due (P5J.F0T OnBytes.secondHashFunction Zp Np cF) = true)
    (hR : ready (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk P w₀ rc x k = .ok R)
    (J : TestJob (Common W₀ Rc TableKey) X₀) (Js : SimJob TableKey)
    (hJp : J.p = (fourOf Np).U) (hfr : J.fresh.isNone = false) (hs : Js.p = (fourOf Np).U)
    (ho : Js.own = false) (σ : Side St ProofFile.Cl Empty (Common W₀ Rc TableKey) X₀ TableKey)
    (hσ : testSide (P5J.F0T OnBytes.secondHashFunction Zp Np cF).shared.blocksInOrder J Js [] = some σ)
    (hg : (P.shared.find? fun g => g.place == (fourOf Np).U.place) = some (proverSideOfProximityTest J))
    (pre' t' : List (Block St ProofFile.Cl))
    (hcut : (P5J.F0T OnBytes.secondHashFunction Zp Np cF).shared.blocksInOrder = pre' ++ σ.block :: t') :
    pre' = (P5J.F0T OnBytes.secondHashFunction Zp Np cF).shared.blocksInOrder.take 9 ∧
      StandsAt (P5J.F0T OnBytes.secondHashFunction Zp Np cF).shared.blocksInOrder R.shared σ (restMember J Js) pre' t'
        (firstLen J.p.nums.stages) ∧
      σ.block.rounds.zip σ.block.oracles = J.laid ∧
      σ.members = [firstMember J Js, restMember J Js] ∧
      ∃ (s next : Fmt.M1.Stage) (rest : List Fmt.M1.Stage),
        FirstTies J s next rest (byNo ((ρ.shared.drop (pre'.flatMap (·.rounds)).length).take
            (firstLen J.p.nums.stages)))
          ((ρ.shared.drop (pre'.flatMap (·.rounds)).length).take (firstLen J.p.nums.stages)) ∧
        s.k = (H2K.Pub.sgOf s).h + (H2K.Pub.sgOf s).g ∧
        drawsFit (((H2K.JointK.laidOf J.p).take (firstLen J.p.nums.stages)).map (·.1))
          ((ρ.shared.drop (pre'.flatMap (·.rounds)).length).take (firstLen J.p.nums.stages)) =
            true := by
  have ePl : (fourOf Np).U.place = placeU := p12At_place _ _
  obtain ⟨-, hmem, -⟩ := (first_any_head_U (V := Empty) h J Js hJp hfr hs ho).2.2 [] σ hσ
  obtain ⟨t, Sd⟩ := stands_at_U h b1 b2 b3 b4 b5 b6 b7 b8 hb hR J Js hJp hfr hs ho [] σ hσ
    (by rw [← ePl]; exact hg)
  have hn := (places_nodup
    (((P5J.F0T OnBytes.secondHashFunction Zp Np cF).planOk_ok).1 h.laid.planOk).places).2.1
  obtain ⟨e₁, e₂⟩ := both_of_cut (fun b : Block St ProofFile.Cl => b.place) _ _ _ _ _ _ Sd.cut hcut hn
  subst e₂
  have hlaid := side_laid_U h hσ hJp
  refine ⟨e₁.symm, e₁ ▸ Sd, hlaid, hmem, ?_⟩
  exact first_ties_at_shared_test h.laid.planOk hρ J (hJp ▸ facts_head_U h) hfr pre' t σ.block hcut
    hlaid

/-! ## 3 On at a run -/

/-- CONDITIONAL: see the head. **The clause of the rule at the list of the test on G_u, at a free
prover.** -/
theorem onAtRun_U {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD} {r₀ : LPFD.Full.RunPF}
    {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain S ProofFile.Cl}
    (h : P5J.AtMg OnBytes.secondHashFunction Z D₀ r₀ Zp Np cF)
    (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8]) {Bk : ProverCoinCounts}
    {H : Prover W₀ Rc ProofFile.Inst TableKey Tr X₀ Y}
    {G : Sides (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk W₀ Rc TableKey Tr X₀ Y} {w₀ : W₀} {rc : Rc}
    {x : ProofFile.Inst} {k : Coins Bk} {ρ : Draws} {R : Ready W₀ Rc ProofFile.Inst TableKey Tr X₀ Y}
    {r : RunC (P5J.F0T OnBytes.secondHashFunction Zp Np cF)}
    (T : ThreadsP (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k R)
    (hρ : ρ.due (P5J.F0T OnBytes.secondHashFunction Zp Np cF) = true)
    (hR : ready (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k = .ok R)
    (hrun : runC (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k ρ = .ok r)
    (weights : Common W₀ Rc TableKey → Weights) (rand : Common W₀ Rc TableKey → TableRand)
    (A : ManyJob (Common W₀ Rc TableKey) X₀)
    (hA : A = jobHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] (G.prover H).storedWords weights rand
      none)
    (Js : SimJob TableKey) (hJs : Js = simHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8])
    (L : Lettered Bk St ProofFile.Cl Empty (Common W₀ Rc TableKey) X₀ TableKey)
    (hL : IsListAtU Np L A Js)
    -- on the filling: three halves are what the search finds
    (hg : ((G.prover H).shared.find? fun g => g.place == (fourOf Np).U.place) =
      some (proverSideOfProximityTest A.toRun.toTest))
    (hgU : ((G.prover H).shared.find? fun g => g.place == sendPlace 2) = some ⟨sendPlace 2,
      [(liftSend (askOf ⟨K1.qAt Zp Np, 0⟩ weights rand) (sendingPart (jobU ⟨K1.qAt Zp Np, 0⟩)) :
        Part Empty (Common W₀ Rc TableKey) X₀)]⟩)
    (hgO : ((G.prover H).shared.find? fun g => g.place == sendPlace 5) = some ⟨sendPlace 5,
      [(liftSend (askOf ⟨K1.qAt Zp Np, 0⟩ weights rand)
        (sendingPart (jobOmega ⟨K1.qAt Zp Np, 0⟩)) : Part Empty (Common W₀ Rc TableKey) X₀)]⟩)
    -- on the book: two tests with code
    (hT : tiesB Bk (fourOf Np).U.place A.toRun.toTest.members.length = true)
    (hbk : bookCutsU Bk ⟨K1.qAt Zp Np, 0⟩ (fourOf Np).U = true)
    -- at every stand of the run: the clause on values
    (hleft : LeftAtEveryStandU T ρ r L.place A Js) :
    OnAtRun₂ T ρ r L := by
  intro σ hσ u hu pre' t' hcut m ca hin hseen hca hc hmid hfrt
  have hpl : σ.block.place = L.place := side_place hσ
  have hJ : A.toRun.toTest = (jobHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8]
      (G.prover H).storedWords weights rand none).toRun.toTest := by rw [hA]
  have hJp : A.toRun.toTest.p = (fourOf Np).U := by rw [hA]; rfl
  have hfr : A.toRun.toTest.fresh.isNone = false := by rw [hA]; rfl
  have hs : Js.p = (fourOf Np).U := by rw [hJs]; rfl
  have ho : Js.own = false := by rw [hJs]; rfl
  have hσ' : testSide (P5J.F0T OnBytes.secondHashFunction Zp Np cF).shared.blocksInOrder A.toRun.toTest Js [] =
      some σ := by
    unfold testSide
    rw [hJp, ← hL.place, ← hL.row]
    exact hσ
  obtain ⟨e9, Sd, hlaid, hmem, s, next, rest, Ti, hk, hfit⟩ := seat_at_U h b1 b2 b3 b4 b5 b6 b7 b8
    hb hρ hR _ Js hJp hfr hs ho σ hσ' hg pre' t' hcut
  rw [hL.on, hfrt]
  replace hu : u ∈ [firstMember A.toRun.toTest Js, restMember A.toRun.toTest Js] := by
    rw [← hmem]
    exact hu
  rcases List.mem_cons.1 hu with rfl | hu'
  · intro hn
    cases hn
  obtain rfl := List.mem_singleton.1 hu'
  intro _
  have hg' : ((G.prover H).shared.find? fun g => g.place == σ.block.place) =
      some (proverSideOfProximityTest A.toRun.toTest) := by
    rw [hpl, hL.place]
    exact hg
  have hc' : r.called ⟨σ.block.place, 1⟩ = true := by
    rw [hpl]
    exact hc
  -- the clause trees
  have hTr := trees_head_U_pub h b1 b2 b3 b4 b5 b6 b7 b8 hb weights rand _ hJ Js hR σ pre' t' Sd e9
    hrun hc' hgU hgO hbk
  -- the other seven, down to the sentence on values
  obtain ⟨ca₁, m₁, g₁, g₂, g₃⟩ := onFreeT_head_U h b1 b2 b3 b4 b5 b6 b7 b8 hb weights rand none _
    hJ Js hJs hR σ pre' t' Sd e9 hg' hlaid (by rw [hJp]; exact hT) s next rest _ Ti hk hfit hrun
    hc' (fun m₀ ca₀ hm₀ hca₀ => by
      rw [hpl] at hm₀ hca₀
      have e₁ : ca₀ = ca := Except.ok.inj (hca₀.symm.trans hca)
      have e₂ : m₀ = m := by
        have hmid' : orRefused (midSharedAtW (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀
            rc x k ρ ⟨L.place, 1⟩) = .ok m := hmid
        have hm₀' : midSharedAtW (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k ρ
            ⟨L.place, 1⟩ = .ok (some m₀) := hm₀
        rw [hm₀'] at hmid'
        exact Except.ok.inj (show (Except.ok m₀ : Except Refusal _) = .ok m from hmid')
      subst e₁
      subst e₂
      rw [← hA]
      exact (hleft m₀ ca₀ σ pre' t' hcut hσ' Sd hin hseen hc hca₀ hm₀ hfrt).rowsSay) hTr
  rw [hpl] at g₁ g₂ g₃
  have e₁ : ca₁ = ca := Except.ok.inj (g₁.symm.trans hca)
  have hmid' : orRefused (midSharedAtW (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k ρ
      ⟨L.place, 1⟩) = .ok m := hmid
  have g₂' : midSharedAtW (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k ρ
      ⟨L.place, 1⟩ = .ok (some m₁) := g₂
  rw [g₂'] at hmid'
  have e₂ : m₁ = m := Except.ok.inj (show (Except.ok m₁ : Except Refusal _) = .ok m from hmid')
  subst e₁
  subst e₂
  exact g₃

/-- **Where the fold over the eight blocks in front fails, `LeftAtStandU` holds for nothing**: so
`onAtRun_U` gives On at the fall-back state too, and whoever pays its hleft pays it only where the
fold returns. By `saysAt_fails` (SaysAtFall.lean). -/
theorem leftAtStandU_where_the_fold_fails (Zp : ProofFile.Pub) (Np : H2U.Places4)
    (bs : List (Block St Unit)) (st : W₀ → Rc → ℕ → ℕ → Option (List UInt64))
    (weights : Common W₀ Rc TableKey → Weights) (rand : Common W₀ Rc TableKey → TableRand)
    (mem : ℕ → Stretch) (m : Mid (Common W₀ Rc TableKey) X₀) (e : String)
    (hfail : foldBlocks 0 bs (first (K1.qAt Zp Np).codes m.st.input.key)
      (restFront (jobHeadU (X := X₀) Zp Np bs st weights rand none).toRun.toTest m).seen.rounds
      (colsLoc (K1.qAt Zp Np) (st m.st.input.w₀ m.st.input.rc)
        (restFront (jobHeadU (X := X₀) Zp Np bs st weights rand none).toRun.toTest
          m).seen.rounds) = .error e) :
    LeftAtStandU (jobHeadU (X := X₀) Zp Np bs st weights rand none) mem m :=
  ⟨saysAt_fails _ (K1.qAt Zp Np) (sentOf (K1.qAt Zp Np).S) bs (fun w => w.key)
    (fun w fr => colsLoc (K1.qAt Zp Np) (st w.w₀ w.rc) fr.seen.rounds) rfl _ _ e hfail _⟩

/-! ## 4 At the maker's return -/

/-- CONDITIONAL: on the head and the eight. **The job that `halfU` lays is the head's job**, as a
`ManyJob` (`realU_at_head`, AtProof/HalfAtPure.lean, has it as a `TestJob`). -/
theorem jobRealU_at_head {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD} {r₀ : LPFD.Full.RunPF}
    {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain S ProofFile.Cl}
    (h : P5J.AtMg OnBytes.secondHashFunction Z D₀ r₀ Zp Np cF)
    (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8])
    (wt : W₀ → Weights) (enc : W₀ → IndexCommitterCoins → ℕ → ℕ → Option (List Cb.Gl.F)) :
    jobRealU wt enc Zp = some (jobHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8]
      (fun w rc i y => (enc w rc i y).map (·.map OnBytes.Slice.ofF))
      (fun w => wt w.w₀) (fun w => randAt (K1.qAt Zp Np) w.rc) none) := by
  unfold jobRealU
  rw [(Light.stages_at_head h).1, sendPub_at_head h b1 b2 b3 b4 b5 b6 b7 b8 hb]
  show (Desc.K14.blocks (K1.qAt Zp Np)).map _ = _
  rw [hb]
  rfl

/-- CONDITIONAL: see the head. **The same at the maker's return at the wide filling**: the prover
is the one that the maker returns there; the job is the one that `halfU` lays there. The three
halves and the stored columns are the filling's own. -/
theorem onAtRun_U_at_return {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD} {r₀ : LPFD.Full.RunPF}
    {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain S ProofFile.Cl}
    {x₀ : VerifiableInference.Desc.First.Look.Place}
    (h : P5J.AtMgA OnBytes.secondHashFunction Z D₀ r₀ Zp Np cF x₀)
    (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8])
    (I : WiderIn W₀) (S' : OnBytes.HonestTrace.Sz) (O : OnlineProverArguments)
    {Ar : OnlineProverWithDescription W₀ IndexCommitterCoins Cells Unit Unit}
    (hAr : onlineProverFromPublicFiles OnBytes.secondHashFunction Z.pol Z.lay Z.KL (onlineProverPartsInUse I OnBytes.secondHashFunction S' O) =
      .ok Ar)
    {Bk : ProverCoinCounts} {H : Prover W₀ IndexCommitterCoins ProofFile.Inst TableKey Cells Unit Unit}
    {G : Sides (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk W₀ IndexCommitterCoins TableKey Cells Unit Unit}
    (hP : G.prover H = Ar.H) {w₀ : W₀} {rc : IndexCommitterCoins}
    {x : ProofFile.Inst} {k : Coins Bk} {ρ : Draws}
    {R : Ready W₀ IndexCommitterCoins ProofFile.Inst TableKey Cells Unit Unit}
    {r : RunC (P5J.F0T OnBytes.secondHashFunction Zp Np cF)}
    (T : ThreadsP (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k R)
    (hρ : ρ.due (P5J.F0T OnBytes.secondHashFunction Zp Np cF) = true)
    (hR : ready (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k = .ok R)
    (hrun : runC (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Bk (G.prover H) w₀ rc x k ρ = .ok r)
    (A : ManyJob (Common W₀ IndexCommitterCoins TableKey) Unit)
    (hA : jobRealU (I.weights Zp) (fun w => Bind.ForProver.encW Zp (I.weights Zp w)) Zp = some A)
    (Js : SimJob TableKey) (hJs : Js = simHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8])
    (L : Lettered Bk St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
    (hL : IsListAtU Np L A Js)
    (hT : tiesB Bk (fourOf Np).U.place A.toRun.toTest.members.length = true)
    (hbk : bookCutsU Bk ⟨K1.qAt Zp Np, 0⟩ (fourOf Np).U = true)
    (hleft : LeftAtEveryStandU T ρ r L.place A Js) :
    OnAtRun₂ T ρ r L := by
  have eZ : Ar.Z = Zp := (atPure_at_laid h.laid hAr).1
  have hst : Ar.H.storedWords = fun w rc i y =>
      (Bind.ForProver.encW Zp (I.weights Zp w) rc i y).map (·.map OnBytes.Slice.ofF) := by
    funext w rc' i y
    rw [atPure_storedWords hAr, eZ]
    rfl
  obtain ⟨hgU, hgO⟩ := sendings_found h I OnBytes.secondHashFunction S' O hAr
  have hA' : A = jobHeadU Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] (G.prover H).storedWords
      (fun w => I.weights Zp w.w₀) (fun w => randAt (K1.qAt Zp Np) w.rc) none := by
    have e := jobRealU_at_head h.toAtMg b1 b2 b3 b4 b5 b6 b7 b8 hb (I.weights Zp)
      (fun w => Bind.ForProver.encW Zp (I.weights Zp w))
    rw [hA] at e
    rw [hP, hst]
    exact Option.some.inj e
  have hg : ((G.prover H).shared.find? fun g => g.place == (fourOf Np).U.place) =
      some (proverSideOfProximityTest A.toRun.toTest) := by
    have hU : halfU (I.weights Ar.Z) (fun w => Bind.ForProver.encW Ar.Z (I.weights Ar.Z w)) Ar.Z ≠
        [] := by
      rw [eZ, halfU_at_head h.toAtMg b1 b2 b3 b4 b5 b6 b7 b8 hb]
      exact List.cons_ne_nil _ _
    obtain ⟨M, hM, hf⟩ := shared_test_found_of_laid I OnBytes.secondHashFunction S' O hAr
      (by rw [eZ]; exact K14.sixBody_at_head h _) hU
    rw [eZ, hA] at hM
    obtain rfl := Option.some.inj hM
    have ePl : (fourOf Np).U.place = placeU := p12At_place _ _
    rw [hP, ePl]
    exact hf
  exact onAtRun_U h.toAtMg b1 b2 b3 b4 b5 b6 b7 b8 hb T hρ hR hrun _ _ A hA' Js hJs L hL hg
    (by rw [hP]; exact hgU) (by rw [hP]; exact hgO) hT hbk hleft

