/-- **What is left at one stand**: On's field asks, whole: ShapeAsksO's nine fields and DataAsks' four. -/
structure LeftAtStandO {W₀ : Type} (J : TestJob (Common W₀ IndexCommitterCoins TableKey) Unit) (mem : ℕ → Stretch)
    (m : Mid (Common W₀ IndexCommitterCoins TableKey) Unit) : Prop where
  asks : ∃ (Dp : H2K.First.Plain) (cc : ℕ → ℕ → List UInt64) (Rw : ProofFile.Honest.K12.PlainRows),
    Dp.ts.length = firstListAtOmega.length ∧
    ProofFile.Honest.K12.Own.ShapeAsksO J m.st.input (restFront J m) (carriedCoins J mem) (heardIn J m)
      codesFull Dp ∧
    DataAsks J m.st.input (restFront J m) (carriedCoins J mem) (heardIn J m) Dp cc Rw

/-- **The list**: the four fields of `rowAtOmega J Js` (SimO/SlotO.lean): so that `Good` (`omega_good`),
`BudDebts` and On at a run are said of one object. -/
structure IsListAtO {W₀ : Type} {Bk : ProverCoinCounts}
    (L : Lettered Bk St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
    (J : TestJob (Common W₀ IndexCommitterCoins TableKey) Unit) (Js : SimJob TableKey) : Prop where
  place : L.place = J.p.place
  row : L.row = omegaRow J Js
  on : L.On = OnOmega Face.shared J Js 1 firstListAtOmega
  bud : L.bud = budBoth Js

/-- **hleft**: On's field asks at every called stand of the second part, under all the rule's hypotheses. -/
def LeftEveryStandO {o : ProofFile.SecondHashFunctionArgument} {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain P5J.TS ProofFile.Cl}
    {W₀ Tr Y : Type} {Bk : ProverCoinCounts} {H : Prover W₀ IndexCommitterCoins ProofFile.Inst TableKey Tr Unit Y}
    {G : Sides (P5J.F0T o Zp Np cF) Bk W₀ IndexCommitterCoins TableKey Tr Unit Y} {w₀ : W₀} {rc : IndexCommitterCoins}
    {x : ProofFile.Inst} {k : Coins Bk} {R : Ready W₀ IndexCommitterCoins ProofFile.Inst TableKey Tr Unit Y}
    (T : ThreadsP (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k R) (ρ : Draws)
    (r : RunC (P5J.F0T o Zp Np cF))
    (L : Lettered Bk St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
    (J : TestJob (Common W₀ IndexCommitterCoins TableKey) Unit) : Prop :=
  ∀ (m : Mid (Common W₀ IndexCommitterCoins TableKey) Unit)
      (ca : CsAll (restPart J :
        Part Empty (Common W₀ IndexCommitterCoins TableKey) Unit).needsField.carries)
      (σ : Side St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
      (pre' t' : List (Block St ProofFile.Cl)), L.side (P5J.F0T o Zp Np cF).shared.blocksInOrder = some σ →
      (P5J.F0T o Zp Np cF).shared.blocksInOrder = pre' ++ σ.block :: t' →
      InsideOf .shared Bk 1 (G.prover H).shared σ.block (T.I₂ pre'.length) (σ.roundsTo 1) k m
        (envOf (H.storedWords w₀ rc) (fun _ _ => none)
          (r.run.played.2.1.take ((pre'.flatMap (·.rounds)).length + σ.roundsTo 1))) →
      m.seen = roundsOf (r.run.played.2.1.take ((pre'.flatMap (·.rounds)).length + σ.roundsTo 1)) →
      r.called ⟨L.place, 1⟩ = true →
      carriedAt Bk k 1 ⟨L.place, 1⟩
        (restPart J :
          Part Empty (Common W₀ IndexCommitterCoins TableKey) Unit).needsField = .ok ca →
      midSharedAtW (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k ρ ⟨L.place, 1⟩ = .ok (some m) →
      (laidOf (P5J.F0T o Zp Np cF) ρ []
          (r.run.played.2.1.take ((pre'.flatMap (·.rounds)).length + σ.roundsTo 1)) []).front 1
          (storedShown (H.storedWords w₀ rc) (storedAsks (P5J.F0T o Zp Np cF) ρ)) =
        r.run.beforeAt (storedShown (H.storedWords w₀ rc) r.run.storedAsked) ⟨L.place, 1⟩ →
      LeftAtStandO J (stretches _ ca) m

/-- CONDITIONAL. **THE CLAUSE OF THE RULE AT THE LIST OF THE TEST ON G_omega.** -/
theorem onAtRun_O {o : ProofFile.SecondHashFunctionArgument} {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD}
    {r₀ : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain P5J.TS ProofFile.Cl} {pO : P12}
    (h : P5J.AtMg o Z D₀ r₀ Zp Np cF) (hO : (fourOf Np).O = some pO)
    (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8]) {Bk : ProverCoinCounts}
    (hB : bookWhole (P5J.F0T o Zp Np cF) Johnson.G.proofSendsFull.1 Johnson.G.proofSendsFull.2.1
      Johnson.G.proofSendsFull.2.2 (mergesByName (P5J.F0T o Zp Np cF).first.blocksInOrder) = .ok Bk)
    {W₀ Tr Y : Type} {H : Prover W₀ IndexCommitterCoins ProofFile.Inst TableKey Tr Unit Y}
    {G : Sides (P5J.F0T o Zp Np cF) Bk W₀ IndexCommitterCoins TableKey Tr Unit Y}
    (hα : ∀ x, (G.prover H).key x = x.pub.key) {w₀ : W₀} {rc : IndexCommitterCoins} {x : ProofFile.Inst} {k : Coins Bk}
    {ρ : Draws} {R : Ready W₀ IndexCommitterCoins ProofFile.Inst TableKey Tr Unit Y}
    {r : RunC (P5J.F0T o Zp Np cF)}
    (T : ThreadsP (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k R)
    (hρ : ρ.due (P5J.F0T o Zp Np cF) = true)
    (hR : ready (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k = .ok R)
    (hrun : runC (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k ρ = .ok r)
    (wt : W₀ → Weights)
    (L : Lettered Bk St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
    (hL : IsListAtO L (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO)
      (simulatorJobAtOmega Zp.p.chains (K1.qAt Zp Np) (fourOf Np).U pO
        [b1, b2, b3, b4, b5, b6, b7, b8]))
    (hg : ((G.prover H).shared.find? fun g => g.place == pO.place) =
      some (proverSideOfProximityTest (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO) :
        Placed Empty _ _).needsField)
    (hgO : ((G.prover H).shared.find? fun g => g.place == K14.sendPlace 5) =
      some ⟨K14.sendPlace 5,
      [(K14.liftSend (askOf ⟨K1.qAt Zp Np, 0⟩ (fun w : Common W₀ IndexCommitterCoins TableKey => wt w.w₀)
          (fun w => randAt (K1.qAt Zp Np) w.rc))
          (K14.sendingPart (K14.jobOmega ⟨K1.qAt Zp Np, 0⟩)) :
        Part Empty (Common W₀ IndexCommitterCoins TableKey) Unit)]⟩)
    (hleft : LeftEveryStandO T ρ r L (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO)) :
    OnAtRun₂ T ρ r L := by
  intro (σ : Side St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey) hσ u hu
    (pre : List (Block St ProofFile.Cl)) (t : List (Block St ProofFile.Cl)) hcut m ca hin hs hca hc hmid hfr
  have hpl : σ.block.place = L.place := side_place hσ
  have hσ' : Side.seated (P5J.F0T o Zp Np cF).shared.blocksInOrder pO.place
      (omegaRow (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO)
        (simulatorJobAtOmega Zp.p.chains (K1.qAt Zp Np) (fourOf Np).U pO
          [b1, b2, b3, b4, b5, b6, b7, b8])) [] = some σ := by
    have e := hσ
    unfold Lettered.side at e
    rw [hL.place, hL.row] at e
    exact e
  obtain ⟨hfit, hmem, hrow', hblk, hp, hr, hor⟩ := side_omega h hO _ _ _ none _ rfl rfl [] σ hσ'
  have hpO : σ.block.place = pO.place := hp
  have hLp : L.place = pO.place := hL.place
  have hdue : drawsFit (P5J.F0T o Zp Np cF).roundsDeclaredByBlocks.2.1 ρ.shared = true := (fits_of hρ).2.1
  have hg' : ((G.prover H).shared.find? fun g => g.place == σ.block.place) =
      some (proverSideOfProximityTest (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO) :
        Placed Empty _ _).needsField := by
    rw [hpO]
    exact hg
  rw [hL.on, hfr]
  have hu₁ : u ∈ σ.members := hu
  rw [hmem] at hu₁
  rcases List.mem_cons.1 hu₁ with rfl | hu'
  · have hc' : r.called ⟨σ.block.place, 0⟩ = true := by
      rw [hpl]
      exact hc
    have hpos : ((firstMember (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO)
        (simulatorJobAtOmega Zp.p.chains (K1.qAt Zp Np) (fourOf Np).U pO
          [b1, b2, b3, b4, b5, b6, b7, b8]) : Member Empty _ _ _).guarded).part.moves.length ≠ 0 := by
      show ((firstPart (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO) :
        Part Empty (Common W₀ IndexCommitterCoins TableKey) Unit).moves.map _).length ≠ 0
      rw [List.length_map, first_moves_len]
      obtain ⟨s, next, rest, hlit⟩ :
          ∃ s next rest, H2K.Member.piOFull.nums.stages = s :: next :: rest := ⟨_, _, _, rfl⟩
      have hst : (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO).p.nums.stages =
          s :: next :: rest := by
        show pO.nums.stages = _
        rw [nums_head_O h hO, hlit]
      rw [hst]
      show 2 + s.k ≠ 0
      omega
    obtain ⟨pre₁, t₁, S⟩ := stands_member h.laid.planOk hR σ hblk hfit _
      hu hpos _ hg' (by rw [hrow']; rfl)
    obtain ⟨m₁, hm₁, hall⟩ := onOmega_first_at_run h.laid.planOk hR hrun σ _ pre₁ t₁ _ S hc'
      (show (0 : ℕ) ≠ 1 by omega) Face.shared (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO)
      (simulatorJobAtOmega Zp.p.chains (K1.qAt Zp Np) (fourOf Np).U pO
        [b1, b2, b3, b4, b5, b6, b7, b8]) codesFull 1 firstListAtOmega
    have hmid' : orRefused (midSharedAtW (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k ρ
        ⟨σ.block.place, 0⟩) = .ok m := by
      rw [hpl]
      exact hmid
    have hm₂ : midSharedAtW (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k ρ ⟨σ.block.place, 0⟩ =
        .ok (some m₁) := hm₁
    rw [hm₂] at hmid'
    have e₂ : m₁ = m := Except.ok.inj (show (Except.ok m₁ : Except Refusal _) = .ok m from hmid')
    subst e₂
    exact hall ca _
  · obtain rfl := List.mem_singleton.1 hu'
    have hc' : r.called ⟨σ.block.place, 1⟩ = true := by
      rw [hpl]
      exact hc
    obtain ⟨c, m₁, g1, g2, g3, -, g4⟩ := onOmega_at_side h hO b1 b2 b3 b4 b5 b6 b7 b8 hb hB hα wt hR []
      σ hσ' hrun hc' hg' hgO hdue
    have hmid' : orRefused (midSharedAtW (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k ρ
        ⟨σ.block.place, 1⟩) = .ok m := by
      rw [hpl]
      exact hmid
    rw [g1] at hmid'
    have e₂ : m₁ = m := Except.ok.inj (show (Except.ok m₁ : Except Refusal _) = .ok m from hmid')
    subst e₂
    have hca' : carriedAt Bk k 1 ⟨σ.block.place, 1⟩
        (restPart (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO) :
          Part Empty (Common W₀ IndexCommitterCoins TableKey) Unit).needsField = .ok ca := by
      rw [hpl]
      exact hca
    have e₁ : c.2.1.2.2 = ca := Except.ok.inj (g2.symm.trans hca')
    subst e₁
    have hL' := hleft m₁ c.2.1.2.2 σ pre t hσ hcut hin hs hc
      (by rw [← hpl]; exact g2) (by rw [← hpl]; exact g1) hfr
    have q := g4 hL'.asks
    rw [hpl] at q
    exact q

/-- CONDITIONAL on h, hb and hO. **The row of `lotAtOmega` is the row that this file speaks of.** -/
theorem rowsAtOmega_at_head {o : ProofFile.SecondHashFunctionArgument} {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD}
    {r₀ : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain P5J.TS ProofFile.Cl} {pO : P12}
    (h : P5J.AtMg o Z D₀ r₀ Zp Np cF) (hO : (fourOf Np).O = some pO)
    (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8]) {W₀ : Type}
    (wt : W₀ → Weights) :
    rowsAtOmega wt Zp = [rowAtOmega (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO)
      (simulatorJobAtOmega Zp.p.chains (K1.qAt Zp Np) (fourOf Np).U pO
        [b1, b2, b3, b4, b5, b6, b7, b8])] := by
  unfold rowsAtOmega
  rw [(Light.stages_at_head h).1, sendPub_at_head h b1 b2 b3 b4 b5 b6 b7 b8 hb]
  simp only [Option.bind_some, hO, hb, Option.map_some, Option.toList_some]
  rfl

/-- CONDITIONAL. **`onAtRun_O` AT A ROW OF `lotAtOmega`**: at any row that the lot lays, at any letters A and B
that `Unlettered.lay` sets. The lot is an SLot; the shared chain's sockets take rows, which
`Letters.ofThreads` lays by `Unlettered.lay` (E2E/TheSides.lean:125): so a row is what the spender has. -/
theorem onAtRun_O_at_lot {o : ProofFile.SecondHashFunctionArgument} {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD}
    {r₀ : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain P5J.TS ProofFile.Cl} {pO : P12}
    (h : P5J.AtMg o Z D₀ r₀ Zp Np cF) (hO : (fourOf Np).O = some pO)
    (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8]) {Bk : ProverCoinCounts}
    (hB : bookWhole (P5J.F0T o Zp Np cF) Johnson.G.proofSendsFull.1 Johnson.G.proofSendsFull.2.1
      Johnson.G.proofSendsFull.2.2 (mergesByName (P5J.F0T o Zp Np cF).first.blocksInOrder) = .ok Bk)
    {W₀ Tr Y : Type} {H : Prover W₀ IndexCommitterCoins ProofFile.Inst TableKey Tr Unit Y}
    {G : Sides (P5J.F0T o Zp Np cF) Bk W₀ IndexCommitterCoins TableKey Tr Unit Y}
    (hα : ∀ x, (G.prover H).key x = x.pub.key) {w₀ : W₀} {rc : IndexCommitterCoins} {x : ProofFile.Inst} {k : Coins Bk}
    {ρ : Draws} {R : Ready W₀ IndexCommitterCoins ProofFile.Inst TableKey Tr Unit Y}
    {r : RunC (P5J.F0T o Zp Np cF)}
    (T : ThreadsP (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k R)
    (hρ : ρ.due (P5J.F0T o Zp Np cF) = true)
    (hR : ready (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k = .ok R)
    (hrun : runC (P5J.F0T o Zp Np cF) Bk (G.prover H) w₀ rc x k ρ = .ok r)
    (wt : ProofFile.Pub → W₀ → Weights) (Gr : ProofFile.Ground)
    (row : Unlettered Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
    (hrow : row ∈ (lotAtOmega wt).rows Zp Gr)
    (Tt : Common W₀ IndexCommitterCoins TableKey → Thread Bk St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
    (Sd : Common W₀ IndexCommitterCoins TableKey → ℕ → Coins Bk → Mid (Common W₀ IndexCommitterCoins TableKey) Unit → Prop)
    (bs : List (Block St ProofFile.Cl))
    (hg : ((G.prover H).shared.find? fun g => g.place == pO.place) =
      some (proverSideOfProximityTest (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] (wt Zp) pO) :
        Placed Empty _ _).needsField)
    (hgO : ((G.prover H).shared.find? fun g => g.place == K14.sendPlace 5) =
      some ⟨K14.sendPlace 5,
      [(K14.liftSend (askOf ⟨K1.qAt Zp Np, 0⟩ (fun w : Common W₀ IndexCommitterCoins TableKey => wt Zp w.w₀)
          (fun w => randAt (K1.qAt Zp Np) w.rc))
          (K14.sendingPart (K14.jobOmega ⟨K1.qAt Zp Np, 0⟩)) :
        Part Empty (Common W₀ IndexCommitterCoins TableKey) Unit)]⟩)
    (hleft : LeftEveryStandO T ρ r (row.lay Tt Sd bs)
      (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] (wt Zp) pO)) :
    OnAtRun₂ T ρ r (row.lay Tt Sd bs) := by
  have e := rowsAtOmega_at_head h hO b1 b2 b3 b4 b5 b6 b7 b8 hb (wt Zp)
  have hrow' : row ∈ rowsAtOmega (wt Zp) Zp := hrow
  rw [e] at hrow'
  obtain rfl := List.mem_singleton.1 hrow'
  exact onAtRun_O h hO b1 b2 b3 b4 b5 b6 b7 b8 hb hB hα T hρ hR hrun (wt Zp) _
    ⟨rfl, rfl, rfl, rfl⟩ hg hgO hleft

/-- CONDITIONAL on hpl, hR, hrun, S, hc, hpre, hstart and hi. **AT THE CALLED SECOND PART OF THE TEST ON G_omega
THE DOOR's OWN FOLD RETURNS**, over the eight and the test on G_u, at the rounds and the columns of the
stand's own front, and the door is the way in at that fold's state. Whether that value differs from
`fallOmega` is not said. -/
theorem door_of_called_O {o : ProofFile.SecondHashFunctionArgument} {Zp : ProofFile.Pub} {Np : H2U.Places4}
    {cF : Chain P5J.TS ProofFile.Cl} {W₀ Rc Tr X₀ Y V Pq : Type} {Bk : ProverCoinCounts}
    {P : Prover W₀ Rc ProofFile.Inst TableKey Tr X₀ Y} {w₀ : W₀} {rc : Rc} {x : ProofFile.Inst} {k : Coins Bk}
    {ρ : Draws} {R : Ready W₀ Rc ProofFile.Inst TableKey Tr X₀ Y} {r : RunC (P5J.F0T o Zp Np cF)}
    (hpl : (P5J.F0T o Zp Np cF).planOk = true)
    (hR : ready (P5J.F0T o Zp Np cF) Bk P w₀ rc x k = .ok R)
    (hrun : runC (P5J.F0T o Zp Np cF) Bk P w₀ rc x k ρ = .ok r)
    (σ : Side (P5J.F0T o Zp Np cF).S₂ (P5J.F0T o Zp Np cF).Cl V (Common W₀ Rc TableKey) X₀ Pq)
    (u : Member V (Common W₀ Rc TableKey) X₀ Pq)
    (pre t : List (Block (P5J.F0T o Zp Np cF).S₂ (P5J.F0T o Zp Np cF).Cl)) (i : ℕ)
    (S : StandsAt (P5J.F0T o Zp Np cF).shared.blocksInOrder R.shared σ u pre t i)
    (hc : r.called ⟨σ.block.place, u.number⟩ = true) (c : OnBytes.Model.Verify.Chains)
    (Q : Desc.K14.P14) (sentU : Array OnBytes.OracleNotice) (bs : List (Block St Unit)) (p : P12)
    (hpre : List.Forall₂ Desc.K14.Honest.Like pre (Desc.K14.frontBlock c ::
      (bs ++ [VerifiableInference.Desc.K12.Seat.onGu (VerifiableInference.Desc.K12.proximityTestKind
        VerifiableInference.Desc.K12.guardedProximityTestParts p)])))
    (hstart : (P5J.F0T o Zp Np cF).start₂ ((P5J.F0T o Zp Np cF).pub x) = Desc.K14.first Q.codes (P.key x))
    (J : TestJob (Common W₀ Rc TableKey) X₀) (hi : i = firstLen J.p.nums.stages) :
    ∃ (m : Mid (Common W₀ Rc TableKey) X₀) (s : St),
      midSharedAtW (P5J.F0T o Zp Np cF) Bk P w₀ rc x k ρ ⟨σ.block.place, u.number⟩ = .ok (some m) ∧
      m.st.input = ⟨w₀, rc, P.key x⟩ ∧
      foldBlocks 0 (bs ++ [VerifiableInference.Desc.K12.Seat.onGu (VerifiableInference.Desc.K12.proximityTestKind
          VerifiableInference.Desc.K12.guardedProximityTestParts p)]) (Desc.K14.first Q.codes (P.key x))
        (restFront J m).seen.rounds (colsOpened m.st.input (restFront J m)) = .ok (s, [], []) ∧
      VerifiableInference.Desc.K12.Seat.enter (·.gOmega) (fun _ => none) s =
        .ok (doorOmegaF Q sentU bs p (fun w : Common W₀ Rc TableKey => w.key) colsOpened m.st.input
          (restFront J m)) := by
  obtain ⟨m, s, cols, hm, hin, hl, ho, hf⟩ := fold_at_called hpl hR σ u pre t i S hrun hc
  rw [hi] at hl
  obtain ⟨e1, e2⟩ := rest_front_at J m (pre.flatMap (·.rounds)).length hl
  rw [hstart] at hf
  have gE := Desc.K14.Honest.peel_front c 0 _ _ _ _ _
    (Desc.K14.Honest.fold_like 0 _ _ hpre _ _ _ _ hf)
  have e : colsOpened m.st.input (restFront J m) = cols := by
    show (restFront J m).seen.opened.getD [] = cols
    rw [e2, ho]
    rfl
  refine ⟨m, s, hm, hin, ?_, door_of_opened c Q sentU bs p pre hpre (P.key x) _ cols s hf
    (fun w : Common W₀ Rc TableKey => w.key) m.st.input (restFront J m) (by rw [hin]) e1
    (e2.trans ho)⟩
  rw [e1, e]
  exact gE

/-- CONDITIONAL. **`door_of_called_O` UNDER THE HEAD, AT THE SEATED SIDE, AT THE JOB OF THE LIST**: the way in at
the door's fold's state is the job's state on entry. -/
theorem door_of_called_at_O {o : ProofFile.SecondHashFunctionArgument} {Z : VerifierAndGoals.PublicFiles} {D₀ : OnBytes.Maker.WholeD}
    {r₀ : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4} {cF : Chain P5J.TS ProofFile.Cl} {pO : P12}
    (h : P5J.AtMg o Z D₀ r₀ Zp Np cF) (b1 b2 b3 b4 b5 b6 b7 b8 : Block St Unit)
    (hb : blocks (K1.qAt Zp Np) = some [b1, b2, b3, b4, b5, b6, b7, b8]) {Bk : ProverCoinCounts}
    {W₀ Tr Y : Type} {P : Prover W₀ IndexCommitterCoins ProofFile.Inst TableKey Tr Unit Y}
    (hα : ∀ x, P.key x = x.pub.key) {w₀ : W₀} {rc : IndexCommitterCoins} {x : ProofFile.Inst} {k : Coins Bk} {ρ : Draws}
    {R : Ready W₀ IndexCommitterCoins ProofFile.Inst TableKey Tr Unit Y} {r : RunC (P5J.F0T o Zp Np cF)}
    (wt : W₀ → Weights) (Js : SimJob TableKey)
    (hR : ready (P5J.F0T o Zp Np cF) Bk P w₀ rc x k = .ok R)
    (hrun : runC (P5J.F0T o Zp Np cF) Bk P w₀ rc x k ρ = .ok r)
    (σ : Side St ProofFile.Cl Empty (Common W₀ IndexCommitterCoins TableKey) Unit TableKey)
    (pre t : List (Block St ProofFile.Cl))
    (S : StandsAt (P5J.F0T o Zp Np cF).shared.blocksInOrder R.shared σ
      (restMember (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO) Js :
        Member Empty _ _ _).guarded pre t
      (firstLen (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO).p.nums.stages))
    (h10 : pre = (P5J.F0T o Zp Np cF).shared.blocksInOrder.take 10)
    (hc : r.called ⟨σ.block.place, 1⟩ = true) :
    ∃ (m : Mid (Common W₀ IndexCommitterCoins TableKey) Unit) (s : St),
      midSharedAtW (P5J.F0T o Zp Np cF) Bk P w₀ rc x k ρ ⟨σ.block.place, 1⟩ = .ok (some m) ∧
      m.st.input = ⟨w₀, rc, P.key x⟩ ∧
      foldBlocks 0 ([b1, b2, b3, b4, b5, b6, b7, b8] ++
          [VerifiableInference.Desc.K12.Seat.onGu (VerifiableInference.Desc.K12.proximityTestKind
            VerifiableInference.Desc.K12.guardedProximityTestParts (fourOf Np).U)])
        (Desc.K14.first (K1.qAt Zp Np).codes (P.key x))
        (restFront (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO) m).seen.rounds
        (colsOpened m.st.input
          (restFront (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO) m)) =
        .ok (s, [], []) ∧
      VerifiableInference.Desc.K12.Seat.enter (·.gOmega) (fun _ => none) s =
        .ok ((jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO).rec₀ m.st.input
          (restFront (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO) m)) := by
  obtain ⟨pre₀, tl, e, hl, hLk, -⟩ := flat_ten (Cl := ProofFile.Cl) Zp.p.chains (K1.qAt Zp Np) Np
    b1 b2 b3 b4 b5 b6 b7 b8 hb
  have e' : (P5J.F0T o Zp Np cF).shared.blocksInOrder = pre₀ ++ tl := e
  have hp : pre = pre₀ := h10.trans ((congrArg (List.take 10) e').trans (List.take_left' hl))
  rw [hp] at S
  exact door_of_called_O h.laid.planOk hR hrun σ _ pre₀ t _ S hc Zp.p.chains (K1.qAt Zp Np)
    (sentOf (K1.qAt Zp Np).S) [b1, b2, b3, b4, b5, b6, b7, b8] (fourOf Np).U hLk (by rw [hα x]; rfl)
    (jobOmegaReal Zp Np [b1, b2, b3, b4, b5, b6, b7, b8] wt pO) rfl

end ProofFile.Honest.K12.Sim2

