/-! ## 1 The facts, as one structure -/

/-- The count of free entries of the index masks' ledger as it is made, in the library's term. -/
abbrev indexFree0 (Zp : ProofFile.Pub) (cF : Chain TS ProofFile.Cl) : ℕ :=
  FillP1.free0Of (P5J.At.cs Zp) (msgsOfChain Zp.made.proof.1) (P5J.At.N Zp cF).indexNo

/-- **THE ELEVEN FACTS THAT NAME NO SEGMENT.** s: a state of the verifier's; sh: the listed shape of
the index masks' message. It is a structure of eleven fields: the form of a conclusion; it claims
nothing. -/
structure IndexMaskFacts (Zp : ProofFile.Pub) (cF : Chain TS ProofFile.Cl) (s : TS) (sh : OracleShape) :
    Prop where
  hi : s.out.indexMasks = 4
  h₁ : msgShapesB (msgsOfChain Zp.made.proof.1) s.st = true
  h₂ : bookInOrderB 0 s.book s.roots = true
  h₃ : seatsCarriedB LFull s.book = true
  hs : s.book.place.size = s.st.oracles.size
  hb : placesBelowB LFull s.book.place.size s.book.trees.size = true
  hc : s.st.codes = P5J.At.cs Zp
  hW : LedgersFit s.st
  hsh : (msgsOfChain Zp.made.proof.1)[4]? = some sh
  hq : LFull.places[4]? = some (1, 0)
  hf : indexFree0 Zp cF =
    Send.freeMaskEntries sh.maskRows ((P5J.At.cs Zp).mask.getD sh.maskCode default).ell sh.answers

/-- The number of mask rows of Lot/IndexNum.lean is the shape's. CONDITIONAL on F. -/
theorem indexRows_of_facts {Zp : ProofFile.Pub} {cF : Chain TS ProofFile.Cl} {s : TS} {sh : OracleShape}
    (F : IndexMaskFacts Zp cF s sh) : k4IndexRows Zp = sh.maskRows := by
  unfold k4IndexRows
  rw [F.hsh]
  rfl

/-! ## 2 The state's number of the message -/

section
variable {Xi P Tok : Type} {rows cols nR : ℕ} {X : Verify.Public}
  {Dm : MgData Xi P Tok rows cols nR X}

/-- The closed base, at the witness's type. -/
local notation "Bm" => (mgBase (P := P) (W := Wit (CellsK rows cols) Tok MsgT))

/-- **Where the promise's public test accepts at a border at which pinI is open, the state's number
of the index masks' message is the table's.** CONDITIONAL on hp and hE. -/
theorem indexNo_at_open {b : ℕ}
    (hp : Item.pinI ∈ (openSets linksFull PS (start linksFull))[b]?.getD []) {z : P} {s : S}
    (hE : ePubAt (pubAll Dm.pubD (Bm).pub) moreAll linksFull PS b (z, s) = true) :
    s.out.indexMasks = Dm.N.indexNo := by
  have hq : VerifiableInference.Desc.First.Pub.indexIs ∈
      pubOfItems ((openSets linksFull PS (start linksFull))[b]?.getD []) := by
    unfold pubOfItems
    exact List.mem_flatMap.2 ⟨.pinI, hp, List.Mem.head _⟩
  have q := ePubAt_mem _ _ _ _ _ _ hE VerifiableInference.Desc.First.Pub.indexIs (Or.inr hq)
  rw [pubAll_indexIs] at q
  exact beq_iff_eq.1 q

end

/-! ## 3 Where the thread stands -/

variable {Z : VerifierAndGoals.PublicFiles} {D : WholeD} {r : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4}
  {cF : Chain TS ProofFile.Cl} {xh : VerifiableInference.Desc.First.Look.Place}
  (h : AtMgA OnBytes.secondHashFunction Z D r Zp Np cF xh) {Bk : ProverCoinCounts} {W₀ Rc Ky Tr X₀ X' : Type}
  (H : Prover W₀ Rc ProofFile.Inst Ky Tr X₀ X')
  (Q : Script Bk (Local W₀ Rc ProofFile.Inst Tr) (CellsM OnBytes.Flat.numsFull) P5J.At.Tok MsgT)
  (test : Nat → TS → Option String) (carryX : Nat → ProofFile.InstPub × TS → Strs → WtF → Prop)
  (item n₁ n₂ b₀ : Nat) (Vd : Local W₀ Rc ProofFile.Inst Tr → Prop)
  (Rd : Nat → Local W₀ Rc ProofFile.Inst Tr → TS → Prop) (Kp : Place → TS → TS → Prop)
  (w₁ : Local W₀ Rc ProofFile.Inst Tr)

/-- CONDITIONAL on h, hb, hb', hpin and hT. **THE ELEVEN, WHERE THE THREAD STANDS AT THE BORDER
b.** -/
theorem indexFacts_thr {b : ℕ} (hb : b ≤ cF.blocksInOrder.length) (hb' : b ≤ 358)
    (hpin : Item.pinI ∈ (openSets linksFull PS (start linksFull))[b]?.getD []) {c : Coins Bk}
    {s : TS} {mm : Mid (Local W₀ Rc ProofFile.Inst Tr) X'} {E : Env}
    (hT : Thr (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread b c s mm E) :
    ∃ sh, IndexMaskFacts Zp cF s sh := by
  have hX := IM.xk_parts (xk_of_form (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁)
    (by
      have hT' := hT
      unfold Thr at hT'
      exact hT'.2.2.1))
  have t3 : bookAt (P5J.At.N Zp cF) PS[b]? s = true := hX.2.2.2.1
  have t2 : pubHeld (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).mgP
      ((openSets linksFull PS (start linksFull))[b]?.getD [])
      ((pubSets (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).mgP.more linksFull
        PS)[b]?.getD []) (mm.st.input.x.pub, s) = true := by
    have e := hX.2.2.2.2
    unfold P1K2.EQ at e
    rw [Bool.and_eq_true] at e
    exact e.2
  have hm : s.failed = none := by
    have hT' := hT
    unfold Thr at hT'
    obtain ⟨-, -, hF, -⟩ := hT'
    have e : s.failed.isNone = true := hF.1
    exact Option.isNone_iff_eq_none.mp e
  have e4 : (P5J.At.N Zp cF).indexNo = 4 := h.toAtMg.indexNo_at
  have hi : s.out.indexMasks = 4 :=
    (indexNo_at_open (Dm := h.𝔇) hpin
      (by
        have eM : (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).mgP.more = moreAll :=
          mgAll_more_base h.𝔇
        have hE0 : ePubAt (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).mgP.pub
            (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).mgP.more linksFull PS b
            (mm.st.input.x.pub, s) = true := t2
        rw [eM] at hE0
        exact hE0)).trans e4
  have F := foldFacts_thr h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁
  have f1 := F.msgShapes b (mm.st.input.x.pub, s) ⟨hb, c, mm, E, hT, rfl⟩ hm
  have f2 := F.bookInOrder b (mm.st.input.x.pub, s) ⟨hb, c, mm, E, hT, rfl⟩ hm
  have f3 := F.seatsCarried b (mm.st.input.x.pub, s) ⟨hb, c, mm, E, hT, rfl⟩ hm
  have f4 := F.codes b (mm.st.input.x.pub, s) ⟨hb, c, mm, E, hT, rfl⟩ hm
  have f5 := F.pileWithin b (mm.st.input.x.pub, s) ⟨hb, c, mm, E, hT, rfl⟩ hm
  have f5' : VerifiableInference.Desc.K13.ledgersFitC s = true := by
    have e : (VerifiableInference.Desc.K13.ledgersFitC s &&
      VerifiableInference.Desc.K13.rowsWithinC s) = true := f5
    rw [Bool.and_eq_true] at e
    exact e.1
  unfold bookAt at t3
  simp only [Bool.and_eq_true, beq_iff_eq] at t3
  have hbl : placesBelowB LFull s.book.place.size s.book.trees.size = true := by
    have hc := P5J.counts_at_name h.toAtMg.scope h.toAtMg.laid (k := b) hb'
    have hw := List.all_eq_true.1 below_written _ (List.mem_of_getElem? hc)
    rw [t3.1.1, t3.1.2, t3.2]
    exact hw
  have hF := nextFits_head h LFull 0 (by decide)
  unfold nextFitsB at hF
  split at hF
  · cases hF
  · rename_i sh hsh
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hF
    rw [List.getElem?_take] at hsh
    split at hsh
    · have hsh' : (msgsOfChain Zp.made.proof.1)[(P5J.At.N Zp cF).indexNo]? = some sh := hsh
      rw [e4] at hsh'
      have hq := P5J.seat_at_head h.toAtMg LFull (P5J.laid_at_head h.toAtMg)
      rw [e4, P5J.index_at_head h.toAtMg] at hq
      exact ⟨sh, hi, f1, f2, f3, t3.1.2, hbl, f4, ledgersFit_of_C s f5', hsh', hq, hF.1⟩
    · cases hsh

/-- CONDITIONAL on h, hp, hk, h2, hb and hT. **THE TWELFTH: THE TEST OF THE PUBLIC ITEM "pile.room"
ACCEPTS**, where the place at b has segment m and piece at least 2. -/
theorem indexRoom_thr {b m : ℕ} {pl : Place} (hp : PS[b]? = some pl) (hk : pl.link = some m)
    (h2 : 2 ≤ pl.piece) (hb : b ≤ cF.blocksInOrder.length) {c : Coins Bk} {s : TS}
    {mm : Mid (Local W₀ Rc ProofFile.Inst Tr) X'} {E : Env}
    (hT : Thr (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread b c s mm E) :
    roomIsB (indexFree0 Zp cF) (FillP1.fvsAt Zp) m s = true := by
  have hm : s.failed = none := by
    have hT' := hT
    unfold Thr at hT'
    obtain ⟨-, -, hF, -⟩ := hT'
    have e : s.failed.isNone = true := hF.1
    exact Option.isNone_iff_eq_none.mp e
  exact (foldFacts_thr h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).room b
    (mm.st.input.x.pub, s) pl m ⟨hb, c, mm, E, hT, rfl⟩ hm hp hk h2

/-- CONDITIONAL on every hypothesis named. **AT THE BORDER b: THE ENTRY THAT THE INDEX MASKS' LEDGER
HANDS OUT NEXT, AND THE READER's MASK ENTRY THERE, AT PUBLIC NUMBERS.** z: any public part; w: any
witness. -/
theorem indexEntry_border {b m : ℕ} {pl : Place} (hp : PS[b]? = some pl) (hk : pl.link = some m)
    (h2 : 2 ≤ pl.piece) (hb : b ≤ cF.blocksInOrder.length) (hb' : b ≤ 358)
    (hpin : Item.pinI ∈ (openSets linksFull PS (start linksFull))[b]?.getD []) {c : Coins Bk}
    {s : TS} {mm : Mid (Local W₀ Rc ProofFile.Inst Tr) X'} {E : Env}
    (hT : Thr (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread b c s mm E)
    (z : ProofFile.InstPub) (w : WtF) {l l' : Ledger} {c' : ℕ} (hl : ledgerAt s = some l)
    (ht : takeEntry l = some (c', l')) :
    c' = takenNo (k4IndexRows Zp) (rowsBefore (FillP1.fvsAt Zp) m) ∧
      (h.𝔇.rw13 (z, s) w).mask ⟨s.out.indexMasks, c'⟩ =
        w.msg (k4IndexNum Zp) true (rowsBefore (FillP1.fvsAt Zp) m % k4IndexRows Zp)
          (rowsBefore (FillP1.fvsAt Zp) m / k4IndexRows Zp) := by
  obtain ⟨sh, F⟩ := indexFacts_thr h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ hb hb' hpin hT
  have hR := indexRoom_thr h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ hp hk h2 hb hT
  have R := index_entry_at h.𝔇.arr h.𝔇.mat13 (msgsOfChain Zp.made.proof.1) LFull z s w F.hi F.h₁
    F.h₂ F.h₃ F.hs F.hb F.hc F.hW hR F.hsh F.hq F.hf hl ht
  rw [indexRows_of_facts F, F.hi]
  exact R

/-- CONDITIONAL on every hypothesis named. **AT THE BORDER b THE INDEX MASKS' LEDGER IS THAT OF JUST
SO MANY TAKES AS SEGMENTS IN FRONT OF m LEAVE A ROW.** -/
theorem indexLedger_border {b m : ℕ} {pl : Place} (hp : PS[b]? = some pl) (hk : pl.link = some m)
    (h2 : 2 ≤ pl.piece) (hb : b ≤ cF.blocksInOrder.length) (hb' : b ≤ 358)
    (hpin : Item.pinI ∈ (openSets linksFull PS (start linksFull))[b]?.getD [])
    (hle : rowsBefore (FillP1.fvsAt Zp) m ≤ indexFree0 Zp cF) {c : Coins Bk} {s : TS}
    {mm : Mid (Local W₀ Rc ProofFile.Inst Tr) X'} {E : Env}
    (hT : Thr (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread b c s mm E) :
    LedgerAt s.st 4 (rowsBefore (FillP1.fvsAt Zp) m) := by
  obtain ⟨sh, F⟩ := indexFacts_thr h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ hb hb' hpin hT
  exact ledgerAt_of_room F.hi F.h₁ F.hc F.hW
    (indexRoom_thr h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ hp hk h2 hb hT) F.hsh F.hf hle

