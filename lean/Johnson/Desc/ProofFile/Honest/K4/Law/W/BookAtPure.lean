import Johnson.Desc.ProofFile.Honest.K4.Law.W.LockAtHeadElems
import Johnson.Desc.ProofFile.Honest.K14.AtPureBookAtHead

set_option autoImplicit false
set_option relaxedAutoImplicit false

/- no standing table of scales is in sight: a statement that reads a table says which -/
attribute [-instance] Inst.Model.Scl.ref

namespace ProofFile.Honest.K4.W
open OnBytes.Maker (WholeD)
open OnBytes.Desc.First.K4.Honest
open VerifiableInference.Desc (Chain)
open P5J (AtMgA TS)
open ProofFile.Honest.K4.Lot (k4PubG k4IndexTakes)

variable {Z : VerifierAndGoals.PublicFiles} {D : WholeD} {r : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4}
  {cF : Chain TS ProofFile.Cl} {xh : VerifiableInference.Desc.First.Look.Place}

/-- CONDITIONAL on h and hA. **AT THE BOOK OF WHAT onlineProverFromPublicFiles RETURNS, BY NAME**: at each group g below
12, at the public data that k4PubG returns: A.B lends K4's unseated row (a Bool); its cut at K4's
place is the numbers of moves of K4's seated row; and both names of the lock hold at A.B, the mask
row's at the number of scalars that the lookup's declared rounds count. -/
theorem k4Book_at_atPure (h : AtMgA OnBytes.secondHashFunction Z D r Zp Np cF xh)
    {Wa Rca Tra Xa₀ Xa : Type} {P : OnlineProverParts Wa Rca Tra Xa₀ Xa} {A : OnlineProverWithDescription Wa Rca Tra Xa₀ Xa}
    (hA : onlineProverFromPublicFiles OnBytes.secondHashFunction Z.pol Z.lay Z.KL P = .ok A)
    {W₀ Rc Xi Tr X : Type} (cells : Tr → Cells) (weights : W₀ → Weights)
    (tokens : Xi → Array Nat) (look : List Fmt.Drawn → OnBytes.Model.Forest.Heard) :
    ∀ g : ℕ, g < 12 → ∀ Qp : K4Pub, k4PubG Zp g = some Qp →
      lendsRow A.B 0 (k4Place Qp) (k4RowIn Qp) = true ∧
      A.B.cuts.lookup (k4Place Qp) =
        some ((k4Row (Rc := Rc) (X := X) Qp cells weights tokens look).map (·.moves.length)) ∧
      ∃ row idx,
        ownerOf maskRowRun cF.blocksInOrder Zp.made.proof.1
            ((P5J.F0T OnBytes.secondHashFunction Zp Np cF).second.blocksInOrder.flatMap (·.rounds))
            s!"link {2 * g}, moment 0" isMaskRowMsg = some row ∧
          ownerOf indexMaskRun cF.blocksInOrder Zp.made.proof.1
            ((P5J.F0T OnBytes.secondHashFunction Zp Np cF).second.blocksInOrder.flatMap (·.rounds))
            "link 0, moment 0" isIndexMaskMsg = some idx ∧
          K4MaskLockAt A.B Qp (OnBytes.Model.Forest.elems (P5J.At.X Zp).y.fo) row.owner row.base.e ∧
          K4LastEntryAt A.B Qp idx.owner (idx.base.e + k4IndexTakes Zp g) := by
  have hB := ProofFile.Honest.K14.atPure_book_at_head h hA
  exact fun _ hg _ hP => ⟨k4Lends_at_head_of h hg hP hB,
    k4Cut_at_head_of h hg hP hB cells weights tokens look,
    k4Names_at_head_elems h hg hP hB⟩

end ProofFile.Honest.K4.W

#print axioms ProofFile.Honest.K4.W.k4Book_at_atPure
