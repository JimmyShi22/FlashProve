/-! ## 1 What is open in front of the sub-protocol -/

/-- The table's public items (`Pub` alone would name another type in this namespace). -/
local notation "PubI" => VerifiableInference.Desc.First.Pub

/-- The public items that are open in front, at segment m. -/
def k4OpenQ (m : Nat) : List PubI :=
  [.unheard, .ledger m, .linkFresh m, .freeAbove m, .more (some m) "frame.sentIs",
   .more (some m) "ledger.treesAre", .lookOut m 2, .look m, .left m, .callerIn m,
   .more (some m) "K4.rowsBare", .more (some m) "K4.lookLeft"]

/-- Those that are tied to items open in front. -/
def k4OpenT (m : Nat) : List PubI := [.indexIs, .indexThere, .formsInT m 2 "objects"]

/-- What the promise's table drops there. -/
def k4Drops (m : Nat) : List PubI :=
  [.look m, .left m, .callerIn m, .more (some m) "K4.rowsBare", .more (some m) "K4.lookLeft"]

/-- What it makes there. -/
def k4Makes (m : Nat) : List PubI := [.lookIn m 7, .leftOn m]

/-- A TEST ON THE TABLE, at the full size's written lists and the composed meaning's list of named
extra tests: at every place of the sub-protocol the open public items are oq m, and the three other
lists are as named. -/
def k4OpenFitAt (oq : Nat → List PubI) : Bool :=
  atK4s linksFull PS fun k m =>
    decide ((pubSets moreAll linksFull PS)[k]?.getD [] = oq m) &&
      decide (pubOfItems ((openSets linksFull PS (start linksFull))[k]?.getD []) = k4OpenT m) &&
      (PS[k]?).any fun pl =>
        decide ((pubRowM moreAll linksFull pl).drops = k4Drops m) &&
          decide ((pubRowM moreAll linksFull pl).makes = k4Makes m)

/-- The test at the list `k4OpenQ`. -/
def k4OpenFit : Bool := k4OpenFitAt k4OpenQ

set_option maxRecDepth 1000000 in
/-- BY LEAN's KERNEL: the test accepts. -/
theorem k4_open_full : k4OpenFit = true := by decide +kernel

set_option maxRecDepth 1000000 in
/-- A negative test: short of its last item. -/
theorem k4_open_short : k4OpenFitAt (fun m => (k4OpenQ m).dropLast) = false := by decide +kernel

set_option maxRecDepth 1000000 in
/-- A negative test: with one item more. -/
theorem k4_open_more : k4OpenFitAt (fun m => k4OpenQ m ++ [.hasRow m]) = false := by
  decide +kernel

/-- What the test's yes gives at a place of the sub-protocol: the four lists. -/
theorem open_at {k m : Nat} {pl : Place} (H : AtK4 linksFull PS k m pl) :
    (pubSets moreAll linksFull PS)[k]?.getD [] = k4OpenQ m ∧
      pubOfItems ((openSets linksFull PS (start linksFull))[k]?.getD []) = k4OpenT m ∧
      (pubRowM moreAll linksFull pl).drops = k4Drops m ∧
      (pubRowM moreAll linksFull pl).makes = k4Makes m := by
  have h0 := k4_open_full
  unfold k4OpenFit k4OpenFitAt at h0
  have h := atK4s_at H h0
  rw [H.here] at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, Option.any_some] at h
  exact ⟨h.1.1, h.1.2, h.2.1, h.2.2⟩

/-! ## 2 The public items behind -/

variable {Xi P Tok : Type} {rows cols nR : ℕ} {X : Verify.Public}
  {Dm : MgData Xi P Tok rows cols nR X} {E : WideData P}

/-- The closed base, at the witness's type. -/
local notation "Bm" => (mgBase (P := P) (W := Wit (CellsK rows cols) Tok MsgT))

variable {Mg : Meaning P (Wit (CellsK rows cols) Tok MsgT)} {k m : ℕ} {pl : Place} {par : Par}
  {told : List (List VerifiableInference.Desc.Oracle)} {pol KL : ByteArray}
  {layout : Option ByteArray} {n : ℕ} {l : Link S Claim} {nO nG : String}
  {runO runG : ℕ → S → Except String (List Claim × S)}

/-- **The public items' tests behind.** -/
theorem pub_behind (ePub : Mg.pub = pubAll Dm.pubD (Bm).pub) (eMore : Mg.more = moreAll)
    (hH : isLay Dm.links (headLink X) = false) (H : AtK4 linksFull PS k m pl)
    (Sx : K4OnX X pol KL layout m par) (Sd : K4OnD Dm m par n) (Sn : K4NamedW Dm E k m par told n)
    (hlk : Dm.lk m = some l)
    (st : ∀ u, StatesAt (K9.statesOfLink l) 2 par "front" u ∧
      StatesAt (K9.statesOfLink l) 2 par "back" u)
    (fO : (K9.statesOfLink l 1).find? (fun r => r.1 == "objects") = some (nO, runO))
    (oRun : ObjRun runO)
    (fG : (K9.statesOfLink l 1).find? (fun r => r.1 == "guests") = some (nG, runG))
    (gRun : GuestRun runG) {z : P} {s s' : S} (K : KeptAtS par s s')
    (hs : shapeAt linksFull (some pl) s = true) (hb : bookAt Dm.N PS[k]? s = true)
    (Fc : K4Fence Dm E m s)
    (h : pubHeld Mg ((openSets linksFull PS (start linksFull))[k]?.getD [])
      ((pubSets Mg.more linksFull PS)[k]?.getD []) (z, s) = true) :
    pubHeld Mg (stepOpen ((openSets linksFull PS (start linksFull))[k]?.getD [])
        (rowOf linksFull pl))
      (pubStep ((pubSets Mg.more linksFull PS)[k]?.getD []) (pubRowM Mg.more linksFull pl))
      (z, s') = true := by
  obtain ⟨oQ, oT, oD, oM⟩ := open_at H
  have R := rest_of_kept K
  have Em := k4Means_mgWide Dm E Bm hH (fun _ _ _ _ h => h) fun _ _ _ => rfl
  have hand : ∀ (q : PubI), classA q = false → ∀ a,
      (mgWide Dm E Bm).pub q a = Mg.pub q a := fun q hq a => by
    rw [ePub]
    exact pubWide_hand E.d12 E.dP Dm.pubD (Bm).pub q hq a
  have hE : ePubAt (pubAll Dm.pubD (Bm).pub) moreAll linksFull PS k (z, s) = true := by
    rw [← ePub, ← eMore]
    exact h
  have el : ∀ q ∈ k4Eleven m, Mg.pub q (z, s') = true := by
    rw [ePub]
    exact eleven_at_all hH H Sx Sd Sn hlk st fO oRun fG gRun K hE hs hb Fc
  refine k4_pubHeld_behind Mg H _ _ _ _ h ?_ ?_ ?_
  · intro x hx hd hp
    rw [eMore, oQ] at hx
    rw [eMore, oD] at hd
    simp only [k4OpenQ, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · rw [← hand _ rfl, Em.unheard] at hp ⊢
      rw [unheardB_kept K]
      exact hp
    · exact el _ (by simp [k4Eleven])
    · rw [← hand _ rfl, Em.linkFresh] at hp ⊢
      rw [linkFreshB_kept R]
      exact hp
    · exact el _ (by simp [k4Eleven])
    · rw [← hand _ rfl, Em.sentIs] at hp ⊢
      rw [sentIsB_kept R]
      exact hp
    · exact el _ (by simp [k4Eleven])
    · exact el _ (by simp [k4Eleven])
    · exact absurd (by simp [k4Drops]) hd
    · exact absurd (by simp [k4Drops]) hd
    · exact absurd (by simp [k4Drops]) hd
    · exact absurd (by simp [k4Drops]) hd
    · exact absurd (by simp [k4Drops]) hd
  · intro x hx hp
    rw [oT] at hx
    simp only [k4OpenT, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl
    · rw [← hand _ rfl, Em.indexIs] at hp ⊢
      rw [indexIsC_kept R]
      exact hp
    · rw [← hand _ rfl, Em.indexThere] at hp ⊢
      rw [indexThereC_kept R]
      exact hp
    · exact el _ (by simp [k4Eleven])
  · intro x hx
    rw [eMore, oM] at hx
    refine el x ?_
    simp only [k4Makes, List.cons_append, List.nil_append, List.mem_cons, List.not_mem_nil,
      or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl <;> simp [k4Eleven]

/-- **What the open public items say beside their tests, behind.** E₀: any value serves: it is the
wider meaning's second argument, and that meaning's sentences are the composed meaning's own. -/
theorem pubP_behind (E₀ : WideData P) (ePP : Mg.pubP = (mgAll Dm Bm).pubP)
    (eMore : Mg.more = moreAll)
    (hH : isLay Dm.links (headLink X) = false) (H : AtK4 linksFull PS k m pl)
    (Sx : K4OnX X pol KL layout m par) {z : P} {s s' : S} (K : KeptAtS par s s')
    (h : ∀ x ∈ (pubSets Mg.more linksFull PS)[k]?.getD [], Mg.pubP x (z, s)) :
    ∀ x ∈ pubStep ((pubSets Mg.more linksFull PS)[k]?.getD []) (pubRowM Mg.more linksFull pl),
      Mg.pubP x (z, s') := by
  obtain ⟨oQ, _, oD, oM⟩ := open_at H
  have R := rest_of_kept K
  have Em := k4Means_mgWide Dm E₀ Bm hH (fun _ _ _ _ h => h) fun _ _ _ => rfl
  have eW : (mgWide Dm E₀ Bm).pubP = Mg.pubP := ePP.symm
  refine k4_pubP_behind Mg _ _ _ h ?_ ?_
  · intro x hx hd hp
    rw [eMore, oQ] at hx
    rw [eMore, oD] at hd
    rw [← eW] at hp ⊢
    refine Em.pubPRides x z s s' ?_ ?_ hp
    · intro m' e
      subst e
      have e2 : m' = m := by simpa [k4OpenQ] using hx
      subst e2
      exact hd (by simp [k4Drops])
    · intro m' e
      subst e
      simp [k4OpenQ] at hx
  · intro x hx
    rw [eMore, oM] at hx
    simp only [k4Makes, List.mem_cons, List.not_mem_nil, or_false] at hx
    rw [← eW]
    rcases hx with rfl | rfl
    · exact Em.pubPLookIn m 7 _
    · have hL : Mg.pubP (.left m) (z, s) := h _ (by rw [eMore, oQ]; simp [k4OpenQ])
      rw [← eW, Em.left] at hL
      rw [Em.leftOn]
      exact leftOn_of_item Sx.pubOf Sx.notHead Sx.step Sx.plan hL R.lookHeard
        (leftOn_of_kept K (left_of_item Sx.pubOf Sx.notHead Sx.step Sx.plan hL))

/-! ## 3 The conditions -/

variable {Bk : ProverCoinCounts} {Cl W₀ Rc Xi' Tr X' : Type}

/-- **The conditions at the composed meaning.** -/
theorem k4Conds_all {L : Letters Bk Cl W₀ Rc Xi' Tr X' P (CellsK rows cols) Tok MsgT}
    (hl : L.links = linksFull) (hp : L.ps = PS) (hN : L.N = Dm.N) (hM : L.MgP = mgAll Dm Bm)
    (hH : isLay Dm.links (headLink X) = false) (H : AtK4 linksFull PS k m pl)
    (Sx : K4OnX X pol KL layout m par) (Sd : K4OnD Dm m par n) (Sn : K4NamedW Dm E k m par told n)
    (hlk : Dm.lk m = some l)
    (st : ∀ u, StatesAt (K9.statesOfLink l) 2 par "front" u ∧
      StatesAt (K9.statesOfLink l) 2 par "back" u)
    (fO : (K9.statesOfLink l 1).find? (fun r => r.1 == "objects") = some (nO, runO))
    (oRun : ObjRun runO)
    (fG : (K9.statesOfLink l 1).find? (fun r => r.1 == "guests") = some (nG, runG))
    (gRun : GuestRun runG) : ∃ pl', K4Conds L k m pl pl' par (K4Fence Dm E m) := by
  obtain ⟨pl', next, link', piece'⟩ :=
    VerifiableInference.Desc.First.FillK4.k4NextFit_at k4_next_full H.here H.link H.sub H.piece
  have hn := VerifiableInference.Desc.First.FillK4.k4ToldFit_at Sn.toldFit H.here H.link H.sub
    H.piece
  have hk1 : k + 1 < PS.length := (List.getElem?_eq_some_iff.mp next).1
  have a0 := bookFit_at Dm.N PS told Sn.book k (by omega)
  have a1 := bookFit_at Dm.N PS told Sn.book (k + 1) (by omega)
  have c := told_succ_nil told k hn
  rw [H.here] at a0
  rw [next] at a1
  have ePub : L.mgP.pub = pubAll Dm.pubD (Bm).pub := by
    show L.MgP.pub = _
    rw [hM]
    rfl
  have eMore : L.mgP.more = moreAll := by
    show L.MgP.more = _
    rw [hM]
    exact mgAll_more_base Dm
  have ePP : L.mgP.pubP = (mgAll Dm Bm).pubP := by
    show L.MgP.pubP = _
    rw [hM]
  have bools : ∀ (z : P) s, L.thread.formP k (z, s) → s.failed = none →
      shapeAt linksFull (some pl) s = true ∧ bookAt Dm.N PS[k]? s = true := by
    intro z s hf hu
    have ha : VerifiableInference.Desc.First.onAt L.N L.mgP L.links L.ps[k]?
        ((openSets L.links L.ps (start L.links))[k]?.getD [])
        ((pubSets L.mgP.more L.links L.ps)[k]?.getD []) (z, s)
        ProofFile.Honest.FirstThread.noStrs := hf
    have hB := (ha.2.resolve_left fun h => h hu).1
    simp only [Bool.and_eq_true] at hB
    have b1 := hB.1.1.1.1.1
    have b6 := hB.2
    rw [hl, hp, H.here] at b1
    rw [hN, hp] at b6
    exact ⟨b1, b6⟩
  refine ⟨pl', ?_⟩
  refine
    { at_ := by rw [hl, hp]; exact H
      next := by rw [hp]; exact next
      link' := link'
      piece' := piece'
      trees := by rw [hN, a1.1, a0.1, c.1]
      msgs := by rw [hN, a1.2, a0.2, c.2]
      inOrder := fun z s s' _ h => ?_
      held := fun z s s' t j R h => ?_
      pub := fun z s s' hf hu K Fc h => ?_
      pubP := fun z s s' K h => ?_ }
  · have e : ∀ a : P × S, L.mgP.inOrder a = (mgAll Dm Bm).inOrder a := fun a => by
      show L.MgP.inOrder a = _
      rw [hM]
    rw [e] at h ⊢
    exact h
  · have e : L.mgP.held = fun j t (a : P × S) => smpHeld a.2.st a.2.book j t := by
      show L.MgP.held = _
      rw [hM]
      rfl
    rw [e] at h ⊢
    show smpHeld s'.st s'.book t j = true
    rw [R.st, R.book]
    exact h
  · obtain ⟨b1, b6⟩ := bools z s hf hu
    rw [hl, hp] at h ⊢
    exact pub_behind ePub eMore hH H Sx Sd Sn hlk st fO oRun fG gRun K b1 b6 Fc h
  · rw [hl, hp] at h ⊢
    exact pubP_behind E ePP eMore hH H Sx K h

/-- **The thread's form and promise pass the sub-protocol's accepting decision, at the composed
meaning.** -/
theorem k4Promise_all
    {L : Letters Bk Claim W₀ Rc Xi' Tr X' P (CellsK rows cols) Tok MsgT}
    (hl : L.links = linksFull) (hp : L.ps = PS) (hN : L.N = Dm.N) (hM : L.MgP = mgAll Dm Bm)
    (hH : isLay Dm.links (headLink X) = false) (H : AtK4 linksFull PS k m pl)
    (Sx : K4OnX X pol KL layout m par) (Sd : K4OnD Dm m par n) (Sn : K4NamedW Dm E k m par told n)
    (hlk : Dm.lk m = some l)
    (st : ∀ u, StatesAt (K9.statesOfLink l) 2 par "front" u ∧
      StatesAt (K9.statesOfLink l) 2 par "back" u)
    (fO : (K9.statesOfLink l 1).find? (fun r => r.1 == "objects") = some (nO, runO))
    (oRun : ObjRun runO)
    (fG : (K9.statesOfLink l 1).find? (fun r => r.1 == "guests") = some (nG, runG))
    (gRun : GuestRun runG) : K4Promise L.thread k par (K4Fence Dm E m) := by
  obtain ⟨pl', K⟩ := k4Conds_all hl hp hN hM hH H Sx Sd Sn hlk st fO oRun fG gRun
  exact k4Promise_of K

end ProofFile.Honest.K4



