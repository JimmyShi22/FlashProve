/-- CONDITIONAL: on every hypothesis named; the head lists them. **THE EXCHANGE AT THE MEMBER's OWN
ITEM.** ν, st, R: the parameters of the frame's list `csHead`. xl: the lookup's place
at the segment. -/
theorem k4_exchange_tenth
    (ν : Nat) (st : Nat → TS → Prop) (R : Nat → Option Forest.Heard → Prop)
    (hRdIs : Rd = ridersOf (csHead ν st R))
    (Said : Nat → Coins Bk → Mid (Local W₀ Rc ProofFile.Inst Tr) X' → Prop) {k m g : ℕ}
    {x : Bool × Par} {blk₀ : Block TS ProofFile.Cl} (Lh : LaidK4 Zp cF k m g x blk₀)
    {cells : Tr → Cells} {weights : W₀ → Weights} {tokens : ProofFile.Inst → Array Nat}
    {look : K4Pub → List Fmt.Drawn → Forest.Heard} {Qp : K4Pub}
    (hQ : k4PubOf Zp x.2 = some Qp)
    (half : H.first.find? (fun z => z.place == IM.k4Place g) =
      some (k4Half cells weights tokens look Qp))
    (fits : ∀ fr, drawsFit (declsTo cF.blocksInOrder k) fr = true → Vd w₁ →
      k4Fits Qp (look Qp fr) (tokens w₁.x) = true)
    (hb₀ : b₀ ≠ k + 1) (hKp : ∀ s s', K4KeepsM s s' → Kp (k4PlaceAt g) s s')
    {xl : VerifiableInference.Desc.First.Look.Place} (hx : layAt (P5J.At.X Zp) m = some xl)
    (hMask : ∀ c s mm E,
      ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k c s mm E →
      K4MaskTieAt (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread cells weights
        tokens look Qp (h.𝔇.N.sent m 0) (seatTab h.𝔇.cs h.𝔇.arr h.𝔇.ms) c s mm)
    (hL : ∀ ξ, LookIsK3 look Qp Zp cF g ξ)
    (hA : ∀ c s mm E,
      ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k c s mm E →
      ∀ d, MatsAre xl x.2.hp.tl h.𝔇.sent h.𝔇.l3.rad h.𝔇.l3.oW h.𝔇.l3.wOf h.𝔇.l3.nr h.𝔇.l3.nc
        (layMs xl h.𝔇.sent h.𝔇.l3.rad h.𝔇.l3.oW (fun j => h.𝔇.l3.seat xl.link false j.1)
          h.𝔇.l3.arr h.𝔇.l3.msgW (Q.wit c mm.st.input (mm.st.heard ++ d)))
        ((h.𝔇.H.hid (Q.wit c mm.st.input (mm.st.heard ++ d))).MG g))
    (hc : ∀ c s mm E,
      ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k c s mm E →
      ∀ d, CellIsList Qp (k4Wit Qp cells weights tokens (look Qp) mm.st.input)
        ((h.𝔇.H.hid (Q.wit c mm.st.input (mm.st.heard ++ d))).MG g) x.2.hp.tl)
    (hiW : ∀ c s mm E,
      ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k c s mm E →
      ∃ i : Cm.Idx, Holds (Q.cells mm.st.input) i ∧ (g = 0 →
        embR ppref kRef (wmOf (k4Wit Qp cells weights tokens (look Qp) mm.st.input).w) =
          embR ppref kRef fun a b => ((i.mat a b : ℤ) : Cb.Gl.E)))
    (hTokP : ∀ c s mm E,
      ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k c s mm E →
      g = 0 → TokensArePrompt tokens mm.st.input.x)
    (hJ : K4JoinLeft (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread
      (ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k) k cells weights
      tokens look Qp (fun _ Dt => matsOfData x.2.hp.tl (P5J.At.names3 Zp m) Dt) (h.𝔇.N.sent m 0)
      (seatTab h.𝔇.cs h.𝔇.arr h.𝔇.ms) x.2.hp.tl (parOf x)) :
    ExchangeAtS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k
      (Item.formsT m 3 "own") := by
  have hRd : ∀ v s s', Rd k v s → K4KeepsM s s' → Rd (k + 1) v s' := by
    intro v _ s₂ _ hK
    rw [hRdIs, Lh.num]
    exact rd_csHead ν st R Lh.lt v hK
  have hLook : ∀ c s mm E,
    ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k c s mm E →
    K4LookTieAt look Qp s mm :=
    fun _ _ mm _ hT => lookTie_k3 h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hT.1
      (hL mm.st.input.x)
  have tie : ∀ c s mm E,
    ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k c s mm E →
    K4SymsTieAt Q xl x.2.hp.tl h.𝔇.sent h.𝔇.l3.rad h.𝔇.l3.oW
      (fun j => h.𝔇.l3.seat xl.link false j.1) h.𝔇.l3.arr h.𝔇.l3.msgW (P5J.At.names3 Zp m)
      (h.𝔇.N.sent m 0)
      (seatTab h.𝔇.cs h.𝔇.arr h.𝔇.ms) c s mm :=
    fun _ _ _ _ hT => symsTie_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hT.1 hx
  have hTok : ∀ c s mm E,
    ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k c s mm E →
    g = 0 → ∀ d q, q < 2 ^ DF.lT →
      (k4Wit Qp cells weights tokens (look Qp) mm.st.input).tokv.getD q 0 =
        Cm.Seg.tokX
          (h.𝔇.put (h.𝔇.H.req (mm.st.input.x.pub, s))
            (h.𝔇.H.hid (Q.wit c mm.st.input (mm.st.heard ++ d))).tok).val q :=
    fun c s mm E hT g0 => tok_head h Q c s (hTokP c s mm E hT g0)
  obtain ⟨l, _, _, hl, _⟩ := (nine_head h Lh).runs
  have hSeat := seated_all_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hQ half
    (front_head h Lh hQ) fits
  have hSit := k4Sits_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh
  have hBh := k4_behind_all h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ (atK4_of_laid Lh) hb₀ hKp
    hRd
  have hF := k4Front_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hl
    (At := ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread Said k)
    (M := fun _ Dt => matsOfData x.2.hp.tl (P5J.At.names3 Zp m) Dt) (Hh := holesK4 Zp m l)
    (St := h.𝔇.St) (own := h.𝔇.N.sent m 0) (rdOf := seatTab h.𝔇.cs h.𝔇.arr h.𝔇.ms)
    (tl := x.2.hp.tl)
    (fun blk hb c s mm E ds y cols s' hT hd hS _ =>
      ⟨asks_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hb hT.1 hS,
        ProofFile.Honest.K4.names_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hb hT.1 hS,
        reads_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hb hT.1 hS,
        fun A' o cc h1 h2 h3 h4 =>
          stated_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hb hT.1 hS A' o cc h1 h2 h3
            h4 _ _,
        test_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ hBh Lh hl hb hT.1 hd hS⟩)
  obtain ⟨⟨eP, _, _, _, _⟩, _, _, _⟩ := pub_of Lh hQ
  have eP' : (parOf x).P = Qp.P := eP
  obtain ⟨hws, hd, hfe, hdq, hf, hfef, hNE, hlt⟩ := wsFacts_head h Lh
  rw [eP'] at hws hd hfe hdq hf hfef hNE hlt
  refine k4_exchangeAtS_own_of_join Said
    (k4Table_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hl) hSeat hSit hMask hLook
    (fun c s mm E hT => cellsTie_of_tie h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁
      (tie c s mm E hT) (hA c s mm E hT) (hc c s mm E hT))
    (fun _ _ => rfl) hF (plan_head h Lh) hws hd hfe hdq hf hfef hNE hlt ?_
  intro blk hb c s mm E ds y cols s' hT hdr hS ds' A' hseg o fs₁ F₁ ho hfr
  obtain ⟨_, _, Ak⟩ := asks_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hb hT.1 hS
  have Zs : K4Stand (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁).thread k cells weights
      tokens look Qp (parOf x) blk (h.𝔇.N.sent m 0) (seatTab h.𝔇.cs h.𝔇.arr h.𝔇.ms) c s mm E ds
      y cols s' A' o := ⟨hSeat blk hb, hSit, Ak.sized, hMask c s mm E hT, hS, hseg, ho⟩
  have R := hJ blk hb c s mm E ds y cols s' hT hdr hS ds' A' hseg o fs₁ F₁ ho hfr
  obtain ⟨i, hi', hW⟩ := hiW c s mm E hT
  exact
    { emb := fun hg0 => by
        obtain ⟨eY, eS, eg⟩ := pub_is Lh hQ
        have Fu := fullAt_stand Zs eY eS (lam_head h)
        have g0 : g = 0 := by rw [← eg, ← Fu.grp]; exact hg0
        obtain ⟨ce, cl, un, env, claim, hu, hs⟩ :=
          emb_returns_stand Zs hT.1 (hLook c s mm E hT) (by rw [eg, g0]; rfl)
        exact emb_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hQ Zs hT.1 hi'
          (tie c s mm E hT) (hA c s mm E hT) (hW g0) (hTok c s mm E hT g0) env claim hu hs ds' hg0
      idn := k4_idn_tie h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hQ Zs hT.1 hi'
        (tie c s mm E hT) (hA c s mm E hT) ds'
      hot := k4_hot_tie h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hQ Zs hT.1
        (hLook c s mm E hT) hx (tie c s mm E hT) ds'
      look := look_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hQ Zs hT.1
        (hLook c s mm E hT)
        (nu_thread_head h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w₁ Lh hQ Zs hT.1
          (hLook c s mm E hT) hx ds')
      join := R.join }

