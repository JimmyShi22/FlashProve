   (⟨2, none, 9, .K12⟩, [9, 26]), (⟨2, none, 10, .K12⟩, [6, 18]), (⟨2, none, 11, .frame⟩, [1])]

/-- **The second chain's one cut, written.** -/
def cutsSecondW : List (Place × List Nat) :=
  [(⟨3, none, 2, .K12⟩, [7, 23])]

/-- A public test: the maker's list at the first chain against t. -/
def cutsFirstIs (t : List (Place × List Nat)) : Bool := decide (cutsIn WP.first.blocksInOrder = t)

/-- It accepts the written list. -/
theorem cutsFirst_test : cutsFirstIs cutsFirstW = true := by decide +kernel

/-- **The cuts at the three chains.** -/
theorem cutsIn_written :
    cutsIn WP.first.blocksInOrder = cutsFirstW ∧ cutsIn WP.shared.blocksInOrder = cutsSharedW ∧
      cutsIn WP.second.blocksInOrder = cutsSecondW :=
  ⟨of_decide_eq_true cutsFirst_test, by decide +kernel, by decide +kernel⟩

/-- **THE EQUATION: THE BOOK's FIELD cuts AT THE WRITTEN DESCRIPTION.** -/
theorem cutsOf_written : cutsOf WP = cutsFirstW ++ cutsSharedW ++ cutsSecondW := by
  unfold cutsOf
  rw [cutsIn_written.1, cutsIn_written.2.1, cutsIn_written.2.2]

/-- **THE TEST CAN FAIL**: the last member dropped; the first member's first part longer by one
round; the first two members swapped. -/
theorem cutsFirst_bite :
    cutsFirstIs cutsFirstW.dropLast = false ∧
      cutsFirstIs (((cutsFirstW.headD default).1,
        ((cutsFirstW.headD default).2.headD 0 + 1) :: (cutsFirstW.headD default).2.drop 1) ::
          cutsFirstW.drop 1) = false ∧
      cutsFirstIs ((cutsFirstW.take 2).reverse ++ cutsFirstW.drop 2) = false := by
  decide +kernel

