/-- **The shared chain's nine cuts, written.** -/
def cutsSharedW : List (Place × List Nat) :=
  [(⟨2, none, 1, .K14⟩, [1]), (⟨2, none, 2, .K1⟩, [2]), (⟨2, none, 4, .K14⟩, [1]),
