/-- **The assembly at an attention segment.** -/
theorem givesTotalB_att (hE : K9Asks.RowsAsked Zp) {Bs : ProofFile.PureBase} {base : List (Block S ProofFile.Cl)}
    (O : IM.Open OnBytes.secondHashFunction Z.pol Z.lay Z.KL (P5J.F0T OnBytes.secondHashFunction Zp Np cF) Zp Bs base cF (seatZ Zp Np)
      (secondAt Zp Np)) {g : ℕ} (hg : g < 12) {kk : ℕ} {Lk : Link S ProofFile.Cl} {p : Desc.K9.Where}
    {ww : Desc.K9.SegSort × ℕ × Desc.K9.TWhere} (Sd : SeatedFree cF Zp (2 * g + 1) kk Lk p ww)
    {A : Attention.Plan} (hA : (P5J.At.X Zp).A[g]? = some A) {Xl : LinkH}
    (e3 : Bs.G₀.built[2 * g + 1]? = some Xl) {xx : First.Look.Place} {tlD : HTailF2}
    (hd : First.Look.digAt (P5J.At.X Zp) (2 * g + 1) = some (xx, tlD)) {pC pD : First.Look.P}
    (hC : placeAt (P5J.At.X Zp) (2 * g + 1) false = some pC)
    (hD : placeAt (P5J.At.X Zp) (2 * g + 1) true = some pD) (own : List (ℕ × ℕ))
    (hown : own = (P5J.At.N Zp cF).group (2 * g + 1))
    (rdW : (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread.Wt → ℕ × ℕ → Sound.MsgQ)
    (tst : S → Option String)
    (Front : ℕ × String → S → (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread.Wt → Prop)
    (htst : ∀ e, tst e = none → freeSlotShare ww.2.2.filled e = none ∧ k8Share (ProofFile.k8NU Bs.G₀ Xl) e = none)
    (hback : ∀ o ∈ [(1, "objects"), (2, "join"), (1, "planes"), (6, "objects")], ItemBack Lk p (phiFill tlD)
      (okFillAtt A (ProofFile.k8NU Bs.G₀ Xl) tlD pC pD) (tmFillAtt A pC pD)
      (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread
      (batchAt P5J.At.links P5J.At.ps (2 * g + 1)) own rdW o (Front o))
    (F₁ : S → (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread.Wt → Prop)
    (hFacts : ∀ κ s m En ds y cols s' x' z G,
      BatStand Lk p (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread
      (batchAt P5J.At.links P5J.At.ps (2 * g + 1)) κ s m En ds y cols s' x' z G →
      ∀ a v, Desc.K9.atS.get? s = some a → okFillAtt A (ProofFile.k8NU Bs.G₀ Xl) tlD pC pD (K9L.fixed9 (phiFill tlD) s) →
        F₁ s v → First.K8.Honest.FourFacts tlD pi8 (K9L.fixed9 (phiFill tlD) s) (Sound.dataQ own a (rdW v)))
    (hF₁ : ∀ s v, Front (4, "K8.equations") s v → F₁ s v) (Xp : Verify.Public) {mH : ℕ}
    (hmH : (2 * g + 1 == mH) = false) (Hh : Desc.K9.LinkHoles)
    (hforms : ∀ o ∈ [(2, "first"), (2, "keys"), (2, "second")], ∀ s v, Front o s v →
      Sound.formsQ (Desc.K9.readersOfLink (Desc.K9.holesAt Xp mH (2 * g + 1) Lk) Lk) own o.1 o.2 s (rdW v))
    (sent : ℕ → List (ℕ × ℕ))
    (hformsE : ∀ s v, Front (4, "K8.equations") s v →
      Sound.formsQA sent own (Desc.K9.readersOfLink (Desc.K9.withSmall Hh) Lk) 4 "K8.equations" s (rdW v))
    (hlens : LensAt Lk p (phiFill tlD) (okFillAtt A (ProofFile.k8NU Bs.G₀ Xl) tlD pC pD) (tmFillAtt A pC pD)
      (lenFillAtt A pC pD) (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread
      (batchAt P5J.At.links P5J.At.ps (2 * g + 1)) ww)
    (hFront : FrontAtStandN Lk p (phiFill tlD) (okFillAtt A (ProofFile.k8NU Bs.G₀ Xl) tlD pC pD) (ProofFile.k8NU Bs.G₀ Xl)
      (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread (batchAt P5J.At.links P5J.At.ps (2 * g + 1)))
    (hVals : ValuesAtStand Lk p (phiFill tlD) (okFillAtt A (ProofFile.k8NU Bs.G₀ Xl) tlD pC pD) (ProofFile.k8NU Bs.G₀ Xl)
      (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread (batchAt P5J.At.links P5J.At.ps (2 * g + 1))) :
    GivesTotalB Lk p (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread
      (batchAt P5J.At.links P5J.At.ps (2 * g + 1)) own rdW (Desc.K9.rowsFit p.rows) tst Front := by
  have hm : 2 * g + 1 < 25 := by omega
  have htot : TotalInBehind Lk p (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread
      (batchAt P5J.At.links P5J.At.ps (2 * g + 1)) own := by
    rw [hown]
    exact totalIn_paid h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w hm Sd
  have hs := sub_odd g hg
  obtain ⟨hlk, seg, drawB, kp⟩ := tied_of_seated h hm Sd
  have seg' : SegAt (2 * g + 1) .attention Lk := hs ▸ seg
  have hA' : Bs.G₀.W.A[g]? = some A := by
    rw [O.W]
    exact hA
  -- the library's laws and the sort's tie, at the constants
  obtain ⟨A₁, X₁, a1, a2, SL⟩ := seal_att h O hg hs Lk p hlk seg drawB kp pC pD hC hD xx tlD hd
  have eA₁ : A₁ = A := Option.some.inj (a1.symm.trans hA')
  have eX₁ : X₁ = Xl := Option.some.inj (a2.symm.trans e3)
  rw [eA₁, eX₁] at SL
  obtain ⟨A₂, X₂, b1, b2, TK⟩ := take_att h O hg hs Lk p hlk seg drawB kp pC pD hC tlD
  have eA₂ : A₂ = A := Option.some.inj (b1.symm.trans hA')
  have eX₂ : X₂ = Xl := Option.some.inj (b2.symm.trans e3)
  rw [eA₂, eX₂] at TK
  -- the smallness test's seat
  obtain ⟨X₃, c1, hK⟩ := k8At_attention h.scope h.reads O hg
  have eX₃ : X₃ = Xl := Option.some.inj (c1.symm.trans e3)
  rw [eX₃] at hK
  have hK' := hK Lk Sd.link seg'
  have hk3 := ProofFile.Honest.K8.thetaAt_attention h hg Sd.link
  have hw : ww.1 = .attention := by rw [seated_w_att h hg Sd hA]
  have hKw : ProofFile.Honest.K8.K8At Lk ww.1 (ProofFile.k8ParW Zp Bs.G₀ Xl (2 * g + 1)) := by
    rw [hw]
    exact hK'
  -- the two runs behind
  have hz : ((2 * g + 1 == 0) : Bool) = false := by simp
  have hsub : (ProofFile.subsOf Zp)[2 * g + 1]? = some ModelPart.attention := hs ▸ IM.subs_scope h.scope h.reads O (2 * g + 1) hm
  obtain ⟨Lk', d1, X₄, d2, SO⟩ := seatOver_k8_at O (2 * g + 1) .attention hsub 4 (by rw [hz]; rfl) (by omega)
  have eL : Lk' = Lk := Option.some.inj (d1.symm.trans Sd.link)
  have eX₄ : X₄ = Xl := by
    have e3' : Bs.G₀.built.toList[2 * g + 1]? = some Xl := by simpa using e3
    exact Option.some.inj (d2.symm.trans e3')
  rw [eL, eX₄] at SO
  have hoa : Lk.orderAfter = [(4, "K8.lsTail"), (4, "K8.tests")] := seg'.orderAfter
  obtain ⟨rLs, hLs, -⟩ := K9L.k8_lsTail_under (ProofFile.k8ParW Zp Bs.G₀ Xl (2 * g + 1))
  obtain ⟨rTs, hTs, -⟩ := K9L.k8_tests_under (ProofFile.k8ParW Zp Bs.G₀ Xl (2 * g + 1))
  have so0 : SeatOver Lk 0 rLs := SO 0 "K8.lsTail" rLs (by rw [hoa]; rfl) hLs
  have so1 : SeatOver Lk 1 rTs := SO 1 "K8.tests" rTs (by rw [hoa]; rfl) hTs
  have hlen : Lk.orderAfter.length = 2 := by rw [hoa]; rfl
