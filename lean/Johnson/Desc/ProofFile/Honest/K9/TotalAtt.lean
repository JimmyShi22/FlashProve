/-- The digits' lookup's place, off the digits' data. -/
theorem placeD_of_dig {X : Verify.Public} {i : ℕ} {xx : First.Look.Place} {tlD : HTailF2}
    (hd : First.Look.digAt X i = some (xx, tlD)) :
    placeAt X i true = some (First.Look.P.ofPlace (Params.settingOf X.P.frame) true xx) := by
  unfold First.Look.digAt at hd
  obtain ⟨y, hy, h1⟩ := Option.bind_eq_some_iff.1 hd
  obtain ⟨tl, -, h2⟩ := Option.bind_eq_some_iff.1 h1
  obtain ⟨sh, -, h3⟩ := Option.map_eq_some_iff.1 h2
  obtain rfl : y = xx := congrArg Prod.fst h3
  unfold First.Look.placeAt
  rw [hy]
  rfl

/-- `SeatOver` at an opening's own chain. -/
theorem seatOver_k8_at {o : ProofFile.SecondHashFunctionArgument} {pol lay KL : ByteArray} {F : FileDescription ProofFile.Inst} {Z : ProofFile.Pub}
    {Bs : ProofFile.PureBase} {base : List (Block S ProofFile.Cl)} {c : Chain S ProofFile.Cl} {A : ProofFile.SharedSeat}
    {B : ProofFile.SecondSeat} (O : IM.Open o pol lay KL F Z Bs base c A B) (l : ℕ) (sub : ModelPart)
    (hl : (ProofFile.subsOf Z)[l]? = some sub) (i : ℕ) (hk : (kindsBeforeBatching sub (l == 0))[i]? = some KindName.K8)
    (hi : 2 ≤ i + 1 ∧ i + 1 ≤ 9) :
    ∃ Lk, c.links[l]? = some Lk ∧ ∃ X, Bs.G₀.built.toList[l]? = some X ∧
      ∀ j name r, Lk.orderAfter[j]? = some (i, name) →
        (First.K8.whole (ProofFile.k8ParW Z Bs.G₀ X l)).after.lookup name = some r → SeatOver Lk j r :=
  seatOver_k8 O.made O.places O.chain l sub hl i hk hi

