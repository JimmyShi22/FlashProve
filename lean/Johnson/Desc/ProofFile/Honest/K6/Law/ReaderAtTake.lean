/-! ## 1 Four abbreviations and two definitions -/

/-- The count of the switch's sending at p. Public. -/
abbrev takeDue (p : SwitchPlace) : Due :=
  sendingDue p.sizes.codes (switchSent p.sizes p.others) (switchFresh p.sizes p.others p.foldVars)

/-- Where, among that sending's coins of the extension field, message n's mask row begins. Public.
-/
abbrev takeBase (p : SwitchPlace) (n : Nat) : Nat :=
  maskBase p.sizes.codes (switchSent p.sizes p.others) (switchFresh p.sizes p.others p.foldVars) n

/-- The message length of message n's mask code. Public. -/
abbrev takeEll (p : SwitchPlace) (n : Nat) : Nat :=
  (p.sizes.codes.mask.getD
    ((switchSent p.sizes p.others).getD n default).shape.maskCode default).ell

/-- The switch's part, as the sender's text has it. Public. -/
abbrev takePart (p : SwitchPlace) :=
  switchPart (coreSender freshTable) p.sizes p.others p.foldVars p.carries

/-- **A part's own coins, off a run's coins, BY THE CUT** (part 5's lentCut: lendPart's own term),
at the first or the shared chain, where part 5's public test bookCovers accepts. IT READS A RUN's
COINS: it is the letter own of K6HeadBelow's fields, as this file's head sets it.
NO DEFAULT STANDS IN IT: it takes the public test's yes and opens the Option by
it. -/
def ownByCut {Bk : ProverCoinCounts} (ch : Nat) (hc : ch ≤ 1) (a : Addr) (d : Due)
    (hB : ProofFile.Honest.K1.bookCovers Bk ch a d = true) (k : Coins Bk) : Cs d :=
  (ProofFile.Honest.K1.lentCut k ch a d).get
    (by rw [ProofFile.Honest.K1.lentCut_isSome k ch hc a d]; exact hB)

/-- The mask row that is the sender's own coin from number b on, in the form of ProofFile's SenderLaysOwn.
ITS getD HAS A DEFAULT WHERE A COIN IS DUE: below free it is not met: no_default_at_take, by part
1's msgTxt_mask_in_head (b + ν lies below the part's count). -/
def rowFromCoin (b : Nat) {d : Due} (cs : Cs d) (ν : Nat) : E := (coinsE cs).getD (b + ν) zeroE

/-- The cut is ownByCut. -/
theorem ownByCut_is {Bk : ProverCoinCounts} (ch : Nat) (hc : ch ≤ 1) (a : Addr) (d : Due)
    (hB : ProofFile.Honest.K1.bookCovers Bk ch a d = true) (k : Coins Bk) :
    ProofFile.Honest.K1.lentCut k ch a d = some (ownByCut ch hc a d hB k) :=
  (Option.some_get _).symm

/-! ## 2 The book's public test -/

/-- Where part 3's public test accepts, the frame hands the switch's part its coins, at every run's
coins. -/
theorem handed_of_lends {Bk : ProverCoinCounts} {p : SwitchPlace}
    (hLend : lendsPart Bk (Bk.rowsOf 0) (lookDue Bk 0) ⟨p.place, 0⟩ (takePart p) = true)
    (k : Coins Bk) : (handed 0 p k).isSome = true := by
  have e : (fun a => (k.look 0 a).1) = lookDue Bk 0 := funext fun a => look_dueIs k 0 a
  obtain ⟨y, hy⟩ := (lendPart_ok_iff Bk (Bk.rowsOf 0) (k.look 0) ⟨p.place, 0⟩ (takePart p)).2
    (by rw [e]; exact hLend)
  unfold handed
  rw [hy]
  rfl

/-- And part 5's public test accepts: the part takes just the book's count. -/
theorem covers_of_lends {Bk : ProverCoinCounts} {p : SwitchPlace}
    (hLend : lendsPart Bk (Bk.rowsOf 0) (lookDue Bk 0) ⟨p.place, 0⟩ (takePart p) = true) :
    ProofFile.Honest.K1.bookCovers Bk 0 ⟨p.place, 0⟩ (takeDue p) = true := by
  unfold lendsPart at hLend
  simp only [Bool.and_eq_true] at hLend
  have e : takeDue p = dueAt (Bk.rowsOf 0) ⟨p.place, 0⟩ := beq_iff_eq.1 hLend.1.1.1
  unfold ProofFile.Honest.K1.bookCovers
  rw [← e]
  exact decide_eq_true ⟨Nat.le_refl _, Nat.le_refl _⟩

/-! ## 3 Out of the library's test on the plan -/

section Plan

variable {Z : VerifierAndGoals.PublicFiles} {D : WholeD} {r : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4}
  {cF : Chain TS ProofFile.Cl} {x : First.Look.Place}
  (h : AtMgA OnBytes.secondHashFunction Z D r Zp Np cF x)

include h in
/-- The last clause of the library's test, under h. -/
theorem copyIn_at_head :
    OffPad.copyIn (P5J.At.arr Zp) (P5J.At.ms Zp Z.lay) (P5J.At.N Zp cF) (At.num Zp 24 0)
      (OffPad.maskOk (P5J.At.cs Zp) (At.X Zp).H.ns 0) = true := by
  have hC := planC_at_head h h.toAtMg.made_accepts
  unfold OffPad.planK6C at hC
  rw [Bool.and_eq_true] at hC
  exact hC.2

include h in
/-- Segment 24 has a tenant with the reader's number. -/
theorem tenant_at_head :
    ∃ y ∈ (P5J.At.N Zp cF).group 24, P5J.At.arr Zp y.1 y.2 = At.num Zp 24 0 := by
  have hc := copyIn_at_head h
  unfold OffPad.copyIn at hc
  rw [Bool.and_eq_true] at hc
  obtain ⟨y, -, hy2⟩ := List.any_eq_true.1 hc.1
  rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at hy2
  exact ⟨seatOf y, hy2.1, hy2.2⟩

include h in
/-- Below H.ns - 1 no member of segment 24's group with the reader's number has a pad's place in
its mask row 0. -/
theorem no_pad_at_head {ν : Nat} (hν : ν + 1 < (At.X Zp).H.ns) :
    ∀ y ∈ P5J.At.ms Zp Z.lay, seatOf y ∈ (P5J.At.N Zp cF).group 24 →
      numOf (P5J.At.arr Zp) y = At.num Zp 24 0 →
      padB (P5J.At.cs Zp) (y.1.l.get y.2).1 true 0 ν = false := by
  intro y hy hg hn
  have hc := copyIn_at_head h
  unfold OffPad.copyIn at hc
  rw [Bool.and_eq_true] at hc
  have h1 := List.all_eq_true.1 hc.2 y hy
  rw [decide_eq_true hg, decide_eq_true hn] at h1
  have h2 : (Decidable.decide (seatOf y ∈ (P5J.At.N Zp cF).sent 24 0) &&
      OffPad.maskOk (P5J.At.cs Zp) (At.X Zp).H.ns 0 (y.1.l.get y.2).1) = true := by
    simpa using h1
  rw [Bool.and_eq_true] at h2
  have hk := h2.2
  unfold OffPad.maskOk at hk
  rw [Bool.and_eq_true, decide_eq_true_eq, Bool.or_eq_true, decide_eq_true_eq] at hk
  have hell : (At.X Zp).H.ns ≤
      ((P5J.At.cs Zp).mask.getD (y.1.l.get y.2).1.maskCode default).ell := by
    rcases hk.2 with e | e
    · have e0 : (At.X Zp).H.ns = 0 := by simpa using e
      omega
    · have e1 : ((At.X Zp).H.ns - 1) / 2 ^ 0 <
          ((P5J.At.cs Zp).mask.getD (y.1.l.get y.2).1.maskCode default).ell := e
      rw [Nat.pow_zero, Nat.div_one] at e1
      omega
  unfold padB
  rw [if_pos rfl]
  have hne : (ν + 1 == ((P5J.At.cs Zp).mask.getD (y.1.l.get y.2).1.maskCode default).ell) =
      false := beq_eq_false_iff_ne.2 (by omega)
  rw [hne, Bool.and_false]

end Plan

/-! ## 4 At a take: the public clauses -/

section Take

variable {Z : VerifierAndGoals.PublicFiles} {D : WholeD} {r : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4}
  {cF : Chain TS ProofFile.Cl} {x : First.Look.Place}
  (h : AtMgA OnBytes.secondHashFunction Z D r Zp Np cF x) {p : SwitchPlace} {n : Nat}
  (hp : p ∈ placesW) (hlk : p.link = 24) (hn : n < (switchSent p.sizes p.others).size)
  (hl : n ≠ (switchSent p.sizes p.others).size - 1)
  (hm : ((switchSent p.sizes p.others).getD n default).shape.maskRows ≠ 0)

include h hp hlk hn in
/-- The message's number at the written list is the reader's own. -/
theorem num_at_take
    (hrole : (switchSeatIn seatsAllFull 24 n).map (·.role) = some (Role.own 0)) :
    switchNumIn seatsAllFull 24 n = At.num Zp 24 0 := by
  obtain ⟨Bs, base, O⟩ := h.laid.opened
  have hp' : p ∈ switchPlaces Zp Bs.G₀ := by
    rw [places_at_head h.toAtMg O]
    exact hp
  have e := ownNum_at_head h.toAtMg O p hp' n 0 hn
    (by rw [pseatsAll_at_head h.toAtMg, hlk]; exact hrole)
  unfold switchNum at e
  rw [pseatsAll_at_head h.toAtMg, hlk] at e
  exact e

include h hp hn hl hm in
/-- **inside**: below the mask code's message length the coin's number lies inside the part's count.
-/
theorem inside_at_take {free : Nat} (hf₁ : free + 1 ≤ takeEll p n) :
    ∀ ν, ν < free → takeBase p n + ν < (takeDue p).e := by
  intro ν hν
  obtain ⟨Bs, base, O⟩ := h.laid.opened
  have hp' : p ∈ switchPlaces Zp Bs.G₀ := by
    rw [places_at_head h.toAtMg O]
    exact hp
  refine msgTxt_mask_in_head h.toAtMg O hp' hn hl ν ?_
  unfold maskLength
  rw [maskRows_eq_one (atMostOneMaskRow_at_head h.toAtMg O p hp') hn hm, Nat.one_mul]
  exact Nat.lt_of_lt_of_le (Nat.lt_succ_of_lt hν) hf₁

include h hp hn hl hm in
/-- **No default is met**: below free the row's entry is a coin of the list. It is inside again, in
the form with [·]?. -/
theorem no_default_at_take {free : Nat} (hf₁ : free + 1 ≤ takeEll p n) (cs : Cs (takeDue p)) :
    ∀ ν, ν < free → (coinsE cs)[takeBase p n + ν]? = some (rowFromCoin (takeBase p n) cs ν) := by
  intro ν hν
  have hlen : takeBase p n + ν < (coinsE cs).length := by
    rw [coinsE_length]
    exact inside_at_take h hp hn hl hm hf₁ ν hν
  unfold rowFromCoin
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlen]
  rfl

end Take

/-- **sender**: by the choice of the letter rowOf. It buys nothing. -/
theorem sender_at_take (b : Nat) (d : Due) (N : Nat → Prop) :
    SenderLaysOwn (d := d) (rowFromCoin b) b N := fun _ _ _ => rfl

/-- **lent**: the definition is the cut. -/
theorem lent_at_take {Bk : ProverCoinCounts} (a : Addr) (d : Due)
    (hB : ProofFile.Honest.K1.bookCovers Bk 0 a d = true) :
    OwnIs Bk 0 a d (ownByCut 0 (Nat.zero_le 1) a d hB) :=
  fun k => ownByCut_is 0 (Nat.zero_le 1) a d hB k

/-! ## 5 The field reader -/

section Reader

variable {Z : VerifierAndGoals.PublicFiles} {D : WholeD} {r : LPFD.Full.RunPF} {Zp : ProofFile.Pub} {Np : H2U.Places4}
  {cF : Chain TS ProofFile.Cl} {x : First.Look.Place}
  (h : AtMgA OnBytes.secondHashFunction Z D r Zp Np cF x) {Bk : ProverCoinCounts} {W₀ Rc Ky Tr X₀ X : Type}
  (H : Prover W₀ Rc ProofFile.Inst Ky Tr X₀ X)
  (Q : Script Bk (Local W₀ Rc ProofFile.Inst Tr) (CellsM OnBytes.Flat.numsFull) P5J.At.Tok MsgT)
  (test : Nat → TS → Option String) (carryX : Nat → ProofFile.InstPub × TS → Strs → WtF → Prop)
  (item n₁ n₂ b₀ : Nat) (Vd : Local W₀ Rc ProofFile.Inst Tr → Prop)
  (Rd : Nat → Local W₀ Rc ProofFile.Inst Tr → TS → Prop) (Kp : Place → TS → TS → Prop)
  (w : Local W₀ Rc ProofFile.Inst Tr)
  (Said : Nat → Coins Bk → Mid (Local W₀ Rc ProofFile.Inst Tr) X → Prop)
  (Dd : RowDataOf ProofFile.Inst) (readers : Local W₀ Rc ProofFile.Inst Tr → Readers)
  (lay : OnBytes.Params.ReqLayout) {p : SwitchPlace} {n : Nat} (N fx free : Nat)

/-- **K6's READER AT A TAKE.** CONDITIONAL: on hO, which is not paid, on the public test hLend,
which is shown at no book that we know (this file's head), and on public premises. The field reader of
K6HeadBelow, to the letter, at rowOf := rowFromCoin (takeBase p n) and own := ownByCut at the
switch's own address. -/
theorem k6_reader_at_take (hp : p ∈ placesW) (hlk : p.link = 24)
    (hn : n < (switchSent p.sizes p.others).size)
    (hl : n ≠ (switchSent p.sizes p.others).size - 1)
    (hm : ((switchSent p.sizes p.others).getD n default).shape.maskRows ≠ 0)
    (hrole : (switchSeatIn seatsAllFull 24 n).map (·.role) = some (Role.own 0))
    (hLend : lendsPart Bk (Bk.rowsOf 0) (lookDue Bk 0) ⟨p.place, 0⟩ (takePart p) = true)
    (hN : N ≤ ((lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread.ahead ++
      declsTo (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread.bs 341).length)
    (hf₁ : free + 1 ≤ takeEll p n) (hf₂ : free + 1 ≤ (At.X Zp).H.ns)
    (hv : publicOk Dd lay p (segsW.take p.link) w.x = true)
    (hO : OwnMsgs Q (fun v => v = w ∧ Vd v) N (switchNumIn seatsAllFull 24 n) fx
      (switchMsgTxt 0 Dd readers (lotClosingAt lay segsW) p n)) :
    ReaderReads (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread
      (ThrS (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread Said 341)
      (fun s : S => s.fork?) (fun _ _ v u ν => rd ((cutAtHead h Q carryX v u).2 ν)) rd
      (fun k _ _ ν => rowFromCoin (takeBase p n)
        (ownByCut 0 (Nat.zero_le 1) ⟨p.place, 0⟩ (takeDue p) (covers_of_lends hLend) k) ν)
      (fun ν => ν < free ∧ ν < (At.X Zp).H.ns) := by
  intro k s m En hT a _ ds ν hν
  obtain ⟨hν1, hν2⟩ := hν
  have hval : m.st.input = w ∧ Vd m.st.input := hT.1.2.2.2.2.2.2
  have hfit : drawsFit ((lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread.ahead ++
      declsTo (lettersHead h H Q test carryX item n₁ n₂ b₀ Vd Rd Kp w).thread.bs 341)
      m.st.heard = true := hT.1.2.1
  have hlen : N ≤ (m.st.heard ++ ds).length := by
    have e := drawsFit_length _ _ hfit
    rw [List.length_append, e]
    exact Nat.le_trans hN (Nat.le_add_right _ _)
  have hin := inside_at_take h hp hn hl hm hf₁ ν hν1
  obtain ⟨Bs, base, O⟩ := h.laid.opened
  have hp' : p ∈ switchPlaces Zp Bs.G₀ := by
    rw [places_at_head h.toAtMg O]
    exact hp
  have htxt := msgTxt_mask_row_zero h.toAtMg O 0 Dd readers lay hp' hn hl hm
    (Nat.lt_of_lt_of_le (Nat.lt_succ_of_lt hν1) hf₁) k m.st.input ((m.st.heard ++ ds).take fx)
    (handed_of_lends hLend k)
    (by rw [segments_at_head h.toAtMg O, hval.1]; exact hv)
  rw [segments_at_head h.toAtMg O,
    ownByCut_is 0 (Nat.zero_le 1) ⟨p.place, 0⟩ (takeDue p) (covers_of_lends hLend) k] at htxt
  have hcoin : ((some (ownByCut 0 (Nat.zero_le 1) ⟨p.place, 0⟩ (takeDue p)
      (covers_of_lends hLend) k)).bind fun cs =>
        (cs.eAt (takeBase p n + ν)).toOption) =
      some ((ownByCut 0 (Nat.zero_le 1) ⟨p.place, 0⟩ (takeDue p)
        (covers_of_lends hLend) k).e ⟨takeBase p n + ν, hin⟩) := by
    show ((ownByCut 0 (Nat.zero_le 1) ⟨p.place, 0⟩ (takeDue p)
      (covers_of_lends hLend) k).eAt (takeBase p n + ν)).toOption = _
    unfold ProofFile.Honest.Cs.eAt
    rw [dif_pos hin]
    rfl
  have hmsg := hO k m.st.input (m.st.heard ++ ds) hval hlen true 0 ν _ (htxt.trans hcoin)
  rw [num_at_take h hp hlk hn hrole] at hmsg
  show rd (maskQ (P5J.At.cs Zp) (P5J.At.arr Zp) (P5J.At.ms Zp Z.lay) (P5J.At.N Zp cF) 24
    (At.X Zp).H.ns (plAt (At.num Zp 24 0) 0) (Q.wit k m.st.input (m.st.heard ++ ds)) ν) = _
  rw [Came.rd_maskQ _ _ _ _ _ _ _ _ _ hν2]
  show Sound.readAt (P5J.At.cs Zp) (P5J.At.arr Zp) (P5J.At.ms Zp Z.lay) (P5J.At.N Zp cF) 24
    (Q.wit k m.st.input (m.st.heard ++ ds)) (At.num Zp 24 0) true (ν % 2 ^ 0) (ν / 2 ^ 0) = _
  rw [Nat.pow_zero, Nat.mod_one, Nat.div_one,
    Sym.readAt_msg _ _ _ _ _ _ _ _ _ _ (tenant_at_head h) (h.plan.hG 24)
      (no_pad_at_head h (Nat.lt_of_lt_of_le (Nat.succ_lt_succ hν1) hf₂))]
  show Q.msg (At.num Zp 24 0) k m.st.input
    ((m.st.heard ++ ds).take (Q.fixedMsg (At.num Zp 24 0))) true 0 ν = _
  rw [hmsg]
  exact (coinsE_getD _ (takeBase p n + ν) hin).symm

