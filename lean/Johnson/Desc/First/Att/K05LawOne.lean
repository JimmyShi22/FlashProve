/-- **A promise that rides** over the hearing's seat and the piece's base. -/
structure Rides (Fr : Frame) (base : ℕ) where
  Rq : Type
  rq : First.S → Rq
  reads : ReadsRest rq
  q : Rq → Fr.E.Str → Prop
  carried : ∀ r y y', SameBelow Fr base y y' → q r y → q r y'

section
variable (x : VerifiableInference.Desc.First.Look.Place) (tl : HTailF2) (D : Sent)
  (rad : OracleShape → Nat) (Ex : Iop.ExtSpec) (Wp : Type)
  (α : TX (Unit × Cb.Gl.E) Cb.Gl.E (Option (JAtt x.ns tl)) → Cb.Gl.E)

/-- **What is a test on public data.** -/
structure K5Public (set : Params.Setting) (settings : Model.Settings) (i : Attention.In)
    (cf : Attention.Cfg) (A : Attention.Plan) (p : Par) (ds : List RDT) (kc iU3 nW Kc : ℕ)
    (k3 : Runs.PadIn) (nzx : ℕ) : Prop where
  plan : Attention.plan settings i cf = Except.ok A
  att : AttOK set x A.S tl D rad
  fs : x.fs = A.fs
  planOk : planOkAll cf A.S A.fs = true
  own : p.own = A.own
  pair : (dimOf A.S).nb ≠ 0
  mats : OnBytes.Road.Rows.MatsFit A.S tl
  claims : claimsOk ⟨geoOf A.S, iU3, nW, K5Law.matsOf tl.mats⟩ Kc k3 true nzx = true
  planes : Look.planesOk x.fs (parCOf A).geo.lmb = true
  plain : ∀ d ∈ ds, Plain (toRD d)
  entries : ds.map (·.entry) = (rounds p).map (·.entry)
  kinds : ∀ d ∈ ds, Fmt.kindOf d.entry.name = some d.kind
  held : k5Held kc (zOf p.own) ((rounds p).map fun r => (r.entry, kindFmt r.entry)) = true
  u3 : iU3 = A.iU3

/-- **What is asked at each statement in front with "on".** -/
structure K5AtOn {W Cl : Type} {Fr : Frame} (claim : Aff → Cl) (p : Par) (ns base : ℕ)
    (x0 : First.S × Fr.E.Str → TX (Unit × Cb.Gl.E) Cb.Gl.E (Option (JAtt x.ns tl)))
    (gOf : First.S × Fr.E.Str → Forest.Heard) (pl : ℕ → ℕ → JAtt x.ns tl)
    (on : First.S × Fr.E.Str → Prop) (I : PinItemP Fr seatSO base W (attSg x D rad).Msg)
    (Rd : Rides Fr base) : Prop where
  left : ∀ a, on a → K3LeftOutIs (VerifiableInference.Desc.K3.seatCalls claim).fork
    (VerifiableInference.Desc.K3.seatCalls claim).heard x.fs x.lm x.F.next
    (Cb.Fo.NumsEq.placeOf (enMask x.ns tl) pl)
    (fun F => Room F ns x.F.next (Forest.elems x.fs + (slotsOf (script p.own) + 0))) (x0 a) (gOf a)
    a.1
  ok : ∀ a, on a → I.ok (I.rc a.1) a.2
  promise : ∀ a, on a → Rd.q (Rd.rq a.1) a.2

/-- **What is asked of the relation behind the kind**: only where LaidBehind holds. -/
structure K5Behind {W : Type} {Fr : Frame} (A : Attention.Plan) (p : Par) (ns base nW Kc : ℕ)
    (k3 : Runs.PadIn) (tj : OnBytes.K.Kc.Tape) (gOf : First.S × Fr.E.Str → Forest.Heard)
    (on : First.S × Fr.E.Str → Prop) (I : PinItemP Fr seatSO base W (attSg x D rad).Msg)
    (R' : First.S × Fr.E.Str → W → Prop) : Prop where
  worth : BillsWorthJ x tl D rad Ex Wp α A.S ns (numsPlan p.own (x.F.next + Forest.elems x.fs)) { A with NC := A.S.calls.size } Kc k3 nW tj gOf
    (fun a => lookOfO (parCOf A).geo.lmb (gOf a)) seatSO p.own (fun a : First.S × Fr.E.Str => a.1) (fun a : First.S × Fr.E.Str => a.1) on I.part
    (fun b w => LaidBehind Fr seatSO p base on b ∧ R' b w)
  item : ∀ b w, LaidBehind Fr seatSO p base on b → R' b w → I.holds (I.rc b.1) b.2 w

/-! ## The joints -/

/-- The place's record is recOf of the closed parameters. -/
theorem own_recOf {settings : Model.Settings} {i : Attention.In} {cf : Attention.Cfg}
    {A : Attention.Plan} (hA : Attention.plan settings i cf = Except.ok A)
    (hok : planOkAll cf A.S A.fs = true) (p : Par) (hp : p.own = A.own) (ns : ℕ) (N : Nums) :
    p.own = recOf (closedOf (attBase x A.S tl D rad) (attLin x A.S tl D rad Ex Wp α ns N) ns N) A.own.rows := by
  have hid := (OnBytes.Road.L5.plan_shape hA).1
  have PA := plan_all hid hok
  obtain ⟨_, _, _, _, _, _, _, U⟩ := PA.units
  exact hp.trans (rec_of_plan hA PA.law.place (OnBytes.Road.Rows.norm_of_hid hid)
    (Nat.le_of_succ_le (OnBytes.Road.Rows.sizes_of_hid hid).lnT) U _ rfl rfl rfl)

/-- **What the payment of the returns asks of the lookup's heard record**, from the lookup's
promise. -/
theorem hK_of_left {S₀ : Type} {set : Params.Setting} {S : Attention.Shape}
    (H : AttOK set x S tl D rad) {lid : ℕ} {cf : Attention.Cfg}
    (hid : Attention.shapeHid lid cf = Except.ok (S, x.fs)) (PL : K5Law.PlanLaw cf S x.fs)
    {fork : S₀ → Option Fork} {heard : S₀ → Option Forest.Heard}
    {ι : Fo.Pl → Option (JAtt x.ns tl)} {Q : Fork → Prop}
    {x0 : TX (Unit × Cb.Gl.E) Cb.Gl.E (Option (JAtt x.ns tl))} {g : Forest.Heard} {s : S₀}
    (h : K3LeftOutIs fork heard x.fs x.lm x.F.next ι Q x0 g s) :
    (∃ zy z, K3Pts x.fs g.zx zy g.zk z) ∧ g.zk.size = 4 ∧ g.shape.calls.size = 4 ∧
      g.e.size = 4 := by
  obtain ⟨F, F', rs, _, _, L, _, _, T⟩ := h
  obtain ⟨e1, e2⟩ := left_sizes L
  have n4 : S.calls.size = 4 := by rw [← Array.length_toList, PL.place.calls]; rfl
  refine ⟨⟨g.zy, _, k3pts_of_left L H.four T.pt⟩, e2.trans H.four, ?_, e1.trans H.four⟩
  rw [L.shape, OnBytes.Road.L5.calls_of_hid hid, Array.size_map, n4]

/-- The seat's own record for the lookup's tables: its point is the heard one, and its test on the
planes is a test on public data. -/
theorem hlk_of_left {S₀ : Type} (lmb : ℕ) (hpl : Look.planesOk x.fs lmb = true)
    {fork : S₀ → Option Fork} {heard : S₀ → Option Forest.Heard}
    {ι : Fo.Pl → Option (JAtt x.ns tl)} {Q : Fork → Prop}
    {x0 : TX (Unit × Cb.Gl.E) Cb.Gl.E (Option (JAtt x.ns tl))} {g : Forest.Heard} {s : S₀}
    (h : K3LeftOutIs fork heard x.fs x.lm x.F.next ι Q x0 g s) :
    (lookOfO lmb g).zx = g.zx ∧ (lookOfO lmb g).planesOk = true := by
  obtain ⟨_, _, _, _, _, L, _, _, _⟩ := h
  refine ⟨rfl, ?_⟩
  show Look.planesOk g.shape lmb = true
  rw [L.shape]
  exact hpl

/-- **The ledger behind the hearing is Sized**: drawn, not asked. -/
theorem sized_of_laid {Cl : Type} {Fr : Frame} (claim : Aff → Cl) (p : Par) (ns base kr : ℕ)
    (x0 : First.S × Fr.E.Str → TX (Unit × Cb.Gl.E) Cb.Gl.E (Option (JAtt x.ns tl)))
    (gOf : First.S × Fr.E.Str → Forest.Heard) (ι : Fo.Pl → Option (JAtt x.ns tl))
    (on : First.S × Fr.E.Str → Prop)
    (hleft : ∀ a, on a → K3LeftOutIs (VerifiableInference.Desc.K3.seatCalls claim).fork
      (VerifiableInference.Desc.K3.seatCalls claim).heard x.fs x.lm x.F.next ι
      (fun F => Room F ns x.F.next (Forest.elems x.fs + kr)) (x0 a) (gOf a) a.1)
    (b : First.S × Fr.E.Str) (hb : LaidBehind Fr seatSO p base on b) (s : First.S) (h : Heard)
    (G : Fork) (hy : seatSO.lay s h G = some b.1) : Sized G := by
  obtain ⟨a', F0, G', h', rs, ha', _, hl, _, _, hh, hy', _⟩ := hb
  have eG : G = G' :=
    Option.some.inj ((laysBack_seatSO _ _ _ _ hy).symm.trans (laysBack_seatSO _ _ _ _ hy'))
  obtain ⟨F, F', _, hQ, _, L, _, hf, _⟩ := hleft a' ha'
  have eF : F0 = F' := Option.some.inj ((ledgerO_fork claim hl).symm.trans hf)
  have zF : Sized F0 := eF ▸ (room_of_left L hQ).sized
  obtain ⟨_, _, _, zG, _, _⟩ := hear_law_paid hh zF
  exact eG ▸ zG

/-! ## The one theorem -/

open Classical in
/-- **KIND K5's LAW, IN ONE STATEMENT.** -/
theorem K05_law_one {W Cl Ck : Type} {Fr : Frame} (claim : Aff → Cl) (ok : Bool)
    {set : Params.Setting} {settings : Model.Settings} {i : Attention.In} {cf : Attention.Cfg}
    {A : Attention.Plan}
    (claims : List (String × (Nat → First.S → Except String (List Ck × First.S)))) (p : Par)
    (ns base kc : ℕ) (ds : List RDT) (iU3 nW : ℕ) {Kc : ℕ} {k3 : Runs.PadIn} {nzx : ℕ}
    (tj : OnBytes.K.Kc.Tape)
    (x0 : First.S × Fr.E.Str → TX (Unit × Cb.Gl.E) Cb.Gl.E (Option (JAtt x.ns tl)))
    (yOf : First.S × Fr.E.Str → Ex.Str) (gOf : First.S × Fr.E.Str → Forest.Heard)
    (pl : ℕ → ℕ → JAtt x.ns tl) (on : First.S × Fr.E.Str → Prop)
    (I : PinItemP Fr seatSO base W (attSg x D rad).Msg) (Rd : Rides Fr base)
    (R' : First.S × Fr.E.Str → W → Prop)
    (Pb : K5Public x tl D rad set settings i cf A p ds kc iU3 nW Kc k3 nzx)
    (On : K5AtOn x tl D rad claim p ns base x0 gOf pl on I Rd)
    (Bh : K5Behind x tl D rad Ex Wp α A p ns base nW Kc k3 tj gOf on I R') :
    (⟨{ attentionKind seatSO claims p with planOk := ok }, base, ds, [], fun _ _ w => w,
        Err.cap kc (uLT (ckP .two) ds)⟩ : Piece (ckP .two) Fr First.S Ck W).GoodIn
      on (fun b => LaidBehind Fr seatSO p base on b ∧ Rd.q (Rd.rq b.1) b.2)
      (fun a w => ((closedOf (attBase x A.S tl D rad) (attLin x A.S tl D rad Ex Wp α ns (numsPlan p.own (x.F.next + Forest.elems x.fs))) ns (numsPlan p.own (x.F.next + Forest.elems x.fs))).own (theMeans Cb.Gl.E _ _ _)).ch.Todo (x0 a) (I.part w)) R' := by
  have hid : Attention.shapeHid settings.lidb cf = Except.ok (A.S, x.fs) := by
    rw [Pb.fs]
    exact (OnBytes.Road.L5.plan_shape Pb.plan).1
  have hok : planOkAll cf A.S x.fs = true := by
    rw [Pb.fs]
    exact Pb.planOk
  have hrec := own_recOf x tl D rad Ex Wp α Pb.plan Pb.planOk p Pb.own ns (numsPlan p.own (x.F.next + Forest.elems x.fs))
  obtain ⟨j0⟩ := nameJ_inhabited (dimOf A.S) A.S.ls A.S.cf.lmS Pb.pair
  have hF : BillsFormsJ x tl D rad Ex Wp α A.S ns (numsPlan p.own (x.F.next + Forest.elems x.fs)) A.own.rows
      (fun a _ gL _ _ => gL = gOf a) seatSO p.own (fun a : First.S × Fr.E.Str => a.1) (fun a : First.S × Fr.E.Str => a.1) x0
      (fun a => (gOf a).zx) (fun a => (gOf a).zk) on I.part
      (fun b w => LaidBehind Fr seatSO p base on b ∧ R' b w) := by
    have hW := Bh.worth
    rw [hrec] at hW ⊢
    exact billsFormsJ_of_worths x tl D rad Ex Wp α hid hok Pb.mats ns _ A.own.rows
      { A with NC := A.S.calls.size } rfl iU3 nW Pb.u3 Pb.claims tj gOf _ seatSO _ _ x0 on
      (fun a ha => hK_of_left x tl D rad Pb.att hid (plan_all hid hok).law (On.left a ha))
      (fun a ha => hlk_of_left x tl _ Pb.planes (On.left a ha)) I.part _
      (fun a b w _ hR _ G h _ _ hy _ _ _ =>
        sized_of_laid x tl claim p ns base _ x0 gOf _ on On.left b hR.1 a.1 h G hy) hW
  have hL := billsLaterJ_of_forms x tl D rad Ex Wp α A.S ns (numsPlan p.own (x.F.next + Forest.elems x.fs)) A.own.rows settings.lidb cf A.fs
    j0 (fun a _ gL _ _ => gL = gOf a) seatSO p.own (fun a : First.S × Fr.E.Str => a.1) (fun a : First.S × Fr.E.Str => a.1) x0 (fun a => (gOf a).zx)
    (fun a => (gOf a).zk) on I.part (fun b w => LaidBehind Fr seatSO p base on b ∧ R' b w)
    (OnBytes.Road.L5.plan_shape Pb.plan).1 Pb.mats hF
  have h1 := K05_goodIn_capP x tl D rad Ex Wp α claim ok Pb.plan Pb.att Pb.fs Pb.planOk claims p
    Pb.own ns x.F.next 0 j0 base ds Pb.plain Pb.entries x0 yOf on gOf pl On.left I
    (msgZero x D rad) On.ok (fun b w => LaidBehind Fr seatSO p base on b ∧ R' b w) hL
    (fun b w hb hw => Bh.item b w hb hw.2) Pb.kinds kc Pb.held
  exact goodIn_on'_mono _
    (goodIn_conseq _ h1 (fun _ _ _ _ _ _ hL' h => ⟨hL', h⟩) (fun _ _ _ _ _ _ _ _ h => h))
    (fun _ _ b _ _ hL' =>
      ⟨hL', laid_rides p base on Rd.rq Rd.reads Rd.q Rd.carried On.promise b hL'⟩)

open Classical in
/-- **The same with what the kind's rounds mean in front.** -/
theorem K05_law_one_means {W Cl Ck : Type} {Fr : Frame} (claim : Aff → Cl) (ok : Bool)
    {set : Params.Setting} {settings : Model.Settings} {i : Attention.In} {cf : Attention.Cfg}
    {A : Attention.Plan}
    (claims : List (String × (Nat → First.S → Except String (List Ck × First.S)))) (p : Par)
    (ns base kc : ℕ) (ds : List RDT) (iU3 nW : ℕ) {Kc : ℕ} {k3 : Runs.PadIn} {nzx : ℕ}
    (tj : OnBytes.K.Kc.Tape)
    (x0 : First.S × Fr.E.Str → TX (Unit × Cb.Gl.E) Cb.Gl.E (Option (JAtt x.ns tl)))
    (yOf : First.S × Fr.E.Str → Ex.Str) (gOf : First.S × Fr.E.Str → Forest.Heard)
    (pl : ℕ → ℕ → JAtt x.ns tl) (on : First.S × Fr.E.Str → Prop)
    (I : PinItemP Fr seatSO base W (attSg x D rad).Msg) (Rd : Rides Fr base)
    (R' : First.S × Fr.E.Str → W → Prop)
    (Pb : K5Public x tl D rad set settings i cf A p ds kc iU3 nW Kc k3 nzx)
    (On : K5AtOn x tl D rad claim p ns base x0 gOf pl on I Rd)
    (Bh : K5Behind x tl D rad Ex Wp α A p ns base nW Kc k3 tj gOf on I R') :
    (⟨{ attentionKind seatSO claims p with planOk := ok }, base, ds, [], fun _ _ w => w,
        Err.cap kc (uLT (ckP .two) ds)⟩ : Piece (ckP .two) Fr First.S Ck W).GoodIn
      on (fun b => LaidBehind Fr seatSO p base on b ∧ Rd.q (Rd.rq b.1) b.2)
      (fun a w => OwnMeans x A.S tl D rad (x0 a).2.1.pt (I.part w)) R' :=
  goodIn_conseq _ (K05_law_one x tl D rad Ex Wp α claim ok claims p ns base kc ds iU3 nW tj x0 yOf gOf pl on I Rd R' Pb On Bh)
    (fun _ _ _ _ _ _ _ h => h)
    (fun a _ _ w _ _ _ _ h => K05_means x tl D rad Ex Wp α Pb.plan ns _ (x0 a) (I.part w) h)

end

/-! ## Beside the law -/

/-- **An item with a promise slot at the seat that sits**: the law `lay` is paid by ReadsRest. -/
def PinItemP.atSeatSO {F : Frame} {W Mg : Type} (base : ℕ) {Rc : Type} (rc : First.S → Rc)
    (hrc : ReadsRest rc) (ok : Rc → F.E.Str → Prop) (holds : Rc → F.E.Str → W → Prop)
    (part : W → Mg)
    (fixes : ∀ r y w w', ok r y → holds r y w → holds r y w' → part w = part w')
    (fenced : ∀ r y y' w, SameBelow F base y y' → holds r y' w → holds r y w) :
    PinItemP F seatSO base W Mg :=
  ⟨Rc, rc, ok, holds, part, fixes, seatSO_keeps rc hrc, fenced⟩

/-- **The text that says yes to all has not the law's form at the cap**, wherever the policy's work
is below kc: at the kind's written rounds, at every seat, condition and pair of relations, under a
pair (a, w) with "on", at which the relation in front fails and the relation behind holds at the
record as it came. -/
theorem K05_yes_fails_cap {S Cl W : Type} {F : Frame} (seat : Seat S)
    (claims : List (String × (Nat → S → Except String (List Cl × S)))) (p : Par) (base kc : ℕ)
    (hw : p.work < kc) (on on' : S × F.E.Str → Prop) (R R' : S × F.E.Str → W → Prop)
    (a : S × F.E.Str) (w : W) (ha : on a) (hR : ¬ R a w) (hR' : ∀ y', R' (a.1, y') w) :
    ¬ (pieceAt (W := W) (F := F) (k5Yes seat claims p) p base
        (Err.cap kc (uLT (ckP .two) (written p)))).GoodIn on on' R R' :=
  yes_not_keeps seat claims p base _
    (ltPass_of_below (ckP .two) kc (written p) _ (Err.cap_below_inv kc _) fun d hd => by
      rcases written_work p d hd with h | h <;> rw [h]
      · exact Nat.lt_of_le_of_lt (Nat.zero_le _) hw
      · exact hw)
    on on' R R' a w ha hR hR'

end VerifiableInference.Desc.First.Att.P

