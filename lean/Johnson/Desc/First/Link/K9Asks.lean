import OnBytes.Model.StagesLinks
import OnBytes.Model.Tail
import Johnson.Desc.ProofFile.Pub
import Johnson.Desc.First.Look.K3Asks
import Johnson.Desc.Ok.PlanWritten.XShape
import Johnson.Desc.First.Link.K9PosAsk
import Johnson.Desc.First.Link.K9NuAsk

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace VerifiableInference.Desc.K9Asks
open OnBytes OnBytes.Model

/-- An array's kind, number of rows, number of columns, number of virtual rows. -/
def lookOf (X : HTree) : HKind × Nat × Nat × Nat := (X.kind, X.R, X.K, X.rows.size)

/-- A ledger's arrays' looks. -/
def looksOf (F : Fork) : List (HKind × Nat × Nat × Nat) := F.trees.toList.map lookOf

/-- Number t is a table with one row and one virtual row. -/
def oneRow (sh : List (HKind × Nat × Nat × Nat)) (t : Nat) : Bool :=
  match sh[t]? with
  | some x => x.1 == HKind.table && x.2.1 == 1 && x.2.2.2 == 1
  | none => false

/-- Number t is a table with one row and at least one virtual row. -/
def unitAt (sh : List (HKind × Nat × Nat × Nat)) (t : Nat) : Bool :=
  match sh[t]? with
  | some x => x.1 == HKind.table && x.2.1 == 1 && decide (0 < x.2.2.2)
  | none => false

/-- Number t is a table's vector's array, and of no other sort. -/
def tableAt (sh : List (HKind × Nat × Nat × Nat)) (tl : HTailF2) (t : Nat) : Bool :=
  ((List.range 4).any fun n => tl.ix.U.getD n none == some t) && oneRow sh t &&
    tl.ix.ZZ != t && tl.ix.BZ != t && ((List.range tl.NM).all fun mu => tl.gtTree.getD mu 0 != t) &&
    (tl.z1.pieces.toList.all fun p => p.tree != t) && tl.z2.pieces.toList.all fun p => p.tree != t

/-- **Every array is of one of the four sorts.** -/
def sortsB (sh : List (HKind × Nat × Nat × Nat)) (tl : HTailF2) : Bool :=
  (List.range sh.length).all fun t =>
    t == tl.ix.ZZ || t == tl.ix.BZ || ((List.range tl.NM).any fun mu => tl.gtTree.getD mu 0 == t) ||
      tableAt sh tl t

/-- **Number 0 and every table's vector's array is a table with one row.** -/
def unitB (sh : List (HKind × Nat × Nat × Nat)) (tl : HTailF2) : Bool :=
  unitAt sh 0 && tl.ix.U.toList.all fun x =>
    match x with
    | some t => unitAt sh t
    | none => true

/-- **Every array of the ledger has an entry in the segment's list of names.** -/
def namesB (X : Stages.LinkH) : Bool := decide (X.Fp.trees.size ≤ X.arrayOf.size)

/-- The ledger has virtual row e of array t. -/
def hasRow (F : Fork) (t e : Nat) : Bool :=
  decide (t < F.trees.size) && decide (e < (F.trees.getD t {}).rows.size)

/-- The two calls' `pieces`, each with its call's number. -/
def allPieces (tl : HTailF2) : List (Nat × Piece) :=
  (tl.zOf 0).pieces.toList.map (fun p => (0, p)) ++ (tl.zOf 1).pieces.toList.map fun p => (1, p)

/-- No pair stands twice. -/
def noTwice : List (Nat × Nat) → Bool
  | [] => true
  | a :: l => !l.contains a && noTwice l

/-- **The planes' array, and the rows of the calls' `pieces`.** -/
def coefB (tl : HTailF2) (F : Fork) : Bool :=
  hasRow F tl.ix.BZ 0 && hasRow F tl.ix.BZ 1 && hasRow F tl.ix.BZ 2 &&
    (F.trees.getD tl.ix.BZ {}).R == 32 &&
    ((List.range tl.NM).all fun mu => tl.gtTree.getD mu 0 != tl.ix.BZ) &&
    noTwice ((allPieces tl).map fun a => (a.2.tree, a.2.row)) &&
    (allPieces tl).all fun a =>
      hasRow F a.2.tree a.2.row && !(tl.ix.ZZ == a.2.tree && tl.zzRowReads == a.2.row) &&
        !(tl.ix.ZZ == a.2.tree && tl.zzRowTies == a.2.row) && tl.ix.BZ != a.2.tree &&
        (List.range tl.NM).all fun mu => !(tl.gtTree.getD mu 0 == a.2.tree && 0 == a.2.row)

/-- **Each call has at most 63 bits, and each `Piece`'s range at most as many.** -/
def smallB (tl : HTailF2) : Bool :=
  (List.range 2).all fun q =>
    decide ((tl.zOf q).call.n ≤ 63) && (tl.zOf q).pieces.toList.all fun p => decide (p.b ≤ 63)

/-- The range of places of p meets none of the list's. -/
def apartFrom (p : Piece) (l : List Piece) : Bool :=
  l.all fun p' => decide (p.off + 2 ^ p.b ≤ p'.off) || decide (p'.off + 2 ^ p'.b ≤ p.off)

/-- The ranges of the list's members do not meet. -/
def apartL : List Piece → Bool
  | [] => true
  | p :: l => apartFrom p l && apartL l

/-- **The ranges of places of a call's `pieces` do not meet.** -/
def rangesB (tl : HTailF2) : Bool := (List.range 2).all fun q => apartL (tl.zOf q).pieces.toList

/-- **The listed shapes have the matrices' rows and columns.** -/
def fitsB (tl : HTailF2) : Bool :=
  (List.range tl.NM).all fun mu =>
    (tl.shp.getD mu {}).m == (tl.mats.getD mu {}).m &&
      (tl.shp.getD mu {}).k == (tl.mats.getD mu {}).k

/-- **What the closing wants of the digits' array (`wants`) has the number that is laid.** -/
def blocksB (tl : HTailF2) : Bool := tl.wants.map (·.1) == some tl.zzBlocks

/-- **The arrays of the tables' vectors number 0 and 2 are of that sort and of no other.** -/
def vectorsB (sh : List (HKind × Nat × Nat × Nat)) (tl : HTailF2) : Bool :=
  [0, 2].all fun n => tableAt sh tl ((tl.ix.U.getD n none).getD 0)

/-- **The nine at one built segment.** -/
def segOk (X : Stages.LinkH) : Bool :=
  sortsB (looksOf X.Fp) X.tl && unitB (looksOf X.Fp) X.tl && namesB X && coefB X.tl X.Fp &&
    smallB X.tl && rangesB X.tl && fitsB X.tl && blocksB X.tl && vectorsB (looksOf X.Fp) X.tl

/-- **The lookup's public numbers that the digits' row tests are the built segment's own.** -/
def sameB (W : Verify.Public) (l : Nat) (X : Stages.LinkH) : Bool :=
  (K3Asks.digAt W l).any fun xt =>
    PlanWritten.forestView xt.2.f9 == PlanWritten.forestView X.tl.f9

/-- **THE TEST.** -/
def k9Entry (Z : ProofFile.Pub) : Bool :=
  let xs := ProofFile.k9Stretches Z
  (List.range 25).all fun l =>
    match Z.p.built.links[l]? with
    | some X =>
      segOk X && sameB Z.p.X l X && rowsFitB xs Z l X && posPlanB Z.p.X l X && nuPosB Z.p.X X
    | none => false

end VerifiableInference.Desc.K9Asks
