/-
Johnson/Goal/Meaning/ScopeBytes.lean: the fixed lines of the stored full-size example's parameter
file (Ladder/Stored.lean), written a second time as lists of bytes, and the theorems that these
lists spell the same texts.

Why. Ladder/Stored.lean writes the parameter file as texts. A theorem on all files in the goals'
scope has to evaluate the verifier's readers on the file's fixed lines, inside Lean's kernel. The
kernel turns a text into bytes slowly; on lists of bytes that are written out it is fast. So each
fixed line stands here as a list of bytes, with the line itself as a comment above it. Nobody has to
trust the lists or the comments: `frame_text`, `textA1`, `textA2`, `textA3` and `textB` say that the
lists spell the texts of Ladder/Stored.lean, and Lean checks them.

Main definitions: `asText`, `fed`, `concatenatedWithLineFeeds`; `frameLines`, `linesA1`, `linesA2`, `linesA3`,
`linesB`.
Main theorems: `bytesOf_asText`; the five named above.

A script wrote the lists from Ladder/Stored.lean. No line holds its line feed.
The verifier program does not import this file.
-/
import OnBytes.Model.ConfigReadersBehind
import Ladder.Stored

set_option autoImplicit false

namespace VerifierAndGoals.Lines

open OnBytes OnBytes.Model OnBytes.Model.Config

/-- Bytes as a text: each byte as the character of that number. -/
def asText (l : List UInt8) : String := String.ofList (l.map fun b => Char.ofNat b.toNat)

/-- Each line with its line feed. -/
def fed (ls : List (List UInt8)) : List (List UInt8) := ls.map fun l => l ++ [0x0A]

/-- The lines, each with its line feed, one behind the other. -/
def concatenatedWithLineFeeds (ls : List (List UInt8)) : List UInt8 := (fed ls).flatten

/-- The bytes of a text made of bytes below 128 are these bytes. -/
theorem bytesOf_asText (l : List UInt8) (h : l.all (fun b => decide (b < 128)) = true) :
    bytesOf (asText l) = l := by
  rw [ConfigReaders.bytesOf_data, asText, String.toUTF8_eq_toByteArray, String.toByteArray_ofList,
    List.utf8Encode, List.toList_data_toByteArray]
  induction l with
  | nil => rfl
  | cons b l ih =>
    rw [List.all_cons, Bool.and_eq_true] at h
    rw [List.map_cons, List.flatMap_cons, ih h.2]
    have hb : b.toNat < 128 := by simpa [UInt8.lt_iff_toNat_lt] using h.1
    have hc : b.toNat.isValidChar := Or.inl (by omega)
    have hv : (Char.ofNat b.toNat).val.toNat = b.toNat := by
      rw [Char.ofNat, dif_pos hc]
      rfl
    have h1 : (Char.ofNat b.toNat).utf8Size = 1 := by
      unfold Char.utf8Size
      rw [if_pos (by rw [UInt32.le_iff_toNat_le, hv]; exact Nat.le_of_lt_succ hb)]
    rw [String.utf8EncodeChar_eq_singleton h1]
    have e : (Char.ofNat b.toNat).val.toUInt8 = b := by
      apply UInt8.toNat_inj.1
      rw [UInt32.toNat_toUInt8, hv]
      omega
    rw [e]
    rfl

