                           c₃ k₃ rest₁ rest₂ rest₃ dW wEnd)).l₃)[2]? =
        some (pieceOf (held (B32 P)) base (dB :: dt) [] (rest₃ 2 (dB :: dt))) →
      Owed32 X N P (DK.at OnBytes.Slice.frS.P.T.a) H2K.Member.rKWFull (numAt (Fk X N P).t₁ (Fk X N P).t₂ 2) base dB dt
