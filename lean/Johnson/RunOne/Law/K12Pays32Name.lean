/-- **The row's «on»**: the tables' invariant; at border 2 also the history. -/
def on32 (k : ℕ) (a : (P₃ × St₃) × (fr₃ X N P D).E.Str) : Prop :=
  On₃ X N P D (LPFD.baseAt X decN recBack) atSix (readAt tab) collN off₂ off₃ k a ∧
    (k = 2 → Hist₃ (Fk X N P) D 2 a.1)

/-- **All that is owed at the row**, a field a debt, at the base and the stretch that the row's look-up
gives. -/
structure Owed32 {W : Type} (r : Fmt.M1.Stage → ℕ) (num : Fmt.TreeSource → ℕ)
    (base : ℕ) (dB : RDT) (dt : List RDT)
    (x' : Rest (ckP .two) (fr₃ X N P D) (P₃ × St₃) W (dB :: dt)) : Prop where
  /-- owed (K12's files'): every open pin's tree (0 · 5 · 7) lies below the piece's base -/
  pins : ∀ k ∈ pinned (open₃ 2), (atSix k).1 < base
  /-- owed (K12's files': the third chain's tile) -/
  place : AtPlace (fr₃ X N P D) (pi32 P) num Sg.lstJ Sg.flC Sg.flZ Sg.flZ (fun s => r s.st) base dB dt
    (errJ (pi32 P) r dt)
  /-- owed (K12's files': the closed place's test, at the made place) -/
  joh : johOk (pi32 P) r = true
  /-- owed (K12's files') -/
  batOne : batOneOk (pi32 P) = true
  /-- owed (K12's files': labels_KW at the closed place; closed against made) -/
  labels : LabelsPub (pi32 P) num (nlKW ((oneAt X).ranges.stages.length + 2)) base
  /-- owed (K12's files', where the row's errors are the cap) -/
  cap : Err.le ((batV0 (pi32 P) r * (bsRound .two dB.entry dB.kind).w, errJ (pi32 P) r dt) :
    Err (uLT (ckP .two) (dB :: dt))) x'.err
  /-- owed (K12's files'): the fit at the place's first stage, at I -/
  fitI : ∀ s rest, (pi32 P).nums.stages = s :: rest →
      r (sgOf s).st < ((six.get i0).2 + 1) * 2 ^ ((sgOf s).C.a - aOf csKey (six.get i0).1)
  /-- owed (K12's files'): … at V -/
  fitV : ∀ s rest, (pi32 P).nums.stages = s :: rest →
      r (sgOf s).st < ((six.get i2).2 + 1) * 2 ^ ((sgOf s).C.a - aOf csKey (six.get i2).1)
  /-- owed (K12's files'): … at Omega -/
  fitO : ∀ s rest, (pi32 P).nums.stages = s :: rest →
      r (sgOf s).st < ((six.get i4).2 + 1) * 2 ^ ((sgOf s).C.a - aOf csKey (six.get i4).1)
  /-- owed (K12's files': a comparison on the list of rounds, like the fit): I's code's depth is at most the first
  stage's mask code's -/
  stageZ : ∀ s rest, (pi32 P).nums.stages = s :: rest → aOf csKey (six.get i0).1 ≤ s.Z.a

