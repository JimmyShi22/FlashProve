                           c₃ k₃ rest₁ rest₂ rest₃ dW wEnd)).l₃)[2]? =
        some (pieceOf (held (B32 P)) base (dB :: dt) [] (rest₃ 2 (dB :: dt))) →
      Owed32S X N P DK num base dB dt (rest₃ 2 (dB :: dt))) :
    ∀ (base : ℕ) (ds : List RDT) (back : List Fmt.RoundView),
      ((atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) (DK.at OnBytes.Slice.frS.P.T.a) c₁ k₁ c₂ k₂
