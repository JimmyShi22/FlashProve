/-- **`Pays` at row 3.2, at the name's terms, in the form of `keepsAt_k12₃`'s hpay.** -/
theorem pays_32_name {Zp : VerifierAndGoals.PublicFiles} (hZ : VerifierAndGoals.InScope Zp = true)
    {Z : Model.Verify.Public} (hP : Johnson.RunOne.Law.AtFreeCfg.ReadOf Zp.pol Z) {cfg : ByteArray}
    {m : Johnson.G.OfPlan.Made} (hm : madeAt Z Zp.lay cfg = .ok m) (hX : sourceOf m = .ok X)
    (hL : laterPlaces m = .ok P) (hp : (Fk X N P).planOk = true)
    (hw : (Fk X N P).wantedOk = true) (hD : (Fk X N P).data "key file" = .ok D) (DK : WholeD)
    (hD₀ : (Fk X N P).data "key file" = .ok (DK.at OnBytes.Slice.frS.P.T.a))
    (hDK : DK.at OnBytes.Slice.frS.P.T.a = Johnson.G.writtenKFull)
    (hN : rangesNumbers m = .ok N) (hoff₂ : ∀ z, off₂ z = LPFD.off₂N z) (hoff₃ : ∀ z, off₃ z = LPFD.off₃N z)
    (n : ℕ) (hn : n = 2) (r : Fmt.M1.Stage → ℕ) (num : Fmt.TreeSource → ℕ) (rdN : ℕ → ℕ)
    (oNo : Sound.Mem → ℕ) (mem : ℕ → Option Sound.Mem)
    (rd : (x : Sound.Mem) → ((sigOf csKey x.1.l).om x.2).Msg → OnBytes.Part → ℕ → GE)
    (hrd : ∀ x u part i, rd x u part i = tabP csKey (x.1.l.get x.2).1 u part i)
    (hoNI : oNo ⟨sixS, i0⟩ = 0)
    (hoNV : oNo ⟨sixS, i2⟩ = 1 + 2 * (oneAt X).ranges.stages.length)
    (hoNO : oNo ⟨sixS, i4⟩ = 1 + 2 * (oneAt X).ranges.stages.length + 2)
    (hmI : mem 0 = some ⟨sixS, i0⟩)
    (hmV : mem (1 + 2 * (oneAt X).ranges.stages.length) = some ⟨sixS, i2⟩)
    (hmO : mem (1 + 2 * (oneAt X).ranges.stages.length + 2) = some ⟨sixS, i4⟩)
    (hrow : ∀ (base : ℕ) (ds : List RDT) (back : List Fmt.RoundView),
      ((atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).p₃ ::
        (atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).l₃)[n]? =
        some (pieceOf (held (B32 P)) base ds back (rest₃ n ds)) →
      ∃ dB dt, ds = dB :: dt ∧ back = [])
    (owed : ∀ (base : ℕ) (dB : RDT) (dt : List RDT),
      ((atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).p₃ ::
        (atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).l₃)[n]? =
        some (pieceOf (held (B32 P)) base (dB :: dt) [] (rest₃ n (dB :: dt))) →
      Owed32 X N P D r num base dB dt (rest₃ n (dB :: dt))) :
    ∀ (base : ℕ) (ds : List RDT) (back : List Fmt.RoundView),
      ((atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).p₃ ::
        (atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).l₃)[n]? =
        some (pieceOf (held (B32 P)) base ds back (rest₃ n ds)) →
      Pays (fr₃ X N P D) (pi32 P) (fun s t => Seat.enterOwn s = .ok t)
        (fun s t s' => Seat.leaveOwn s t = .ok s') (held (B32 P))
        (on32 X N P D tab off₂ off₃)
        (Cl₃ X N P D (LPFD.baseAt X decN recBack) atSix (readAt tab)) n base ds back (rest₃ n ds) := by
  intro base ds back hl
  obtain ⟨dB, dt, rfl, rfl⟩ := hrow base ds back hl
  have O := owed base dB dt hl
  subst hn
  have seats := KeyAt2932.seats_six_scope (N := N) (P := P) hZ hP hm hX hp hw DK hD₀ hDK
  obtain rfl : off₂ = LPFD.off₂N := funext hoff₂
  obtain rfl : off₃ = LPFD.off₃N := funext hoff₃
  have h4 : (oneAt X).ranges.stages.length = 4 := by
    rw [(Johnson.RunOne.Law.KeyInScope.five_in_scope (N := N) (P := P) hZ hP hm hX hp).2.1]
    exact Johnson.RunOne.KeyLetters.stages_full
  have hst : (oneAt X).ranges.stages ≠ [] := by
    intro e
    rw [e] at h4
    cases h4
  have hAt : AtOk atSix LPFD.off₂N LPFD.off₃N ((oneAt X).ranges.stages.length + 2) := by
    rw [h4]
    exact LPFD.atOk_six
  have hω : LPFD.off₃N ((oneAt X).ranges.stages.length + 2) =
      (oneAt X).ranges.stages.length + 2 + 1 := by
    rw [h4]
    rfl
  obtain ⟨cA, kA, qA⟩ : ∃ cA kA, (Fk X N P).first.blocksInOrder = cA :: kA := ⟨_, _, rfl⟩
  exact pays_32M₂ (Fk X N P) (fr₃ X N P D) decN recBack (plan₁ (oneAt X)).orc tab (shapeAt X)
    (plan₁ (oneAt X)) (oneAt X).given.plan.samples [0] collN (srcOk (ownTest P)) LPFD.off₂N LPFD.off₃N
    ((oneAt X).ranges.stages.length + 2) (pi32 P) (nlKW ((oneAt X).ranges.stages.length + 2)) r rdN
    (on32 X N P D tab LPFD.off₂N LPFD.off₃N) (B32 P)
    (fun a c rs gs ha hd hS => ⟨K12FwdName.fwd_32_name X N P D tab LPFD.off₂N LPFD.off₃N hZ hP hm hX hL hp D
      (B32 P) (K12SeatsAt.fk_own_at X N P) a c rs gs ha.1 (ha.2 rfl) hd hS,
      fun e => absurd e (by decide)⟩)
    base O.pins dB dt (rest₃ 2 (dB :: dt)) (fun a h => h.1) ⟨rfl, rfl, rfl⟩
    (H2K.JointK.keyPlan_W X N P hp) (smpSt csKey oNo fun a : P₃ × St₃ => a.2.st) mem rd hrd
    (Johnson.RunOne.KeyRows23.layIdem_h₃ _ _ _ _ _ _ _ _) (fun i _ => (seats i).2)
    (fun i _ => (seats i).1) 0 rfl rfl rfl hmI (LPFD.samples_32 hZ hP hm hX hp)
    (fun a τ b ha hout => by
      obtain ⟨hshape, _, hfree, _⟩ := id (ha.1.resolve_left (fun h => h trivial))
      have hist := ha.2 rfl
      have hoV := orcV_of_shape _ _ _ _ _ _ _ hshape
      obtain ⟨_, _, hV, hA⟩ := k1_facts_32 (oneAt X) hst a.1.2.loc.w hoV
      have ew : 1 + 2 * (oneAt X).ranges.stages.length = a.1.2.loc.w := Option.some.inj hoV
      have mV : mem a.1.2.loc.w = some ⟨sixS, i2⟩ := by rw [← ew]; exact hmV
      have mO : mem (a.1.2.loc.w + 2) = some ⟨sixS, i4⟩ := by rw [← ew]; exact hmO
      have nV : oNo ⟨sixS, i2⟩ = a.1.2.loc.w := by rw [← ew]; exact hoNV
      have nO : oNo ⟨sixS, i4⟩ = a.1.2.loc.w + 2 := by rw [← ew]; exact hoNO
      -- the border's book-keeping, opened once
      have hsB := hshape
      simp only [shapeB₃, Bool.and_eq_true, beq_iff_eq] at hsB
      obtain ⟨hbd, hom, hmk, _, _, _⟩ := shape32_facts _ _ _ a.1.2 hsB.1.1.1.1.1
      have hmask : a.1.2.loc.mask.isSome = true := by rw [hmk]; rfl
      -- the fit of the key, the seeds, the guard: three other files' lemmas off the promise and the history
      have hfit := LPFD.fits_of_freeAt₃ (LPFD.baseAt X decN recBack) hZ hP hm hX hp rfl collN a.1
        (strsOf (fr₃ X N P D) a.2) hfree.record
      obtain ⟨_, sI, ⟨ρV, yV, sV⟩, sO, _, _⟩ :=
        SeedAt32.at_32' hZ hP hm hX hL hp hw hN D a.1 hist hoV hfit
      have sdI := (sI 0 rfl).1
      have sdV : ∃ ρ yv, K1.SeedIs csKey (six.get i2).1 a.1.2.st a.1.2.loc.w ρ yv :=
        ⟨ρV, yV, sV.seedIs⟩
      obtain ⟨hB, hsz, _⟩ := LPFD.guard_32_free X N P cA kA D (LPFD.baseAt X decN recBack) rfl collN qA hZ
        hP hm hX hL hp hw hN a.1 (strsOf (fr₃ X N P D) a.2) hist hfree.record _ rfl
      -- the book's places of the three
      obtain ⟨oI', qI, eI, pI, aI⟩ := hfree.placed (by decide) 0 (by decide)
      obtain rfl : 0 = oI' := Option.some.inj eI
      obtain ⟨oV', qV, eV, pV, aV⟩ := hfree.placed (by decide) 2 (by decide)
      obtain rfl : a.1.2.loc.w = oV' := Option.some.inj (hoV.symm.trans eV)
      obtain ⟨oO', qO, eO, pO, aO⟩ := hfree.omega (by decide) (by decide) 4 (by decide)
      obtain rfl : a.1.2.loc.omega = oO' := Option.some.inj eO
      rw [hom] at pO
      have shn : ∀ i : Fin six.length, i = i0 ∨ i = i2 ∨ i = i4 →
          Sound.ShownAt (Fk X N P) csKey six (seatAt six numSix atSix) (strsOf (fr₃ X N P D) a.2) i := by
        intro i hi
        refine shown_32 (Fk X N P) _ i ?_ (seats i).1 (seats i).2
        rcases hi with rfl | rfl | rfl
        · exact hfree.shown 0 (by decide)
        · exact hfree.shown 2 (by decide)
        · exact hfree.shown 4 (by decide)
      have tld : ∀ (i : Fin six.length) (hk : i.val ∈ [0, 2, 4]) (q : ℕ × ℕ),
          atSix i.val = (LPFD.off₃N q.1, q.2) → ∀ u,
          (Fk X N P).oracleAt (seatAt six numSix atSix i).1 = some u →
          ∃ T, a.1.2.book.trees[q.1]? = some T ∧ ShapeIs T.shape u := fun i hk q hq =>
        K12Left32Fit.htold_32_scope hZ hP hm hX hp hw DK hD₀ hDK hN D a.1 hist _ rfl i hk q hq
      have fits := fun i => Johnson.RunOne.KeyRows23.seatFits_one_scope (N := N) (P := P) hZ hP hm hX hp hw
        DK hD₀ hDK i
      have wrd := fun (i : Fin six.length) (hk : i.val ∈ [0, 2, 4]) (hi : i = i0 ∨ i = i2 ∨ i = i4)
          (o : ℕ) (q : ℕ × ℕ) (hq : a.1.2.book.place[o]? = some q)
          (hat : atSix i.val = (LPFD.off₃N q.1, q.2))
          (hs : ∃ ρ yv, K1.SeedIs csKey (six.get i).1 a.1.2.st o ρ yv) =>
        K12Members32.word_at_32 (Fk X N P) (fr₃ X N P D) (pi32 P) _ LPFD.off₂N LPFD.off₃N hAt hω a hmask hB
          hsz i hk (six.get i).1 (six.get i).2 rfl o q hq hat hs (fits i) (shn i hi) (tld i hk q hat)
          (fun u hu => _root_.Desc.K14.Law.Fence.depth_of_planOk (Fk X N P) "key file" D hp hD D.key₃
            (Fk X N P).lastChainFirstTreeNumber _ u hu)
      exact
        { left := K12Members32.left_32 (Fk X N P) (fr₃ X N P D) (pi32 P) _ r oNo mem a 0 hmI mV mO
            (K12Members32.cod_of_seed sdI.choose_spec.choose_spec)
            (members_of_shape _ _ _ _ _ _ _ hshape) sdI sdV sO hoNI nV nO
            (fun t ht s rest G0 Ly Dp hf j hj => by
              rw [K12Members32.dep_at_32 (Fk X N P) (fr₃ X N P D) (pi32 P) _ LPFD.off₂N LPFD.off₃N hAt hω a
                hmask hB hsz i0 (by decide) 0 qI pI aI (seats i0).1 (seats i0).2
                (tld i0 (by decide) qI aI) t ht s rest G0 Ly Dp hf j hj]
              exact O.stageZ s rest hf.1)
            (fun t ht s rest G0 Ly Dp hf j hj => by
              cases ht
              rw [hj]
              exact K12Members32.okV_of_seedOk hf (tie_six i2) sV)
            O.fitI O.fitV O.fitO
            (wrd i0 (by decide) (Or.inl rfl) 0 qI pI aI sdI)
            (wrd i2 (by decide) (Or.inr (Or.inl rfl)) _ qV pV aV sdV)
            (wrd i4 (by decide) (Or.inr (Or.inr rfl)) _ qO pO aO sO)
          seeds := fun i hi => by
            rcases hi with rfl | rfl | rfl
            · exact K12Members32.sm_of_seed₃_lo _ oNo i0 (by decide) 0 rfl hoNI a.1 sdI
            · exact K12Members32.sm_of_seed₃_lo _ oNo i2 (by decide) _ hoV nV a.1 sdV
            · exact K12Members32.sm_of_seed₃_own _ oNo i4 (by decide) a.1 hbd nO sO
          shown := shn
          numV := hV
          apartI := hA
          memV := mV
          memO := mO
          kinds := kinds_32 D a.1 hist
          sampledI := K12Members32.sampled_of_seed sdI.choose_spec.choose_spec })
    num O.place O.joh O.batOne O.labels O.cap

/-- **The tables' row 3.2 keeps, by the door `keepsAt_own`** (K12AtField.lean), fed with
`pays_32_name`: that the door takes it is hereby held by Lean. -/
theorem keeps_32_name {Zp : VerifierAndGoals.PublicFiles} (hZ : VerifierAndGoals.InScope Zp = true)
    {Z : Model.Verify.Public} (hP : Johnson.RunOne.Law.AtFreeCfg.ReadOf Zp.pol Z) {cfg : ByteArray}
    {m : Johnson.G.OfPlan.Made} (hm : madeAt Z Zp.lay cfg = .ok m) (hX : sourceOf m = .ok X)
    (hL : laterPlaces m = .ok P) (hp : (Fk X N P).planOk = true)
    (hw : (Fk X N P).wantedOk = true) (hD : (Fk X N P).data "key file" = .ok D) (DK : WholeD)
    (hD₀ : (Fk X N P).data "key file" = .ok (DK.at OnBytes.Slice.frS.P.T.a))
    (hDK : DK.at OnBytes.Slice.frS.P.T.a = Johnson.G.writtenKFull)
    (hN : rangesNumbers m = .ok N) (hoff₂ : ∀ z, off₂ z = LPFD.off₂N z) (hoff₃ : ∀ z, off₃ z = LPFD.off₃N z)
    (n : ℕ) (hn : n = 2) (r : Fmt.M1.Stage → ℕ) (num : Fmt.TreeSource → ℕ) (rdN : ℕ → ℕ)
    (oNo : Sound.Mem → ℕ) (mem : ℕ → Option Sound.Mem)
    (rd : (x : Sound.Mem) → ((sigOf csKey x.1.l).om x.2).Msg → OnBytes.Part → ℕ → GE)
    (hrd : ∀ x u part i, rd x u part i = tabP csKey (x.1.l.get x.2).1 u part i)
    (hoNI : oNo ⟨sixS, i0⟩ = 0)
    (hoNV : oNo ⟨sixS, i2⟩ = 1 + 2 * (oneAt X).ranges.stages.length)
    (hoNO : oNo ⟨sixS, i4⟩ = 1 + 2 * (oneAt X).ranges.stages.length + 2)
    (hmI : mem 0 = some ⟨sixS, i0⟩)
    (hmV : mem (1 + 2 * (oneAt X).ranges.stages.length) = some ⟨sixS, i2⟩)
    (hmO : mem (1 + 2 * (oneAt X).ranges.stages.length + 2) = some ⟨sixS, i4⟩)
    (hrow : ∀ (base : ℕ) (ds : List RDT) (back : List Fmt.RoundView),
      ((atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).p₃ ::
        (atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).l₃)[n]? =
        some (pieceOf (held (B32 P)) base ds back (rest₃ n ds)) →
      ∃ dB dt, ds = dB :: dt ∧ back = [])
    (owed : ∀ (base : ℕ) (dB : RDT) (dt : List RDT),
      ((atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).p₃ ::
        (atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).l₃)[n]? =
        some (pieceOf (held (B32 P)) base (dB :: dt) [] (rest₃ n (dB :: dt))) →
      Owed32 X N P D r num base dB dt (rest₃ n (dB :: dt)))
    (q₃ : (Key.descriptionFromSource X N P).second.blocksInOrder = c₃ :: k₃) :
    LPFD.KeepsAt (on32 X N P D tab off₂ off₃)
      (Cl₃ X N P D (LPFD.baseAt X decN recBack) atSix (readAt tab))
      ((atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).p₃ ::
        (atDesc (Key.descriptionFromSource X N P) (piecesAt (ckP .two) (Key.descriptionFromSource X N P) D c₁ k₁ c₂ k₂ c₃ k₃ rest₁
                           rest₂ rest₃ dW wEnd)).l₃) n := by
  subst hn
  exact K12AtField.keepsAt_own X N P D c₁ k₁ c₂ k₂ c₃ k₃ rest₁ rest₂ rest₃ dW wEnd
    (on32 X N P D tab off₂ off₃)
    (Cl₃ X N P D (LPFD.baseAt X decN recBack) atSix (readAt tab)) q₃
    (pays_32_name X N P D tab off₂ off₃ c₁ k₁ c₂ k₂ c₃ k₃ rest₁ rest₂ rest₃ dW wEnd hZ hP hm hX hL hp hw
      hD DK hD₀ hDK hN hoff₂ hoff₃ 2 rfl r num rdN oNo mem rd hrd hoNI hoNV hoNO hmI hmV hmO hrow owed)

end

