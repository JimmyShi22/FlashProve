/-- What the border's book-keeping says of V's number. -/
theorem orcV_of_shape (S : LinShape) (K₁ : KPlan) (a : Nat) (idx : List Nat) (src : St₃ → Bool)
    (t₁ : Nat) (s : St₃) (h : shapeB₃ S K₁ a idx src t₁ 2 s = true) : K₁.orc 2 = some s.loc.w := by
  simp only [shapeB₃, Bool.and_eq_true, beq_iff_eq] at h
  exact h.1.1.1.1.2

/-- What it says of the own group's members. -/
theorem members_of_shape (S : LinShape) (K₁ : KPlan) (a : Nat) (idx : List Nat) (src : St₃ → Bool)
    (t₁ : Nat) (s : St₃) (h : shapeB₃ S K₁ a idx src t₁ 2 s = true) :
    ∀ G0, s.st.groups[s.loc.own]? = some G0 →
      G0.members.toList = idx ++ [s.loc.w, s.loc.w + 2] := by
  simp only [shapeB₃, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨_, _, _, _, _, hgr⟩ := shape32_facts S a idx s h.1.1.1.1.1
  obtain ⟨G1, hG1, hm, _⟩ := grpIs_facts _ _ _ _ _ _ hgr
  intro G0 hG0
  obtain rfl := Option.some.inj (hG1.symm.trans hG0)
  exact hm

