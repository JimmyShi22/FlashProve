/-- **What is still owed at the row, at the seat**: three fields, all on the piece. -/
structure Owed32S (num : Fmt.TreeSource → ℕ) (base : ℕ) (dB : RDT) (dt : List RDT)
    (x' : Rest (ckP .two) (fr₃ X N P (DK.at OnBytes.Slice.frS.P.T.a)) (P₃ × St₃) W (dB :: dt)) : Prop where
  /-- owed (K12's files': the third chain's tile) -/
  place : AtPlace (fr₃ X N P (DK.at OnBytes.Slice.frS.P.T.a)) (pi32 P) num Sg.lstJ Sg.flC Sg.flZ Sg.flZ
    (fun s => H2K.Member.rKWFull s.st) base dB dt (errJ (pi32 P) H2K.Member.rKWFull dt)
  /-- owed (K12's files': labels_KW at the closed place; closed against made) -/
  labels : LabelsPub (pi32 P) num (nlKW ((oneAt X).ranges.stages.length + 2)) base
  /-- owed (K12's files', where the row's errors are the cap) -/
  cap : Err.le ((batV0 (pi32 P) H2K.Member.rKWFull * (bsRound .two dB.entry dB.kind).w,
    errJ (pi32 P) H2K.Member.rKWFull dt) : Err (uLT (ckP .two) (dB :: dt))) x'.err

