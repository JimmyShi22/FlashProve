/-- **The plan's numbers at I and V.** -/
theorem k1_facts_32 (one : OneTime) (hs : one.ranges.stages ≠ []) (w : ℕ)
    (hw : (plan₁ one).orc 2 = some w) :
    (plan₁ one).orc 0 = some 0 ∧ (plan₁ one).num 0 = some 0 ∧ (plan₁ one).num w = some 2 ∧
      0 ≠ w + 2 := by
  have hL : one.ranges.stages.length ≠ 0 := fun h => hs (List.length_eq_zero_iff.1 h)
  have e : 1 + 2 * one.ranges.stages.length = w := Option.some.inj hw
  refine ⟨rfl, rfl, ?_, by omega⟩
  subst e
  show (if (1 + 2 * one.ranges.stages.length == 0) = true then some 0
    else if (1 + 2 * one.ranges.stages.length == 1) = true then some 1
    else if (1 + 2 * one.ranges.stages.length == 1 + 2 * one.ranges.stages.length) = true then some 2
    else none) = some 2
  rw [if_neg (by simp), if_neg (by simp; omega), if_pos (by simp)]

/-- **Sound.ShownAt from the tables' own.** -/
theorem shown_32 {XI : Type} (F : FileDescription XI) (y : Strs) (i : Fin six.length)
    (h : VerifiableInference.Desc.Key.ShownAt F atSix i.val y)
    (told : (F.oracleAt (seatAt six numSix atSix i).1).isSome = true)
    (hlog : ∀ o, F.oracleAt (seatAt six numSix atSix i).1 = some o →
      o.logLength = aOf csKey (six.get i).1) :
    VerifiableInference.Desc.Sound.ShownAt F csKey six (seatAt six numSix atSix) y i := by
  obtain ⟨o, ho⟩ := Option.isSome_iff_exists.1 told
  exact fun x hx => h o ho x (by rw [hlog o ho]; exact hx)

/-- **No open row is marked as a sample row, off the history.** -/
theorem kinds_32 {X : Source} {N : H2U.PlaceNums} {P : LaterPlaces} (D : OnBytes.Maker.WholeD)
    (a : (Xi × FirstState × St₂) × St₃) (h : Hist₃ (descriptionFromSource X N P) D 2 a) :
    OnBytes.Means.OpenKinds a.2.st :=
  Johnson.RunOne.KeyWalk.openKinds_at_reached₃ D 2 a h

