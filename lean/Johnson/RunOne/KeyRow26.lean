/-! ## What reads no table of ours: riders along two statements with the same tables -/

theorem rowsHold_rides (same : E → E → Prop) {A B : Statement} (hT : SameTables A B) (val : Nat → Part → Nat → E) (g lo n : Nat)
    (hG : ∀ G', A.groups[g]? = some G' → ∃ G, B.groups[g]? = some G ∧ G.rows = G'.rows) (h : rowsHold same A val g lo n) :
    rowsHold same B val g lo n := by
  obtain ⟨G', h1, h2, h3, h4⟩ := h
  obtain ⟨G, g1, g2⟩ := hG G' h1
  exact ⟨G, g1, g2 ▸ h2, h3, fun r hr => (rowHolds_congr same hT val r).1 (h4 r (g2 ▸ hr))⟩

theorem srowAt_rides {Cells M : Type} (R : KRead Cells M) (K : KPlan) {A B : Statement} (hT : SameTables A B) (k : Nat) (w : Wit Cells Unit M)
    (hO : ∀ (o : Nat) (x' : OnBytes.Oracle), A.oracles[o]? = some x' → ∃ x : OnBytes.Oracle, B.oracles[o]? = some x ∧ x.sampled = x'.sampled ∧ x.sampleRows = x'.sampleRows)
    (h : srowAt R K A k w) : srowAt R K B k w := by
  obtain ⟨o, x', ho, hx', h1, h2, h3⟩ := h
  obtain ⟨x, hx, e1, e2⟩ := hO o x' hx'
  exact ⟨o, x, ho, hx, e1.trans h1, e2 ▸ h2, fun r hr => (rowHolds_congr _ hT _ r).1 (h3 r (e2 ▸ hr))⟩

/-! ## What Joined gives of the two statements -/

section
variable {d d' : St₂} {GU GO : OnBytes.Group}

theorem joined_none (J : Joined d d' GU GO) (o : Nat) (h : d.st.oracles[o]? = none) : d'.st.oracles[o]? = none := by
  have s := J.size
  rw [Array.getElem?_eq_none_iff] at h ⊢
  omega

theorem joined_tables (J : Joined d d' GU GO) : SameTables d'.st d.st := by
  refine ⟨J.size, fun o part => ?_⟩
  cases hx : d.st.oracles[o]? with
  | none => simp [Statement.tableBits, Statement.rowBits, Statement.placeBits, hx, joined_none J o hx]
  | some x =>
    obtain ⟨gs, hx'⟩ := J.msgs o x hx
    simp [Statement.tableBits, Statement.rowBits, Statement.placeBits, hx, hx', J.codes]

/-- A test on a message's shape says one thing at both statements. -/
theorem shapeAny_joined (J : Joined d d' GU GO) (o : Nat) (sh : OnBytes.OracleShape) :
    (d'.st.oracles[o]?).any (·.shape == sh) = (d.st.oracles[o]?).any (·.shape == sh) := by
  cases hx : d.st.oracles[o]? with
  | none => rw [joined_none J o hx]
  | some x =>
    obtain ⟨gs, hx'⟩ := J.msgs o x hx
    rw [hx']
    rfl

/-- A message behind is a message in front, the same but for its list of groups. -/
theorem joined_msgBack (J : Joined d d' GU GO) (o : Nat) (x' : OnBytes.Oracle) (h : d'.st.oracles[o]? = some x') :
    ∃ x gs, d.st.oracles[o]? = some x ∧ x' = { x with groups := gs } := by
  cases hx : d.st.oracles[o]? with
  | none =>
    rw [joined_none J o hx] at h
    cases h
  | some x =>
    obtain ⟨gs, hx'⟩ := J.msgs o x hx
    exact ⟨x, gs, rfl, Option.some.inj (h.symm.trans hx')⟩

theorem joined_sampleBack (J : Joined d d' GU GO) (o : Nat) (x' : OnBytes.Oracle) (h : d'.st.oracles[o]? = some x') :
    ∃ x : OnBytes.Oracle, d.st.oracles[o]? = some x ∧ x.sampled = x'.sampled ∧ x.sampleRows = x'.sampleRows := by
  obtain ⟨x, gs, hx, e⟩ := joined_msgBack J o x' h
  exact ⟨x, hx, by rw [e], by rw [e]⟩

/-- A group behind is a group in front with the same open rows, and no member has gone. -/
theorem joined_groupBack (J : Joined d d' GU GO) (g : Nat) (G' : OnBytes.Group) (h : d'.st.groups[g]? = some G') :
    ∃ G, d.st.groups[g]? = some G ∧ G.rows = G'.rows ∧ ∀ o ∈ G.members.toList, o ∈ G'.members.toList := by
  have mem : ∀ (G : OnBytes.Group) (o : Nat) (k : Bool), ∀ x ∈ G.members.toList, x ∈ (entered G o k).members.toList := by
    intro G o k x hx
    have hx' : x ∈ G.members := Array.mem_toList_iff.1 hx
    refine Array.mem_toList_iff.2 ?_
    show x ∈ G.members.insertIdxIfInBounds _ o
    unfold Array.insertIdxIfInBounds
    split
    · exact Array.mem_insertIdx.2 (Or.inr hx')
    · exact hx'
  by_cases hU : g = d.loc.gU
  · subst hU
    have e := Option.some.inj (h.symm.trans J.gU')
    exact ⟨GU, J.gU, by rw [e]; rfl, fun o ho => by rw [e]; exact mem _ _ _ o ho⟩
  · by_cases hO : g = d.loc.gOmega
    · subst hO
      have e := Option.some.inj (h.symm.trans J.gO')
      exact ⟨GO, J.gO, by rw [e]; rfl, fun o ho => by rw [e]; exact mem _ _ _ o (mem _ _ _ o ho)⟩
    · exact ⟨G', (J.other g hU hO).symm.trans h, rfl, fun _ ho => ho⟩

theorem msgIs_joined (J : Joined d d' GU GO) (o : Nat) (sm : Option Nat) (sp : Bool) :
    LKFU.Shape23.msgIs d'.st o sm sp = LKFU.Shape23.msgIs d.st o sm sp := by
  unfold LKFU.Shape23.msgIs
  cases hx : d.st.oracles[o]? with
  | none => rw [joined_none J o hx]
  | some x =>
    obtain ⟨gs, hx'⟩ := J.msgs o x hx
    rw [hx']
    cases sm <;> rfl

end

theorem insert_at_end₂ (m : Array Nat) (k : Nat) (h : ∀ i ∈ m.toList, i < k) :
    m.insertIdxIfInBounds (m.filter (· < k)).size k = m.push k := by
  rcases m with ⟨l⟩
  have hl : l.filter (fun i => decide (i < k)) = l :=
    List.filter_eq_self.2 fun a ha => decide_eq_true (h a ha)
  apply Array.toList_inj.1
  simp [hl]

/-- Entering a number above all members: it comes last. -/
theorem entered_last (G : OnBytes.Group) (o : Nat) (k : Bool) (l : List Nat) (hl : G.members.toList = l) (h : ∀ i ∈ l, i < o) :
    (entered G o k).members.toList = l ++ [o] := by
  show (G.members.insertIdxIfInBounds (G.members.filter (· < o)).size o).toList = _
  rw [insert_at_end₂ _ _ (by rw [hl]; exact h), Array.toList_push, hl]

/-- grpIs reads of a group its members, its rows and its mark. -/
theorem grpIs_entered (st st' : Statement) (g : Nat) (G G' : OnBytes.Group) (l l' : List Nat) (p q : Nat) (b : Bool)
    (hG : st.groups[g]? = some G) (hG' : st'.groups[g]? = some G') (hr : G'.rows = G.rows) (hm : G'.inRun = G.inRun)
    (hl : G.members.toList = l → G'.members.toList = l') (h : LKFU.Shape23.grpIs st g l p q b = true) :
    LKFU.Shape23.grpIs st' g l' p q b = true := by
  unfold LKFU.Shape23.grpIs at h ⊢
  rw [hG] at h
  rw [hG']
  simp only [Bool.and_eq_true, beq_iff_eq] at h ⊢
  obtain ⟨⟨⟨⟨m1, m2⟩, m3⟩, m4⟩, m5⟩ := h
  refine ⟨⟨⟨⟨hl m1, ?_⟩, ?_⟩, by rw [hr]; exact m4⟩, by rw [hm]; exact m5⟩
  · unfold LKFU.Shape23.plainRows at m2 ⊢
    rw [hr]
    exact m2
  · unfold LKFU.Shape23.genRows at m3 ⊢
    rw [hr]
    exact m3

/-! ## The book-keeping, forward -/

theorem shape₂_67 (S : LinShape) (a : Nat) (d d' : St₂) {GU GO : OnBytes.Group} (J : Joined d d' GU GO)
    (h : LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a 6 d) = true) : LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a 7 d') = true := by
  simp only [LKFU.Shape23.ok, LKFU.Shape23.shape₂, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at h ⊢
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18⟩ := h
  have el := J.loc
  have eb := J.book
  have er := J.roots
  have es := J.size
  have eg := J.groups
  have ec := J.codes
  have n7 : d.loc.gU = 0 ∧ d.loc.gOmega = 1 := by simpa using c7
  have n10 : d.loc.oOmega = 2 ∧ d.loc.oSp = 3 := by simpa using c10
  have g13 : LKFU.Shape23.grpIs d.st 0 [0] S.fold.index.answers S.fold.columns false = true := by simpa using c13
  have g14 : LKFU.Shape23.grpIs d.st 1 [] 0 0 false = true := by simpa using c14
  have jU := J.gU
  have jU' := J.gU'
  have jO := J.gO
  have jO' := J.gO'
  rw [n7.1] at jU jU'
  rw [n7.2] at jO jO'
  rw [n10.2] at jU' jO'
  rw [n10.1] at jO'
  have g13' : LKFU.Shape23.grpIs d'.st 0 [0, 3] S.fold.index.answers S.fold.columns false = true :=
    grpIs_entered d.st d'.st 0 GU _ [0] [0, 3] _ _ _ jU jU' rfl rfl
      (fun hl => entered_last GU 3 false [0] hl (by decide)) g13
  have g14' : LKFU.Shape23.grpIs d'.st 1 [2, 3] 0 0 false = true :=
    grpIs_entered d.st d'.st 1 GO _ [] [2, 3] _ _ _ jO jO' rfl rfl
      (fun hl => entered_last _ 3 false [2] (entered_last GO 2 false [] hl (by decide)) (by decide)) g14
  -- the split's record, for the ledger's clause
  have m3 : LKFU.Shape23.msgIs d.st 3 (some a) false = true := by
    have t : LKFU.Shape23.msgIs d.st 2 (some a) false = true ∧ LKFU.Shape23.msgIs d.st 3 (some a) false = true := by simpa using c11
    exact t.2
  obtain ⟨x3, hx3⟩ : ∃ x, d.st.oracles[3]? = some x := by
    cases hx : d.st.oracles[3]? with
    | none =>
      unfold LKFU.Shape23.msgIs at m3
      rw [hx] at m3
      cases m3
    | some x => exact ⟨x, rfl⟩
  obtain ⟨gs3, hx3'⟩ := J.msgs 3 x3 hx3
  refine ⟨c1, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa [es] using c2
  · simpa [eg] using c3
  · simpa [eb, er] using c4
  · simpa [es, eb] using c5
  · simpa [el] using c6
  · simpa [el] using c7
  · simpa [el] using c8
  · simpa [msgIs_joined J] using c9
  · simpa [el] using c10
  · simpa [msgIs_joined J] using c11
  · simpa [el] using c12
  · simpa using g13'
  · simpa using g14'
  · simpa [hx3, hx3', ec] using c15
  · simp
  · simp
  · simpa [eb, er] using c18

