theorem srow₂_rides (k : Nat) (z : P₂) (d d' : St₂) (y : Strs) (w : Wit Cells Unit M) {GU GO : OnBytes.Group} (J : Joined d d' GU GO)
    (h : (meaning₂ S K₁ R enc rad).srow k (z, d') y w) : (meaning₂ S K₁ R enc rad).srow k (z, d) y w := by
  simp only [meaning₂] at h ⊢
  split_ifs at h ⊢
  · exact h
  · exact srowAt_rides R (plan₂ S) (joined_tables J) k w (joined_sampleBack J) h

