/-- The rows on G_u, back. -/
theorem rowsU_rides (z : P₂) (d d' : St₂) (w : Wit Cells Unit M) {GU GO : OnBytes.Group} (J : Joined d d' GU GO) (lo n : Nat)
    (h : rowsHold R.same ((readers₂ S).st (z, d').2) (valOf (plan₂ S) R w) ((readers₂ S).gU (z, d').2) lo n) :
    rowsHold R.same ((readers₂ S).st (z, d).2) (valOf (plan₂ S) R w) ((readers₂ S).gU (z, d).2) lo n := by
  have h' : rowsHold R.same d'.st (valOf (plan₂ S) R w) d'.loc.gU lo n := h
  rw [J.loc] at h'
  show rowsHold R.same d.st (valOf (plan₂ S) R w) d.loc.gU lo n
  refine rowsHold_rides R.same (joined_tables J) _ _ _ _ (fun G' hG' => ?_) h'
  obtain ⟨G, h1, h2, _⟩ := joined_groupBack J _ G' hG'
  exact ⟨G, h1, h2⟩

/-- **The relation, back, at one witness**: every open item rides. -/
theorem rel₂_76 (z : P₂) (d d' : St₂) (y : Strs) (w : Wit Cells Unit M) {GU GO : OnBytes.Group} (J : Joined d d' GU GO)
    (hp : PinsStay G₂ at_ [0, 2, 3, 4, 5] (z, d) (z, d'))
    (hw : relAt F G₂ at_ (meaning₂ S K₁ R enc rad) (open₂ 7) (z, d') y w) :
    relAt F G₂ at_ (meaning₂ S K₁ R enc rad) (open₂ 6) (z, d) y w := by
  have mem : ∀ j, j ∈ open₂ 6 → j.holds F G₂ at_ (meaning₂ S K₁ R enc rad) (z, d') y w := fun j hj => hw j (by rw [open₂_76]; exact hj)
  have pin : ∀ k ∈ [0, 2, 3, 4, 5], (KItem.pin k).holds F G₂ at_ (meaning₂ S K₁ R enc rad) (z, d') y w →
      (KItem.pin k).holds F G₂ at_ (meaning₂ S K₁ R enc rad) (z, d) y w :=
    fun k hk hu => rides_pin2_at F G₂ _ _ _ _ _ _ _ (hp.smp k hk) rfl hu
  intro i hi
  have hu := mem i hi
  rw [open₂_6] at hi
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact trivial
  · exact pin 0 (by decide) hu
  · exact srow₂_rides S K₁ R enc rad 0 z d d' y w J hu
  · exact pin 2 (by decide) hu
  · exact srow₂_rides S K₁ R enc rad 2 z d d' y w J hu
  · exact (eval₂_is F G₂ at_ S K₁ R enc rad (z, d) y w).2 ((eval₂_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 hu)
  · obtain ⟨g, hg, hd⟩ := (dotU_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 hu
    have hd' : DotUAt R.same (plan₂ S).lin g d'.loc.psiSh (uOf (plan₂ S) R d'.st.codes w) (vOf' (plan₂ S) R d'.st.codes w) := hd
    rw [J.loc, J.codes] at hd'
    exact (dotU_is F G₂ at_ S K₁ R enc rad (z, d) y w).2 ⟨g, hg, hd'⟩
  · exact pin 3 (by decide) hu
  · exact srow₂_rides S K₁ R enc rad 3 z d d' y w J hu
  · exact (record_is F G₂ at_ S K₁ R enc rad (z, d) y w).2 (rowsU_rides S R z d d' w J _ _ ((record_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 hu))
  · exact (columns_is F G₂ at_ S K₁ R enc rad (z, d) y w).2 (rowsU_rides S R z d d' w J _ _ ((columns_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 hu))
  · exact pin 4 (by decide) hu
  · exact srow₂_rides S K₁ R enc rad 4 z d d' y w J hu
  · exact pin 5 (by decide) hu
  · exact srow₂_rides S K₁ R enc rad 5 z d d' y w J hu

/-- **ROW 2.6.** From the promise in front, what the joinings have laid, and the one premise on the reading: the promise behind; and at every witness the relation behind
gives the relation in front. -/
theorem row26 (z : P₂) (d d' : St₂) (y : Strs) {GU GO : OnBytes.Group} (J : Joined d d' GU GO)
    (hp : PinsStay G₂ at_ [0, 2, 3, 4, 5] (z, d) (z, d'))
    (hon : onAt F G₂ at_ (meaning₂ S K₁ R enc rad) (fun d => LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a 6 d)) (Free₂ F G₂ at_ S K₁ R coll last₁ off₂ 6) (open₂ 6) (z, d) y) :
    onAt F G₂ at_ (meaning₂ S K₁ R enc rad) (fun d => LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a 7 d)) (Free₂ F G₂ at_ S K₁ R coll last₁ off₂ 7) (open₂ 7) (z, d') y ∧
      ∀ w, relAt F G₂ at_ (meaning₂ S K₁ R enc rad) (open₂ 7) (z, d') y w → relAt F G₂ at_ (meaning₂ S K₁ R enc rad) (open₂ 6) (z, d) y w := by
  refine ⟨?_, fun w hw => rel₂_76 F G₂ at_ S K₁ R enc rad z d d' y w J hp hw⟩
  exact hp.onAt F (meaning₂ S K₁ R enc rad) _ _ _ _ (open₂ 6) (open₂ 7) y pinned₂_6 (by rw [open₂_76]; exact pinned₂_6) trivial
    (fun hsh => shape₂_67 S a d d' J hsh) (fun _ h3 => free₂_67 F G₂ at_ S K₁ R coll last₁ off₂ z d d' y J hp h3) hon

end

