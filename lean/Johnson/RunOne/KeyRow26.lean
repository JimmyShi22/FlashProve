/-! ## The promise's last letter, forward -/

theorem free₂_67 (z : P₂) (d d' : St₂) (y : Strs) {GU GO : OnBytes.Group} (J : Joined d d' GU GO)
    (hp : PinsStay G₂ at_ [0, 2, 3, 4, 5] (z, d) (z, d'))
    (hf : Free₂ F G₂ at_ S K₁ R coll last₁ off₂ 6 (z, d) y) : Free₂ F G₂ at_ S K₁ R coll last₁ off₂ 7 (z, d') y :=
  have hord : Means.InOrder d'.st := J.order hf.order
  { hf with
    record := hp.freeAt coll y hf.record
    key := by
      show d'.loc.key = _
      rw [J.loc]
      exact hf.key
    codes := by
      show d'.st.codes = _
      rw [J.codes]
      exact hf.codes
    lay := fun _ => by
      show d'.loc.oU.lay = vectorLay d'.st.codes S.fold.u S.fold.rowsHigh
      rw [J.loc, J.codes]
      exact hf.lay (by decide)
    placed := by
      show Placed (plan₂ S).orc (fun o => d'.book.place[o]?) off₂ at_ ((pinned (open₂ 7)).filter (3 ≤ ·))
      rw [J.book, open₂_76]
      exact hf.placed
    samples := fun _ _ o _ => sampleIn_of_order hord o
    rowsIn := fun _ => ⟨openIn_of_order hord _, openIn_of_order hord _⟩
    order := hord
    linOk := fun _ => by
      show OnBytes.linOk d'.st.codes S = true
      rw [J.codes]
      exact hf.linOk (by decide)
    seatU := fun _ => by
      show (d'.st.oracles[0]?).any (·.shape == S.fold.u) = true
      rw [shapeAny_joined J]
      exact hf.seatU (by decide)
    seatOmega := fun _ => by
      show (d'.st.oracles[2]?).any (·.shape == S.omega) = true
      rw [shapeAny_joined J]
      exact hf.seatOmega (by decide)
    shown := fun j hj => hf.shown j (by rw [open₂_76] at hj; exact hj)
    maskU := fun _ => by
      show MaskWith (fun i => d'.book.place[i]?) 0 1
      rw [J.book]
      exact hf.maskU (by decide) }

