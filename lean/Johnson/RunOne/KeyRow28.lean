variable {XI Cells M Smp Rec : Type} (F : FileDescription XI)
  (G₂ : Reading (P₂ × St₂) Cells M Smp Rec) (at_ : Where)
  (S : LinShape) (K₁ : KPlan) (R : KRead Cells M) (enc : (Nat → E) → Nat → E) (rad a : Nat)
  (coll : Strs → Rec → Prop) (last₁ : FirstState → Bool) (off₂ : Nat → Nat)

/-! ## The promise's last letter, forward -/

theorem free₂_89 (z : P₂) (d d' : St₂) (y : Strs) {GU GO : OnBytes.Group} {x : OnBytes.Oracle} {l : OnBytes.Ledger} {n : Nat} {row : OnBytes.Row} {mu : E}
    (P : SplitLaid S d d' GU GO x l n row mu) (hp : PinsStay G₂ at_ [0, 2, 3, 4, 5] (z, d) (z, d'))
    (hf : Free₂ F G₂ at_ S K₁ R coll last₁ off₂ 8 (z, d) y) : Free₂ F G₂ at_ S K₁ R coll last₁ off₂ 9 (z, d') y :=
  have hord : Means.InOrder d'.st := P.order hf.order
  { hf with
    record := hp.freeAt coll y hf.record
    key := by
      show d'.loc.key = _
      rw [P.loc]
      exact hf.key
    codes := by
      show d'.st.codes = _
      rw [P.codes]
      exact hf.codes
    lay := fun _ => by
      show d'.loc.oU.lay = vectorLay d'.st.codes S.fold.u S.fold.rowsHigh
      rw [P.loc, P.codes]
      exact hf.lay (by decide)
    placed := by
      show Placed (plan₂ S).orc (fun o => d'.book.place[o]?) off₂ at_ ((pinned (open₂ 9)).filter (3 ≤ ·))
      rw [P.book, pinned₂_9, ← pinned₂_8]
      exact hf.placed
    samples := fun _ _ o _ => sampleIn_of_order hord o
    rowsIn := fun _ => ⟨openIn_of_order hord _, openIn_of_order hord _⟩
    order := hord
    linOk := fun _ => by
      show OnBytes.linOk d'.st.codes S = true
      rw [P.codes]
      exact hf.linOk (by decide)
    seatU := fun _ => by
      show (d'.st.oracles[0]?).any (·.shape == S.fold.u) = true
      rw [shapeAny_split P]
      exact hf.seatU (by decide)
    seatOmega := fun _ => by
      show (d'.st.oracles[2]?).any (·.shape == S.omega) = true
      rw [shapeAny_split P]
      exact hf.seatOmega (by decide)
    shown := fun j hj => hf.shown j (by rw [pinned₂_8]; rw [pinned₂_9] at hj; exact hj)
    maskU := fun _ => by
      show MaskWith (fun i => d'.book.place[i]?) 0 1
      rw [P.book]
      exact hf.maskU (by decide) }

/-! ## The items that ride -/

theorem srow₂_ridesS (k : Nat) (z : P₂) (d d' : St₂) (y : Strs) (w : Wit Cells Unit M) {GU GO : OnBytes.Group} {x : OnBytes.Oracle} {l : OnBytes.Ledger} {n : Nat}
    {row : OnBytes.Row} {mu : E} (P : SplitLaid S d d' GU GO x l n row mu)
    (h : (meaning₂ S K₁ R enc rad).srow k (z, d') y w) : (meaning₂ S K₁ R enc rad).srow k (z, d) y w := by
  simp only [meaning₂] at h ⊢
  split_ifs at h ⊢
  · exact h
  · exact srowAt_rides R (plan₂ S) (split_tables P) k w (split_sampleBack P) h

theorem take_drop_push {α : Type} (L : List α) (x : α) (lo n : Nat) (h : lo + n ≤ L.length) :
    ((L ++ [x]).drop lo).take n = (L.drop lo).take n := by
  rw [List.drop_append_of_le_length (by omega), List.take_append_of_le_length (by rw [List.length_drop]; omega)]

/-- The elder rows on G_u, back: those below the new row. -/
theorem rowsU_ridesS (z : P₂) (d d' : St₂) (w : Wit Cells Unit M) {GU GO : OnBytes.Group} {x : OnBytes.Oracle} {l : OnBytes.Ledger} {n : Nat}
    {row : OnBytes.Row} {mu : E} (P : SplitLaid S d d' GU GO x l n row mu) (lo m : Nat) (hlm : lo + m ≤ GU.rows.size)
    (h : rowsHold R.same ((readers₂ S).st (z, d').2) (valOf (plan₂ S) R w) ((readers₂ S).gU (z, d').2) lo m) :
    rowsHold R.same ((readers₂ S).st (z, d).2) (valOf (plan₂ S) R w) ((readers₂ S).gU (z, d).2) lo m := by
  have h' : rowsHold R.same d'.st (valOf (plan₂ S) R w) d'.loc.gU lo m := h
  rw [P.loc] at h'
  show rowsHold R.same d.st (valOf (plan₂ S) R w) d.loc.gU lo m
  obtain ⟨G', h1, _, h3, h4⟩ := h'
  have e := Option.some.inj (h1.symm.trans P.gU')
  refine ⟨GU, P.gU, hlm, h3, fun r hr => (rowHolds_congr _ (split_tables P) _ r).1 (h4 r ?_)⟩
  rw [e]
  show r ∈ ((GU.rows.push _).toList.drop lo).take m
  rw [Array.toList_push, take_drop_push _ _ _ _ (by simpa using hlm)]
  exact hr

