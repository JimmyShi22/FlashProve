/-! ## (Fold), back -/

section
variable {K : Type} [Field K] (ρ : Model.Reading K)
open _root_.Desc.K14.Law (FoldEq eqK entry_eq onOmega onU)

/-- The tables' «Fold» at «ρ x = ρ y» is FoldEq at the readings. -/
theorem foldAt_iff_foldEq (S : LinShape) (psi zeta : List E) (u om : Nat → E) :
    FoldAt (fun a b => ρ.val a = ρ.val b) S psi zeta u om ↔
      FoldEq S ((psi.take S.kLo).map ρ.val) (zeta.map ρ.val) (fun j => ρ.val (om j)) (fun k => ρ.val (u k)) := by
  unfold FoldAt evalEq FoldEq
  beta_reduce
  rw [sumE_read ρ.val ρ.zero ρ.add, sumE_read ρ.val ρ.zero ρ.add]
  have e1 : ∀ j ∈ Finset.range S.matrixRows, ρ.val (mulE ((Tensor.eq zeta).entry j) (om j)) =
      eqK (zeta.map ρ.val) j * ρ.val (om j) := fun j _ => by
    rw [ρ.mul, entry_eq, ρ.one, one_mul]
  have e2 : ∀ j ∈ Finset.range S.matrixRows, ρ.val (mulE ((Tensor.eq zeta).entry j) (readU S psi u j)) =
      ∑ t ∈ Finset.range (2 ^ S.kLo), eqK ((psi.take S.kLo).map ρ.val) t * eqK (zeta.map ρ.val) j * ρ.val (u (t + 2 ^ S.kLo * j)) := fun j _ => by
    unfold readU evalEq
    rw [ρ.mul, entry_eq, ρ.one, one_mul, sumE_read ρ.val ρ.zero ρ.add, Finset.mul_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [ρ.mul, entry_eq, ρ.one, one_mul]
    ring
  rw [Finset.sum_congr rfl e1, Finset.sum_congr rfl e2]

end


/-! ## (Fold), back: out of the two rows that SPLIT has laid -/

section
variable {XI Cells M Smp Rec : Type} (F : FileDescription XI)
  (G₂ : Reading (P₂ × St₂) Cells M Smp Rec) (at_ : Where)
  (S : LinShape) (K₁ : KPlan) (R : KRead Cells M) (enc : (Nat → E) → Nat → E) (rad a : Nat)
  (coll : Strs → Rec → Prop) (last₁ : FirstState → Bool) (off₂ : Nat → Nat)
variable {K : Type} [Field K] (ρ : Model.Reading K)
open _root_.Desc.K14.Law (FoldEq onOmega onU says_of_add split_coefficient foldMeansW placed_of_seated Seated)

/-- The one row at place lo of a list of rows that ends there. -/
theorem last_row_holds (same : E → E → Prop) (St : Statement) (val : Nat → Part → Nat → E) (g lo : Nat) (G : OnBytes.Group) (r : OnBytes.Row)
    (hG : St.groups[g]? = some { G with rows := G.rows.push r }) (hlo : G.rows.size = lo) (h : rowsHold same St val g lo 1) :
    RowHolds same St val r := by
  obtain ⟨G', h1, _, _, h4⟩ := h
  have e := Option.some.inj (h1.symm.trans hG)
  refine h4 r ?_
  rw [e]
  show r ∈ ((G.rows.push r).toList.drop lo).take 1
  rw [Array.toList_push, List.drop_append_of_le_length (by simp [hlo]), List.drop_eq_nil_of_le (by simp [hlo])]
  simp

/-- **(Fold), back.** The two rows hold at the witness; they add up to (fold)'s row; what that row says is FoldEq; that is the tables' «Fold». -/
theorem fold_back (d d' : St₂) (w : Wit Cells Unit M) {GU GO : OnBytes.Group} {x : OnBytes.Oracle} {l : OnBytes.Ledger} {n : Nat} {row : OnBytes.Row} {mu : E}
    (P : SplitLaid S d d' GU GO x l n row mu) (hsame : R.same = fun x y => ρ.val x = ρ.val y)
    (hU0 : d.loc.oU.oracle = 0) (hO2 : d.loc.oOmega = 2)
    (hlay : d.loc.oU.lay = vectorLay d.st.codes S.fold.u S.fold.rowsHigh) (hlin : OnBytes.linOk d.st.codes S = true)
    (hsU : (d.st.oracles[0]?).any (·.shape == S.fold.u) = true) (hsO : (d.st.oracles[2]?).any (·.shape == S.omega) = true)
    (sizeO : GO.rows.size = 0) (lo : Nat) (sizeU : GU.rows.size = lo)
    (hO : rowsHold R.same d'.st (valOf (plan₂ S) R w) d.loc.gOmega 0 1)
    (hU : rowsHold R.same d'.st (valOf (plan₂ S) R w) d.loc.gU lo 1) :
    FoldAt R.same S d.loc.psiSh d.loc.zFd (uOf (plan₂ S) R d.st.codes w) (omOf (plan₂ S) R d.st.codes w) := by
  have rO := last_row_holds R.same d'.st _ _ 0 GO _ P.gO' sizeO hO
  have rU := last_row_holds R.same d'.st _ _ lo GU _ P.gU' sizeU hU
  rw [hsame] at rO rU ⊢
  have sO := (rowHolds_iff_says_of_rowIn ρ d'.st _ _ _ P.inO).1 rO
  have sU := (rowHolds_iff_says_of_rowIn ρ d'.st _ _ _ P.inU).1 rU
  have sR : Means.Says ρ d'.st row fun o pt i => ρ.val (valOf (plan₂ S) R w o pt i) :=
    says_of_add ρ d'.st _ _ row (fun o pt i => split_coefficient ρ row GO.members d.loc.oSp n mu o pt i)
      (by
        show ρ.val mu + ρ.val (subE row.target mu) = ρ.val row.target
        rw [ρ.sub]
        ring) _ sO sU
  -- the two messages are seated, behind as in front
  obtain ⟨xU, hxU, shU⟩ : ∃ x0, d.st.oracles[0]? = some x0 ∧ x0.shape = S.fold.u := by
    cases hx : d.st.oracles[0]? with
    | none =>
      rw [hx] at hsU
      cases hsU
    | some x0 =>
      rw [hx] at hsU
      exact ⟨x0, rfl, by simpa using hsU⟩
  obtain ⟨xO, hxO, shO⟩ : ∃ x0, d.st.oracles[2]? = some x0 ∧ x0.shape = S.omega := by
    cases hx : d.st.oracles[2]? with
    | none =>
      rw [hx] at hsO
      cases hsO
    | some x0 =>
      rw [hx] at hsO
      exact ⟨x0, rfl, by simpa using hsO⟩
  obtain ⟨lgU, hxU'⟩ := split_msg P 0 xU hxU
  obtain ⟨lgO, hxO'⟩ := split_msg P 2 xO hxO
  have seated : Seated d'.st d.st.codes S d.loc :=
    ⟨P.codes, by rw [hO2, hU0]; decide, ⟨{ xO with ledger := lgO }, by rw [hO2]; exact hxO', shO⟩,
      ⟨{ xU with ledger := lgU }, by rw [hU0]; exact hxU', shU⟩, hlay⟩
  have hF := (foldMeansW ρ d'.st S d.loc _ row P.made (placed_of_seated seated hlin) _).1 sR
  refine (foldAt_iff_foldEq ρ S d.loc.psiSh d.loc.zFd _ _).2 ?_
  have e1 : (fun j => ρ.val (omOf (plan₂ S) R d.st.codes w j)) =
      _root_.Desc.K14.Law.omegaOf d.loc (linLayOmega d.st.codes S) (fun o pt i => ρ.val (valOf (plan₂ S) R w o pt i)) := by
    funext j
    simp [omOf, valOf, plan₂, _root_.Desc.K14.Law.omegaOf, hO2]
  have e2 : (fun k => ρ.val (uOf (plan₂ S) R d.st.codes w k)) =
      _root_.Desc.K14.Law.uOf d.loc (fun o pt i => ρ.val (valOf (plan₂ S) R w o pt i)) := by
    funext k
    simp [uOf, valOf, plan₂, _root_.Desc.K14.Law.uOf, hU0, hlay]
  rw [e1, e2]
  exact hF

/-- **What row 2.8 takes from others, by name.** -/
structure NotOurs₂₈ (z : P₂) (d d' : St₂) : Prop where
  /-- the letter «same» is «reads as one element», of a field -/
  sameRho : R.same = fun x y => ρ.val x = ρ.val y
  /-- the reading gives one sample at the five pinned seats, and one record of the stored table, in front and behind -/
  samePins : PinsStay G₂ at_ [0, 2, 3, 4, 5] (z, d) (z, d')

/-- **The relation, back, at one witness.** -/
theorem rel₂_98 (z : P₂) (d d' : St₂) (y : Strs) (w : Wit Cells Unit M) {GU GO : OnBytes.Group} {x : OnBytes.Oracle} {l : OnBytes.Ledger} {n : Nat}
    {row : OnBytes.Row} {mu : E} (P : SplitLaid S d d' GU GO x l n row mu) (N : NotOurs₂₈ G₂ at_ R ρ z d d')
    (hsh : LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a 8 d) = true) (hf : Free₂ F G₂ at_ S K₁ R coll last₁ off₂ 8 (z, d) y)
    (hw : relAt F G₂ at_ (meaning₂ S K₁ R enc rad) (open₂ 9) (z, d') y w) :
    relAt F G₂ at_ (meaning₂ S K₁ R enc rad) (open₂ 8) (z, d) y w := by
  have mem : ∀ j, j ∈ open₂ 9 → j.holds F G₂ at_ (meaning₂ S K₁ R enc rad) (z, d') y w := hw
  have pin : ∀ k ∈ [0, 2, 3, 4, 5], (KItem.pin k).holds F G₂ at_ (meaning₂ S K₁ R enc rad) (z, d') y w →
      (KItem.pin k).holds F G₂ at_ (meaning₂ S K₁ R enc rad) (z, d) y w :=
    fun k hk hu => rides_pin2_at F G₂ _ _ _ _ _ _ _ (N.samePins.smp k hk) rfl hu
  -- what the book-keeping in front says of the numbers and of the two groups' rows
  simp only [LKFU.Shape23.ok, LKFU.Shape23.shape₂, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at hsh
  obtain ⟨_, _, _, _, _, _, c7, c8, _, c10, _, _, c13, c14, _, _, _⟩ := hsh
  have n7 : d.loc.gU = 0 ∧ d.loc.gOmega = 1 := by simpa using c7
  have n8 : d.loc.oU.oracle = 0 ∧ d.loc.firstMask = some 1 := by simpa using c8
  have n10 : d.loc.oOmega = 2 ∧ d.loc.oSp = 3 := by simpa using c10
  have g13 : LKFU.Shape23.grpIs d.st 0 [0, 3] S.fold.index.answers S.fold.columns false = true := by simpa using c13
  have g14 : LKFU.Shape23.grpIs d.st 1 [2, 3] 0 0 false = true := by simpa using c14
  have sizeU : GU.rows.size = S.fold.index.answers + S.fold.columns := by
    have jU := P.gU
    rw [n7.1] at jU
    unfold LKFU.Shape23.grpIs at g13
    rw [jU] at g13
    simp only [Bool.and_eq_true, beq_iff_eq] at g13
    exact g13.1.2
  have sizeO : GO.rows.size = 0 := by
    have jO := P.gO
    rw [n7.2] at jO
    unfold LKFU.Shape23.grpIs at g14
    rw [jO] at g14
    simp only [Bool.and_eq_true, beq_iff_eq] at g14
    exact g14.1.2
  intro i hi
  rw [open₂_8] at hi
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact trivial
  · exact pin 0 (by decide) (mem _ (by decide))
  · exact srow₂_ridesS S K₁ R enc rad 0 z d d' y w P (mem (.srow 0) (by decide))
  · exact pin 2 (by decide) (mem _ (by decide))
  · exact srow₂_ridesS S K₁ R enc rad 2 z d d' y w P (mem (.srow 2) (by decide))
  · exact (eval₂_is F G₂ at_ S K₁ R enc rad (z, d) y w).2 ((eval₂_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 (mem _ (by decide)))
  · exact pin 3 (by decide) (mem _ (by decide))
  · exact srow₂_ridesS S K₁ R enc rad 3 z d d' y w P (mem (.srow 3) (by decide))
  · exact (record_is F G₂ at_ S K₁ R enc rad (z, d) y w).2 (rowsU_ridesS S R z d d' w P _ _ (by rw [sizeU]; exact Nat.le_add_right _ _ |>.trans_eq' (by simp [plan₂]))
      ((record_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 (mem _ (by decide))))
  · exact (columns_is F G₂ at_ S K₁ R enc rad (z, d) y w).2 (rowsU_ridesS S R z d d' w P _ _ (by rw [sizeU]; exact Nat.le_of_eq (by simp [plan₂]))
      ((columns_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 (mem _ (by decide))))
  · exact pin 4 (by decide) (mem _ (by decide))
  · exact srow₂_ridesS S K₁ R enc rad 4 z d d' y w P (mem (.srow 4) (by decide))
  · exact pin 5 (by decide) (mem _ (by decide))
  · exact srow₂_ridesS S K₁ R enc rad 5 z d d' y w P (mem (.srow 5) (by decide))
  · -- «Fold»
    have hO := (foldO_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 (mem _ (by decide))
    have hU := (foldU_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 (mem _ (by decide))
    have hO' : rowsHold R.same d'.st (valOf (plan₂ S) R w) d'.loc.gOmega 0 1 := hO
    have hU' : rowsHold R.same d'.st (valOf (plan₂ S) R w) d'.loc.gU (S.fold.index.answers + S.fold.columns) 1 := hU
    rw [P.loc] at hO' hU'
    exact (fold_is F G₂ at_ S K₁ R enc rad (z, d) y w).2
      (fold_back S R ρ d d' w P N.sameRho n8.1 n10.1 (hf.lay (by decide)) (hf.linOk (by decide)) (hf.seatU (by decide)) (hf.seatOmega (by decide))
        sizeO _ sizeU hO' hU')
  · -- «DotOm» rides
    obtain ⟨g, hg, hd⟩ := (dotOm₂_is F G₂ at_ S K₁ R enc rad (z, d') y w).1 (mem _ (by decide))
    have hd' : DotOmAt R.same (plan₂ S).lin g d'.loc.psiSh (omOf (plan₂ S) R d'.st.codes w) (vOf' (plan₂ S) R d'.st.codes w) := hd
    rw [P.loc, P.codes] at hd'
    exact (dotOm₂_is F G₂ at_ S K₁ R enc rad (z, d) y w).2 ⟨g, hg, hd'⟩

/-- **ROW 2.8.** From the promise in front, what SPLIT has laid, and two premises on letters: the promise behind; and at every witness the relation behind gives the relation in front. -/
theorem row28 (z : P₂) (d d' : St₂) (y : Strs) {GU GO : OnBytes.Group} {x : OnBytes.Oracle} {l : OnBytes.Ledger} {n : Nat} {row : OnBytes.Row} {mu : E}
    (P : SplitLaid S d d' GU GO x l n row mu) (N : NotOurs₂₈ G₂ at_ R ρ z d d')
    (hon : onAt F G₂ at_ (meaning₂ S K₁ R enc rad) (fun d => LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a 8 d)) (Free₂ F G₂ at_ S K₁ R coll last₁ off₂ 8) (open₂ 8) (z, d) y) :
    onAt F G₂ at_ (meaning₂ S K₁ R enc rad) (fun d => LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a 9 d)) (Free₂ F G₂ at_ S K₁ R coll last₁ off₂ 9) (open₂ 9) (z, d') y ∧
      ∀ w, relAt F G₂ at_ (meaning₂ S K₁ R enc rad) (open₂ 9) (z, d') y w → relAt F G₂ at_ (meaning₂ S K₁ R enc rad) (open₂ 8) (z, d) y w := by
  refine ⟨?_, fun w hw => ?_⟩
  · exact N.samePins.onAt F (meaning₂ S K₁ R enc rad) _ _ _ _ (open₂ 8) (open₂ 9) y pinned₂_8 pinned₂_9 trivial
      (fun hsh => shape₂_89 S a d d' P hsh) (fun _ h3 => free₂_89 F G₂ at_ S K₁ R coll last₁ off₂ z d d' y P N.samePins h3) hon
  · rcases hon with hn | ⟨hsh, _, h3, _⟩
    · exact absurd trivial hn
    · exact rel₂_98 F G₂ at_ S K₁ R enc rad a coll last₁ off₂ ρ z d d' y w P N hsh h3 hw

end

