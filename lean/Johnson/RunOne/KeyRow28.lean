/-! ## What SplitLaid gives of the two statements -/

section
variable {S : LinShape} {d d' : St₂} {GU GO : OnBytes.Group} {x : OnBytes.Oracle} {l : OnBytes.Ledger} {n : Nat} {row : OnBytes.Row} {mu : E}

theorem split_none (P : SplitLaid S d d' GU GO x l n row mu) (o : Nat) (h : d.st.oracles[o]? = none) : d'.st.oracles[o]? = none := by
  have s := P.size
  rw [Array.getElem?_eq_none_iff] at h ⊢
  omega

/-- Every message behind is the same record but for its ledger. -/
theorem split_msg (P : SplitLaid S d d' GU GO x l n row mu) (o : Nat) (x0 : OnBytes.Oracle) (h : d.st.oracles[o]? = some x0) :
    ∃ lg, d'.st.oracles[o]? = some { x0 with ledger := lg } := by
  by_cases e : o = d.loc.oSp
  · subst e
    have ex : x0 = x := Option.some.inj (h.symm.trans P.sp)
    rw [ex]
    exact ⟨_, P.sp'⟩
  · exact ⟨x0.ledger, (P.msgs o e).trans h⟩

theorem split_tables (P : SplitLaid S d d' GU GO x l n row mu) : SameTables d'.st d.st := by
  refine ⟨P.size, fun o part => ?_⟩
  cases hx : d.st.oracles[o]? with
  | none => simp [Statement.tableBits, Statement.rowBits, Statement.placeBits, hx, split_none P o hx]
  | some x0 =>
    obtain ⟨lg, hx'⟩ := split_msg P o x0 hx
    simp [Statement.tableBits, Statement.rowBits, Statement.placeBits, hx, hx', P.codes]

theorem split_sampleBack (P : SplitLaid S d d' GU GO x l n row mu) (o : Nat) (x' : OnBytes.Oracle) (h : d'.st.oracles[o]? = some x') :
    ∃ x0 : OnBytes.Oracle, d.st.oracles[o]? = some x0 ∧ x0.sampled = x'.sampled ∧ x0.sampleRows = x'.sampleRows := by
  cases hx : d.st.oracles[o]? with
  | none =>
    rw [split_none P o hx] at h
    cases h
  | some x0 =>
    obtain ⟨lg, hx'⟩ := split_msg P o x0 hx
    have e : x' = { x0 with ledger := lg } := Option.some.inj (h.symm.trans hx')
    exact ⟨x0, rfl, by rw [e], by rw [e]⟩

theorem msgIs_split (P : SplitLaid S d d' GU GO x l n row mu) (o : Nat) (sm : Option Nat) (sp : Bool) :
    LKFU.Shape23.msgIs d'.st o sm sp = LKFU.Shape23.msgIs d.st o sm sp := by
  unfold LKFU.Shape23.msgIs
  cases hx : d.st.oracles[o]? with
  | none => rw [split_none P o hx]
  | some x0 =>
    obtain ⟨lg, hx'⟩ := split_msg P o x0 hx
    rw [hx']
    cases sm <;> rfl

theorem shapeAny_split (P : SplitLaid S d d' GU GO x l n row mu) (o : Nat) (sh : OnBytes.OracleShape) :
    (d'.st.oracles[o]?).any (·.shape == sh) = (d.st.oracles[o]?).any (·.shape == sh) := by
  cases hx : d.st.oracles[o]? with
  | none => rw [split_none P o hx]
  | some x0 =>
    obtain ⟨lg, hx'⟩ := split_msg P o x0 hx
    rw [hx']
    rfl

end

/-- grpIs at a group that has gained one plain row. -/
theorem grpIs_pushed (st st' : Statement) (g : Nat) (G : OnBytes.Group) (r : OnBytes.Row) (l : List Nat) (p q : Nat) (b : Bool)
    (hG : st.groups[g]? = some G) (hG' : st'.groups[g]? = some { G with rows := G.rows.push r }) (hr : r.kind = .plain)
    (h : LKFU.Shape23.grpIs st g l p q b = true) : LKFU.Shape23.grpIs st' g l (p + 1) q b = true := by
  unfold LKFU.Shape23.grpIs at h ⊢
  rw [hG] at h
  rw [hG']
  simp only [Bool.and_eq_true, beq_iff_eq] at h ⊢
  obtain ⟨⟨⟨⟨m1, m2⟩, m3⟩, m4⟩, m5⟩ := h
  refine ⟨⟨⟨⟨m1, ?_⟩, ?_⟩, ?_⟩, m5⟩
  · unfold LKFU.Shape23.plainRows at m2 ⊢
    simp only [Array.toList_push, List.filter_append, List.length_append, m2]
    simp [hr]
  · unfold LKFU.Shape23.genRows at m3 ⊢
    simp only [Array.toList_push, List.filter_append, List.length_append, m3]
    simp [hr]
  · simp only [Array.size_push]
    omega

/-! ## The book-keeping, forward -/

theorem shape₂_89 (S : LinShape) (a : Nat) (d d' : St₂) {GU GO : OnBytes.Group} {x : OnBytes.Oracle} {l : OnBytes.Ledger} {n : Nat} {row : OnBytes.Row} {mu : E}
    (P : SplitLaid S d d' GU GO x l n row mu)
    (h : LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a 8 d) = true) : LKFU.Shape23.ok (LKFU.Shape23.shape₂ S a 9 d') = true := by
  simp only [LKFU.Shape23.ok, LKFU.Shape23.shape₂, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at h ⊢
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18⟩ := h
  have el := P.loc
  have eb := P.book
  have er := P.roots
  have es := P.size
  have eg := P.groups
  have ec := P.codes
  have n7 : d.loc.gU = 0 ∧ d.loc.gOmega = 1 := by simpa using c7
  have n10 : d.loc.oOmega = 2 ∧ d.loc.oSp = 3 := by simpa using c10
  have g13 : LKFU.Shape23.grpIs d.st 0 [0, 3] S.fold.index.answers S.fold.columns false = true := by simpa using c13
  have g14 : LKFU.Shape23.grpIs d.st 1 [2, 3] 0 0 false = true := by simpa using c14
  have jU := P.gU
  have jU' := P.gU'
  have jO := P.gO
  have jO' := P.gO'
  have hx3 := P.sp
  have hx3' := P.sp'
  rw [n7.1] at jU jU'
  rw [n7.2] at jO jO'
  rw [n10.2] at hx3 hx3'
  have g13' : LKFU.Shape23.grpIs d'.st 0 [0, 3] (S.fold.index.answers + 1) S.fold.columns false = true :=
    grpIs_pushed d.st d'.st 0 GU _ [0, 3] _ _ _ jU jU' rfl g13
  have g14' : LKFU.Shape23.grpIs d'.st 1 [2, 3] (0 + 1) 0 false = true :=
    grpIs_pushed d.st d'.st 1 GO _ [2, 3] _ _ _ jO jO' rfl g14
  have hl := P.ledger
  have hleft := P.left
  have back : l.left - 1 + 1 = l.left := by omega
  refine ⟨c1, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa [es] using c2
  · simpa [eg] using c3
  · simpa [eb, er] using c4
  · simpa [es, eb] using c5
  · simpa [el] using c6
  · simpa [el] using c7
  · simpa [el] using c8
  · simpa [msgIs_split P] using c9
  · simpa [el] using c10
  · simpa [msgIs_split P] using c11
  · simpa [el] using c12
  · simpa using g13'
  · simpa using g14'
  · simpa [hx3, hx3', hl, ec, back] using c15
  · simp
  · simp
  · simpa [eb, er] using c18

