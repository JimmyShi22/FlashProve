/-- o_u has its table, which holds a row's message and its random tail: FROM o_u's SEAT ALONE (placedU_of_seated asks Omega's seat too, which is not there before Omega is sent). After that law's proof. -/
theorem placedU_of_u {T : Statement} {codes : Codes} {S : LinShape} {l : _root_.Desc.K14.Lin} (hc : T.codes = codes)
    (hu : ∃ x, T.oracles[l.oU.oracle]? = some x ∧ x.shape = S.fold.u) (hlay : l.oU.lay = vectorLay codes S.fold.u S.fold.rowsHigh)
    (hok : linOk codes S = true) : PlacedU T S.fold l.oU ∧ S.fold.index.ok = true := by
  obtain ⟨y, hy, sy⟩ := hu
  simp only [linOk, Bool.and_eq_true, decide_eq_true_eq] at hok
  have hF : foldeqOk codes S.fold = true := by tauto
  simp only [foldeqOk, FoldeqShape.ok, Bool.and_eq_true, decide_eq_true_eq] at hF
  have c0 : S.fold.index.ok = true := by tauto
  have c1 : 0 < S.fold.u.mainRows := by tauto
  have c2 : S.fold.entries ≤ vectorRoom codes S.fold.u S.fold.rowsHigh := by tauto
  have tU := tableBits_main T _ y hy (by rw [sy]; omega) S.fold.rowsHigh
  rw [sy, hc] at tU
  have hE : S.fold.entries ≤ 2 ^ l.oU.lay.bits := by
    rw [hlay]
    exact Nat.le_trans c2 (vectorRoom_le _ _ _)
  have e2 : S.fold.index.code.ell ≤ S.fold.tailFirst := le_roundUp _ _ (Nat.two_pow_pos _)
  unfold FoldeqShape.entries at hE
  refine ⟨⟨tU.1, by rw [tU.2, hlay], ceilLog2_le _ _ (by omega), hE, ?_⟩, c0⟩
  unfold FoldeqShape.tailFirst
  exact Nat.mul_mod_left _ _

/-- One answer's clause of the tables' «RecRow» at «ρ x = ρ y» is RecEq at the readings. -/
theorem recAt_iff_recEq (s : IndexShape) (seed : SampleSeed) (i : Nat) (gamma : List E) (record wt : Array E) (u : Nat → E)
    (hw : ∀ r, r < s.rows → ρ.val (wt.getD r zeroE) = eqK (gamma.map ρ.val) r) :
    ρ.val (addE (sumE s.plain fun q => mulE ((Tensor.eq seed.z).entry q) (u q)) (sumE 3 fun t => mulE (mulE seed.beta (thetaE t)) (u (s.padPlace i t)))) =
        ρ.val (sumE s.rows fun r => mulE ((Tensor.eq gamma).entry r) (record.getD (r * s.answers + i) zeroE)) ↔
      RecEq s (seed.z.map ρ.val) (ρ.val seed.beta) (fun t => ρ.val (thetaE t)) i (fun r => ρ.val (wt.getD r zeroE))
        (fun k => ρ.val (record.getD k zeroE)) (fun k => ρ.val (u k)) := by
  unfold RecEq
  rw [ρ.add, sumE_read ρ.val ρ.zero ρ.add, sumE_read ρ.val ρ.zero ρ.add, sumE_read ρ.val ρ.zero ρ.add]
  have e1 : ∀ q ∈ Finset.range s.plain, ρ.val (mulE ((Tensor.eq seed.z).entry q) (u q)) = eqK (seed.z.map ρ.val) q * ρ.val (u q) := fun q _ => by
    rw [ρ.mul, entry_eq, ρ.one, one_mul]
  have e2 : ∀ t ∈ Finset.range 3, ρ.val (mulE (mulE seed.beta (thetaE t)) (u (s.padPlace i t))) =
      ρ.val seed.beta * ρ.val (thetaE t) * ρ.val (u (s.padPlace i t)) := fun t _ => by
    rw [ρ.mul, ρ.mul]
  have e3 : ∀ r ∈ Finset.range s.rows, ρ.val (mulE ((Tensor.eq gamma).entry r) (record.getD (r * s.answers + i) zeroE)) =
      ρ.val (wt.getD r zeroE) * ρ.val (record.getD (r * s.answers + i) zeroE) := fun r hr => by
    rw [ρ.mul, entry_eq, ρ.one, one_mul, hw r (Finset.mem_range.1 hr)]
  rw [Finset.sum_congr rfl e1, Finset.sum_congr rfl e2, Finset.sum_congr rfl e3]

end

section
variable {XI Cells M Smp Rec : Type} (F : FileDescription XI)
  (G₂ : Reading (P₂ × St₂) Cells M Smp Rec) (at_ : Where)
  (p : Par) (K₁ : KPlan) (R : KRead Cells M) (enc : (Nat → E) → Nat → E) (rad a : Nat)
  (coll : Strs → Rec → Prop) (last₁ : FirstState → Bool) (off₂ : Nat → Nat)
variable {K : Type} [Field K] (ρ : Model.Reading K)
open _root_.Desc.K14.Law (recMeansW mem_mapM weights_val)

/-- **«RecRow», back.** Every row that (rec_gamma) has laid holds at the witness; what each says is RecEq; that is one answer's clause of the tables' «RecRow». -/
theorem rec_back (d d' : St₂) (w : Wit Cells Unit M) {GU : OnBytes.Group} {rows : List OnBytes.Row} (P : RecLaid p d d' GU rows)
    (hsame : R.same = fun x y => ρ.val x = ρ.val y) (hU0 : d.loc.oU.oracle = 0)
    (hlay : d.loc.oU.lay = vectorLay d.st.codes p.S.fold.u p.S.fold.rowsHigh) (hlin : OnBytes.linOk d.st.codes p.S = true)
    (hsU : (d.st.oracles[0]?).any (·.shape == p.S.fold.u) = true) (hord : Means.InOrder d'.st) (sizeU : GU.rows.size = 0)
    (h : rowsHold R.same d'.st (valOf (plan₂ p.S) R w) d.loc.gU 0 p.S.fold.index.answers) :
    RecRowAt R.same p.S.fold.index d.loc.key (d.loc.psiSh.drop p.S.kLo) (uOf (plan₂ p.S) R d.st.codes w) := by
  obtain ⟨G', h1, _, _, h4⟩ := h
  have e := Option.some.inj (h1.symm.trans P.gU')
  have hnil : GU.rows.toList = [] := by
    have : GU.rows.toList.length = 0 := by rw [Array.length_toList]; exact sizeU
    exact List.length_eq_zero_iff.1 this
  have hrows : G'.rows.toList = rows := by
    rw [e]
    show (GU.rows ++ rows.toArray).toList = rows
    rw [Array.toList_append, hnil]
    simp
  have hall : ∀ r ∈ rows, RowHolds R.same d'.st (valOf (plan₂ p.S) R w) r := fun r hr => h4 r (by
    rw [hrows, List.drop_zero, List.take_of_length_le (Nat.le_of_eq (rec_count P))]
    exact hr)
  -- o_u is seated, behind as in front
  obtain ⟨xU, hxU, shU⟩ : ∃ x0, d.st.oracles[0]? = some x0 ∧ x0.shape = p.S.fold.u := by
    cases hx : d.st.oracles[0]? with
    | none =>
      rw [hx] at hsU
      cases hsU
    | some x0 =>
      rw [hx] at hsU
      exact ⟨x0, rfl, by simpa using hsU⟩
  obtain ⟨gsU, hxU'⟩ := rec_msg P 0 xU hxU
  obtain ⟨hP, hiok⟩ := placedU_of_u (T := d'.st) (codes := d.st.codes) (S := p.S) (l := d.loc) P.codes
    ⟨{ xU with groups := gsU }, by rw [hU0]; exact hxU', shU⟩ hlay hlin
  have hfit := P.fits
  simp only [TableKey.fits, Bool.and_eq_true, beq_iff_eq, List.all_eq_true] at hfit
  intro i hi
  have hlt : i < d.loc.key.seeds.length := by
    rw [hfit.1.2]
    exact hi
  refine ⟨d.loc.key.seeds[i], List.getElem?_eq_getElem hlt, ?_⟩
  have hx' : d.loc.key.seeds[i]? = some d.loc.key.seeds[i] := List.getElem?_eq_getElem hlt
  have hx : (d.loc.key.seeds[i], i) ∈ d.loc.key.seeds.zipIdx := List.mem_zipIdx_iff_getElem?.2 hx'
  obtain ⟨row, hrow, hg⟩ := mem_mapM _ _ _ P.made _ hx
  have hz : (d.loc.key.seeds[i]).z.length = p.S.fold.index.cubeBits := hfit.2 _ (List.mem_of_getElem? hx')
  have t := hall row hrow
  rw [hsame] at t ⊢
  have hin : Means.RowIn d'.st G' row := hord.rows _ G' h1 row (by rw [hrows]; exact hrow)
  have hsays := (rowHolds_iff_says_of_rowIn ρ d'.st G' _ row hin).1 t
  have hE := (recMeansW ρ d'.st p.S.fold _ i _ _ _ row hiok hi hz hg hP _).1 hsays
  beta_reduce
  refine (recAt_iff_recEq ρ p.S.fold.index _ i _ d.loc.key.record (_root_.Desc.K14.weights p.S d.loc) _ (fun r hr => ?_)).2 ?_
  · refine weights_val ρ p.S d.loc r ?_
    rw [P.gamma]
    exact hr
  · have e2 : (fun k => ρ.val (uOf (plan₂ p.S) R d.st.codes w k)) =
        fun k => ρ.val (valOf (plan₂ p.S) R w d.loc.oU.oracle .main (d.loc.oU.lay.index k)) := by
      funext k
      simp [uOf, valOf, plan₂, hU0, hlay]
    rw [e2]
    exact hE

/-- **What row 2.3 takes from others, by name.** -/
structure NotOurs₂₃ (z : P₂) (d d' : St₂) : Prop where
  /-- the letter «same» is «reads as one element», of a field -/
  sameRho : R.same = fun x y => ρ.val x = ρ.val y
  /-- the reading gives one sample at the three pinned seats, and one record of the stored table, in front and behind -/
  samePins : PinsStay G₂ at_ [0, 2, 3] (z, d) (z, d')

/-- **The relation, back, at one witness.** -/
theorem rel₂_43 (z : P₂) (d d' : St₂) (y : Strs) (w : Wit Cells Unit M) {GU : OnBytes.Group} {rows : List OnBytes.Row} (P : RecLaid p d d' GU rows)
    (N : NotOurs₂₃ G₂ at_ R ρ z d d')
    (hsh : LKFU.Shape23.ok (LKFU.Shape23.shape₂ p.S a 3 d) = true) (hf : Free₂ F G₂ at_ p.S K₁ R coll last₁ off₂ 3 (z, d) y)
    (hw : relAt F G₂ at_ (meaning₂ p.S K₁ R enc rad) (open₂ 4) (z, d') y w) :
    relAt F G₂ at_ (meaning₂ p.S K₁ R enc rad) (open₂ 3) (z, d) y w := by
  have mem : ∀ j, j ∈ open₂ 4 → j.holds F G₂ at_ (meaning₂ p.S K₁ R enc rad) (z, d') y w := hw
  have pin : ∀ k ∈ [0, 2, 3], (KItem.pin k).holds F G₂ at_ (meaning₂ p.S K₁ R enc rad) (z, d') y w →
      (KItem.pin k).holds F G₂ at_ (meaning₂ p.S K₁ R enc rad) (z, d) y w :=
    fun k hk hu => rides_pin2_at F G₂ _ _ _ _ _ _ _ (N.samePins.smp k hk) rfl hu
  simp only [LKFU.Shape23.ok, LKFU.Shape23.shape₂, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at hsh
  obtain ⟨_, _, _, _, _, _, c7, c8, _, _, _, _, c13, _, _, _, _⟩ := hsh
  have n7 : d.loc.gU = 0 ∧ d.loc.gOmega = 1 := by simpa using c7
  have n8 : d.loc.oU.oracle = 0 ∧ d.loc.firstMask = some 1 := by simpa using c8
  have g13 : LKFU.Shape23.grpIs d.st 0 [] 0 0 false = true := by simpa using c13
  have sizeU : GU.rows.size = 0 := by
    have jU := P.gU
    rw [n7.1] at jU
    unfold LKFU.Shape23.grpIs at g13
    rw [jU] at g13
    simp only [Bool.and_eq_true, beq_iff_eq] at g13
    exact g13.1.2
  intro i hi
  rw [open₂_3] at hi
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact trivial
  · exact pin 0 (by decide) (mem _ (by decide))
  · exact srow₂_ridesR p K₁ R enc rad 0 z d d' y w P (mem (.srow 0) (by decide))
  · exact pin 2 (by decide) (mem _ (by decide))
  · exact srow₂_ridesR p K₁ R enc rad 2 z d d' y w P (mem (.srow 2) (by decide))
  · exact (eval₂_is F G₂ at_ p.S K₁ R enc rad (z, d) y w).2 ((eval₂_is F G₂ at_ p.S K₁ R enc rad (z, d') y w).1 (mem _ (by decide)))
  · -- «NearU» rides
    have hn := (nearU_is F G₂ at_ K₁ R enc rad p.S (z, d') y w).1 (mem _ (by decide))
    have hn' : NearUAt R.same (plan₂ p.S).lin.fold.index.code.logN rad enc (d'.loc.psiSh.drop (plan₂ p.S).lin.kLo) y (uOf (plan₂ p.S) R d'.st.codes w) := hn
    rw [P.loc, P.codes] at hn'
    exact (nearU_is F G₂ at_ K₁ R enc rad p.S (z, d) y w).2 hn'
  · -- «RecRow»
    have hr := (record_is F G₂ at_ p.S K₁ R enc rad (z, d') y w).1 (mem _ (by decide))
    have hr' : rowsHold R.same d'.st (valOf (plan₂ p.S) R w) d'.loc.gU 0 p.S.fold.index.answers := hr
    rw [P.loc] at hr'
    exact (recRow_is F G₂ at_ K₁ R enc rad p.S (z, d) y w).2
      (rec_back p R ρ d d' w P N.sameRho n8.1 (hf.lay (by decide)) (hf.linOk (by decide)) (hf.seatU (by decide)) (P.order hf.order) sizeU hr')
  · -- «DotU» rides
    obtain ⟨g, hg, hd⟩ := (dotU_is F G₂ at_ p.S K₁ R enc rad (z, d') y w).1 (mem _ (by decide))
    have hd' : DotUAt R.same (plan₂ p.S).lin g d'.loc.psiSh (uOf (plan₂ p.S) R d'.st.codes w) (vOf' (plan₂ p.S) R d'.st.codes w) := hd
    rw [P.loc, P.codes] at hd'
    exact (dotU_is F G₂ at_ p.S K₁ R enc rad (z, d) y w).2 ⟨g, hg, hd'⟩
  · exact pin 3 (by decide) (mem _ (by decide))
  · exact srow₂_ridesR p K₁ R enc rad 3 z d d' y w P (mem (.srow 3) (by decide))

/-- **ROW 2.3.** From the promise in front, what (rec_gamma) has laid, and two premises on letters: the promise behind; and at every witness the relation behind gives the relation in front. The tables stand at the shape p.S of the text's own letter p. -/
theorem row23 (z : P₂) (d d' : St₂) (y : Strs) {GU : OnBytes.Group} {rows : List OnBytes.Row} (P : RecLaid p d d' GU rows) (N : NotOurs₂₃ G₂ at_ R ρ z d d')
    (hon : onAt F G₂ at_ (meaning₂ p.S K₁ R enc rad) (fun d => LKFU.Shape23.ok (LKFU.Shape23.shape₂ p.S a 3 d)) (Free₂ F G₂ at_ p.S K₁ R coll last₁ off₂ 3) (open₂ 3) (z, d) y) :
    onAt F G₂ at_ (meaning₂ p.S K₁ R enc rad) (fun d => LKFU.Shape23.ok (LKFU.Shape23.shape₂ p.S a 4 d)) (Free₂ F G₂ at_ p.S K₁ R coll last₁ off₂ 4) (open₂ 4) (z, d') y ∧
      ∀ w, relAt F G₂ at_ (meaning₂ p.S K₁ R enc rad) (open₂ 4) (z, d') y w → relAt F G₂ at_ (meaning₂ p.S K₁ R enc rad) (open₂ 3) (z, d) y w := by
  refine ⟨?_, fun w hw => ?_⟩
  · exact N.samePins.onAt F (meaning₂ p.S K₁ R enc rad) _ _ _ _ (open₂ 3) (open₂ 4) y pinned₂_3 pinned₂_4 trivial
      (fun hsh => shape₂_34 p a d d' P hsh) (fun _ h3 => free₂_34 F G₂ at_ p K₁ R coll last₁ off₂ z d d' y P N.samePins h3) hon
  · rcases hon with hn | ⟨hsh, _, h3, _⟩
    · exact absurd trivial hn
    · exact rel₂_43 F G₂ at_ p K₁ R enc rad a coll last₁ off₂ ρ z d d' y w P N hsh h3 hw

end

