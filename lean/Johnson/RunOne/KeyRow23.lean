theorem srow₂_ridesR (k : Nat) (z : P₂) (d d' : St₂) (y : Strs) (w : Wit Cells Unit M) {GU : OnBytes.Group} {rows : List OnBytes.Row} (P : RecLaid p d d' GU rows)
    (h : (meaning₂ p.S K₁ R enc rad).srow k (z, d') y w) : (meaning₂ p.S K₁ R enc rad).srow k (z, d) y w := by
  simp only [meaning₂] at h ⊢
  split_ifs at h ⊢
  · exact h
  · exact srowAt_rides R (plan₂ p.S) (rec_tables P) k w (rec_sampleBack P) h

