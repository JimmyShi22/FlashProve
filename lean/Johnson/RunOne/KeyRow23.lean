/-! ## (rec_gamma)'s rows are plain rows -/

theorem addLaid_kind' (o : Nat) (lay : VectorLay) : ∀ (l : List Tensor) (row : OnBytes.Row), (addLaid row o lay l).kind = row.kind
  | [], _ => rfl
  | t :: l, row => addLaid_kind' o lay l (row.add o .main (lay.onTable t))

theorem foldl_kind {α : Type} (f : OnBytes.Row → α → OnBytes.Row) (hf : ∀ r x, (f r x).kind = r.kind) : ∀ (l : List α) (r : OnBytes.Row), (l.foldl f r).kind = r.kind
  | [], _ => rfl
  | x :: l, r => (foldl_kind f hf l (f r x)).trans (hf r x)

theorem recRow_plain (s : IndexShape) (seed : SampleSeed) (i : Nat) (u : FoldedRow) (L : List Tensor) :
    (_root_.Desc.K14.Law.recRow s seed i u L).kind = .plain := by
  unfold _root_.Desc.K14.Law.recRow
  refine (foldl_kind _ ?_ _ _).trans (addLaid_kind' u.oracle u.lay L {})
  intro r x
  rfl

/-! ## What RecLaid gives of the two statements -/

section
variable {p : Par} {d d' : St₂} {GU : OnBytes.Group} {rows : List OnBytes.Row}

theorem rec_none (P : RecLaid p d d' GU rows) (o : Nat) (h : d.st.oracles[o]? = none) : d'.st.oracles[o]? = none := by
  have s := P.size
  rw [Array.getElem?_eq_none_iff] at h ⊢
  omega

/-- Every message behind is the same record but for its list of groups. -/
theorem rec_msg (P : RecLaid p d d' GU rows) (o : Nat) (x0 : OnBytes.Oracle) (h : d.st.oracles[o]? = some x0) :
    ∃ gs, d'.st.oracles[o]? = some { x0 with groups := gs } := by
  by_cases e : o = d.loc.oU.oracle
  · subst e
    exact ⟨_, P.u x0 h⟩
  · exact ⟨x0.groups, (P.rest o e).trans h⟩

theorem rec_tables (P : RecLaid p d d' GU rows) : SameTables d'.st d.st := by
  refine ⟨P.size, fun o part => ?_⟩
  cases hx : d.st.oracles[o]? with
  | none => simp [Statement.tableBits, Statement.rowBits, Statement.placeBits, hx, rec_none P o hx]
  | some x0 =>
    obtain ⟨gs, hx'⟩ := rec_msg P o x0 hx
    simp [Statement.tableBits, Statement.rowBits, Statement.placeBits, hx, hx', P.codes]

theorem rec_sampleBack (P : RecLaid p d d' GU rows) (o : Nat) (x' : OnBytes.Oracle) (h : d'.st.oracles[o]? = some x') :
    ∃ x0 : OnBytes.Oracle, d.st.oracles[o]? = some x0 ∧ x0.sampled = x'.sampled ∧ x0.sampleRows = x'.sampleRows := by
  cases hx : d.st.oracles[o]? with
  | none =>
    rw [rec_none P o hx] at h
    cases h
  | some x0 =>
    obtain ⟨gs, hx'⟩ := rec_msg P o x0 hx
    have e : x' = { x0 with groups := gs } := Option.some.inj (h.symm.trans hx')
    exact ⟨x0, rfl, by rw [e], by rw [e]⟩

theorem msgIs_rec (P : RecLaid p d d' GU rows) (o : Nat) (sm : Option Nat) (sp : Bool) :
    LKFU.Shape23.msgIs d'.st o sm sp = LKFU.Shape23.msgIs d.st o sm sp := by
  unfold LKFU.Shape23.msgIs
  cases hx : d.st.oracles[o]? with
  | none => rw [rec_none P o hx]
  | some x0 =>
    obtain ⟨gs, hx'⟩ := rec_msg P o x0 hx
    rw [hx']
    cases sm <;> rfl

theorem shapeAny_rec (P : RecLaid p d d' GU rows) (o : Nat) (sh : OnBytes.OracleShape) :
    (d'.st.oracles[o]?).any (·.shape == sh) = (d.st.oracles[o]?).any (·.shape == sh) := by
  cases hx : d.st.oracles[o]? with
  | none => rw [rec_none P o hx]
  | some x0 =>
    obtain ⟨gs, hx'⟩ := rec_msg P o x0 hx
    rw [hx']
    rfl

/-- As many rows as the record has answers. -/
theorem rec_count (P : RecLaid p d d' GU rows) : rows.length = p.S.fold.index.answers := by
  have h1 := _root_.Desc.K14.Law.length_mapM _ _ _ P.made
  have hfit := P.fits
  simp only [TableKey.fits, Bool.and_eq_true, beq_iff_eq] at hfit
  rw [h1, List.length_zipIdx, hfit.1.2]

/-- Every row that is laid is a plain row. -/
theorem rec_plain (P : RecLaid p d d' GU rows) : ∀ r ∈ rows, r.kind = .plain := by
  have key : ∀ (l : List (SampleSeed × Nat)) (rs : List OnBytes.Row),
      l.mapM (fun x => _root_.Desc.K14.recGamma p.S.fold.index x.1 x.2 (_root_.Desc.K14.weights p.S d.loc) d.loc.key.record d.loc.oU) = some rs →
      ∀ r ∈ rs, r.kind = .plain := by
    intro l
    induction l with
    | nil =>
      intro rs h r hr
      simp only [List.mapM_nil, Option.pure_def, Option.some.injEq] at h
      subst h
      cases hr
    | cons a l ih =>
      intro rs h r hr
      simp only [List.mapM_cons, Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def, Option.some.injEq] at h
      obtain ⟨b, hb, bs, hbs, rfl⟩ := h
      rcases List.mem_cons.1 hr with rfl | hr
      · obtain ⟨L, sum, _, _, e⟩ := _root_.Desc.K14.Law.recGamma_inv _ _ _ _ _ _ _ hb
        rw [e]
        exact recRow_plain _ _ _ _ _
      · exact ih bs hbs r hr
  exact key _ _ P.made

end


theorem grpIs_same (st st' : Statement) (g : Nat) (l : List Nat) (p q : Nat) (b : Bool) (h : st'.groups[g]? = st.groups[g]?) :
    LKFU.Shape23.grpIs st' g l p q b = LKFU.Shape23.grpIs st g l p q b := by
  unfold LKFU.Shape23.grpIs
  rw [h]

/-! ## The book-keeping, forward -/

theorem shape₂_34 (p : Par) (a : Nat) (d d' : St₂) {GU : OnBytes.Group} {rows : List OnBytes.Row} (P : RecLaid p d d' GU rows)
    (h : LKFU.Shape23.ok (LKFU.Shape23.shape₂ p.S a 3 d) = true) : LKFU.Shape23.ok (LKFU.Shape23.shape₂ p.S a 4 d') = true := by
  simp only [LKFU.Shape23.ok, LKFU.Shape23.shape₂, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at h ⊢
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18⟩ := h
  have el := P.loc
  have eb := P.book
  have er := P.roots
  have es := P.size
  have eg := P.groups
  have n7 : d.loc.gU = 0 ∧ d.loc.gOmega = 1 := by simpa using c7
  have n8 : d.loc.oU.oracle = 0 ∧ d.loc.firstMask = some 1 := by simpa using c8
  have g13 : LKFU.Shape23.grpIs d.st 0 [] 0 0 false = true := by simpa using c13
  have g14 : LKFU.Shape23.grpIs d.st 1 [] 0 0 false = true := by simpa using c14
  have jU := P.gU
  have jU' := P.gU'
  rw [n7.1] at jU jU'
  rw [n8.1] at jU'
  have g14' : LKFU.Shape23.grpIs d'.st 1 [] 0 0 false = true := by
    rw [grpIs_same d.st d'.st 1 _ _ _ _ (P.other 1 (by rw [n7.1]; decide))]
    exact g14
  have g13' : LKFU.Shape23.grpIs d'.st 0 [0] p.S.fold.index.answers 0 false = true := by
    unfold LKFU.Shape23.grpIs at g13 ⊢
    rw [jU] at g13
    rw [jU']
    simp only [Bool.and_eq_true, beq_iff_eq] at g13 ⊢
    obtain ⟨⟨⟨⟨m1, _⟩, _⟩, m4⟩, m5⟩ := g13
    have hnil : GU.rows.toList = [] := by
      have : GU.rows.toList.length = 0 := by rw [Array.length_toList]; exact m4
      exact List.length_eq_zero_iff.1 this
    have hrows : (GU.rows ++ rows.toArray).toList = rows := by
      rw [Array.toList_append, hnil]
      simp
    have hpl := rec_plain P
    refine ⟨⟨⟨⟨entered_last GU 0 false [] m1 (by decide), ?_⟩, ?_⟩, ?_⟩, m5⟩
    · unfold LKFU.Shape23.plainRows
      show ((GU.rows ++ rows.toArray).toList.filter (·.kind == .plain)).length = _
      rw [hrows, List.filter_eq_self.2 (fun r hr => by rw [hpl r hr]; rfl), rec_count P]
    · unfold LKFU.Shape23.genRows
      show ((GU.rows ++ rows.toArray).toList.filter (·.kind == .generator)).length = _
      rw [hrows, List.filter_eq_nil_iff.2 (fun r hr => by rw [hpl r hr]; decide)]
      rfl
    · show (GU.rows ++ rows.toArray).size = _
      rw [← Array.length_toList, hrows, rec_count P]
      omega
  refine ⟨c1, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa [es] using c2
  · simpa [eg] using c3
  · simpa [eb, er] using c4
  · simpa [es, eb] using c5
  · simpa [el] using c6
  · simpa [el] using c7
  · simpa [el] using c8
  · simpa [msgIs_rec P] using c9
  · simpa [el] using c10
  · simp
  · simpa [el] using c12
  · simpa using g13'
  · simpa using g14'
  · simp
  · simp
  · simp
  · simpa [eb, er] using c18

