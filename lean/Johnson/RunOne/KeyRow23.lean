/-! ## The promise's last letter, forward -/

theorem free₂_34 (z : P₂) (d d' : St₂) (y : Strs) {GU : OnBytes.Group} {rows : List OnBytes.Row} (P : RecLaid p d d' GU rows)
    (hp : PinsStay G₂ at_ [0, 2, 3] (z, d) (z, d'))
    (hf : Free₂ F G₂ at_ p.S K₁ R coll last₁ off₂ 3 (z, d) y) : Free₂ F G₂ at_ p.S K₁ R coll last₁ off₂ 4 (z, d') y :=
  have hord : Means.InOrder d'.st := P.order hf.order
  { hf with
    record := hp.freeAt coll y hf.record
    key := by
      show d'.loc.key = _
      rw [P.loc]
      exact hf.key
    codes := by
      show d'.st.codes = _
      rw [P.codes]
      exact hf.codes
    lay := fun _ => by
      show d'.loc.oU.lay = vectorLay d'.st.codes p.S.fold.u p.S.fold.rowsHigh
      rw [P.loc, P.codes]
      exact hf.lay (by decide)
    placed := by
      show Placed (plan₂ p.S).orc (fun o => d'.book.place[o]?) off₂ at_ ((pinned (open₂ 4)).filter (3 ≤ ·))
      rw [P.book, pinned₂_4, ← pinned₂_3]
      exact hf.placed
    samples := fun _ _ o _ => sampleIn_of_order hord o
    rowsIn := fun _ => ⟨openIn_of_order hord _, openIn_of_order hord _⟩
    order := hord
    linOk := fun _ => by
      show OnBytes.linOk d'.st.codes p.S = true
      rw [P.codes]
      exact hf.linOk (by decide)
    seatU := fun _ => by
      show (d'.st.oracles[0]?).any (·.shape == p.S.fold.u) = true
      rw [shapeAny_rec P]
      exact hf.seatU (by decide)
    seatOmega := fun h6 => absurd h6 (by decide)
    shown := fun j hj => hf.shown j (by rw [pinned₂_3]; rw [pinned₂_4] at hj; exact hj)
    maskU := fun _ => by
      show MaskWith (fun i => d'.book.place[i]?) 0 1
      rw [P.book]
      exact hf.maskU (by decide) }

