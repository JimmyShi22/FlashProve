theorem msgIs_old {st st' : Statement} {o : Nat} (h : st'.oracles[o]? = st.oracles[o]?) (x : Option Nat) (sp : Bool) :
    LKFU.Shape23.msgIs st' o x sp = LKFU.Shape23.msgIs st o x sp := by
  unfold LKFU.Shape23.msgIs
  rw [h]

theorem insert_at_end' (m : Array Nat) (k : Nat) (h : ∀ i ∈ m.toList, i < k) :
    m.insertIdxIfInBounds (m.filter (· < k)).size k = m.push k := by
  rcases m with ⟨l⟩
  have hl : l.filter (fun i => decide (i < k)) = l :=
    List.filter_eq_self.2 fun a ha => decide_eq_true (h a ha)
  apply Array.toList_inj.1
  simp [hl]

/-- What the book-keeping in front of the block says, as propositions. -/
structure Front (S : LinShape) (K₁ : KPlan) (a : Nat) (idx : List Nat) (t₁ : Nat) (s : St₃) : Prop where
  form : LKFU.Shape23.formOk S = true
  msgs : s.st.oracles.size = s.loc.w + 2
  grps : s.st.groups.size = s.loc.own + 1
  trees : s.book.trees.size = s.loc.firstTree - 1
  roots : s.roots = 0
  mask : s.loc.mask = some (s.loc.w + 1)
  first : s.loc.firstTree = s.loc.firstTree - 1 + 1
  border : s.loc.border.isSome = true
  omega : s.loc.omega = noId
  w : LKFU.Shape23.msgIs s.st s.loc.w (some a) false = true
  m : LKFU.Shape23.msgIs s.st (s.loc.w + 1) none false = true
  grp : LKFU.Shape23.grpIs s.st s.loc.own (idx ++ [s.loc.w]) 1 0 false = true
  orc : K₁.orc 2 = some s.loc.w
  t₁ : s.loc.firstTree = t₁ + 1
  bord : borderB a s = true

theorem front_of_shape (S : LinShape) (K₁ : KPlan) (a : Nat) (idx : List Nat) (src : St₃ → Bool) (t₁ : Nat) (s : St₃)
    (h0 : shapeB₃ S K₁ a idx src t₁ 0 s = true) : Front S K₁ a idx t₁ s := by
  simp [shapeB₃, LKFU.Shape23.ok, LKFU.Shape23.shape₃, nOwn, gOwn, tOwn] at h0
  obtain ⟨⟨⟨⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, ⟨c10, c11⟩, c12⟩, k1⟩, k2⟩, k3⟩ := h0
  exact ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, k1, k2, k3⟩

/-- What the border's Bool says of Omega's record in the border's copy: by borderB_spec, field by name. -/
theorem border_gives {S : LinShape} {a : Nat} {s s' : St₃} {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row}
    (L : Laid S s s' b yO G dot) (k3 : borderB a s = true) :
    b.shared.omega = 2 ∧ yO.sampled = true ∧ yO.sampleRows.size = a ∧ yO.spentAsMask = false ∧ (∀ g ∈ b.g, g.ok = true) ∧
      b.shared.st.codes = s.st.codes := by
  obtain ⟨b', B'⟩ := borderB_spec a s k3
  have eb : b' = b := Option.some.inj (B'.lies.symm.trans L.border)
  have B : BorderSays a s b := eb ▸ B'
  have there2 : b.shared.st.oracles[2]? = some yO := by
    rw [← B.omega]
    exact L.there
  have t := B.msg
  unfold LKFU.Shape23.msgIs at t
  rw [there2] at t
  simp only [Bool.and_eq_true, beq_iff_eq, Bool.not_eq_true'] at t
  exact ⟨B.omega, t.1.1, t.1.2, t.2, B.weights, B.codes⟩

theorem extends_of_laid {S : LinShape} {s s' : St₃} {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row}
    (L : Laid S s s' b yO G dot) : Means.Extends s.st s'.st :=
  ⟨L.codes, fun o x hx => ⟨x, (L.old o (Array.getElem?_eq_some_iff.1 hx).1).trans hx, rfl⟩⟩

/-- The own group in front: every member's number is below the number of messages; one open row. -/
theorem front_members {S : LinShape} {K₁ : KPlan} {a : Nat} {idx : List Nat} {t₁ : Nat} {s s' : St₃}
    {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row} (L : Laid S s s' b yO G dot)
    (Fr : Front S K₁ a idx t₁ s) (hidx : ∀ i ∈ idx, i < s.loc.w + 2) :
    (∀ i ∈ G.members.toList, i < s.st.oracles.size) ∧ G.rows.size = 1 := by
  have c2 := Fr.msgs
  have hg := Fr.grp
  unfold LKFU.Shape23.grpIs at hg
  rw [L.group] at hg
  simp only [Bool.and_eq_true, beq_iff_eq] at hg
  obtain ⟨⟨⟨⟨m1, _⟩, _⟩, m4⟩, _⟩ := hg
  refine ⟨fun i hi => ?_, m4⟩
  rw [m1] at hi
  rw [c2]
  rcases List.mem_append.1 hi with h | h
  · exact hidx i h
  · have e : i = s.loc.w := by simpa using h
    omega

/-- The claim's masks' messages stand in front of the messages' end: OUT OF THE PROMISE: they are
members of the own group, and the statement is in order. -/
theorem idx_below {S : LinShape} {K₁ : KPlan} {a : Nat} {idx : List Nat} {t₁ : Nat} {s : St₃} {G : OnBytes.Group}
    (Fr : Front S K₁ a idx t₁ s) (hG : s.st.groups[s.loc.own]? = some G) (hO : Means.InOrder s.st) :
    ∀ i ∈ idx, i < s.loc.w + 2 := by
  intro i hi
  have hg := Fr.grp
  unfold LKFU.Shape23.grpIs at hg
  rw [hG] at hg
  simp only [Bool.and_eq_true, beq_iff_eq] at hg
  obtain ⟨⟨⟨⟨m1, _⟩, _⟩, _⟩, _⟩ := hg
  have t := (hO.groups _ G hG).there i (by rw [m1]; exact List.mem_append.2 (Or.inl hi))
  rw [Fr.msgs] at t
  exact t

/-- **The book-keeping, forward.** -/
theorem shape_forward (S : LinShape) (K₁ : KPlan) (a : Nat) (idx : List Nat) (src : St₃ → Bool) (t₁ : Nat) (s s' : St₃)
    {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row} (L : Laid S s s' b yO G dot)
    (hidx : ∀ i ∈ idx, i < s.loc.w + 2)
    (h0 : shapeB₃ S K₁ a idx src t₁ 0 s = true) : shapeB₃ S K₁ a idx src t₁ 1 s' = true := by
  have Fr := front_of_shape S K₁ a idx src t₁ s h0
  have ew : s'.loc.w = s.loc.w := by rw [L.loc]
  have eo : s'.loc.own = s.loc.own := by rw [L.loc]
  have ef : s'.loc.firstTree = s.loc.firstTree := by rw [L.loc]
  have em : s'.loc.mask = s.loc.mask := by rw [L.loc]
  have eb : s'.loc.border = none := by rw [L.loc]
  have eom : s'.loc.omega = s.st.oracles.size := by rw [L.loc]
  have c2 := Fr.msgs
  have c3 := Fr.grps
  have c4 := Fr.trees
  have c5 := Fr.roots
  have c7 := Fr.first
  have l1 := L.size
  have l2 := L.groups
  have l3 := L.trees
  have l4 := L.roots
  obtain ⟨_, y1, y2, y3, _, _⟩ := border_gives L Fr.bord
  -- the own group in front
  have hg := Fr.grp
  unfold LKFU.Shape23.grpIs at hg
  rw [L.group] at hg
  simp only [Bool.and_eq_true, beq_iff_eq] at hg
  obtain ⟨⟨⟨⟨m1, m2⟩, m3⟩, m4⟩, m5⟩ := hg
  have hlt : ∀ i ∈ G.members.toList, i < s.st.oracles.size := by
    intro i hi
    rw [m1] at hi
    rw [c2]
    rcases List.mem_append.1 hi with h | h
    · exact hidx i h
    · have e : i = s.loc.w := by simpa using h
      omega
  simp [shapeB₃, LKFU.Shape23.ok, LKFU.Shape23.shape₃, nOwn, gOwn, tOwn]
  refine ⟨⟨⟨Fr.form, by omega, by omega, by omega, by omega, by rw [em, ew]; exact Fr.mask, by omega, eb, by omega,
    ⟨?_, ?_⟩, ?_, ?_⟩, by rw [ew]; exact Fr.orc⟩, by rw [ef]; exact Fr.t₁⟩
  · rw [ew, msgIs_old (L.old s.loc.w (by omega))]
    exact Fr.w
  · rw [ew, msgIs_old (L.old (s.loc.w + 1) (by omega))]
    exact Fr.m
  · rw [ew, ← c2]
    unfold LKFU.Shape23.msgIs
    rw [L.copy]
    simp [y2]
  · rw [eo, ew]
    unfold LKFU.Shape23.grpIs
    rw [L.group']
    simp only [Bool.and_eq_true, beq_iff_eq]
    refine ⟨⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩, m5⟩
    · rw [insert_at_end' _ _ hlt, Array.toList_push, m1, c2]
      simp
    · unfold LKFU.Shape23.plainRows at m2 ⊢
      simp only [Array.toList_push, List.filter_append, List.length_append, m2]
      simp [L.plain]
    · unfold LKFU.Shape23.genRows at m3 ⊢
      simp only [Array.toList_push, List.filter_append, List.length_append, m3]
      simp [L.plain]
    · simp only [Array.size_push]
      omega

theorem open₃_0 : open₃ 0 = [.unmarked, .pin 0, .srow 0, .pin 2, .srow 2, .claim 1 "Eval", .pin 4, .srow 4, .claim 2 "DotOm"] := by decide
theorem open₃_1 : open₃ 1 = [.unmarked, .pin 0, .srow 0, .pin 2, .srow 2, .claim 1 "Eval", .pin 4, .srow 4, .claim 3 "Dot"] := by decide
theorem pinned₃_0 : pinned (open₃ 0) = [0, 2, 4] := by decide
theorem pinned₃_1 : pinned (open₃ 1) = [0, 2, 4] := by decide

section
variable {XI Cells M Smp Rec : Type} (F : FileDescription XI)
  (G₃ : Reading (P₃ × St₃) Cells M Smp Rec) (at_ : Where)
  (S : LinShape) (K₁ : KPlan) (R : KRead Cells M) (a : Nat) (idx : List Nat)
  (coll : Strs → Rec → Prop) (src : St₃ → Bool) (off₂ off₃ : Nat → Nat) (t₁ : Nat)

variable {S}

/-- **The promise's last letter, forward.** The fence on the rows' content behind comes out of «in order» behind, which Laid keeps. -/
theorem free_forward (z : P₃) (s s' : St₃) (y : Strs) {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row}
    (L : Laid S s s' b yO G dot) (hp : PinsStay G₃ at_ [0, 2, 4] (z, s) (z, s')) (hA : AtOk at_ off₂ off₃ t₁) (ht : s.book.trees.size = t₁)
    (hf : Free₃ F G₃ at_ S K₁ R coll off₂ off₃ 0 (z, s) y) : Free₃ F G₃ at_ S K₁ R coll off₂ off₃ 1 (z, s') y :=
  have hord : Means.InOrder s'.st := by
    obtain ⟨b', hb', hO⟩ := hf.order₀ rfl
    have e : b' = b := Option.some.inj (hb'.symm.trans L.border)
    exact L.order hf.order (e ▸ hO)
  { hf with
    record := hp.freeAt coll y hf.record
    placed := fun _ k hk => by
      obtain ⟨o, t, h1, h2, h3⟩ := hf.placed (by decide) k hk
      have h2' : s.book.place[o]? = some t := h2
      exact ⟨o, t, h1, (L.oldPlaces o (Array.getElem?_eq_some_iff.1 h2').1).trans h2', h3⟩
    omega₀ := fun h0 => absurd h0 (by decide)
    omega := fun _ _ k hk => by
      have e : k = 4 := by simpa using hk
      subst e
      have eo : s'.loc.omega = s.st.oracles.size := by rw [L.loc]
      refine ⟨s'.loc.omega, (s.book.trees.size, 0), rfl, ?_, ?_⟩
      · show s'.book.place[s'.loc.omega]? = _
        rw [eo]
        exact L.place
      · rw [ht]
        exact hA.omega₃
    in₀ := fun h0 => absurd h0 (by decide)
    inOwn := fun _ => ⟨fun _ _ o _ => sampleIn_of_order hord o, openIn_of_order hord _⟩
    inOmega := fun _ _ => sampleIn_of_order hord _
    order := hord
    order₀ := fun h0 => absurd h0 (by decide)
    shown := fun j hj => hf.shown j (by rw [pinned₃_0]; rw [pinned₃_1] at hj; exact hj)
    maskW := by
      obtain ⟨q, p, h1, h2⟩ := hf.maskW
      have h1' : s.book.place[s.loc.w]? = some (q, p) := h1
      have h2' : s.book.place[s.loc.w + 1]? = some (q, p + 1) := h2
      have ew : s'.loc.w = s.loc.w := by rw [L.loc]
      refine ⟨q, p, ?_, ?_⟩
      · show s'.book.place[s'.loc.w]? = _
        rw [ew]
        exact (L.oldPlaces _ (Array.getElem?_eq_some_iff.1 h1').1).trans h1'
      · show s'.book.place[s'.loc.w + 1]? = _
        rw [ew]
        exact (L.oldPlaces _ (Array.getElem?_eq_some_iff.1 h2').1).trans h2'
    lin₀ := fun h0 => absurd h0 (by decide)
    seatW := fun h0 => absurd h0 (by decide)
    seatOmega₀ := fun h0 => absurd h0 (by decide) }

variable (S)

/-- **The promise, forward**, from the book-keeping behind. -/
theorem on_forward (z : P₃) (s s' : St₃) (y : Strs) {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row}
    (L : Laid S s s' b yO G dot) (hp : PinsStay G₃ at_ [0, 2, 4] (z, s) (z, s')) (hA : AtOk at_ off₂ off₃ t₁) (ht : s.book.trees.size = t₁)
    (hs' : shapeB₃ S K₁ a idx src t₁ 1 s' = true)
    (h : onAt F G₃ at_ (meaning₃ S K₁ R) (shapeB₃ S K₁ a idx src t₁ 0) (Free₃ F G₃ at_ S K₁ R coll off₂ off₃ 0) (open₃ 0) (z, s) y) :
    onAt F G₃ at_ (meaning₃ S K₁ R) (shapeB₃ S K₁ a idx src t₁ 1) (Free₃ F G₃ at_ S K₁ R coll off₂ off₃ 1) (open₃ 1) (z, s') y :=
  hp.onAt F (meaning₃ S K₁ R) _ _ _ _ (open₃ 0) (open₃ 1) y pinned₃_0 pinned₃_1 trivial (fun _ => hs')
    (fun _ h3 => free_forward F G₃ at_ K₁ R coll off₂ off₃ t₁ z s s' y L hp hA ht h3) h

end

