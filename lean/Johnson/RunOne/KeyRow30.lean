variable {XI Cells M Smp Rec : Type} (F : FileDescription XI)
  (G₃ : Reading (P₃ × St₃) Cells M Smp Rec) (at_ : Where)
  (S : LinShape) (K₁ : KPlan) (R : KRead Cells M)
variable {K : Type} [CommRing K] (ρ : Model.Reading K)

theorem srow_none (k : Nat) (z : P₃) (s' : St₃) (y : Strs) (w : Wit Cells Unit M) (hb : s'.loc.border = none) :
    (meaning₃ S K₁ R).srow k (z, s') y w = srowAt R (plan₃ K₁ (nOwn s')) s'.st k w := by
  simp only [meaning₃, hb]

theorem srow_some (k : Nat) (z : P₃) (s : St₃) (y : Strs) (w : Wit Cells Unit M) (b : Border) (hb : s.loc.border = some b) :
    (meaning₃ S K₁ R).srow k (z, s) y w =
      if k = 4 then srowAt R (plan₂ S) b.shared.st 4 w else srowAt R (plan₃ K₁ (nOwn s)) s.st k w := by
  simp only [meaning₃, hb]

theorem eval_is (u : P₃ × St₃) (y : Strs) (w : Wit Cells Unit M) :
    (KItem.claim 1 "Eval").holds F G₃ at_ (meaning₃ S K₁ R) u y w ↔
      rowsHold R.same u.2.st (valOf (plan₃ K₁ (nOwn u.2)) R w) u.2.loc.own 0 1 := by
  simp [KItem.holds, meaning₃, claim₃, readers₃]

theorem dot_is (u : P₃ × St₃) (y : Strs) (w : Wit Cells Unit M) :
    (KItem.claim 3 "Dot").holds F G₃ at_ (meaning₃ S K₁ R) u y w ↔
      rowsHold R.same u.2.st (valOf (plan₃ K₁ (nOwn u.2)) R w) u.2.loc.own 1 1 := by
  simp [KItem.holds, meaning₃, claim₃, readers₃]

theorem dotOm_is (u : P₃ × St₃) (y : Strs) (w : Wit Cells Unit M) :
    (KItem.claim 2 "DotOm").holds F G₃ at_ (meaning₃ S K₁ R) u y w ↔
      ∃ g, u.2.loc.border.map (·.g) = some g ∧
        DotOmAt R.same K₁.lin g ((u.2.loc.border.map (·.shared.psi)).getD [])
          (omOf (plan₃ K₁ (nOwn u.2)) R u.2.st.codes w) (vOf' (plan₃ K₁ (nOwn u.2)) R u.2.st.codes w) := by
  simp [KItem.holds, meaning₃, claim₃, readers₃, plan₃]

variable {S}

/-- An older message's sample rows, back. -/
theorem srowAt_back (k n : Nat) (hk : k ≠ 4) {s s' : St₃} {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row}
    (L : Laid S s s' b yO G dot) (hsame : R.same = fun x y => ρ.val x = ρ.val y) (w : Wit Cells Unit M)
    (hlt : ∀ o, K₁.orc k = some o → o < s.st.oracles.size)
    (hin : ∀ o x, K₁.orc k = some o → s.st.oracles[o]? = some x → ∀ r ∈ x.sampleRows.toList, ∃ Gx, Means.RowIn s.st Gx r)
    (h : srowAt R (plan₃ K₁ n) s'.st k w) : srowAt R (plan₃ K₁ n) s.st k w := by
  obtain ⟨o, x, h1, h2, h3, h4, h5⟩ := h
  have h1' : K₁.orc k = some o := by simpa [plan₃, hk] using h1
  have ho := hlt o h1'
  have h2' : s.st.oracles[o]? = some x := (L.old o ho).symm.trans h2
  refine ⟨o, x, h1, h2', h3, h4, fun r hr => ?_⟩
  obtain ⟨Gx, hG⟩ := hin o x h1' h2' r hr
  have t := h5 r hr
  rw [hsame] at t ⊢
  exact (rowHolds_extends ρ (extends_of_laid L) hG _).1 t

/-- (Eval), back. -/
theorem eval_back {s s' : St₃} {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row}
    (L : Laid S s s' b yO G dot) (hsame : R.same = fun x y => ρ.val x = ρ.val y) (val : Nat → Part → Nat → E)
    (hone : G.rows.size = 1) (hin : ∀ r ∈ G.rows.toList, Means.RowIn s.st G r)
    (h : rowsHold R.same s'.st val s.loc.own 0 1) : rowsHold R.same s.st val s.loc.own 0 1 := by
  obtain ⟨G', hG', _, _, hall⟩ := h
  have e := Option.some.inj (hG'.symm.trans L.group')
  have hl : G.rows.toList.length = 1 := by rw [Array.length_toList]; exact hone
  obtain ⟨r0, hr0⟩ := List.length_eq_one_iff.1 hl
  have hrows : G'.rows.toList = [r0, dot] := by
    rw [e]
    show (G.rows.push dot).toList = _
    rw [Array.toList_push, hr0]
    rfl
  refine ⟨G, L.group, by omega, by decide, fun r hr => ?_⟩
  rw [hr0] at hr
  have er : r = r0 := by simpa using hr
  subst er
  have t := hall r (by rw [hrows]; simp)
  rw [hsame] at t ⊢
  exact (rowHolds_extends ρ (extends_of_laid L) (hin r (by rw [hr0]; simp)) _).1 t

/-- Omega's sample rows, back: from this chain's statement to the border's copy of the shared statement. -/
theorem srow4_back {s s' : St₃} {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row}
    (L : Laid S s s' b yO G dot) (hsame : R.same = fun x y => ρ.val x = ρ.val y) (w : Wit Cells Unit M)
    (h2 : b.shared.omega = 2) (hcodes : b.shared.st.codes = s.st.codes)
    (hfence : ∀ r ∈ yO.sampleRows.toList, Means.RowIn b.shared.st { code := 0, members := #[2] } r)
    (h : srowAt R (plan₃ K₁ s.st.oracles.size) s'.st 4 w) : srowAt R (plan₂ S) b.shared.st 4 w := by
  obtain ⟨o, x, h1, hx, _, h4, h5⟩ := h
  have eo : s.st.oracles.size = o := by simpa [plan₃] using h1
  subst eo
  have ex := Option.some.inj (hx.symm.trans L.copy)
  have there2 : b.shared.st.oracles[2]? = some yO := by
    rw [← h2]
    exact L.there
  refine ⟨2, yO, by simp [plan₂], there2, L.sampled, ?_, fun r hr => ?_⟩
  · rw [ex] at h4
    simpa using h4
  · have hm : r.renamed s.st.oracles.size ∈ x.sampleRows.toList := by
      rw [ex]
      show r.renamed s.st.oracles.size ∈ (yO.sampleRows.map (·.renamed s.st.oracles.size)).toList
      rw [Array.toList_map]
      exact List.mem_map_of_mem hr
    have t := h5 _ hm
    rw [hsame] at t ⊢
    refine (rowHolds_renamed ρ b.shared.st s'.st r 2 s.st.oracles.size 0 yO x there2 hx (by rw [ex])
      (L.codes.trans hcodes.symm) (hfence r hr) _ _ (fun pt i => ?_)).1 t
    simp [valOf, plan₂, plan₃]

end

section
variable {XI Cells M Smp Rec : Type} (F : FileDescription XI)
  (G₃ : Reading (P₃ × St₃) Cells M Smp Rec) (at_ : Where)
  (S : LinShape) (K₁ : KPlan) (R : KRead Cells M) (a : Nat) (idx : List Nat)
  (coll : Strs → Rec → Prop) (src : St₃ → Bool) (off₂ off₃ : Nat → Nat) (t₁ : Nat)
variable {K : Type} [Field K] (ρ : Model.Reading K)

/-- **What row 3.0 takes from others, by name.** z: what was handed to the chain. s: the record in front; s': behind. -/
structure NotOurs (z : P₃) (s s' : St₃) : Prop where
  /-- the letter «same» is «reads as one element» -/
  sameRho : R.same = fun x y => ρ.val x = ρ.val y
  /-- public: the plan's shape is the block's -/
  planLin : K₁.lin = S
  /-- public: the plan's two tables of numbers are inverse at V -/
  planNum : ∀ o, K₁.orc 2 = some o → K₁.num o = some 2
  samePins : PinsStay G₃ at_ [0, 2, 4] (z, s) (z, s')
  atOk : AtOk at_ off₂ off₃ t₁

/-- **The relation, back, at one witness.** -/
theorem rel_back (z : P₃) (s s' : St₃) (y : Strs) (w : Wit Cells Unit M)
    {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row} (L : Laid S s s' b yO G dot)
    (N : NotOurs G₃ at_ S K₁ R off₂ off₃ t₁ ρ z s s')
    (hon : onAt F G₃ at_ (meaning₃ S K₁ R) (shapeB₃ S K₁ a idx src t₁ 0) (Free₃ F G₃ at_ S K₁ R coll off₂ off₃ 0) (open₃ 0) (z, s) y)
    (hw : relAt F G₃ at_ (meaning₃ S K₁ R) (open₃ 1) (z, s') y w) :
    relAt F G₃ at_ (meaning₃ S K₁ R) (open₃ 0) (z, s) y w := by
  obtain hn | ⟨hsh, _, hfree, _⟩ := hon
  · exact absurd trivial hn
  have Fr := front_of_shape S K₁ a idx src t₁ s hsh
  have eb : s'.loc.border = none := by rw [L.loc]
  have ew : s'.loc.w = s.loc.w := by rw [L.loc]
  have eo : s'.loc.own = s.loc.own := by rw [L.loc]
  have en : nOwn s' = nOwn s := by unfold nOwn; rw [ew]
  have ens : nOwn s = s.st.oracles.size := by unfold nOwn; exact Fr.msgs.symm
  obtain ⟨h2, _, _, _, _, hcodes⟩ := border_gives L Fr.bord
  have hone : G.rows.size = 1 := (front_members L Fr (idx_below Fr L.group hfree.order)).2
  obtain ⟨hSam, hOpen⟩ := hfree.inOwn (by decide)
  have oldIn : ∀ k ∈ [0, 2], ∀ o x, K₁.orc k = some o → s.st.oracles[o]? = some x →
      ∀ r ∈ x.sampleRows.toList, ∃ Gx, Means.RowIn s.st Gx r :=
    fun k hk o x ho hx r hr => ⟨_, hSam k hk o ho x hx r hr⟩
  have evalIn : ∀ r ∈ G.rows.toList, Means.RowIn s.st G r := fun r hr => hOpen G L.group r hr
  have fence : ∀ r ∈ yO.sampleRows.toList, Means.RowIn b.shared.st { code := 0, members := #[2] } r := by
    obtain ⟨b', hb', hS⟩ := hfree.in₀ rfl
    have ebb : b' = b := Option.some.inj (hb'.symm.trans L.border)
    rw [ebb] at hS
    intro r hr
    have t := hS yO L.there r hr
    rw [h2] at t
    exact t
  have hlt : ∀ k ∈ [0, 2], ∀ o, K₁.orc k = some o → o < s.st.oracles.size := by
    intro k hk o ho
    obtain ⟨o', t, h1, h2', _⟩ := hfree.placed (by decide) k hk
    have e : o' = o := Option.some.inj (h1.symm.trans ho)
    have h3 : s.book.place[o']? = some t := h2'
    rw [L.step, ← e]
    exact (Array.getElem?_eq_some_iff.1 h3).1
  have mem1 : ∀ j, j ∈ open₃ 1 → j.holds F G₃ at_ (meaning₃ S K₁ R) (z, s') y w := hw
  intro i hi
  rw [open₃_0] at hi
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact trivial
  · exact rides_pin2_at F G₃ _ _ _ _ _ _ _ (N.samePins.smp 0 (by decide)) rfl (mem1 (.pin 0) (by decide))
  · show (meaning₃ S K₁ R).srow 0 (z, s) y w
    rw [srow_some S K₁ R 0 z s y w b L.border, if_neg (by decide)]
    have t : (meaning₃ S K₁ R).srow 0 (z, s') y w := mem1 (.srow 0) (by decide)
    rw [srow_none S K₁ R 0 z s' y w eb, en] at t
    exact srowAt_back K₁ R ρ 0 _ (by decide) L N.sameRho w (hlt 0 (by decide)) (oldIn 0 (by decide)) t
  · exact rides_pin2_at F G₃ _ _ _ _ _ _ _ (N.samePins.smp 2 (by decide)) rfl (mem1 (.pin 2) (by decide))
  · show (meaning₃ S K₁ R).srow 2 (z, s) y w
    rw [srow_some S K₁ R 2 z s y w b L.border, if_neg (by decide)]
    have t : (meaning₃ S K₁ R).srow 2 (z, s') y w := mem1 (.srow 2) (by decide)
    rw [srow_none S K₁ R 2 z s' y w eb, en] at t
    exact srowAt_back K₁ R ρ 2 _ (by decide) L N.sameRho w (hlt 2 (by decide)) (oldIn 2 (by decide)) t
  · rw [eval_is]
    have t : rowsHold R.same s'.st (valOf (plan₃ K₁ (nOwn s')) R w) s'.loc.own 0 1 :=
      (eval_is F G₃ at_ S K₁ R (z, s') y w).1 (mem1 (.claim 1 "Eval") (by decide))
    rw [en, eo] at t
    exact eval_back R ρ L N.sameRho _ hone evalIn t
  · exact rides_pin2_at F G₃ _ _ _ _ _ _ _ (N.samePins.smp 4 (by decide)) rfl (mem1 (.pin 4) (by decide))
  · show (meaning₃ S K₁ R).srow 4 (z, s) y w
    rw [srow_some S K₁ R 4 z s y w b L.border, if_pos rfl]
    have t : (meaning₃ S K₁ R).srow 4 (z, s') y w := mem1 (.srow 4) (by decide)
    rw [srow_none S K₁ R 4 z s' y w eb, en, ens] at t
    exact srow4_back K₁ R ρ L N.sameRho w h2 hcodes fence t
  · have t : rowsHold R.same s'.st (valOf (plan₃ K₁ (nOwn s')) R w) s'.loc.own 1 1 :=
      (dot_is F G₃ at_ S K₁ R (z, s') y w).1 (mem1 (.claim 3 "Dot") (by decide))
    rw [en, eo, N.sameRho] at t
    have hwS : ∃ x, s.st.oracles[s.loc.w]? = some x ∧ x.shape = S.w := by
      have tw := hfree.seatW rfl
      cases hx : s.st.oracles[s.loc.w]? with
      | none =>
        rw [hx] at tw
        cases tw
      | some x =>
        rw [hx] at tw
        exact ⟨x, rfl, by simpa using tw⟩
    have hOS : yO.shape = S.omega := by
      have hto := hfree.seatOmega₀ rfl b L.border
      rw [L.there] at hto
      simpa using hto
    have hd := dotOm_of_laid ρ S L (hfree.lin₀ rfl) hwS hOS (border_gives L Fr.bord).2.2.2.2.1 hone _ t
    have eg : s.loc.border.map (·.g) = some b.g := by rw [L.border]; rfl
    have epsi : (s.loc.border.map (·.shared.psi)).getD [] = b.shared.psi := by rw [L.border]; rfl
    have hne : s.loc.w ≠ nOwn s := by
      unfold nOwn
      omega
    have e1 : omOf (plan₃ K₁ (nOwn s)) R s.st.codes w =
        fun y => valOf (plan₃ K₁ (nOwn s)) R w s.st.oracles.size .main ((linLayOmega s.st.codes S).index y) := by
      funext y
      simp [omOf, valOf, plan₃, ens, N.planLin]
    have e2 : vOf' (plan₃ K₁ (nOwn s)) R s.st.codes w =
        fun c => valOf (plan₃ K₁ (nOwn s)) R w s.loc.w .main ((linLayW s.st.codes S).index c) := by
      funext c
      simp [vOf', valOf, plan₃, hne, N.planLin, N.planNum _ Fr.orc]
    refine (dotOm_is F G₃ at_ S K₁ R (z, s) y w).2 ⟨b.g, eg, ?_⟩
    dsimp only
    rw [epsi, N.sameRho, N.planLin, e1, e2]
    exact hd

/-- **ROW 3.0.** From the promise in front, what the block has laid, and what is taken from others by name: the promise behind; and at every witness the relation
behind gives the relation in front. -/
theorem row30 (z : P₃) (s s' : St₃) (y : Strs)
    {b : Border} {yO : OnBytes.Oracle} {G : OnBytes.Group} {dot : OnBytes.Row} (L : Laid S s s' b yO G dot)
    (N : NotOurs G₃ at_ S K₁ R off₂ off₃ t₁ ρ z s s')
    (hon : onAt F G₃ at_ (meaning₃ S K₁ R) (shapeB₃ S K₁ a idx src t₁ 0) (Free₃ F G₃ at_ S K₁ R coll off₂ off₃ 0) (open₃ 0) (z, s) y) :
    onAt F G₃ at_ (meaning₃ S K₁ R) (shapeB₃ S K₁ a idx src t₁ 1) (Free₃ F G₃ at_ S K₁ R coll off₂ off₃ 1) (open₃ 1) (z, s') y ∧
      ∀ w, relAt F G₃ at_ (meaning₃ S K₁ R) (open₃ 1) (z, s') y w → relAt F G₃ at_ (meaning₃ S K₁ R) (open₃ 0) (z, s) y w := by
  refine ⟨?_, fun w hw => rel_back F G₃ at_ S K₁ R a idx coll src off₂ off₃ t₁ ρ z s s' y w L N hon hw⟩
  obtain hn | ⟨hsh, h2, h3, h4⟩ := hon
  · exact absurd trivial hn
  have Fr := front_of_shape S K₁ a idx src t₁ s hsh
  have ht : s.book.trees.size = t₁ := by
    have c4 := Fr.trees
    have k2 := Fr.t₁
    omega
  exact on_forward F G₃ at_ S K₁ R a idx coll src off₂ off₃ t₁ z s s' y L N.samePins N.atOk ht
    (shape_forward S K₁ a idx src t₁ s s' L (idx_below Fr L.group h3.order) hsh) (Or.inr ⟨hsh, h2, h3, h4⟩)

end

end Johnson.RunOne.KeyRows23
