/-- Equality of places with their rows is decidable: an instance in this file alone. -/
@[reducible] def spotDecEq : DecidableEq Spot
  | ⟨a₁, a₂, a₃⟩, ⟨b₁, b₂, b₃⟩ =>
    if h₁ : a₁ = b₁ then
      if h₂ : a₂ = b₂ then
        if h₃ : a₃ = b₃ then isTrue (by rw [h₁, h₂, h₃])
        else isFalse fun h => h₃ (congrArg Spot.cuts h)
      else isFalse fun h => h₂ (congrArg Spot.place h)
    else isFalse fun h => h₁ (congrArg Spot.name h)

attribute [local instance] spotDecEq

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `spotsOfK` at the written table: one decision of the kernel. -/
theorem spotsK_written : spotsOfK cutWritten = some spotsWritten := by
  decide +kernel

/-- **THE PLACES AT THE WRITTEN TABLE.** -/
theorem spots_written : spotsOf cutWritten = some spotsWritten :=
  (spotsOf_eq _).trans spotsK_written

set_option maxRecDepth 1000000 in
/-- A negative test: with the first row's kind bent nothing is returned. -/
theorem spots_refuse :
    (spotsOf (cutWritten.set 0 ⟨"G0.0.call", "gFirst", 0, "sent", 2⟩)).isNone = true := by
  rw [spotsOf_eq]
  decide +kernel

end Johnson.AtFull.Desc

