open Johnson.AtFull.Cut (cutWritten)

/-- `ProofFile.headOf` behind `Johnson.Unfolds.splitOn_eq`. -/
def headK (look : String) : String :=
  (if ("." == "") = true then [look]
    else (Johnson.Unfolds.splitF (Johnson.Unfolds.splitBound look "." 0 0) look "." 0 0 0 []).getD
      []).headD ""

/-- `ProofFile.headOf` is `headK`, at all names. -/
theorem headOf_eq (look : String) : headOf look = headK look := by
  unfold headOf headK
  rw [Johnson.Unfolds.splitOn_eq]

/-- `ProofFile.byPlace` over `headK`. -/
def byPlaceK : List Cut → List (List Cut)
  | [] => []
  | c :: cs =>
    match byPlaceK cs with
    | (d :: g) :: gs =>
      if d.place == c.place && headK d.look == headK c.look then (c :: d :: g) :: gs
      else [c] :: (d :: g) :: gs
    | gs => [c] :: gs

/-- `ProofFile.byPlace` is `byPlaceK`, at all tables. -/
theorem byPlace_eq : ∀ cs : List Cut, byPlace cs = byPlaceK cs
  | [] => rfl
  | c :: cs => by
    rw [byPlace, byPlaceK, byPlace_eq cs]
    cases byPlaceK cs with
    | nil => rfl
    | cons g gs =>
      cases g with
      | nil => rfl
      | cons d g => simp only [headOf_eq]

/-- `ProofFile.spotsFrom` over `headK`. -/
def spotsFromK : List (List Cut) → (link piece : Nat) → (last : String) → Option (List Spot)
  | [], _, _, _ => some []
  | [] :: gs, link, piece, last => spotsFromK gs link piece last
  | (c :: g) :: gs, link, piece, last =>
    let h := headK c.look
    let back := behindLinks h
    let fresh := h != last && !(back && behindLinks last)
    let link' := if fresh && !last.isEmpty && !behindLinks last then link + 1 else link
    let piece' := if fresh then 1 else piece
    (kindName h c.kind).bind fun k =>
      (spotsFromK gs link' (piece' + 1) h).map fun l =>
        let mine : Nat → Spot := fun at' =>
          { name := s!"{h}:{piece'}", place := ⟨1, if back then none else some link', at', k⟩,
            cuts := (c :: g).map fun x => if x.kind == "SEAL" then { x with take := 1 } else x }
        if k == KindName.K10 then
          { name := s!"{h}:{piece'}.equation", place := ⟨1, some link', piece' + 1, .K9⟩,
            cuts := [] } :: mine (piece' + 2) ::
          { name := s!"{h}:{piece'}.shut", place := ⟨1, some link', piece' + 3, .K9⟩,
            cuts := [] } :: l
        else mine piece' :: l

/-- `ProofFile.spotsFrom` is `spotsFromK`, at all arguments. -/
theorem spotsFrom_eq : ∀ (gs : List (List Cut)) (link piece : Nat) (last : String),
    spotsFrom gs link piece last = spotsFromK gs link piece last
  | [], _, _, _ => rfl
  | [] :: gs, link, piece, last => by
    rw [spotsFrom, spotsFromK, spotsFrom_eq gs]
  | (c :: g) :: gs, link, piece, last => by
    have ih := spotsFrom_eq gs
    rw [spotsFrom, spotsFromK]
    simp only [headOf_eq, ih]

/-- `ProofFile.spotsOf` over `headK`. -/
def spotsOfK (cs : List Cut) : Option (List Spot) := spotsFromK (byPlaceK cs) 0 1 ""

/-- **`ProofFile.spotsOf` is its twin**, at all tables. -/
theorem spotsOf_eq (cs : List Cut) : spotsOf cs = spotsOfK cs := by
  unfold spotsOf spotsOfK
  rw [byPlace_eq, spotsFrom_eq]

