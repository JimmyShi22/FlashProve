/-- The runs of the block of that name. -/
def runsAt (n : String) : List (Nat × Nat) := (whichW.lookup n).elim [] fun j => listsW.getD j []

/-- **The declared rounds of the block of that name.** -/
def listAt (n : String) : List Fmt.DeclaredRound := unrunG declRecsFull (runsAt n)

/-! ## The law -/

/-- Lists of runs in a row, laid out one by one or all together. -/
theorem unrunG_flatMap {α β : Type} (recs : List α) (l : List β) (f : β → List (Nat × Nat)) :
    l.flatMap (fun a => unrunG recs (f a)) = unrunG recs (l.flatMap f) := by
  unfold unrunG
  rw [List.flatMap_assoc]

/-- From a yes of the walk: the names' lists in a row are the list of these runs. -/
theorem lists_of_walk {names : List String} {runs : List (Nat × Nat)} {k : Nat}
    (h : sameBy (fun a b : Fmt.DeclaredRound => decide (id a = id b)) k
      (valRuns declRecsFull (names.flatMap runsAt)) (valRuns declRecsFull runs) = true) :
    names.flatMap listAt = unrunG declRecsFull runs := by
  have e := map_eq_of_same (id : Fmt.DeclaredRound → Fmt.DeclaredRound) id k h
  rw [List.map_id, List.map_id] at e
  unfold listAt
  rw [unrunG_flatMap]
  exact e

/-! ## The closed statements -/

set_option maxRecDepth 1000000 in
theorem walk_first : sameBy (fun a b : Fmt.DeclaredRound => decide (id a = id b)) 60000
    (valRuns declRecsFull ((cutFirstFull.map (·.1)).flatMap runsAt))
    (valRuns declRecsFull dryProofRunsFull0) = true := by decide +kernel

set_option maxRecDepth 1000000 in
theorem walk_shared : sameBy (fun a b : Fmt.DeclaredRound => decide (id a = id b)) 1000
    (valRuns declRecsFull ((cutSharedFull.map (·.1)).flatMap runsAt))
    (valRuns declRecsFull dryProofRunsFull1) = true := by decide +kernel

set_option maxRecDepth 1000000 in
theorem walk_second : sameBy (fun a b : Fmt.DeclaredRound => decide (id a = id b)) 1000
    (valRuns declRecsFull ((cutSecondFull.map (·.1)).flatMap runsAt))
    (valRuns declRecsFull dryProofRunsFull2) = true := by decide +kernel

/-- **The first chain: the names' lists in a row are the written declared rounds.** -/
theorem first_lists : (cutFirstFull.map (·.1)).flatMap listAt = declProofFull.1 :=
  lists_of_walk walk_first

/-- The shared chain. -/
theorem shared_lists : (cutSharedFull.map (·.1)).flatMap listAt = declProofFull.2.1 :=
  lists_of_walk walk_shared

/-- The second chain. -/
theorem second_lists : (cutSecondFull.map (·.1)).flatMap listAt = declProofFull.2.2 :=
  lists_of_walk walk_second

/-! ## The walk can fail -/

/-- The first chain's names with two of them exchanged. -/
def swapped (a b : String) : List String :=
  (cutFirstFull.map (·.1)).map fun n => if n == a then b else if n == b then a else n

set_option maxRecDepth 1000000 in
/-- Two code switches' names exchanged: their lists have two rounds each, and differ. -/
theorem walk_first_swapped : sameBy (fun a b : Fmt.DeclaredRound => decide (id a = id b)) 60000
    (valRuns declRecsFull ((swapped "A1:1" "G2:1").flatMap runsAt))
    (valRuns declRecsFull dryProofRunsFull0) = false := by decide +kernel

set_option maxRecDepth 1000000 in
/-- The last name dropped. -/
theorem walk_first_short : sameBy (fun a b : Fmt.DeclaredRound => decide (id a = id b)) 60000
    (valRuns declRecsFull ((cutFirstFull.map (·.1)).dropLast.flatMap runsAt))
    (valRuns declRecsFull dryProofRunsFull0) = false := by decide +kernel

end Johnson.AtFull.Rounds

