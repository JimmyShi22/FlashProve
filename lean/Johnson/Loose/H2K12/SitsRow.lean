set_option autoImplicit false
namespace H2K.JointK
open VerifiableInference.Desc VerifiableInference.Desc.K12
open VerifiableInference.Desc.K12.Seat (enterOwn leaveOwn)

/-- The row at the description descN o mk guardedProximityTestParts Z N c. -/
structure RowK12 (o : ProofFile.SecondHashFunctionArgument) (mk : ProofFile.LinksBy) (Z : ProofFile.Pub) (N : H2U.Places4)
    (c : Chain First.S ProofFile.Cl) : Prop where
  first : ∃ (J : Block First.S ProofFile.Cl) (leave : First.S → T12 → Except String First.S),
    firstEntry ProofFile.sameReply J ∈ (descN o mk guardedProximityTestParts Z N c).first.blocksInOrder ∧
    FirstOut ProofFile.sameReply (pL N) J leave ∧
    Sits (firstEntry ProofFile.sameReply J) (proximityTestKind guardedProximityTestParts (pL N) : Blk') enterFinish leave ∧
    ∀ E ∈ (descN o mk guardedProximityTestParts Z N c).first.blocksInOrder, E.place.kind = .K12 →
      E = firstEntry ProofFile.sameReply J
  gu : guEntry ProofFile.Cl N ∈ (descN o mk guardedProximityTestParts Z N c).shared.blocksInOrder ∧
    Sits (guEntry ProofFile.Cl N) (proximityTestKind guardedProximityTestParts (pGu N) : Blk') (Seat.enter (·.gU) (·.firstMask))
      Seat.leave
  omega : ∀ nO, N.O = some nO →
    omegaEntry ProofFile.Cl nO ∈ (descN o mk guardedProximityTestParts Z N c).shared.blocksInOrder ∧
    Sits (omegaEntry ProofFile.Cl nO) (proximityTestKind guardedProximityTestParts (pGomega nO) : Blk')
      (Seat.enter (·.gOmega) fun _ => none) Seat.leave
  sharedOnly : ∀ E ∈ (descN o mk guardedProximityTestParts Z N c).shared.blocksInOrder, E.place.kind = .K12 →
    E = guEntry ProofFile.Cl N ∨ ∃ nO, N.O = some nO ∧ E = omegaEntry ProofFile.Cl nO
  own : ownEntry ProofFile.Cl (proximityTestKind guardedProximityTestParts (pOwn N) : Blk') ∈ (descN o mk guardedProximityTestParts Z N c).second.blocksInOrder ∧
    Sits (ownEntry ProofFile.Cl (proximityTestKind guardedProximityTestParts (pOwn N) : Blk')) (proximityTestKind guardedProximityTestParts (pOwn N) : Blk') enterOwn
      leaveOwn ∧
    ∀ E ∈ (descN o mk guardedProximityTestParts Z N c).second.blocksInOrder, E.place.kind = .K12 →
      E = ownEntry ProofFile.Cl (proximityTestKind guardedProximityTestParts (pOwn N) : Blk')

section
variable {o : ProofFile.SecondHashFunctionArgument} {mk : ProofFile.LinksBy} {Z : ProofFile.Pub} {N : H2U.Places4}
  {c : Chain First.S ProofFile.Cl}

/-- ★ Every entry of the first chain that bears the kind sits. -/
theorem RowK12.every₁ (R : RowK12 o mk Z N c) :
    ∀ E ∈ (descN o mk guardedProximityTestParts Z N c).first.blocksInOrder, E.place.kind = .K12 →
      ∃ leave, Sits E (proximityTestKind guardedProximityTestParts (pL N) : Blk') enterFinish leave := by
  obtain ⟨J, leave, _, _, hs, ho⟩ := R.first
  intro E hE hk
  rw [ho E hE hk]
  exact ⟨leave, hs⟩

/-- ★ Every entry of the shared chain that bears the kind sits. -/
theorem RowK12.every₂ (R : RowK12 o mk Z N c) :
    ∀ E ∈ (descN o mk guardedProximityTestParts Z N c).shared.blocksInOrder, E.place.kind = .K12 →
      Sits E (proximityTestKind guardedProximityTestParts (pGu N) : Blk') (Seat.enter (·.gU) (·.firstMask)) Seat.leave ∨
      ∃ nO, N.O = some nO ∧
        Sits E (proximityTestKind guardedProximityTestParts (pGomega nO) : Blk') (Seat.enter (·.gOmega) fun _ => none)
          Seat.leave := by
  intro E hE hk
  rcases R.sharedOnly E hE hk with rfl | ⟨nO, hO, rfl⟩
  · exact .inl R.gu.2
  · exact .inr ⟨nO, hO, (R.omega nO hO).2⟩

/-- ★ Every entry of the last chain that bears the kind sits. -/
theorem RowK12.every₃ (R : RowK12 o mk Z N c) :
    ∀ E ∈ (descN o mk guardedProximityTestParts Z N c).second.blocksInOrder, E.place.kind = .K12 →
      Sits E (proximityTestKind guardedProximityTestParts (pOwn N) : Blk') enterOwn leaveOwn := by
  intro E hE hk
  rw [R.own.2.2 E hE hk]
  exact R.own.2.1

/-- ★ Where the description passes its test on the plan the constant passes its own at all four
places. -/
theorem RowK12.plans (R : RowK12 o mk Z N c) (hp : (descN o mk guardedProximityTestParts Z N c).planOk = true) :
    (proximityTestKind guardedProximityTestParts (pL N) : Blk').planOk = true ∧ (proximityTestKind guardedProximityTestParts (pGu N) : Blk').planOk = true ∧
      (∀ nO, N.O = some nO → (proximityTestKind guardedProximityTestParts (pGomega nO) : Blk').planOk = true) ∧
      (proximityTestKind guardedProximityTestParts (pOwn N) : Blk').planOk = true := by
  obtain ⟨b1, b2, b3⟩ := VerifiableInference.Desc.Keeps.planOk_blocks _ hp
  obtain ⟨J, leave, hm, _, hs, _⟩ := R.first
  exact ⟨hs.plan (b1 _ hm), R.gu.2.plan (b2 _ R.gu.1),
    fun nO hO => (R.omega nO hO).2.plan (b2 _ (R.omega nO hO).1), R.own.2.1.plan (b3 _ R.own.1)⟩

/-- ★ And so its numbers are the maker's own: the empty place is shut out. -/
theorem RowK12.nums (R : RowK12 o mk Z N c) (hp : (descN o mk guardedProximityTestParts Z N c).planOk = true) :
    (pL N).nums = N.L.nums ∧ (pGu N).nums = N.U.nums ∧
      (∀ nO, N.O = some nO → (pGomega nO).nums = nO.nums) ∧ (pOwn N).nums = N.W.nums := by
  obtain ⟨h1, h2, h3, h4⟩ := R.plans hp
  exact ⟨H2K.Made.nums_of_planOk a12 N.L h1, H2K.Made.nums_of_planOk ⟨2, none, 9, .K12⟩ N.U h2,
    fun nO hO => H2K.Made.nums_of_planOk ⟨2, none, 10, .K12⟩ nO (h3 nO hO),
    H2K.Made.nums_of_planOk ⟨3, none, 2, .K12⟩ N.W h4⟩

end

/-- ★★★ The proof file's half of the row: where ProofFile.onlineDescription returns F, F is descN at the public
parameters Z, the maker's places N and a first chain c, and the row holds there. -/
theorem k12_sits_row (o : ProofFile.SecondHashFunctionArgument) (pol lay KL : ByteArray) (F : FileDescription ProofFile.Inst)
    (hF : ProofFile.onlineDescription o pol lay KL = .ok F) :
    ∃ Z N c, ProofFile.pubPlain o pol lay KL = .ok Z ∧ H2U.placesOfMade Z.made = .ok N ∧
      F = descN o ProofFile.pureRoad.links guardedProximityTestParts Z N c ∧ RowK12 o ProofFile.pureRoad.links Z N c := by
  obtain ⟨Z, N, c, B, hZ, hN, e, _, pre, l, J, hc, honly, hJ⟩ := k12_sits o pol lay KL F hF
  obtain ⟨leave, hout, hs⟩ := firstJ_sits ProofFile.sameReply (pL N) J hJ
  obtain ⟨o2, o3⟩ := descN_only o ProofFile.pureRoad.links guardedProximityTestParts Z N c
  have f1 : (descN o ProofFile.pureRoad.links guardedProximityTestParts Z N c).first.blocksInOrder = c.blocksInOrder := rfl
  refine ⟨Z, N, c, hZ, hN, e, ⟨⟨J, leave, ?_, hout, hs, ?_⟩, ⟨?_, guEntry_sits ProofFile.Cl N⟩, ?_, o2,
    ⟨?_, ownEntry_sits ProofFile.Cl _, o3⟩⟩⟩
  · rw [f1, hc]
    exact List.mem_append_right _ List.mem_cons_self
  · rw [f1]
    exact honly
  · rw [descN_shared]
    exact List.mem_append_right _ List.mem_cons_self
  · intro nO hO
    refine ⟨?_, omegaEntry_sits ProofFile.Cl nO⟩
    rw [descN_shared, hO]
    exact List.mem_append_right _ (List.mem_cons_of_mem _ (List.mem_append_left _
      (List.mem_map.2 ⟨nO, List.mem_singleton.2 rfl, rfl⟩)))
  · rw [descN_second]
    exact List.mem_append_right _ List.mem_cons_self

theorem pull_first {Xi Xi' : Type} (f : Xi' → Xi) (F : FileDescription Xi) :
    (F.pull f).first = F.first := rfl
theorem pull_shared {Xi Xi' : Type} (f : Xi' → Xi) (F : FileDescription Xi) :
    (F.pull f).shared = F.shared := rfl
theorem pull_second {Xi Xi' : Type} (f : Xi' → Xi) (F : FileDescription Xi) :
    (F.pull f).second = F.second := rfl

/-- ★★★ AT proofDataAndDecisionOfPublicFiles's RETURN (the value offered for the verifier's slot). RowK12 speaks of descN's
three lists: by pull_first | pull_shared | pull_second (rfl) these are, to the letter, the pulled
description's own. -/
theorem k12_sits_row_laid (o : ProofFile.SecondHashFunctionArgument) (pol lay KL : ByteArray) (D : OnBytes.Maker.WholeD)
    (r : LPFD.Full.RunPF) (hL : LPFD.Full.proofDataAndDecisionOfPublicFiles o pol lay KL = .ok (D, r)) :
    ∃ Z N c, ProofFile.pubPlain o pol lay KL = .ok Z ∧ H2U.placesOfMade Z.made = .ok N ∧
      ProofFile.onlineDescription o pol lay KL = .ok (descN o ProofFile.pureRoad.links guardedProximityTestParts Z N c) ∧
      r = ((descN o ProofFile.pureRoad.links guardedProximityTestParts Z N c).pull LPFD.Full.instanceAsPlainRecord).run ∧
      (descN o ProofFile.pureRoad.links guardedProximityTestParts Z N c).planOk = true ∧
      RowK12 o ProofFile.pureRoad.links Z N c ∧
      ((proximityTestKind guardedProximityTestParts (pL N) : Blk').planOk = true ∧ (proximityTestKind guardedProximityTestParts (pGu N) : Blk').planOk = true ∧
        (∀ nO, N.O = some nO → (proximityTestKind guardedProximityTestParts (pGomega nO) : Blk').planOk = true) ∧
        (proximityTestKind guardedProximityTestParts (pOwn N) : Blk').planOk = true) ∧
      ((pL N).nums = N.L.nums ∧ (pGu N).nums = N.U.nums ∧
        (∀ nO, N.O = some nO → (pGomega nO).nums = nO.nums) ∧ (pOwn N).nums = N.W.nums) ∧
      (descN o ProofFile.pureRoad.links guardedProximityTestParts Z N c).data "proof file" = .ok D ∧
      ∀ t ∈ LPFD.lawsAsk o pol lay KL (descN o ProofFile.pureRoad.links guardedProximityTestParts Z N c) D,
        t.2 = true := by
  obtain ⟨F, hF, hp, hD, hs, hr⟩ := LPFD.Full.laidPOf_ok hL
  obtain ⟨Z, N, c, hZ, hN, rfl, R⟩ := k12_sits_row o pol lay KL F hF
  exact ⟨Z, N, c, hZ, hN, hF, hr, hp, R, R.plans hp, R.nums hp, hD, hs⟩

/-- ★★★ AT THE VERIFIER's OWN GATE: where FlashProve.protocolDataWellFormed accepts the three public files, the
decision behind the proof file's gate (theProofRun) is the run of descN … pulled along instanceAsPlainRecord, its
data (theProofData) are that IOP's own, and all that k12_sits_row_laid says holds at the format's
second hash function OnBytes.secondHashFunction. By FlashProve.pseat_name
(Johnson/Goal/Description/ProofSeat.lean). OnBytes.secondHashFunction enters as the value of the letter o at the
gate: nothing here spends a property of it (k12_sits_row is general in o). NO EXAMPLE: that protocolDataWellFormed
accepts at any files is shown by no theorem here (at files as bytes an evaluation alone says so). -/
theorem k12_sits_row_live (S : VerifierAndGoals.PublicFiles)
    (live : FlashProve.protocolDataWellFormed (VerifierAndGoals.asDescriptionFiles S) = true) :
    ∃ Z N c, ProofFile.pubPlain OnBytes.secondHashFunction S.pol S.lay S.KL = .ok Z ∧
      H2U.placesOfMade Z.made = .ok N ∧
      ProofFile.onlineDescription OnBytes.secondHashFunction S.pol S.lay S.KL =
        .ok (descN OnBytes.secondHashFunction ProofFile.pureRoad.links guardedProximityTestParts Z N c) ∧
      FlashProve.theProofRun (VerifierAndGoals.asDescriptionFiles S) =
        ((descN OnBytes.secondHashFunction ProofFile.pureRoad.links guardedProximityTestParts Z N c).pull LPFD.Full.instanceAsPlainRecord).run ∧
      (descN OnBytes.secondHashFunction ProofFile.pureRoad.links guardedProximityTestParts Z N c).planOk = true ∧
      RowK12 OnBytes.secondHashFunction ProofFile.pureRoad.links Z N c ∧
      ((proximityTestKind guardedProximityTestParts (pL N) : Blk').planOk = true ∧ (proximityTestKind guardedProximityTestParts (pGu N) : Blk').planOk = true ∧
        (∀ nO, N.O = some nO → (proximityTestKind guardedProximityTestParts (pGomega nO) : Blk').planOk = true) ∧
        (proximityTestKind guardedProximityTestParts (pOwn N) : Blk').planOk = true) ∧
      ((pL N).nums = N.L.nums ∧ (pGu N).nums = N.U.nums ∧
        (∀ nO, N.O = some nO → (pGomega nO).nums = nO.nums) ∧ (pOwn N).nums = N.W.nums) ∧
      (descN OnBytes.secondHashFunction ProofFile.pureRoad.links guardedProximityTestParts Z N c).data "proof file" =
        .ok (FlashProve.theProofData (VerifierAndGoals.asDescriptionFiles S)) ∧
      ∀ t ∈ LPFD.lawsAsk OnBytes.secondHashFunction S.pol S.lay S.KL
          (descN OnBytes.secondHashFunction ProofFile.pureRoad.links guardedProximityTestParts Z N c)
          (FlashProve.theProofData (VerifierAndGoals.asDescriptionFiles S)),
        t.2 = true := by
  obtain ⟨F, hF, hp, hD, hs, hr⟩ := FlashProve.pseat_name S live
  obtain ⟨Z, N, c, hZ, hN, rfl, R⟩ := k12_sits_row OnBytes.secondHashFunction S.pol S.lay S.KL F hF
  exact ⟨Z, N, c, hZ, hN, hF, hr, hp, R, R.plans hp, R.nums hp, hD, hs⟩

end H2K.JointK

