/-- **What is left for the lines in front, the riders and what an accepting run keeps**, at one
group, one piece and one public part: the premises of `k4Row_of_means` but `K4Means`, the place and
the piece's base. -/
structure K4RowAt {Fr : Frame} (x : Bool × Par) (links : List ModelPart)
    (ps : List VerifiableInference.Desc.Place) (k m : ℕ) (pl : VerifiableInference.Desc.Place)
    (q : Piece (ckP .two) Fr (ProofFile.InstPub × S) ProofFile.Cl (Wit (CellsK rows cols) Tok MsgT))
    (Dk : K4Data Xi ProofFile.InstPub Tok rows cols nR kC Xp)
    (Mg : Meaning ProofFile.InstPub (Wit (CellsK rows cols) Tok MsgT))
    (told : List (List VerifiableInference.Desc.Oracle)) (z : ProofFile.InstPub) where
  /-- PUBLIC LETTERS of the tests on public data: the two public files, the layout file, a
  number. -/
  pol : ByteArray
  KL : ByteArray
  layout : Option ByteArray
  n : ℕ
  /-- A LETTER: which names of the meaning's door ride across K4's sub-protocol untouched. -/
  rest : Option ℕ → String → Bool
  /-- LETTERS: the segment of the IOP as written in Lean, and the lookup's two runs in it. Shown at
  that IOP's own segment elsewhere: not called. -/
  Hh : K9.LinkHoles
  l : Link S Claim
  nO : String
  nG : String
  runO : ℕ → S → Except String (List Claim × S)
  runG : ℕ → S → Except String (List Claim × S)
  /-- ON THE DATA's LETTERS: they read only what K4's accepting run leaves. Left to the files
  that fill the letters (Johnson/P5J/) and to each layer's files, once the letters are terms. -/
  reads : K4Reads Dk z Fr q.base
  /-- TESTS ON PUBLIC DATA ALONE: 36 fields, each decidable. K4's; seven are theorems in the goals'
  scope (not called); those that read the meaning's door: decided at an elder door alone. -/
  plan : K4RowPlan Dk rest links ps k m pl (parOf x) told pol KL layout (parOf x).hp n
  /-- ONE LINE FOR EVERY NAME AT THE DOOR, OF WHICHEVER KIND: a name of the sort rest has a test
  that says one thing at two states that part inside K4's fence alone. K4's: a theorem at the
  names, out of `K4Means` and five equations on the pile's and the frame's names: not called. -/
  kept : K4Kept Mg rest z
  /-- ON THE SEGMENT's SUB-PROTOCOLS: the data's readers are the segment's; K4's two runs at the
  segment are the sub-protocol's own, state by state; the lookup's two runs are found there and are
  of the right make. K4's: shown at the IOP's own segment: not called. -/
  seats : K4Seats Dk m (parOf x) Hh l nO nG runO runG
  /-- OUT OF THE MEANING's DOOR: whatever name the door's row makes at K4's place holds behind an
  accepting run. K4's: where the door makes no name there, it holds for nothing (a decision by the
  kernel at a closed door): not called. -/
  door : ∀ B', SeatOf (ProofFile.k4Block x) B' → ∀ a τ fo o G',
    onQ Dk.N Mg links ps (fun s => (z, s)) k a → a.1.failed = none →
    Yes seatS (parOf x) (twinOf q B') a τ fo o G' → ∀ nm ∈ (Mg.more.rows links pl).makes,
    Mg.pub (moreItem nm) (z, (behindOf seatS (twinOf q B') a τ o G').1) = true
  /-- AND ITS SENTENCE WITHOUT A TEST HOLDS EVERYWHERE. K4's: at the base `mgBase`: not called. -/
  doorP : ∀ nm ∈ (Mg.more.rows links pl).makes, ∀ a, Mg.pubP (moreItem nm) a

/-- **What pins the name that the segment's row bears**: three premises of `Rec.nextEntryIs`. -/
structure K4NameAt (links : List ModelPart) (ps : List VerifiableInference.Desc.Place) (k m : ℕ)
    (Dk : K4Data Xi ProofFile.InstPub Tok rows cols nR kC Xp)
    (Mg : Meaning ProofFile.InstPub (Wit (CellsK rows cols) Tok MsgT)) : Prop where
  /-- OUT OF THE PROMISE, AN IMPLICATION: where the public item "K13.pileWithin" holds, every ledger
  of the verifier's state is that of some number of takes since it was made. The pile's files': it
  hangs on their statement `OwedLedgersC`, proved as `ledgersC` (Desc/K13/Law/LedgersC.lean). -/
  within : Rec.EWithin Mg
  /-- A TEST ON PUBLIC DATA: the four public items that pin the entry are asked by the promise
  behind K4's sub-protocol. OF ITS FOUR: indexIs: decided by the kernel at the written lists (pinI
  is open there; a negative test rejects). ALL FOUR: decided by the kernel at the wider
  meaning's door (`mgWide`): it accepts; at the composed meaning's own door it rejects. -/
  openNext : Rec.openNextB Mg.more links ps (k + 1) m = true
  /-- A TEST ON PUBLIC DATA: the list of shapes has one at the index masks' number; free0 is its
  count of free entries; the bearing segments in front of m are at most so many. Evaluated true at
  the twelve segments at the full size, with two negative tests, at a sheet's own letters. -/
  nextFits : Rec.nextFitsB Dk.cs Dk.d12.M (Dk.N.msgsAt ps[k + 1]?) Dk.N.indexNo Dk.free0
    Dk.fvs m = true

