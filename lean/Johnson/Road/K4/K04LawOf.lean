    (q : Piece (ckP .two) Fr (ProofFile.InstPub × S) ProofFile.Cl (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT))
    (Dk : K4Data Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nR kC Xp)
    (Mg : Meaning ProofFile.InstPub (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)) (z : ProofFile.InstPub) where
  /-- LETTERS WITHOUT A TERM HERE: as in `K4LaterAt`. -/
  xL : VerifiableInference.Desc.First.Look.Place
  posI : ℕ → Bool × ℕ × ℕ
  enc : CellsK hRef (2 ^ kRef) → Dk.L3.oW.Msg
  sz : ℕ → Size
  seat : ∀ k, Fin (sz k).NM → ℕ → ℕ → ℕ × ℕ × ℕ
  nM : ℕ
  nRr : ℕ
  nC : ℕ
  nx : ℕ
  v7 : ℕ
  /-- A THEOREM IN THE GOALS' SCOPE (`refPub_in_scope`, Johnson/Road/K4/RefInScope.lean), not called
  in this file. -/
  B : RefPub Xp (parOf x).g
  /-- THREE FACTS ON THE PUBLIC PARAMETERS that the first group's embedding wants. -/
  hla : (layerShape Xp.P).la = 16
  hV : (parOf x).P.V = ppref.V
  NE : EmbNums (parOf x).P.y
  /-- FIVE TIES ON THE DATA's LETTERS: as in `K4LaterAt`. -/
  tiesM : MeansTies Dk (parOf x) m xL sz seat enc
  /-- EIGHT CONDITIONS ON PUBLIC LETTERS. K4's. -/
  fit : K4PlanFitF (X := Xp) (p := parOf x) xL (pubAt Xp (m / stepOf Xp)) (sentOf Dk) Dk.L3.rad
    (fun j => Dk.L3.seat xL.link false j.1) posI Dk.L3.oW enc Dk.L3.wOf Dk.arr Dk.ms Dk.N m nM nRr
    nC 0 sz seat Dk.hd
  /-- THREE TIES ON FOUR OF THE DATA's LETTERS: the request's words are the bytes' words; the
  request is what is read back off the bytes; put is the library's. Left to the files that fill
  the letters (Johnson/P5J/): met by nobody. -/
  reqT : ReqTies Dk.reqB Dk.reqW Dk.H.req Dk.put
  /-- ON THE DATA's LETTERS: as in `K4LaterAt`. -/
  rides : RecRides (sentOf Dk).codes Dk.smp Dk.decT z
  /-- A TIE OF TWO READERS, AND THE PILE's READER's MATRIX: as in `K4LaterAt`. -/
  encIs : cutW enc Dk.L3.wOf hRef (2 ^ kRef) = rcQ hRef (2 ^ kRef)
  rwMat : ∀ a w, (Dk.rw13 a w).mat = matOfCells nR kC w.cells
  /-- A TIE OF TWO READERS OF ONE WITNESS: as in `K4LaterAt`, at the first group's value. -/
  mask : ∀ (b : S × Fr.E.Str) w, onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1) b →
    b.1.failed = none →
    (Dk.rw13 (z, b.1) w).mask
        ⟨Dk.N.indexNo, Rec.nextNoP Dk.d12.M (Dk.N.msgsAt ps[k + 1]?) Dk.N.indexNo Dk.fvs m⟩ =
      (qkFAt Dk (parOf x) m xL posI enc nM nRr nC nx v7).toPlan4K.toL.plan.full.msg
        (partOf (sentOf Dk).codes Dk.arr Dk.ms Dk.N m w)
        (qkFAt Dk (parOf x) m xL posI enc nM nRr nC nx v7).toPlan4K.toL.plan.full.c7
  /-- OF WEIGHT: THE LINE forms, at the first group's value. K4's. -/
  forms : ∀ B', SeatOf (ProofFile.k4Block x) B' → ∀ b w,
    ((qkFAt Dk (parOf x) m xL posI enc nM nRr nC nx v7).lettersOfF (Fr := Fr)
      (partOf (sentOf Dk).codes Dk.arr Dk.ms Dk.N m) (parOf x) 0 (parOf x).P.y.fo
      (LeftQ (parOf x).hp.ns) (tableOn0 Dk.N Mg z links ps k)
      (keptFrom (tableOn0 Dk.N Mg z links ps k) (parOf x) (twinOf q B'))
      (tableCtx0 Dk.N Mg z m) (decOf (sentOf Dk).codes Dk.G Dk.smp Dk.ms Dk.decT Dk.N z m)).on' b →
    onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1) b → b.1.failed = none →
    meansQ (Fr := Fr) Dk.N Mg (fun s => (z, s)) (.formsT m 3 "own") b w →
    FormsT seatS ((qkFAt Dk (parOf x) m xL posI enc nM nRr nC nx v7).toPlan4K.semOf
      (partOf (sentOf Dk).codes Dk.arr Dk.ms Dk.N m) (parOf x).hp.tl) (frontRun (parOf x))
      formsBack b.1 w

end

/-- "In order" gives that the state's code table is the data's: out of `K4Means`' field inOrder. -/
theorem codes_of_means {P : Type} {Dk : K4Data Xi P Tok rows cols nR kC Xp}
    {Mg : Meaning P (Wit (CellsK rows cols) Tok MsgT)} (Em : K4Means Mg Dk) :
    Rec.ECodes Mg Dk.cs := fun a h => by
  rw [Em.inOrder a] at h
  simp only [Bool.and_eq_true] at h
  have h1 := h.1.1.1.2
  unfold VerifiableInference.Desc.First.eqsB at h1
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h1
  exact h1.1.1

/-- **The core of the line wo at a meaning that meets `K4Means`**: the two premises of `k4_wo_core`
on the meaning's fields are paid by the fields hasRow and wo; hopen, `WoTies`, hname, hmat, hmask
stay. hname was met by no clause of the table's promise when K4LinesWo.lean was typed: see its
Limits. -/
theorem k4_wo_of_means [scl : Scl] {M P : Type} {Fr : Frame}
    {Dk : K4Data Xi P Tok rows cols nR kC Xp}
    {Mg : Meaning P (Wit (CellsK rows cols) Tok MsgT)} (Em : K4Means Mg Dk) {Z : P}
    {links : List ModelPart} {ps : List VerifiableInference.Desc.Place} {k m : ℕ} (QK : Plan4K M S)
    {part : Wit (CellsK rows cols) Tok MsgT → M} {par : Par}
    (hopen : Item.wo m ∈ (openSets links ps (start links))[k + 1]?.getD [])
    (T : WoTies Dk.d1.lay nR kC QK part par)
    (hmat : ∀ (b : S × Fr.E.Str) w, onQ Dk.N Mg links ps (fun s => (Z, s)) (k + 1) b →
      b.1.failed = none → ∀ (i : Fin nR) (C : ℕ), C < 2 ^ kC →
        (Dk.rw13 (Z, b.1) w).mat i (lowBits kC C) =
          QK.toL.plan.full.Wn (QK.toL.plan.full.msg (part w)) i C)
    {im₀ v : ℕ}
    (hname : ∀ b : S × Fr.E.Str, onQ Dk.N Mg links ps (fun s => (Z, s)) (k + 1) b →
      b.1.failed = none → b.1.out.indexMasks = im₀ ∧
        ∀ l c l', Johnson.Desc.First.Walk.Law.ledgerAt b.1 = some l →
          VerifiableInference.Desc.First.Pend.takeEntry l = some (c, l') → c = v)
    (hmask : ∀ (b : S × Fr.E.Str) w, onQ Dk.N Mg links ps (fun s => (Z, s)) (k + 1) b →
      b.1.failed = none →
      (Dk.rw13 (Z, b.1) w).mask ⟨im₀, v⟩ = QK.toL.plan.full.msg (part w) QK.toL.plan.full.c7) :
    ∀ (b : S × Fr.E.Str) w, onQ Dk.N Mg links ps (fun s => (Z, s)) (k + 1) b →
      b.1.failed = none → meansQ (Fr := Fr) Dk.N Mg (fun s => (Z, s)) (.wo m) b w →
      ∀ o, seatS.own b.1 = some o → QK.WoRow par o (part w) :=
  k4_wo_core QK (rw := Dk.rw13) hopen (fun a => Em.hasRow m a)
    (fun a y w hw => by
      rw [Em.wo] at hw
      exact hw) T hmat hname hmask

/-- The row's sentence at the first group's value, out of the row's sentence at the structure that
it extends: `Plan4KF.woRowF_iff` (WoRowSameFirst.lean): the two values part in the number of one
list of slots alone, which the sentence does not read. -/
theorem Plan4KF.woRowF_of_woRow [scl : Scl] {Mm T : Type} (QK : Plan4KF Mm T) (par : Par)
    (o : OnBytes.Model.Layer.Own) (m : Mm) (h : QK.toPlan4K.WoRow par o m) : QK.WoRowF par o m :=
  (Plan4KF.woRowF_iff QK par o m).2 h

section
variable [scl : Scl] {Fr : Frame} {pol KL : ByteArray}
  {Dk : K4Data Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nR kC Xp}
  {Mg : Meaning ProofFile.InstPub (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)} {x : Bool × Par}
  {links : List ModelPart} {ps : List VerifiableInference.Desc.Place} {k m : ℕ}
  {pl pl' : VerifiableInference.Desc.Place}
  {q : Piece (ckP .two) Fr (ProofFile.InstPub × S) ProofFile.Cl (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)}
  {z : ProofFile.InstPub} {B' : Block S ProofFile.Cl}

/-- **The piece's own law at a later group**: `k4_own_end` at the letters that `meanEqs_of_means`
names, its line wo by `k4Lines_wo_at` at the pinned readers. -/
theorem k04_own_later (hnR : nR = hRef) (hkC : kC = kRef) (Em : K4Means Mg Dk)
    {hg : (parOf x).g < 12}
    (Lw : K4LaterAt x links ps k m q Dk Mg hg z) (hscl : scl = sclX Xp (parOf x).g)
    (St : PublicSteps pol KL Xp) (hP : (parOf x).P = { Xp.layers with tokv := Xp.layers.tokv })
    (hG : Xp.G[(parOf x).g]? = some (parOf x).hp) (hg0 : ((parOf x).g == 0) = false)
    (hB : SeatOf (ProofFile.k4Block x) B') (hds : q.ds = dsLater (parOf x)) (hbk : q.back = [])
    (hcap : q.err = Err.cap 128 (uLT (ckP .two) q.ds)) (lw : ℕ → LW Cb.Gl.E)
    (Hk : AtK4 links ps k m pl) (hr : readsOpen links ps (start links) = true)
    (hopen : Item.wo m ∈ (openSets links ps (start links))[k + 1]?.getD [])
    (hlay : Dk.d1.lay = (parOf x).P.wsLay)
    (Kf : K4Front Mg z links ps m Xp.y.fo Xp.y.h.lmb 0 (LeftQ (parOf x).hp.ns))
    (Kp : K4Keeps Dk.N Mg z links ps k m pl pl' (twinOf q B') (parOf x))
    (name : ∀ b : S × Fr.E.Str, onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1) b →
      b.1.failed = none → b.1.out.indexMasks = Dk.N.indexNo ∧
        ∀ l c l', Johnson.Desc.First.Walk.Law.ledgerAt b.1 = some l →
          VerifiableInference.Desc.First.Pend.takeEntry l = some (c, l') →
          c = Rec.nextNoP Dk.d12.M (Dk.N.msgsAt ps[k + 1]?) Dk.N.indexNo Dk.fvs m) :
    (twinOf q B').Own (onQ Dk.N Mg links ps (fun s => (z, s)) k)
      (onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1)) (meansQ Dk.N Mg (fun s => (z, s)))
      (insQ links ps k) (outsQ links ps k) := by
  subst hnR hkC
  have hm0 : hRef = Dk.d1.lay.m0 := by
    rw [hlay, hP]
    exact m0_ref Lw.B hG
  have hlk : kRef = Dk.d1.lay.lk := by
    rw [hlay, hP]
    exact lk_ref Lw.B hG
  have Kf' : K4Front Mg z links ps m (parOf x).P.y.fo (parOf x).P.y.h.lmb 0
      (LeftQ (parOf x).hp.ns) := by
    rw [Lw.tiesM.worth.layout]
    exact Kf
  exact k4_own_end (p := parOf x) Lw.xL (pubAt Xp (m / stepOf Xp)) (sentOf Dk) Dk.L3.rad
    (fun j => Dk.L3.seat Lw.xL.link false j.1) Lw.posI Dk.L3.oW Lw.enc Dk.L3.wOf Dk.arr Dk.ms
    Dk.N m Lw.nM Lw.nRr Lw.nC (Forest.elems Xp.layers.y.fo) (parOf x).hp.ns Lw.nx Lw.v7 hg Dk.G
    Dk.smp Dk.decT Mg z links ps k 0
    (LeftQ (parOf x).hp.ns) Lw.sz Lw.seat Dk.hd Dk.put Dk.H Dk.headPart Dk.digitsPart hscl St Lw.B
    hP hG hg0 (pubAt_y _ _) Fr.E B' (twinOf q B') hds (fun a => a.2) hbk hcap lw
    (Nat.zero_add _).symm (fun F hF => Nat.le_succ_of_le (Nat.le_of_eq hF.2.1)) rfl
    (hearsAs_seatOf hB) (fun _ _ _ _ _ => rfl) Hk hr Kf' Kp Lw.fit
    (meanEqs_of_means Em Lw.tiesM z) Lw.rides (Lw.forms B' hB)
    (k4Lines_wo_at _ rfl (rw := Dk.rw13) hopen (fun a => Em.hasRow m a)
      (fun a y w hw => by
        rw [Em.wo] at hw
        exact hw)
      (PinPlan.woTies (pinAt Dk Lw.xL Lw.posI Lw.enc) Lw.xL.ns Dk.N (parOf x).hp.tl
        (pubAt Xp (m / stepOf Xp)).y Lw.nM Lw.nRr Lw.nC (Forest.elems Xp.layers.y.fo)
        (parOf x).hp.ns Lw.nx Lw.v7 Xp (parOf x) hg
        Dk.arr Dk.ms m hlay hm0 hlk)
      (fun b w _ _ i C hC => by
        rw [Lw.rwMat]
        exact PinPlan.wo_mat (pinAt Dk Lw.xL Lw.posI Lw.enc) Lw.encIs Lw.xL.ns Dk.N
          (parOf x).hp.tl (pubAt Xp (m / stepOf Xp)).y Lw.nM Lw.nRr Lw.nC
          (Forest.elems Xp.layers.y.fo) (parOf x).hp.ns Lw.nx Lw.v7
          Xp (parOf x) hg Dk.arr Dk.ms m w i C hC)
      name Lw.mask)

