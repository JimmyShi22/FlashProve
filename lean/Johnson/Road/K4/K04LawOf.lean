/-- The two forms of one tie: where the caller's reader, cut at the sizes, is the reading of the
cells, it gives each cell. -/
theorem encAt_of_encIs {oW : Cb.OMsg Cb.Gl.E} {rows cols : ℕ}
    {enc : (Fin rows → Fin cols → Cb.Gl.E) → oW.Msg} {wOf : oW.Msg → ℕ → ℕ → Cb.Gl.E}
    (h : cutW enc wOf rows cols = rcQ rows cols) (C : Fin rows → Fin cols → Cb.Gl.E) (r : Fin rows)
    (c : Fin cols) : wOf (enc C) r.val c.val = C r c := by
  have e := congrFun (congrFun (congrFun h C) r.val) c.val
  unfold cutW rcQ at e
  rw [if_pos ⟨r.isLt, c.isLt⟩, dif_pos ⟨r.isLt, c.isLt⟩] at e
  exact e

/-- The core of the line wo at the first group's value and the pinned readers. -/
theorem k04_wo_first (hnR : nR = hRef) (hkC : kC = kRef) (Em : K4Means Mg Dk)
    (Lw : K4FirstAt x links ps k m q Dk Mg z)
    (hP : (parOf x).P = { Xp.layers with tokv := Xp.layers.tokv })
    (hG : Xp.G[(parOf x).g]? = some (parOf x).hp)
    (hopen : Item.wo m ∈ (openSets links ps (start links))[k + 1]?.getD [])
    (hlay : Dk.d1.lay = (parOf x).P.wsLay)
    (name : ∀ b : S × Fr.E.Str, onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1) b →
      b.1.failed = none → b.1.out.indexMasks = Dk.N.indexNo ∧
        ∀ l c l', Johnson.Desc.First.Walk.Law.ledgerAt b.1 = some l →
          VerifiableInference.Desc.First.Pend.takeEntry l = some (c, l') →
          c = Rec.nextNoP Dk.d12.M (Dk.N.msgsAt ps[k + 1]?) Dk.N.indexNo Dk.fvs m) :
    ∀ (b : S × Fr.E.Str) w, onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1) b →
      b.1.failed = none → meansQ (Fr := Fr) Dk.N Mg (fun s => (z, s)) (.wo m) b w →
      ∀ o, seatS.own b.1 = some o →
        (qkFAt Dk (parOf x) m Lw.xL Lw.posI Lw.enc Lw.nM Lw.nRr Lw.nC Lw.nx
          Lw.v7).toPlan4K.WoRow (parOf x) o (partOf (sentOf Dk).codes Dk.arr Dk.ms Dk.N m w) := by
  subst hnR hkC
  have hm0 : hRef = Dk.d1.lay.m0 := by
    rw [hlay, hP]
    exact m0_ref Lw.B hG
  have hlk : kRef = Dk.d1.lay.lk := by
    rw [hlay, hP]
    exact lk_ref Lw.B hG
  exact k4_wo_of_means Em
    (qkFAt Dk (parOf x) m Lw.xL Lw.posI Lw.enc Lw.nM Lw.nRr Lw.nC Lw.nx
      Lw.v7).toPlan4K hopen
    (PinPlan.woTiesF (pinAt Dk Lw.xL Lw.posI Lw.enc) Lw.xL.ns Dk.N (parOf x).hp.tl
      (pubAt Xp (m / stepOf Xp)).y Lw.nM Lw.nRr Lw.nC (Forest.elems Xp.layers.y.fo) (parOf x).hp.ns
      Lw.nx Lw.v7 Xp (parOf x) Dk.arr
      Dk.ms m hlay hm0 hlk)
    (fun b w _ _ i C hC => by
      rw [Lw.rwMat]
      exact PinPlan.wo_matF (pinAt Dk Lw.xL Lw.posI Lw.enc) Lw.encIs Lw.xL.ns Dk.N (parOf x).hp.tl
        (pubAt Xp (m / stepOf Xp)).y Lw.nM Lw.nRr Lw.nC (Forest.elems Xp.layers.y.fo)
        (parOf x).hp.ns Lw.nx Lw.v7 Xp (parOf x)
        Dk.arr Dk.ms m w i C hC)
    name Lw.mask

/-- **The piece's own law at the first group**: `k4_own_endF` at the same letters, the premises of
its line on the request by `idnFit_of_means`, its line wo by `k04_wo_first`. -/
theorem k04_own_first (hnR : nR = hRef) (hkC : kC = kRef) (Em : K4Means Mg Dk)
    (Lw : K4FirstAt x links ps k m q Dk Mg z)
    (hscl : scl = sclX Xp (parOf x).g) (St : PublicSteps pol KL Xp)
    (hP : (parOf x).P = { Xp.layers with tokv := Xp.layers.tokv })
    (hG : Xp.G[(parOf x).g]? = some (parOf x).hp) (hg0 : ((parOf x).g == 0) = true)
    (hB : SeatOf (ProofFile.k4Block x) B') (hds : q.ds = dsFirst (parOf x)) (hbk : q.back = [])
    (hcap : q.err = Err.cap 128 (uLT (ckP .two) q.ds)) (lw : ℕ → LW Cb.Gl.E)
    (Hk : AtK4 links ps k m pl) (hr : readsOpen links ps (start links) = true)
    (hopen : Item.wo m ∈ (openSets links ps (start links))[k + 1]?.getD [])
    (hlay : Dk.d1.lay = (parOf x).P.wsLay)
    (Kf : K4Front Mg z links ps m Xp.y.fo Xp.y.h.lmb 0 (LeftQ (parOf x).hp.ns))
    (Kp : K4Keeps Dk.N Mg z links ps k m pl pl' (twinOf q B') (parOf x))
    (name : ∀ b : S × Fr.E.Str, onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1) b →
      b.1.failed = none → b.1.out.indexMasks = Dk.N.indexNo ∧
        ∀ l c l', Johnson.Desc.First.Walk.Law.ledgerAt b.1 = some l →
          VerifiableInference.Desc.First.Pend.takeEntry l = some (c, l') →
          c = Rec.nextNoP Dk.d12.M (Dk.N.msgsAt ps[k + 1]?) Dk.N.indexNo Dk.fvs m) :
    (twinOf q B').Own (onQ Dk.N Mg links ps (fun s => (z, s)) k)
      (onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1)) (meansQ Dk.N Mg (fun s => (z, s)))
      (insQ links ps k) (outsQ links ps k) := by
  subst hnR hkC
  have Kf' : K4Front Mg z links ps m (parOf x).P.y.fo (parOf x).P.y.h.lmb 0
      (LeftQ (parOf x).hp.ns) := by
    rw [Lw.tiesM.worth.layout]
    exact Kf
  have core := k04_wo_first rfl rfl Em Lw hP hG hopen hlay name
  exact k4_own_endF (p := parOf x) Lw.xL (pubAt Xp (m / stepOf Xp)) (sentOf Dk) Dk.L3.rad
    (fun j => Dk.L3.seat Lw.xL.link false j.1) Lw.posI Dk.L3.oW Lw.enc Dk.L3.wOf Dk.arr Dk.ms
    Dk.N m Lw.nM Lw.nRr Lw.nC (Forest.elems Xp.layers.y.fo) (parOf x).hp.ns Lw.nx Lw.v7 Dk.G Dk.smp
    Dk.decT Mg z links ps k 0
    (LeftQ (parOf x).hp.ns) Lw.sz Lw.seat Dk.hd Dk.put Dk.H Dk.headPart Dk.digitsPart hscl St Lw.B
    hP hG hg0 Lw.hla (pubAt_y _ _) Fr.E B' (twinOf q B') hds (fun a => a.2) hbk hcap lw
    (Nat.zero_add _).symm (fun F hF => Nat.le_succ_of_le (Nat.le_of_eq hF.2.1))
    Lw.hV Lw.NE rfl (hearsAs_seatOf hB) (fun _ _ _ _ _ => rfl) Hk hr Kf' Kp Lw.fit
    (meanEqs_of_means Em Lw.tiesM z)
    (idnFit_of_means Em Lw.reqT (fun w r c => encAt_of_encIs Lw.encIs w.cells r c) z) Lw.rides
    (Lw.forms B' hB)
    (fun b w _ hb hu hm o ho =>
      Plan4KF.woRowF_of_woRow
        (qkFAt Dk (parOf x) m Lw.xL Lw.posI Lw.enc Lw.nM Lw.nRr Lw.nC Lw.nx Lw.v7)
        (parOf x) o _ (core b w hb hu hm o ho))

