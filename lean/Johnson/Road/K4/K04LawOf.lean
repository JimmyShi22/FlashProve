/-- The pinned readers of the reference value, at the data's letters. -/
abbrev pinAt (Dk : K4Data Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nR kC Xp)
    (xL : VerifiableInference.Desc.First.Look.Place) (posI : ℕ → Bool × ℕ × ℕ)
    (enc : CellsK hRef (2 ^ kRef) → Dk.L3.oW.Msg) : PinPlan (CellsK hRef (2 ^ kRef)) :=
  planAt xL (sentOf Dk) Dk.L3.rad (fun j => Dk.L3.seat xL.link false j.1)
    (cutW enc Dk.L3.wOf hRef (2 ^ kRef)) posI

/-- The reference value at a later group, at the data's letters. -/
noncomputable abbrev qkAt (Dk : K4Data Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nR kC Xp) (p : Par)
    (m : ℕ)
    (xL : VerifiableInference.Desc.First.Look.Place) (posI : ℕ → Bool × ℕ × ℕ)
    (enc : CellsK hRef (2 ^ kRef) → Dk.L3.oW.Msg) (nM nRr nC nx v7 : ℕ) (hg : p.g < 12) :=
  RefSeat.atRec (PinPlan.seatN (pinAt Dk xL posI enc) xL.ns Dk.N p.hp.tl
    (pubAt Xp (m / stepOf Xp)).y nM nRr nC (Forest.elems Xp.layers.y.fo) p.hp.ns nx v7) Xp p hg

/-- **What is left for the piece's own law at a later group**: the premises of `k4_own_end`
(K4PinsEnd.lean) that nothing here concludes, at the letters that `meanEqs_of_means` names. -/
structure K4LaterAt (x : Bool × Par) (links : List ModelPart)
    (ps : List VerifiableInference.Desc.Place) (k m : ℕ)
    (q : Piece (ckP .two) Fr (ProofFile.InstPub × S) ProofFile.Cl (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT))
    (Dk : K4Data Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nR kC Xp)
    (Mg : Meaning ProofFile.InstPub (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)) (hg : (parOf x).g < 12)
    (z : ProofFile.InstPub) where
  /-- LETTERS WITHOUT A TERM HERE: the lookup's place, the index's positions, the cells as the
  lookup's message, the sizes and seats of the symbols, five numbers. K4's and the lookups'. -/
  xL : VerifiableInference.Desc.First.Look.Place
  posI : ℕ → Bool × ℕ × ℕ
  enc : CellsK hRef (2 ^ kRef) → Dk.L3.oW.Msg
  sz : ℕ → Size
  seat : ∀ k, Fin (sz k).NM → ℕ → ℕ → ℕ × ℕ × ℕ
  nM : ℕ
  nRr : ℕ
  nC : ℕ
  nx : ℕ
  v7 : ℕ
  /-- A THEOREM IN THE GOALS' SCOPE (`refPub_in_scope`, Johnson/Road/K4/RefInScope.lean), not called
  in this file: the public lines of the reference value. -/
  B : RefPub Xp (parOf x).g
  /-- FIVE TIES ON THE DATA's LETTERS (two equations of letters; seven tests on public data; the
  lookup's message is the cells'; the hidden integers are the seats'). K4's, the lookups' and that
  of the files that fill the letters (Johnson/P5J/). -/
  tiesM : MeansTies Dk (parOf x) m xL sz seat enc
  /-- NINE CONDITIONS ON PUBLIC LETTERS. K4's. -/
  fit : K4PlanFit (X := Xp) (p := parOf x) xL (pubAt Xp (m / stepOf Xp)) (sentOf Dk) Dk.L3.rad
    (fun j => Dk.L3.seat xL.link false j.1) posI Dk.L3.oW enc Dk.L3.wOf Dk.arr Dk.ms Dk.N m nM nRr
    nC 0 sz seat Dk.hd
  /-- ON THE DATA's LETTERS: the samples' and the table's readers read only what an accepting run
  leaves, AT EVERY STATE. Left to the files that fill the letters (Johnson/P5J/). -/
  rides : RecRides (sentOf Dk).codes Dk.smp Dk.decT z
  /-- A TIE OF TWO READERS: the lookup's reading of the cells' message is the cells. The lookups':
  a payer is announced. -/
  encIs : cutW enc Dk.L3.wOf hRef (2 ^ kRef) = rcQ hRef (2 ^ kRef)
  /-- ON THE DATA's LETTER rw13: the pile's reader's matrix is made of the witness's cells.
  so by make, as reported; laid by no filling. -/
  rwMat : ∀ a w, (Dk.rw13 a w).mat = matOfCells nR kC w.cells
  /-- A TIE OF TWO READERS OF ONE WITNESS: the pile's mask entry at the name that the public data
  give is the value's message at its slot. -/
  mask : ∀ (b : S × Fr.E.Str) w, onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1) b →
    b.1.failed = none →
    (Dk.rw13 (z, b.1) w).mask
        ⟨Dk.N.indexNo, Rec.nextNoP Dk.d12.M (Dk.N.msgsAt ps[k + 1]?) Dk.N.indexNo Dk.fvs m⟩ =
      (qkAt Dk (parOf x) m xL posI enc nM nRr nC nx v7 hg).toL.plan.full.msg
        (partOf (sentOf Dk).codes Dk.arr Dk.ms Dk.N m w)
        (qkAt Dk (parOf x) m xL posI enc nM nRr nC nx v7 hg).toL.plan.full.c7
  /-- OF WEIGHT: THE LINE forms: behind an accepting run, inside the promise behind, the item on
  K4's own forms gives the reference value's sentence on them. K4's: a theorem ends in it under
  sixteen premises: not called. -/
  forms : ∀ B', SeatOf (ProofFile.k4Block x) B' → ∀ b w,
    ((qkAt Dk (parOf x) m xL posI enc nM nRr nC nx v7 hg).lettersOf (Fr := Fr)
      (partOf (sentOf Dk).codes Dk.arr Dk.ms Dk.N m) (parOf x) 0 (parOf x).P.y.fo
      (LeftQ (parOf x).hp.ns) (tableOn0 Dk.N Mg z links ps k)
      (keptFrom (tableOn0 Dk.N Mg z links ps k) (parOf x) (twinOf q B'))
      (tableCtx0 Dk.N Mg z m) (decOf (sentOf Dk).codes Dk.G Dk.smp Dk.ms Dk.decT Dk.N z m)).on' b →
    onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1) b → b.1.failed = none →
    meansQ (Fr := Fr) Dk.N Mg (fun s => (z, s)) (.formsT m 3 "own") b w →
    FormsT seatS ((qkAt Dk (parOf x) m xL posI enc nM nRr nC nx v7 hg).semOf
      (partOf (sentOf Dk).codes Dk.arr Dk.ms Dk.N m) (parOf x).hp.tl) (frontRun (parOf x))
      formsBack b.1 w

/-- The reference value at the first group, at the data's letters. -/
