/-- **The name that the segment's row bears**: `Rec.nextEntryIs` at a meaning that meets `K4Means`,
under `K4NameAt`. -/
theorem k04_name (Em : K4Means Mg Dk) (Nm : K4NameAt links ps k m Dk Mg) (z : ProofFile.InstPub) :
    ∀ b : S × Fr.E.Str, onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1) b →
      b.1.failed = none → b.1.out.indexMasks = Dk.N.indexNo ∧
        ∀ l c l', Johnson.Desc.First.Walk.Law.ledgerAt b.1 = some l →
          VerifiableInference.Desc.First.Pend.takeEntry l = some (c, l') →
          c = Rec.nextNoP Dk.d12.M (Dk.N.msgsAt ps[k + 1]?) Dk.N.indexNo Dk.fvs m :=
  Rec.nextEntryIs _ _ Fr Dk.N Mg z links ps (k + 1) m Dk.d12.M Dk.cs Dk.free0 Dk.fvs
    Em.indexIs Em.msgShapes (codes_of_means Em) Nm.within Em.room Nm.openNext Nm.nextFits

