/-- **What `SeatLaws` reads at one public part, out of the piece's own law**: the lines in front,
the riders and what an accepting run keeps by `k4Row_of_means`. -/
theorem k04_ownAt {told : List (List VerifiableInference.Desc.Oracle)} (Em : K4Means Mg Dk)
    (Lf : K4RowAt x links ps k m pl q Dk Mg told z) (hbase : Dk.N.treesAt (some pl) = q.base)
    (Hk : AtK4 links ps k m pl)
    (own : ∀ B', SeatOf (ProofFile.k4Block x) B' → ∀ pl',
      K4Front Mg z links ps m Xp.y.fo Xp.y.h.lmb 0 (LeftQ (parOf x).hp.ns) →
      K4Keeps Dk.N Mg z links ps k m pl pl' (twinOf q B') (parOf x) →
      (twinOf q B').Own (onQ Dk.N Mg links ps (fun s => (z, s)) k)
        (onQ Dk.N Mg links ps (fun s => (z, s)) (k + 1)) (meansQ Dk.N Mg (fun s => (z, s)))
        (insQ links ps k) (outsQ links ps k)) :
    K4OwnAt x links ps k m q Dk.N Mg z := by
  have row := fun (B' : Block S ProofFile.Cl) (hB : SeatOf (ProofFile.k4Block x) B') =>
    k4Row_of_means (q := twinOf q B') Em Lf.kept Lf.reads Hk Lf.plan hbase Lf.seats
      (Lf.door B' hB) Lf.doorP
  refine ⟨fun B' hB => ?_, fun B' hB => (row B' hB).2.1, fun B' hB a τ fo o G y hd' => ?_⟩
  · obtain ⟨Kf, _, pl', Kp⟩ := row B' hB
    exact own B' hB pl' Kf Kp
  · obtain ⟨_, _, pl', Kp⟩ := row B' hB
    exact Kp.dec a τ fo o G y hd'

end

/-- **THE ASSEMBLY.** In the goals' scope (hS, hR), at an opening O of the IOP as written
in Lean for the proof file, where the three rows T hold its sub-protocols (hT) and are the maker's
cut at `allOf D` (hD, hs, hc) at errors at the cap (hcap), and its sub-protocols are well shaped
(hok): for every meaning Mg that meets `K4Means Mg Dk`, under hnR, hkC, hE, `K4RowAt` and `K4NameAt`
at every group (L, Nm), `K4LaterAt` at the eleven later groups (LL) and `K4FirstAt` at the first
(LF): every piece of the first row at a number at which the written list names the kind K4 is tied
at the table. A JOINING: SHOWN TOGETHER AT NO FILLING; THE LIST FOR THE COUNT IS `k04_law_R`'s. -/
theorem k04_law_of {Pb : VerifierAndGoals.PublicFiles} {pp : Inst.Model.ScalesAndPolicy} {ly : ByteArray}
    {F : FileDescription ProofFile.Inst} {Z : ProofFile.Pub} {Bs : ProofFile.PureBase} {base : List (Block S ProofFile.Cl)}
    {c : VerifiableInference.Desc.Chain S ProofFile.Cl} {A : ProofFile.SharedSeat} {B : ProofFile.SecondSeat}
    (hS : VerifierAndGoals.InScope Pb = true) (hR : VerifierAndGoals.readFiles Pb = .ok pp)
    (O : IM.Open OnBytes.secondHashFunction Pb.pol ly Pb.KL F Z Bs base c A B)
    {D : WholeD} {X₁ X₂ : Type}
    {T : ThreeAt (ckP .two) D (allOf D) (descAt Z A B c) X₁ X₂
      (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)}
    (hT : OfDesc _ T) (file : String) (hD : (descAt Z A B c).data file = .ok D)
    (hs : (descAt Z A B c).sealLast = true) b₁ l₁ b₂ l₂ b₃ l₃ rest₁ rest₂ rest₃ (r : Fmt.RoundView)
    (hc : T.IsCut b₁ l₁ b₂ l₂ b₃ l₃ rest₁ rest₂ rest₃ r) (hcap : AtCap rest₁)
    (hok : VerifiableInference.Desc.blocksOk c.blocksInOrder = true)
    (Dk : K4Data Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nR kC Bs.G₀.W)
    (hnR : nR = hRef) (hkC : kC = kRef)
    (Mg : Meaning ProofFile.InstPub (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)) (Em : K4Means Mg Dk)
    (E : ℕ → (ProofFile.InstPub × S) × (frameAt D (allOf D) D.key₁ T.ft₁).E.Str →
      (ProofFile.InstPub × S) × (frameAt D (allOf D) D.key₁ T.ft₁).E.Str →
      Wit (CellsK hRef (2 ^ kRef)) Tok MsgT → Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)
    (hE : ∀ g, g < 12 → ∀ a b w, E (28 * g + 4) a b w = w) (lw : ℕ → LW Cb.Gl.E)
    (L : ∀ g, g < 12 → ∀ q, (T.p₁ :: T.l₁)[28 * g + 4]? = some q →
      ∀ x b, K4Here c Z Bs.G₀ g x b →
        ∀ z, Nonempty (K4RowAt x linksFull (flatPlacesOf linksFull true) (28 * g + 4) (2 * g)
          (k4PlaceAt g) q Dk Mg (c.blocksInOrder.map fun b => b.oracles.flatMap id) z))
    (Nm : ∀ g, g < 12 →
      K4NameAt linksFull (flatPlacesOf linksFull true) (28 * g + 4) (2 * g) Dk Mg)
    (LL : ∀ g, ∀ hg : g < 12, (g == 0) = false → ∀ q, (T.p₁ :: T.l₁)[28 * g + 4]? = some q →
      ∀ x b, ∀ h : K4Here c Z Bs.G₀ g x b,
        ∀ z, Nonempty (K4LaterAt (scl := sclX Bs.G₀.W g) x linksFull (flatPlacesOf linksFull true)
          (28 * g + 4) (2 * g) q Dk Mg (lt_of_eq_of_lt h.hg hg) z))
    (LF : ∀ q, (T.p₁ :: T.l₁)[28 * 0 + 4]? = some q →
      ∀ x b, K4Here c Z Bs.G₀ 0 x b →
        ∀ z, Nonempty (K4FirstAt (scl := sclX Bs.G₀.W 0) x linksFull
          (flatPlacesOf linksFull true) (28 * 0 + 4) (2 * 0) q Dk Mg z)) :
    KindTied Dk.N Mg linksFull (flatPlacesOf linksFull true) E (T.p₁ :: T.l₁) KindName.K4 := by
  obtain ⟨ht, hd, h0, hcp⟩ :=
    rows_of_cut _ file D hD hs T hT b₁ l₁ b₂ l₂ b₃ l₃ rest₁ rest₂ rest₃ r hc hcap
  refine k04_kindTied_own hS hR O hT Dk.N Mg E hE fun g hg q hq x b h =>
    ⟨(fits_piece (descAt Z A B c) file D hD T hT ht hd hq h.flat h.more).2.1, fun z => ?_⟩
  obtain ⟨Lf⟩ := L g hg q hq x b h z
  have hbase := k04_base_at_makers hS hR O hT file hD ht hd h0 Dk.N hok Lf.plan.book g hg hq
  have hcq := hcp q (List.mem_of_getElem? hq)
  refine k04_ownAt Em Lf hbase (atK4_full g hg) fun B' hB pl' Kf Kp => ?_
  by_cases h00 : g = 0
  · subst h00
    obtain ⟨Lw⟩ := LF q hq x b h z
    have hg0' : ((parOf x).g == 0) = true := by
      show (x.2.g == 0) = true
      rw [h.hg]
      rfl
    have hscl : (sclX Bs.G₀.W 0 : Scl) = sclX Bs.G₀.W (parOf x).g := by
      show sclX Bs.G₀.W 0 = sclX Bs.G₀.W x.2.g
      rw [h.hg]
    obtain ⟨_, hbk, hds⟩ :=
      k04_piece_first (descAt Z A B c) file D hD T hT ht hd hq h.flat h.more h.decl hg0'
    exact k04_own_first (scl := sclX Bs.G₀.W 0) hnR hkC Em Lw hscl (publicSteps_of O.public) h.P
      h.G hg0' hB hds hbk hcq lw (atK4_full 0 hg) Riders.reads_open_full (wo_open_full 0 hg)
      Lf.plan.lay Kf Kp (k04_name Em (Nm 0 hg) z)
  · have hg0 : (g == 0) = false := by simpa using h00
    obtain ⟨Lw⟩ := LL g hg hg0 q hq x b h z
    have hg0' : ((parOf x).g == 0) = false := by
      show (x.2.g == 0) = false
      rw [h.hg]
      exact hg0
    have hscl : (sclX Bs.G₀.W g : Scl) = sclX Bs.G₀.W (parOf x).g := by
      show sclX Bs.G₀.W g = sclX Bs.G₀.W x.2.g
      rw [h.hg]
    obtain ⟨_, hbk, hds⟩ :=
      k04_piece_later (descAt Z A B c) file D hD T hT ht hd hq h.flat h.more h.decl hg0'
    exact k04_own_later (scl := sclX Bs.G₀.W g) hnR hkC Em Lw hscl (publicSteps_of O.public) h.P
      h.G hg0' hB hds hbk hcq lw (atK4_full g hg) Riders.reads_open_full (wo_open_full g hg)
      Lf.plan.lay Kf Kp (k04_name Em (Nm g hg) z)

end OnBytes.Road.K4

