namespace OnBytes.Road.K4
open OnBytes
open OnBytes.Model.Verify (Public publicOf)
open VerifiableInference.PlanWritten (PublicSteps publicSteps_of)
open OnBytes.Desc.First.K4 (Par seatS blockAtC blockAtS)
open VerifiableInference.Desc (Block Link FileDescription)
open VerifiableInference.Desc.First (S hearsReply)
open VerifiableInference.Desc.Plain.K04 (HearsAs)

/-- The parameters at which K4's own block rides in the lot's block. -/
abbrev parOf (x : Bool × Par) : Par := { x.2 with k3Runs := true }

theorem parOf_P (x : Bool × Par) : (parOf x).P = x.2.P := rfl
theorem parOf_hp (x : Bool × Par) : (parOf x).hp = x.2.hp := rfl
theorem parOf_g (x : Bool × Par) : (parOf x).g = x.2.g := rfl

/-- K4's address at group g. -/
abbrev k4PlaceAt (g : ℕ) : VerifiableInference.Desc.Place :=
  { chain := 1, link := some (2 * g), piece := 3, kind := .K4 }

/-- **What `IM.k4_of` concludes**, typed after it conjunct by conjunct. -/
def K4Of (c : VerifiableInference.Desc.Chain S ProofFile.Cl) (Z : ProofFile.Pub) (G₀ : ProofFile.Ground)
    (X : Public) : Prop :=
  ∀ g < 12, ∃ (Lk : Link S ProofFile.Cl) (b : Block S ProofFile.Cl) (x : Bool × Par),
    c.links[2 * g]? = some Lk ∧ Lk.hear[2]? = some b ∧
    x ∈ ProofFile.k4From Z G₀ G₀.built.toList 0 none ∧
    IM.LaidAlone ProofFile.sameReply b (ProofFile.k4Block x) b.name (k4PlaceAt g) ∧
    x.2.link = 2 * g ∧ x.2.g = g ∧ x.2.P = X.layers ∧ X.G[g]? = some x.2.hp ∧
    x.2.P.tails = OnBytes.Model.Layer.tailsOf x.2.P.y ∧
    OnBytes.Model.Layer.plansG x.2.P = .ok X.G

/-- **K4's lot's block sits, alone, at K4's place of segment 2 g.** -/
structure K4SitsAt (c : VerifiableInference.Desc.Chain S ProofFile.Cl) (Z : ProofFile.Pub) (G₀ : ProofFile.Ground)
    (g : ℕ) (Lk : Link S ProofFile.Cl) (b : Block S ProofFile.Cl) (x : Bool × Par) : Prop where
  link : c.links[2 * g]? = some Lk
  hear : Lk.hear[2]? = some b
  mem : x ∈ ProofFile.k4From Z G₀ G₀.built.toList 0 none
  alone : IM.LaidAlone ProofFile.sameReply b (ProofFile.k4Block x) b.name (k4PlaceAt g)
  g : x.2.g = g

/-- `K4Of` gives `K4SitsAt` at every group. -/
theorem sitsAt_of_k4Of {c : VerifiableInference.Desc.Chain S ProofFile.Cl} {Z : ProofFile.Pub}
    {G₀ : ProofFile.Ground} {X : Public}
    (h : K4Of c Z G₀ X) (g : ℕ) (hg : g < 12) : ∃ Lk b x, K4SitsAt c Z G₀ g Lk b x := by
  obtain ⟨Lk, b, x, e1, e2, e3, e4, _, e6, _⟩ := h g hg
  exact ⟨Lk, b, x, e1, e2, e3, e4, e6⟩

/-- **The lot's block, alone, hears as K4's own block at the first chain's record.** -/
theorem hearsAs_alone {same : S → S → Bool} {b : Block S ProofFile.Cl} {x : Bool × Par} {n : String}
    {a : VerifiableInference.Desc.Place} (h : IM.LaidAlone same b (ProofFile.k4Block x) n a) :
    HearsAs seatS (parOf x) b := by
  unfold IM.LaidAlone at h
  subst h
  exact hearsAs_seatedLot same hearsReply x n a

/-- **The lot's block, alone, declares K4's rounds.** -/
theorem declares_alone {same : S → S → Bool} {b : Block S ProofFile.Cl} {x : Bool × Par} {n : String}
    {a : VerifiableInference.Desc.Place} (h : IM.LaidAlone same b (ProofFile.k4Block x) n a) :
    Declares b (parOf x) := by
  unfold IM.LaidAlone at h
  subst h
  exact declares_seatedLot same hearsReply x n a

/-- **The lot's block is K4's own block at the fold's type of a claim**, with the lot's Bool laid
into its test on the plan; and that block decides as K4's own block at the carried record, the
block of which `hearsAs_atS` speaks. -/
theorem k4Block_is (x : Bool × Par) :
    ProofFile.k4Block x =
        { blockAtC (parOf x) with planOk := (blockAtC (parOf x)).planOk && x.1 } ∧
      (blockAtC (parOf x)).decide = (blockAtS (parOf x)).decide :=
  ⟨rfl, rfl⟩

variable {c : VerifiableInference.Desc.Chain S ProofFile.Cl} {Z : ProofFile.Pub} {G₀ : ProofFile.Ground} {g : ℕ}
  {Lk : Link S ProofFile.Cl}
  {b : Block S ProofFile.Cl} {x : Bool × Par}

/-- **The place holds the ground's layers and the group's plan.** -/
theorem par_sits (H : K4SitsAt c Z G₀ g Lk b x) :
    (parOf x).P = { G₀.W.layers with tokv := G₀.W.layers.tokv } ∧
      G₀.W.G[(parOf x).g]? = some (parOf x).hp := by
  obtain ⟨e1, e2, _⟩ := ProofFile.k4From_par Z G₀ _ _ _ x H.mem
  exact ⟨e1, e2⟩

/-- **Toward the row K04_sits: twelve entries, the first group's among them**: under `K4Of`: the
block at K4's place of segment 2 g is the lot's block at a member x of the lot's list, alone under
the seat's wrappers, at the plan's numbers, and its yes gives the law's premise `HearsAs`. -/
theorem k04_sits {c : VerifiableInference.Desc.Chain S ProofFile.Cl} {Z : ProofFile.Pub} {G₀ : ProofFile.Ground}
    {X : Public}
    (h : K4Of c Z G₀ X) (g : ℕ) (hg : g < 12) :
    ∃ (Lk : Link S ProofFile.Cl) (b : Block S ProofFile.Cl) (x : Bool × Par),
      c.links[2 * g]? = some Lk ∧ Lk.hear[2]? = some b ∧
      x ∈ ProofFile.k4From Z G₀ G₀.built.toList 0 none ∧ x.2.link = 2 * g ∧
      b = Block.guarded ProofFile.sameReply hearsReply
        { { ProofFile.guardMark (ProofFile.k4Block x) with name := b.name } with place := k4PlaceAt g } ∧
      (parOf x).g = g ∧ (parOf x).P = X.layers ∧ X.G[g]? = some (parOf x).hp ∧
      HearsAs seatS (parOf x) b ∧ Declares b (parOf x) ∧
      (∀ s t rs gs, b.decide s rs gs = .ok t ↔
        (blockAtS (parOf x)).decide s rs gs = .ok t ∧ t.failed = none ∧
          ProofFile.sameReply s t = true) ∧
      ∀ ft s t k rs cols, b.step ft s rs cols = .ok (t, k) ↔
        (ProofFile.k4Block x).step ft s rs cols = .ok (t, k) ∧ t.failed = none ∧
          ProofFile.sameReply s t = true := by
  obtain ⟨Lk, b, x, e1, e2, e3, e4, e5, e6, e7, e8, _⟩ := h g hg
  exact ⟨Lk, b, x, e1, e2, e3, e5, e4, e6, e7, e8, hearsAs_alone e4, declares_alone e4,
    fun s t rs gs => IM.k4_yes e4 s t rs gs,
    fun ft s t k rs cols => IM.step_alone e4 (fun e => nomatch e) ft s t k rs cols⟩

/-- **The lot's list has one member at most at a segment's number.** -/
theorem k04_sits_one {Z : ProofFile.Pub} {G₀ : ProofFile.Ground} {g : ℕ} {x y : Bool × Par}
    (hx : x ∈ ProofFile.k4From Z G₀ G₀.built.toList 0 none)
    (hy : y ∈ ProofFile.k4From Z G₀ G₀.built.toList 0 none) (ex : x.2.link = 2 * g)
    (ey : y.2.link = 2 * g) : x = y :=
  ProofFile.k4From_link_inj Z G₀ G₀.built.toList 0 none x y hx hy (ex.trans ey.symm)

/-- The proof file's description as `onlineDescription` makes it of its letters, at the format's second
hash function. Its first chain's state and type of a claim are S and `ProofFile.Cl` by its make. -/
abbrev descAt (Z : ProofFile.Pub) (A : ProofFile.SharedSeat) (B : ProofFile.SecondSeat)
    (c : VerifiableInference.Desc.Chain S ProofFile.Cl) : FileDescription ProofFile.Inst :=
  ProofFile.fileDescBy OnBytes.secondHashFunction ProofFile.pureRoad.links Z A B (fun s => s) (ProofFile.startS Z) c

/-- **`K4Of` holds at an opening of the proof file's description, in the goals' scope**:
`IM.k4_of`, to the letter. -/
theorem k4Of_of_open {Pb : VerifierAndGoals.PublicFiles} {pp : Inst.Model.ScalesAndPolicy} {ly : ByteArray}
    {F : FileDescription ProofFile.Inst} {Z : ProofFile.Pub} {Bs : ProofFile.PureBase} {base : List (Block S ProofFile.Cl)}
    {c : VerifiableInference.Desc.Chain S ProofFile.Cl} {A : ProofFile.SharedSeat} {B : ProofFile.SecondSeat}
    (hS : VerifierAndGoals.InScope Pb = true) (hR : VerifierAndGoals.readFiles Pb = .ok pp)
    (O : IM.Open OnBytes.secondHashFunction Pb.pol ly Pb.KL F Z Bs base c A B) :
    K4Of c Z Bs.G₀ Bs.G₀.W :=
  IM.k4_of hS hR O

/-- **TOWARD THE ROW K04_sits, AT THE PROOF FILE's DESCRIPTION: TWELVE ENTRIES**: for public files
in the goals' scope that `VerifierAndGoals.readFiles` reads, where `onlineDescription` returns F at the format's
second hash function `OnBytes.secondHashFunction`: F is the value `descAt Z A B c`, each of its letters the
return of the maker's own step, made of a first chain c in which, at every g < 12, the block at
K4's place of segment 2 g is the lot's block alone under the seat's wrappers, at the numbers of
`publicOf`'s return X, and its yes gives the law's premise. -/
theorem k04_sits_desc {Pb : VerifierAndGoals.PublicFiles} {pp : Inst.Model.ScalesAndPolicy} {ly : ByteArray}
    {F : FileDescription ProofFile.Inst} (hS : VerifierAndGoals.InScope Pb = true) (hR : VerifierAndGoals.readFiles Pb = .ok pp)
    (hF : ProofFile.onlineDescription OnBytes.secondHashFunction Pb.pol ly Pb.KL = .ok F) :
    ∃ (X : Public) (Z : ProofFile.Pub) (G₀ : ProofFile.Ground) (c : VerifiableInference.Desc.Chain S ProofFile.Cl)
        (A : ProofFile.SharedSeat)
        (B : ProofFile.SecondSeat),
      ProofFile.pubPlain OnBytes.secondHashFunction Pb.pol ly Pb.KL = .ok Z ∧
      ProofFile.blankBy ProofFile.pureRoad.links Z = some G₀ ∧ ProofFile.onlineSharedChain Z = some A ∧
      ProofFile.onlineLastChain Z = some B ∧
      publicOf Pb.pol Pb.KL (some ly) = .ok X ∧ PublicSteps Pb.pol Pb.KL X ∧ G₀.W = X ∧
      F = descAt Z A B c ∧ (descAt Z A B c).first = c ∧
      ∀ g < 12, ∃ (Lk : Link S ProofFile.Cl) (b : Block S ProofFile.Cl) (x : Bool × Par),
        c.links[2 * g]? = some Lk ∧ Lk.hear[2]? = some b ∧
        x ∈ ProofFile.k4From Z G₀ G₀.built.toList 0 none ∧ x.2.link = 2 * g ∧
        (descAt Z A B c).first.blocksInOrder[28 * g + 4]? = some b ∧
        28 * g + 4 + 1 < (descAt Z A B c).first.blocksInOrder.length ∧
        b = Block.guarded ProofFile.sameReply hearsReply
          { { ProofFile.guardMark (ProofFile.k4Block x) with name := b.name } with place := k4PlaceAt g } ∧
        (parOf x).g = g ∧ (parOf x).P = X.layers ∧ X.G[g]? = some (parOf x).hp ∧
        HearsAs seatS (parOf x) b ∧ Declares b (parOf x) ∧
        (∀ s t rs gs, b.decide s rs gs = .ok t ↔
          (blockAtS (parOf x)).decide s rs gs = .ok t ∧ t.failed = none ∧
            ProofFile.sameReply s t = true) ∧
        ∀ ft s t k rs cols, b.step ft s rs cols = .ok (t, k) ↔
          (ProofFile.k4Block x).step ft s rs cols = .ok (t, k) ∧ t.failed = none ∧
            ProofFile.sameReply s t = true := by
  obtain ⟨Z, Bs, base, c, A, B, O⟩ := IM.seat_open hF
  have h : K4Of c Z Bs.G₀ Bs.G₀.W := IM.k4_of hS hR O
  refine ⟨Bs.G₀.W, Z, Bs.G₀, c, A, B, O.pub, O.blank, O.shared, O.second, O.public,
    publicSteps_of O.public, rfl, O.desc, rfl, fun g hg => ?_⟩
  obtain ⟨Lk, b, x, e1, e2, em, el, e3⟩ := k04_sits h g hg
  have hi : IM.flatIx c (2 * g) 2 = 28 * g + 4 := by
    rw [IM.flatIx_scope hS hR O (by omega) 2]
    omega
  have hf : c.blocksInOrder[28 * g + 4]? = some b := by
    rw [← hi]
    exact IM.hear_at_flat e1 e2
  obtain ⟨Lk', b8, _, _, f1, f2, _⟩ := IM.k8_of_layers hS hR O g hg
  have hi8 : IM.flatIx c (2 * g) 4 = 28 * g + 6 := by
    rw [IM.flatIx_scope hS hR O (by omega) 4]
    omega
  have hf8 : c.blocksInOrder[28 * g + 6]? = some b8 := by
    rw [← hi8]
    exact IM.hear_at_flat f1 f2
  have hl : 28 * g + 6 < c.blocksInOrder.length := (List.getElem?_eq_some_iff.1 hf8).1
  have hl1 : 28 * g + 4 + 1 < c.blocksInOrder.length := by omega
  exact ⟨Lk, b, x, e1, e2, em, el, hf, hl1, e3⟩

end OnBytes.Road.K4

