/-- At the base `mgBase` every name of the class has its sentence: the written table names it. -/
theorem classA_said {P W : Type} (q : VerifiableInference.Desc.First.Pub) (h : classA q = true)
    (x : P × S) : (mgBase : Meaning P W).pubP q x := by
  cases q with
  | more sg name => exact VerifiableInference.Desc.First.saysNone_of_leaves (sg, name) h
  | _ => exact absurd h (by simp [classA])

/-- **WHAT K4's SHARE OF THE BRIDGE SPENDS AT ONE BORDER j AND ONE STATE x**: the fifteen
facts there (`WideFacts`, each under the name of its field in `FoldFacts`), and, for each of four
names that have left the table, its test WHERE IT IS OPEN AT j in the wider meaning's door. -/
structure K4Spends {Xi P Tok : Type} {rows cols nR : ℕ} {X : Public}
    (𝔇 : MgData Xi P Tok rows cols nR X) (E : WideData P) (j : ℕ) (x : P × S) : Prop where
  /-- The fifteen: bookInOrder, seatsCarried, bookFits, msgShapes, weightsOk, pileMasks, pileWithin,
  oneRow, tidy, codes, shape, layout, liveShape, liveLayout, reqIs. -/
  wide : WideFacts 𝔇 E x
  room : ∀ m, Pub.more (some m) "pile.room" ∈
      (pubSets (moreW 𝔇 mgBase) linksFull (flatPlacesOf linksFull true))[j]?.getD [] →
    Johnson.Desc.First.Walk.Tied.roomIsB E.dP.free0 E.dP.fvs m x.2 = true
  lay7 : ∀ m, Pub.more (some m) "K8.lay7" ∈
      (pubSets (moreW 𝔇 mgBase) linksFull (flatPlacesOf linksFull true))[j]?.getD [] →
    ((E.dP.tl m).any fun tlP => VerifiableInference.Desc.First.K8.Ready.lay7B tlP x.2) = true
  onThird : ∀ m, Pub.more (some m) "K8.onThird" ∈
      (pubSets (moreW 𝔇 mgBase) linksFull (flatPlacesOf linksFull true))[j]?.getD [] →
    VerifiableInference.Desc.First.K8.Ready.onThirdB x.2 = true
  funsThird : ∀ m, Pub.more (some m) "K8.funsThird" ∈
      (pubSets (moreW 𝔇 mgBase) linksFull (flatPlacesOf linksFull true))[j]?.getD [] →
    VerifiableInference.Desc.First.K8.Ready.funsThirdB x.2 = true

/-- **K4's SHARE IN THE SECOND FORM, UNDER THE TIGHT LIST.** Its binders:
`k04_law_of`'s, at the wider meaning, but the test openNext (concluded); and Sp: what the bridge
spends at K4's own twenty-four borders. LETTERS: 𝔇, Ew, Dk, E, T. IT PAYS NOTHING; NO MEMBER OF
ITS BINDERS IS SHOWN ANYWHERE. -/
theorem k04_law_R {Pb : VerifierAndGoals.PublicFiles} {pp : Inst.Model.ScalesAndPolicy} {ly : ByteArray}
    {F : FileDescription ProofFile.Inst} {Z : ProofFile.Pub} {Bs : ProofFile.PureBase} {base : List (Block S ProofFile.Cl)}
    {c : VerifiableInference.Desc.Chain S ProofFile.Cl} {A : ProofFile.SharedSeat} {B : ProofFile.SecondSeat}
    (hS : VerifierAndGoals.InScope Pb = true) (hR : VerifierAndGoals.readFiles Pb = .ok pp)
    (O : IM.Open OnBytes.secondHashFunction Pb.pol ly Pb.KL F Z Bs base c A B)
    {D : WholeD} {X₁ X₂ : Type}
    {T : ThreeAt (ckP .two) D (allOf D) (descAt Z A B c) X₁ X₂
      (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)}
    (hT : OfDesc _ T) (file : String) (hD : (descAt Z A B c).data file = .ok D)
    (hs : (descAt Z A B c).sealLast = true) b₁ l₁ b₂ l₂ b₃ l₃ rest₁ rest₂ rest₃ (r : Fmt.RoundView)
    (hc : T.IsCut b₁ l₁ b₂ l₂ b₃ l₃ rest₁ rest₂ rest₃ r) (hcap : AtCap rest₁)
    (hok : VerifiableInference.Desc.blocksOk c.blocksInOrder = true)
    (Dk : K4Data Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nR kC Bs.G₀.W)
    (hnR : nR = hRef) (hkC : kC = kRef)
    {nQ : ℕ} (𝔇 : MgData Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nQ Bs.G₀.W)
    (Ew : WideData ProofFile.InstPub)
    (Em : K4Means (mgWide 𝔇 Ew mgBase) Dk)
    (E : ℕ → (ProofFile.InstPub × S) × (frameAt D (allOf D) D.key₁ T.ft₁).E.Str →
      (ProofFile.InstPub × S) × (frameAt D (allOf D) D.key₁ T.ft₁).E.Str →
      Wit (CellsK hRef (2 ^ kRef)) Tok MsgT → Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)
    (hE : ∀ g, g < 12 → ∀ a b w, E (28 * g + 4) a b w = w) (lw : ℕ → LW Cb.Gl.E)
    (L : ∀ g, g < 12 → ∀ q, (T.p₁ :: T.l₁)[28 * g + 4]? = some q →
      ∀ x b, K4Here c Z Bs.G₀ g x b →
        ∀ z, Nonempty (K4RowAt x linksFull (flatPlacesOf linksFull true) (28 * g + 4) (2 * g)
          (k4PlaceAt g) q Dk (mgWide 𝔇 Ew mgBase) (c.blocksInOrder.map fun b => b.oracles.flatMap id) z))
    (hWi : Rec.EWithin (mgWide 𝔇 Ew mgBase))
    (hNf : ∀ g, g < 12 →
      Rec.nextFitsB Dk.cs Dk.d12.M (Dk.N.msgsAt (flatPlacesOf linksFull true)[28 * g + 4 + 1]?)
        Dk.N.indexNo Dk.free0 Dk.fvs (2 * g) = true)
    (LL : ∀ g, ∀ hg : g < 12, (g == 0) = false → ∀ q, (T.p₁ :: T.l₁)[28 * g + 4]? = some q →
      ∀ x b, ∀ h : K4Here c Z Bs.G₀ g x b,
        ∀ z, Nonempty (K4LaterAt (scl := sclX Bs.G₀.W g) x linksFull (flatPlacesOf linksFull true)
          (28 * g + 4) (2 * g) q Dk (mgWide 𝔇 Ew mgBase) (lt_of_eq_of_lt h.hg hg) z))
    (LF : ∀ q, (T.p₁ :: T.l₁)[28 * 0 + 4]? = some q →
      ∀ x b, K4Here c Z Bs.G₀ 0 x b →
        ∀ z, Nonempty (K4FirstAt (scl := sclX Bs.G₀.W 0) x linksFull
          (flatPlacesOf linksFull true) (28 * 0 + 4) (2 * 0) q Dk (mgWide 𝔇 Ew mgBase) z))
    (Pp : ProofFile.InstPub → Prop)
    (Sp : ∀ g, g < 12 → ∀ j, j = 28 * g + 4 ∨ j = 28 * g + 4 + 1 →
      ∀ a : (ProofFile.InstPub × S) × (frameAt D (allOf D) D.key₁ T.ft₁).E.Str,
        RchPub (descAt Z A B c) Pp j a → a.1.2.failed = none → K4Spends 𝔇 Ew j a.1) :
    KindTiedR Dk.N (mgAll 𝔇 mgBase) linksFull (flatPlacesOf linksFull true)
      (RchPub (descAt Z A B c) Pp) E (T.p₁ :: T.l₁) KindName.K4 :=
  k04_kindTiedR_mgAll 𝔇 Ew mgBase Dk.N (RchPub (descAt Z A B c) Pp) E (T.p₁ :: T.l₁)
    (k04_law_of hS hR O hT file hD hs b₁ l₁ b₂ l₂ b₃ l₃ rest₁ rest₂ rest₃ r hc hcap hok Dk hnR hkC
      (mgWide 𝔇 Ew mgBase) Em E hE lw L
      (fun g hg => ⟨hWi, Rec.openNext_mgWide 𝔇 Ew (atK4_full g hg), hNf g hg⟩) LL LF)
    (fun g hg => Rec.doorsFit_mgWide 𝔇 (atK4_full g hg))
    (fun g hg =>
      ⟨fun a hr => factsAt_at 𝔇 Ew mgBase linksFull (flatPlacesOf linksFull true) (fun a => a)
          (28 * g + 4) a (fun hm => (Sp g hg _ (.inl rfl) a hr hm).wide)
          (fun m hm => (Sp g hg _ (.inl rfl) a hr hm).room m)
          (fun m hm => ⟨(Sp g hg _ (.inl rfl) a hr hm).lay7 m,
            (Sp g hg _ (.inl rfl) a hr hm).onThird m,
            (Sp g hg _ (.inl rfl) a hr hm).funsThird m⟩)
          (fun q hq => classA_said q hq _),
        fun b hr => factsAt_at 𝔇 Ew mgBase linksFull (flatPlacesOf linksFull true) (fun a => a)
          (28 * g + 4 + 1) b (fun hm => (Sp g hg _ (.inr rfl) b hr hm).wide)
          (fun m hm => (Sp g hg _ (.inr rfl) b hr hm).room m)
          (fun m hm => ⟨(Sp g hg _ (.inr rfl) b hr hm).lay7 m,
            (Sp g hg _ (.inr rfl) b hr hm).onThird m,
            (Sp g hg _ (.inr rfl) b hr hm).funsThird m⟩)
          (fun q hq => classA_said q hq _)⟩)
    (fun _ _ _ hq => handsOn_pub hT Pp hq _)

/-- **THE COROLLARY, UNDER `FoldFacts`,
`FoldTies`, `RoomOpen` AND `K8Open`**, all four at every border: they give what the bridge spends at
K4's own twenty-four. For a join that calls every kind's law under the same four. -/
theorem k04_law_R_fold {Pb : VerifierAndGoals.PublicFiles} {pp : Inst.Model.ScalesAndPolicy} {ly : ByteArray}
    {F : FileDescription ProofFile.Inst} {Z : ProofFile.Pub} {Bs : ProofFile.PureBase} {base : List (Block S ProofFile.Cl)}
    {c : VerifiableInference.Desc.Chain S ProofFile.Cl} {A : ProofFile.SharedSeat} {B : ProofFile.SecondSeat}
    (hS : VerifierAndGoals.InScope Pb = true) (hR : VerifierAndGoals.readFiles Pb = .ok pp)
    (O : IM.Open OnBytes.secondHashFunction Pb.pol ly Pb.KL F Z Bs base c A B)
    {D : WholeD} {X₁ X₂ : Type}
    {T : ThreeAt (ckP .two) D (allOf D) (descAt Z A B c) X₁ X₂
      (Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)}
    (hT : OfDesc _ T) (file : String) (hD : (descAt Z A B c).data file = .ok D)
    (hs : (descAt Z A B c).sealLast = true) b₁ l₁ b₂ l₂ b₃ l₃ rest₁ rest₂ rest₃ (r : Fmt.RoundView)
    (hc : T.IsCut b₁ l₁ b₂ l₂ b₃ l₃ rest₁ rest₂ rest₃ r) (hcap : AtCap rest₁)
    (hok : VerifiableInference.Desc.blocksOk c.blocksInOrder = true)
    (Dk : K4Data Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nR kC Bs.G₀.W)
    (hnR : nR = hRef) (hkC : kC = kRef)
    {nQ : ℕ} (𝔇 : MgData Xi ProofFile.InstPub Tok hRef (2 ^ kRef) nQ Bs.G₀.W)
    (Ew : WideData ProofFile.InstPub)
    (Em : K4Means (mgWide 𝔇 Ew mgBase) Dk)
    (E : ℕ → (ProofFile.InstPub × S) × (frameAt D (allOf D) D.key₁ T.ft₁).E.Str →
      (ProofFile.InstPub × S) × (frameAt D (allOf D) D.key₁ T.ft₁).E.Str →
      Wit (CellsK hRef (2 ^ kRef)) Tok MsgT → Wit (CellsK hRef (2 ^ kRef)) Tok MsgT)
    (hE : ∀ g, g < 12 → ∀ a b w, E (28 * g + 4) a b w = w) (lw : ℕ → LW Cb.Gl.E)
    (L : ∀ g, g < 12 → ∀ q, (T.p₁ :: T.l₁)[28 * g + 4]? = some q →
      ∀ x b, K4Here c Z Bs.G₀ g x b →
        ∀ z, Nonempty (K4RowAt x linksFull (flatPlacesOf linksFull true) (28 * g + 4) (2 * g)
          (k4PlaceAt g) q Dk (mgWide 𝔇 Ew mgBase) (c.blocksInOrder.map fun b => b.oracles.flatMap id) z))
    (hWi : Rec.EWithin (mgWide 𝔇 Ew mgBase))
    (hNf : ∀ g, g < 12 →
      Rec.nextFitsB Dk.cs Dk.d12.M (Dk.N.msgsAt (flatPlacesOf linksFull true)[28 * g + 4 + 1]?)
        Dk.N.indexNo Dk.free0 Dk.fvs (2 * g) = true)
    (LL : ∀ g, ∀ hg : g < 12, (g == 0) = false → ∀ q, (T.p₁ :: T.l₁)[28 * g + 4]? = some q →
      ∀ x b, ∀ h : K4Here c Z Bs.G₀ g x b,
        ∀ z, Nonempty (K4LaterAt (scl := sclX Bs.G₀.W g) x linksFull (flatPlacesOf linksFull true)
          (28 * g + 4) (2 * g) q Dk (mgWide 𝔇 Ew mgBase) (lt_of_eq_of_lt h.hg hg) z))
    (LF : ∀ q, (T.p₁ :: T.l₁)[28 * 0 + 4]? = some q →
      ∀ x b, K4Here c Z Bs.G₀ 0 x b →
        ∀ z, Nonempty (K4FirstAt (scl := sclX Bs.G₀.W 0) x linksFull
          (flatPlacesOf linksFull true) (28 * 0 + 4) (2 * 0) q Dk (mgWide 𝔇 Ew mgBase) z))
    (Pp : ProofFile.InstPub → Prop) (d : FoldData) (reqW : ProofFile.InstPub → Array UInt32)
    (Ff : FoldFacts (RchPub (descAt Z A B c) Pp)
      (fun a : (ProofFile.InstPub × S) × (frameAt D (allOf D) D.key₁ T.ft₁).E.Str => a.1) d reqW linksFull
      (flatPlacesOf linksFull true))
    (Tf : FoldTies 𝔇 Ew d reqW)
    (hRo : RoomOpen (Fr := frameAt D (allOf D) D.key₁ T.ft₁) 𝔇 Ew mgBase linksFull
      (flatPlacesOf linksFull true) (fun a => a) (RchPub (descAt Z A B c) Pp))
    (hK8 : K8Open (Fr := frameAt D (allOf D) D.key₁ T.ft₁) 𝔇 Ew mgBase linksFull
      (flatPlacesOf linksFull true) (fun a => a) (RchPub (descAt Z A B c) Pp)) :
    KindTiedR Dk.N (mgAll 𝔇 mgBase) linksFull (flatPlacesOf linksFull true)
      (RchPub (descAt Z A B c) Pp) E (T.p₁ :: T.l₁) KindName.K4 :=
  k04_law_R hS hR O hT file hD hs b₁ l₁ b₂ l₂ b₃ l₃ rest₁ rest₂ rest₃ r hc hcap hok Dk hnR hkC 𝔇 Ew
    Em E hE lw L hWi hNf LL LF Pp
    (fun _ _ j _ a hr hm =>
      ⟨wideFacts_of_fold 𝔇 Ew linksFull (flatPlacesOf linksFull true) (fun a => a)
          (RchPub (descAt Z A B c) Pp) d reqW Ff Tf j a hr hm,
        fun m => hRo j a m hr hm,
        fun m => (hK8 j a m hr hm).1, fun m => (hK8 j a m hr hm).2.1,
        fun m => (hK8 j a m hr hm).2.2⟩)

end OnBytes.Road.K4

