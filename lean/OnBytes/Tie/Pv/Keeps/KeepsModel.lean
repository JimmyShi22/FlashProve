/- In place of one #print axioms line for each: the number of the instances that the lines above
have made, and the axioms of all of them together. -/
open Lean Elab Command in
run_cmd liftCoreM do
  let env ← getEnv
  let mut n : Nat := 0
  let mut ax : NameSet := {}
  for (c, _) in env.constants.toList do
    if c.isInternal then continue
    if c.toString.startsWith "OnBytes.L5.walked_" then
      n := n + 1
      for a in ← collectAxioms c do ax := ax.insert a
  logInfo m!"{n} instances walked_*; the axioms of all of them together: {ax.toList}"

end OnBytes.L5
