/-
OnBytes/Tie/Pv/Plan/PlanSizes.lean: where the sub-proofs' hand-written sumchecks stand in the plan,
and their sizes, as written lists.

A request's first chain has one link for each sub-proof: a group of layers, its attention, the
output head. Behind its lookup a sub-proof runs sumchecks that are written by hand: seven in a group
of layers, eight in attention, five in the head. For each of these twenty kinds this file lists
every place at which the kind occurs in the plans of two example configurations
(prover/examples/target_small_f2 and prover/examples/target_full_f2), with the numbers that the
plan's entries give it.

The lists were written by a program from a print of the planner's rounds. The tests in
OnBytes/Tie/Pv/Plan/TestPlanSizesSmall.lean and
TestPlanSizesFull.lean compute them anew from the two examples' public files,
by the verifier's own reader and planner, and compare.

Main definitions: PscAt, PscShape, PscAt.shape, atL1 to atL7, atA1 to atA8, atH1 to atH5, allAt,
CloseAt, closeAt, closeRows.
What is not claimed: no theorem is stated here. This file imports nothing.

-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace OnBytes.Tie.Pv.Plan

/-- The numbers of a sumcheck that decide its rounds. -/
structure PscShape where
  /-- the scalars that the message before the first challenge holds beside the hiding sum -/
  riders : Nat
  /-- for each variable, in the order of the rounds: the scalars that its round sends. The plan's
  bound on the round's error is this number over the size of the extension field -/
  sent : List Nat
  /-- the scalars of the round in the further variable -/
  inY : Nat
  /-- the end values -/
  values : Nat
  /-- a round that draws the point of a line follows the end values -/
  line : Bool
  deriving DecidableEq, Repr, Inhabited

/-- A sumcheck at its place in a plan. -/
structure PscAt extends PscShape where
  /-- the full-size example; false: the small one -/
  full : Bool
  /-- the number of the link in the chain -/
  link : Nat
  /-- the group of layers; 0 for the head -/
  group : Nat
  /-- the moment of the link behind which the sumcheck stands -/
  moment : Nat
  /-- the place of the sumcheck's first round in the list of the sub-proof's rounds behind that
  moment, counted from 0, the lookup's rounds counted -/
  place : Nat
  /-- the place of that round in the plan of the proof's first chain, counted from 0 -/
  chain : Nat
  /-- the slot of the first scalar of the sumcheck's first message: how many scalars the sub-proof
  has sent before it -/
  slot : Nat
  deriving DecidableEq, Repr, Inhabited

/-- The slot of the hiding sum. -/
def PscAt.slotSum (x : PscAt) : Nat := x.slot + x.riders

/-- The slot of the first end value. -/
def PscAt.slotEnd (x : PscAt) : Nat := x.slotSum + 1 + x.sent.foldl (· + ·) 0 + x.inY

/-- The number of the sumcheck's rounds, the line's counted. -/
def PscShape.rounds (x : PscShape) : Nat :=
  1 + x.sent.length + (if x.values == 0 then 0 else 2) + (if x.line then 1 else 0)

