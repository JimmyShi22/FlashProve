/-- The closing draw of a sub-proof at its place in a plan: the last round of the link's sub-proof,
which batches all its claims and the equations of its smallness test. The plan's bound on its error
is the number of rows less 1, over the size of the extension field. -/
structure CloseAt where
  /-- the full-size example; false: the small one -/
  full : Bool
  /-- the number of the link in the chain -/
  link : Nat
  /-- the round's place in the list of the sub-proof's rounds behind moment 2 -/
  place : Nat
  /-- its place in the plan of the proof's first chain -/
  chain : Nat
  /-- the rows that it batches -/
  rows : Nat
  deriving DecidableEq, Repr, Inhabited

