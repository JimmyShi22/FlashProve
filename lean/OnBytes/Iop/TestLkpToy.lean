/-- The intermediate values that the C++ verifier prints for the key's second lookup. -/
def secondNotes : List (String × E) := [
  ("LKP: alpha",
    E.mk3 17829945369363857801 5294296646472618192 9969613718143367796),
  ("LKP: the public factor a",
    E.mk3 9565790618100006083 9604212762671831650 5590547602665343912),
  ("LKP: the table side's first claim",
    E.mk3 14283413183212376401 7742721070887703127 566291872332479639),
  ("LKP: the leaves' factor",
    E.mk3 7510481500328323044 14021337812739056613 8572972918095508814),
  ("LKP: a part's key claim",
    E.mk3 13201498986626221442 16734772070537643948 2133312211155112993)]

/-- The element that a line holds after its first letter; none unless there are exactly three
numbers. -/
def element (line : String) : Option E :=
  match ((line.splitOn " ").drop 1).filterMap (·.toNat?) with
  | [a, b, c] => some (E.mk3 (UInt64.ofNat a) (UInt64.ofNat b) (UInt64.ofNat c))
  | _ => none

/-- The rounds of a text, each with its name. The lines are taken from the last to the first. A
line that holds no element is skipped; sameShape would then fail. -/
def parse (text : String) : List (String × Fmt.RoundView) :=
  ((text.splitOn "\n").foldr (fun line (acc : List (String × Fmt.RoundView) × List E × List E) =>
    if line.startsWith "R " then
      ((" ".intercalate ((line.splitOn " ").drop 1),
        ⟨acc.2.1.map fun x => Fmt.ItemValue.e x.triple, ⟨acc.2.2.map E.triple, [], [], none⟩⟩) ::
          acc.1, [], [])
    else
      match element line with
      | some x =>
        if line.startsWith "S " then (acc.1, x :: acc.2.1, acc.2.2)
        else (acc.1, acc.2.1, x :: acc.2.2)
      | none => acc) ([], [], [])).1

/-- The rounds have the names and the numbers of elements of Lkp.roundsOf. -/
def sameShape (S : Public) (text : String) : Bool :=
  (parse text).map (fun r => (r.1, 24 * r.2.vals.length, r.2.drawn.elems.length)) ==
    (roundsOf 0 S).map fun r => (r.entry.name, r.entry.msg, r.entry.drawE)

/-- The block on the made-up statement. -/
def block (S : Public) : Blk Out := verify S (fun row v => row.add 0 .main v) 0 0 (some 1)

/-- Where a run of the block starts. -/
def start (S : Public) : Start :=
  { entries := (roundsOf 0 S).map (·.entry), st := TestLkp.statement S }

/-- The values that the block notes on some rounds. Empty if the block fails. -/
def notesOn (S : Public) (rounds : List Fmt.RoundView) : List (String × E) :=
  ((block S).notesOn (start S) ⟨rounds, []⟩).toList

/-- The values that the block notes on the rounds of a text. -/
def notesOf (S : Public) (text : String) : List (String × E) := notesOn S ((parse text).map (·.2))

/-- The rounds of a text with 1 added to the first element sent in every round of one of the given
names. -/
def altered (names : List String) (text : String) : List Fmt.RoundView :=
  (parse text).map fun r =>
    match names.contains r.1, r.2.vals with
    | true, .e x :: rest => { r.2 with vals := .e (addE (E.ofTriple x) oneE).triple :: rest }
    | _, _ => r.2

#guard firstPublic.ok && secondPublic.ok
#guard sameShape firstPublic firstRounds
#guard sameShape secondPublic secondRounds
#guard notesOf firstPublic firstRounds == firstNotes
#guard notesOf secondPublic secondRounds == secondNotes
-- the runs use up all rounds and entries, and no test in them fails
#guard ((block firstPublic).failureOn (start firstPublic)
  ⟨(parse firstRounds).map (·.2), []⟩).isNone
#guard ((block secondPublic).failureOn (start secondPublic)
  ⟨(parse secondRounds).map (·.2), []⟩).isNone
-- what the head says is not tested: the compared values stay the same if the sum of every hiding
-- polynomial and a coefficient of every round's polynomial are changed
#guard notesOn firstPublic (altered ["PSC epsilon", "PSC round", "PSC Y"] firstRounds) == firstNotes
#guard notesOn secondPublic (altered ["PSC epsilon", "PSC round", "PSC Y"] secondRounds) ==
  secondNotes
-- and they do not stay the same if the shown values are changed
#guard notesOn firstPublic (altered ["PSC values"] firstRounds) != firstNotes
-- the order of the two variables that lastKeyLevelOrder names does not show; their number does
#guard firstPublic.lastKeyLevelOrder == [1, 0]
#guard notesOn { firstPublic with lastKeyLevelOrder := [0, 1] } ((parse firstRounds).map (·.2)) ==
  firstNotes
#guard notesOn { firstPublic with lastKeyLevelOrder := [] } ((parse firstRounds).map (·.2)) !=
  firstNotes

/-- The rounds of a text with 1 added to the first shown value of every sumcheck, counted from 0,
whose number is not in keep. -/
def alteredShown (keep : List Nat) (text : String) : List Fmt.RoundView :=
  ((parse text).foldl (fun (acc : List Fmt.RoundView × Nat) r =>
    if r.1 != "PSC values" then (r.2 :: acc.1, acc.2)
    else
      match keep.contains acc.2, r.2.vals with
      | false, .e x :: rest =>
        ({ r.2 with vals := .e (addE (E.ofTriple x) oneE).triple :: rest } :: acc.1, acc.2 + 1)
      | _, _ => (r.2 :: acc.1, acc.2 + 1)) ([], 0)).1.reverse

