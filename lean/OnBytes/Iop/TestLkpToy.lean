bits. -/
def entering (S : Public) : List Nat :=
  let before := (S.planes - 1) + (S.parts.length - 1)
  List.range (S.planes - 1) ++
    (List.range S.parts.length).map fun i => before + ((S.parts.take (i + 1)).foldl (· + ·) 0) - 1

-- the shown values of all other sumchecks changed (the parts' roots, every key level before the
-- last, the table's tree, the bits): the compared values stay the same
#guard notesOn firstPublic (alteredShown (entering firstPublic) firstRounds) == firstNotes
#guard notesOn secondPublic (alteredShown (entering secondPublic) secondRounds) == secondNotes
-- and that is a change to most of them: 64 and 26 sumchecks show values, 17 and 11 of them enter
#guard ((parse firstRounds).filter (·.1 == "PSC values")).length == 64 &&
  (entering firstPublic).length == 17
#guard ((parse secondRounds).filter (·.1 == "PSC values")).length == 26 &&
  (entering secondPublic).length == 11
-- so that the two comparisons above do not hold between empty lists
#guard firstNotes.length == 8 && secondNotes.length == 5

end OnBytes.TestLkpToy
