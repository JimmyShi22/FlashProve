/-
OnBytes/Field/TestMle.lean: tests of OnBytes/Field/Mle.lean.

The expected values were computed outside Lean with arbitrary-precision integers, each from the
plain sum or product that defines it, not by folding. The program does not import this file.
-/
import OnBytes.Field.Mle

namespace OnBytes.FieldTest

/-- A point with four coordinates. -/
def z4 : List E := List.map E.ofTriple [
  (7463747201985028409, 2597715575674216276, 2935573227337232147),
  (6672154074160968870, 5880989965393796221, 13033111943786956360),
  (5804721827186922487, 9355718521252564154, 5225262324764394497),
  (6436115159631328380, 6055106669938736923, 5217820749700054542)]

/-- Another point with four coordinates. -/
def y4 : List E := List.map E.ofTriple [
  (5616047901170981829, 8293734926989188592, 5107328233381598335),
  (13248207541713738914, 1456266121540036553, 6115214026385880740),
  (6231667049743431715, 13102723760186604662, 6876010583607782413),
  (13785102888577872536, 12540268792070196743, 14033438636275282314)]

/-- A vector of eleven elements of E. -/
def vE : List E := List.map E.ofTriple [
  (11087538346198281361, 18034473346922825164, 17792407487519357483),
  (5448600941327175646, 6982437021770624341, 619646148381516864),
  (1051530567511810191, 12735706394310912882, 3981233653984735833),
  (15012000433298375156, 16196320527752914227, 2967243764967446598),
  (14671645920725761949, 8196187172897182440, 12310035624710974487),
  (13759594571073497690, 16101904676611168545, 1180114229831944988),
  (15037529639305582907, 14772765556268905902, 15860183122190975717),
  (11309682776122351248, 6428330314167324831, 14578384413093514818),
  (7138397922768683241, 8042244539749351748, 10133948682310989379),
  (7316522613715388438, 627040600671852333, 361793115218700088),
  (1186245561831845415, 7790190191312877354, 15902649024983501233)]

/-- A vector of thirteen elements of the base field. -/
def vF : List F := [
  6528110351792571500, 7057998389887982667, 9239690920699424638, 4012558910616968309,
  14703294978931461344, 6950466280229528751, 17622571629022020882, 6215885043298095993,
  4903654644428190868, 5475059573772004179, 2296471409186327526, 18171700437677109949,
  4600204532801597320]

/-- Four factors. -/
def f4 : List F := [
  14586579415275738167, 10995207574060161018, 12270767228577644097, 9932650939414376892]

#guard (eqIndex z4 0).triple == (7447744014788699033, 11575417008176989707, 9031601415882184662)
#guard (eqIndex z4 11).triple == (5141813168215559912, 2717913590422778717, 14180801602813211103)
#guard (List.range 16).all fun j => (eqTable z4)[j]? == some (eqIndex z4 j)
#guard (eqTable z4).size == 16
#guard (eqEval z4 y4).triple == (17971122847603667285, 14893032997850266102, 573002012712491083)
#guard (mleEvalE vE z4).triple == (13021751655364406388, 1129972101074080681, 12140629564535729679)
#guard (mleEvalF vF z4).triple == (11663439697041269322, 12684682571574151881, 2945423531308326136)
#guard (polyEval vE (z4.headD zeroE)).triple ==
  (5351701075206795667, 15796718050634746084, 12935073716340607845)
#guard productIndex f4 13 == 13688884049653182136
#guard (List.range 13).all fun j => (productTable f4 13)[j]? == some (productIndex f4 j)
#guard (productTable f4 13).size == 13
#guard (productMle f4 z4).triple == (5972856961772026115, 1422958233557163036, 11264317478440921015)
#guard productDotF vF f4 == 6545980400953925488
#guard (productDotE vE f4).triple ==
  (13274978948969266750, 9368477568280731479, 15418328515484991679)
#guard squaresOf 3 5 == [5, 25, 625]
#guard mleEvalE [] z4 == zeroE && mleEvalF [] z4 == zeroE && mleEvalF [7] [] == ofF 7
#guard foldPairE (E.mk3 1 2 3) (E.mk3 4 5 6) zeroE == E.mk3 1 2 3 &&
  foldPairE (E.mk3 1 2 3) (E.mk3 4 5 6) oneE == E.mk3 4 5 6
#guard foldPairF 8 9 zeroE == ofF 8 && foldPairF 8 9 oneE == ofF 9
-- entries beyond 2^k are ignored, and a table has at most 2^k entries
#guard mleEvalE vE (z4.take 2) == mleEvalE (vE.take 4) (z4.take 2)
#guard mleEvalF vF (z4.take 2) == mleEvalF (vF.take 4) (z4.take 2)
#guard productDotF vF (f4.take 2) == productDotF (vF.take 4) (f4.take 2)
#guard productDotE vE (f4.take 2) == productDotE (vE.take 4) (f4.take 2)
#guard (productTable f4 100).size == 16
#guard productDotF [] f4 == 0 && productDotE [] f4 == zeroE

end OnBytes.FieldTest
